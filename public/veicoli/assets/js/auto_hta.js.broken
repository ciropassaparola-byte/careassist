                  "WHERE (([AnnoRiferimento] = " + annoVal + " AND [MeseRiferimento] = " + (mIdx + 1) + ") " +
                  "OR ([AnnoRiferimento] IS NULL AND Year(DataConsegna) = " + annoVal + " AND Month(DataConsegna) = " + (mIdx + 1) + ")) " +
                  "ORDER BY DataConsegna ASC";
