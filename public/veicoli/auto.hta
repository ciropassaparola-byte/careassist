                            <h2 style="color: #0ea5e9; font-size: 18px; margin:0; font-weight: 800; font-family: 'Inter', sans-serif;"><i class="fa fa-pie-chart"></i> Statistiche & Bilancio Finanziario Auto</h2>
                            <div style="font-size:12px; color:#94a3b8;">Anno: <b id="lblAnnoStatistiche" style="color:#0ea5e9;">2026</b></div>
                        </div>
                        
                        <div class="balance-cards" style="margin-bottom: 25px; display:flex; gap:15px;">
                            <div class="balance-card reimbursement" style="flex:1; background:#0f172a; border-left:4px solid #10b981; padding:15px; border-radius:12px; border-top:1px solid #1e293b; border-right:1px solid #1e293b; border-bottom:1px solid #1e293b;">
                                <div class="balance-title" style="font-size:10px; text-transform:uppercase; color:#94a3b8; font-weight:700;">Tot. Rimborsi ACI</div>
                                <div class="balance-val" id="analisi-kpi-rimborsi" style="color:#34d399; font-size:20px; font-weight:800; margin-top:4px;">0,00 €</div>
                            </div>
                            <div class="balance-card fuel" style="flex:1; background:#0f172a; border-left:4px solid #0ea5e9; padding:15px; border-radius:12px; border-top:1px solid #1e293b; border-right:1px solid #1e293b; border-bottom:1px solid #1e293b;">
                                <div class="balance-title" style="font-size:10px; text-transform:uppercase; color:#94a3b8; font-weight:700;">Stima Carburante</div>
                                <div class="balance-val" id="analisi-kpi-ord" style="color:#38bdf8; font-size:20px; font-weight:800; margin-top:4px;">0,00 €</div>
                            </div>
                            <div class="balance-card expense" style="flex:1; background:#0f172a; border-left:4px solid #ef4444; padding:15px; border-radius:12px; border-top:1px solid #1e293b; border-right:1px solid #1e293b; border-bottom:1px solid #1e293b;">
                                <div class="balance-title" style="font-size:10px; text-transform:uppercase; color:#94a3b8; font-weight:700;">Manutenzione & Officina</div>
                                <div class="balance-val" id="analisi-kpi-stra" style="color:#f87171; font-size:20px; font-weight:800; margin-top:4px;">0,00 €</div>
                            </div>
                            <div class="balance-card net" id="analisi-card-netto" style="flex:1; background:#0f172a; border-left:4px solid #f59e0b; padding:15px; border-radius:12px; border-top:1px solid #1e293b; border-right:1px solid #1e293b; border-bottom:1px solid #1e293b;">
                                <div class="balance-title" style="font-size:10px; text-transform:uppercase; color:#94a3b8; font-weight:700;">Guadagno Netto Reale</div>
                                <div class="balance-val" id="analisi-kpi-netto" style="color:#fbbf24; font-size:20px; font-weight:800; margin-top:4px;">0,00 €</div>
                            </div>
                        </div>

                        <!-- GRIGLIA DETTAGLIO MENSILI -->
                        <h3 style="color:#e2e8f0; font-size:14px; font-weight:700; margin-bottom:12px; border-bottom:1px solid #334155; padding-bottom:6px;"><i class="fa fa-list-alt"></i> Ripartizione Finanziaria Mese per Mese</h3>
                        <table class="enterprise-grid" style="width:100%; border-collapse:collapse; margin-bottom:25px;">
