                            <div style="display:flex; width:100%;">
                                <input type="text" id="txtScadenzaRevisione" placeholder="Scegli data..." onclick="ShowCalendarPicker(this.id)" readonly style="cursor:pointer; border-radius:8px 0 0 8px; flex:1;">
                                <button type="button" onclick="SalvaRecord();" title="Salva Modifiche" style="padding:0 12px; border:1.5px solid #334155; border-left:none; background:rgba(16, 185, 129, 0.15); cursor:pointer; border-radius:0 8px 8px 0; display:flex; align-items:center; color:#10b981;" onmouseover="this.style.background='rgba(16, 185, 129, 0.3)'" onmouseout="this.style.background='rgba(16, 185, 129, 0.15)'">
                                    <i class="fa fa-save"></i>
                                </button>
                            </div>
                        </div>
                        <div style="display:flex; gap:10px;">
                            <div class="form-group-modern" style="flex:1">
                                <label>Km Attuali</label>
                                <div style="display:flex; width:100%;">
                                    <input type="text" id="txtKmAttuali" placeholder="Es. 142000" style="border-radius:8px 0 0 8px; flex:1;">
                                    <button type="button" onclick="SalvaRecord();" title="Salva Modifiche" style="padding:0 12px; border:1.5px solid #334155; border-left:none; background:rgba(16, 185, 129, 0.15); cursor:pointer; border-radius:0 8px 8px 0; display:flex; align-items:center; color:#10b981;" onmouseover="this.style.background='rgba(16, 185, 129, 0.3)'" onmouseout="this.style.background='rgba(16, 185, 129, 0.15)'">
                                        <i class="fa fa-save"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="form-group-modern" style="flex:1">
                                <label>Prossimo Tagliando (Km)</label>
                                <div style="display:flex; width:100%;">
                                    <input type="text" id="txtSogliaTagliando" placeholder="Es. 150000" style="border-radius:8px 0 0 8px; flex:1;">
                                    <button type="button" onclick="SalvaRecord();" title="Salva Modifiche" style="padding:0 12px; border:1.5px solid #334155; border-left:none; background:rgba(16, 185, 129, 0.15); cursor:pointer; border-radius:0 8px 8px 0; display:flex; align-items:center; color:#10b981;" onmouseover="this.style.background='rgba(16, 185, 129, 0.3)'" onmouseout="this.style.background='rgba(16, 185, 129, 0.15)'">
                                        <i class="fa fa-save"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="form-group-modern">
                            <label>Note / Dettagli Mezzo</label>
                            <div style="display:flex; width:100%;">
                                <textarea id="txtNoteVeh" placeholder="Aggiungi note..." style="height: 60px; resize: none; border-radius:8px 0 0 8px; flex:1;"></textarea>
                                <button type="button" onclick="SalvaRecord();" title="Salva Modifiche" style="padding:0 12px; border:1.5px solid #334155; border-left:none; background:rgba(16, 185, 129, 0.15); cursor:pointer; border-radius:0 8px 8px 0; display:flex; align-items:center; color:#10b981;" onmouseover="this.style.background='rgba(16, 185, 129, 0.3)'" onmouseout="this.style.background='rgba(16, 185, 129, 0.15)'">
                                    <i class="fa fa-save"></i>
                                </button>
                            </div>
                        </div>

                        <!-- SEZIONE X-RAY COMPONENTI -->
                        <div class="xray-container" id="xrayPanel">
                            <div class="xray-header"><i class="fa fa-cogs"></i> Salute Componenti (Km Base)</div>
                            
                            <!-- Component: Olio -->
                            <div class="health-item">
                                <div class="health-row-info">
                                    <span class="health-label"><i class="fa fa-tint"></i> Olio Motore <i class="fa fa-cog health-config-trigger" onclick="ToggleXrayConfig('Olio')" title="Imposta Km Ultimo Cambio"></i></span>
                                    <span id="healthPct_Olio" class="health-pct">100%</span>
                                </div>
                                <div class="health-bar-bg"><div id="healthFill_Olio" class="health-bar-fill" style="width: 100%"></div></div>
                                <div id="healthConfig_Olio" class="xray-config-inline">
                                    <label style="color:#06b6d4; font-size:9px; font-weight:bold;">KM ULTIMO CAMBIO:</label><br>
                                    <input type="text" id="baseKm_Olio" placeholder="Es. 120000">
                                    <button class="xray-btn-save" onclick="SaveXrayBaseline('Olio')">Salva</button>
                                    <button class="xray-btn-save" style="background:#ef4444; box-shadow:0 0 8px rgba(239,68,68,0.3);" onclick="ResetXrayToCurrent('Olio')">Reset 🔄</button>
                                </div>
                            </div>

                            <!-- Component: Freni -->
                            <div class="health-item">
                                <div class="health-row-info">
                                    <span class="health-label"><i class="fa fa-circle-o-notch"></i> Impianto Frenante <i class="fa fa-cog health-config-trigger" onclick="ToggleXrayConfig('Freni')" title="Imposta Km Ultimo Cambio"></i></span>
                                    <span id="healthPct_Freni" class="health-pct">100%</span>
                                </div>
                                <div class="health-bar-bg"><div id="healthFill_Freni" class="health-bar-fill" style="width: 100%"></div></div>
                                <div id="healthConfig_Freni" class="xray-config-inline">
                                    <label style="color:#06b6d4; font-size:9px; font-weight:bold;">KM ULTIMO CAMBIO:</label><br>
                                    <input type="text" id="baseKm_Freni" placeholder="Es. 120000">
                                    <button class="xray-btn-save" onclick="SaveXrayBaseline('Freni')">Salva</button>
                                    <button class="xray-btn-save" style="background:#ef4444; box-shadow:0 0 8px rgba(239,68,68,0.3);" onclick="ResetXrayToCurrent('Freni')">Reset 🔄</button>
                                </div>
                            </div>

                            <!-- Component: Gomme -->
                            <div class="health-item">
                                <div class="health-row-info">
                                    <span class="health-label"><i class="fa fa-dot-circle-o"></i> Pneumatici <i class="fa fa-cog health-config-trigger" onclick="ToggleXrayConfig('Gomme')" title="Imposta Km Ultimo Cambio"></i></span>
                                    <span id="healthPct_Gomme" class="health-pct">100%</span>
                                </div>
                                <div class="health-bar-bg"><div id="healthFill_Gomme" class="health-bar-fill" style="width: 100%"></div></div>
                                <div id="healthConfig_Gomme" class="xray-config-inline">
                                    <label style="color:#06b6d4; font-size:9px; font-weight:bold;">KM ULTIMO CAMBIO:</label><br>
                                    <input type="text" id="baseKm_Gomme" placeholder="Es. 120000">
                                    <button class="xray-btn-save" onclick="SaveXrayBaseline('Gomme')">Salva</button>
                                    <button class="xray-btn-save" style="background:#ef4444; box-shadow:0 0 8px rgba(239,68,68,0.3);" onclick="ResetXrayToCurrent('Gomme')">Reset 🔄</button>
                                </div>
                            </div>

                            <!-- Component: Cinghia -->
                            <div class="health-item">
                                <div class="health-row-info">
                                    <span class="health-label"><i class="fa fa-refresh"></i> Cinghia Distrib. <i class="fa fa-cog health-config-trigger" onclick="ToggleXrayConfig('Cinghia')" title="Imposta Km Ultimo Cambio"></i></span>
                                    <span id="healthPct_Cinghia" class="health-pct">100%</span>
                                </div>
                                <div class="health-bar-bg"><div id="healthFill_Cinghia" class="health-bar-fill" style="width: 100%"></div></div>
                                <div id="healthConfig_Cinghia" class="xray-config-inline">
                                    <label style="color:#06b6d4; font-size:9px; font-weight:bold;">KM ULTIMO CAMBIO:</label><br>
                                    <input type="text" id="baseKm_Cinghia" placeholder="Es. 120000">
                                    <button class="xray-btn-save" onclick="SaveXrayBaseline('Cinghia')">Salva</button>
                                    <button class="xray-btn-save" style="background:#ef4444; box-shadow:0 0 8px rgba(239,68,68,0.3);" onclick="ResetXrayToCurrent('Cinghia')">Reset 🔄</button>
                                </div>
                            </div>
                        </div>
                        
                        <!-- INLINE SAVE ACTION BUTTON -->
                        <button onclick="SalvaRecord()" style="width:100%; margin-top:18px; background:linear-gradient(135deg, #10b981 0%, #059669 100%); border:none; border-radius:12px; padding:14px 20px; color:#ffffff; font-family:'Inter',sans-serif; font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:1px; display:flex; align-items:center; justify-content:center; gap:10px; cursor:pointer; box-shadow:0 5px 15px rgba(16,185,129,0.3); transition:all 0.2s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 20px rgba(16,185,129,0.5)';" onmouseout="this.style.transform='translateY(0px)'; this.style.boxShadow='0 5px 15px rgba(16,185,129,0.3)';">
                            <i class="fa fa-save" style="font-size:16px;"></i> Salva Scheda Veicolo
                        </button>
                    </div>
                </div>

            </div>

        </div>

    </div>

    <script src="assets/js/auto_hta.js?v=11.3"></script>

    <!-- CALENDARIO FLOTTANTE STILE DIARIO -->
    <div id="diaryCalendarPicker" style="display:none; position:absolute; z-index:9999; background:#ffffff; border:1.5px solid #cbd5e1; border-radius:20px; width:280px; box-shadow:0 10px 25px rgba(0,0,0,0.15); font-family:'Inter', sans-serif; overflow:hidden; padding:5px;">
        <!-- Intestazione Mese -->
        <div style="background:#ffffff; padding:12px 15px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #f1f5f9;">
            <button onclick="PrevMonthCalendar(); if(window.event){window.event.cancelBubble=true;}else{event.stopPropagation();}" style="background:transparent; border:none; color:#000000; font-weight:bold; cursor:pointer; font-size:16px; outline:none; padding:0 5px;">&#9664;</button>
            <span id="calendarMonthTitle" style="font-weight:800; font-size:15px; color:#005a9e; font-family:'Inter', sans-serif;">Maggio 2026</span>
            <button onclick="NextMonthCalendar(); if(window.event){window.event.cancelBubble=true;}else{event.stopPropagation();}" style="background:transparent; border:none; color:#000000; font-weight:bold; cursor:pointer; font-size:16px; outline:none; padding:0 5px;">&#9654;</button>
        </div>
        
        <!-- Tabella Calendario -->
        <table style="width:100%; border-collapse:collapse; margin-top:5px; font-family:'Inter', sans-serif; table-layout:fixed;">
            <thead>
                <tr style="font-size:11px; font-weight:800; color:#94a3b8; border-bottom:1px solid #f1f5f9; height:30px; text-align:center;">
                    <th style="width:14%; text-align:center; font-family:'Inter', sans-serif;">LU</th>
                    <th style="width:14%; text-align:center; font-family:'Inter', sans-serif;">MA</th>
                    <th style="width:14%; text-align:center; font-family:'Inter', sans-serif;">ME</th>
                    <th style="width:14%; text-align:center; font-family:'Inter', sans-serif;">GI</th>
                    <th style="width:14%; text-align:center; font-family:'Inter', sans-serif;">VE</th>
                    <th style="width:14%; text-align:center; color:#005a9e; font-family:'Inter', sans-serif;">SA</th>
                    <th style="width:14%; text-align:center; color:#e05638; font-family:'Inter', sans-serif;">DO</th>
                </tr>
            </thead>
            <tbody id="calendarDaysGridTable">
                <!-- Righe e celle generate via JS -->
            </tbody>
        </table>
        
        <!-- Pulsanti Azione Bottom -->
        <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 15px 15px 15px; border-top:1px solid #f1f5f9; background:#ffffff; margin-top:5px;">
            <button onclick="SetCalendarToday(); if(window.event){window.event.cancelBubble=true;}" style="background:#ffffff; border:1px solid #cbd5e1; border-radius:8px; padding:6px 14px; font-size:11px; font-weight:bold; color:#475569; cursor:pointer; outline:none; transition:all 0.15s ease; font-family:'Inter', sans-serif;">OGGI</button>
            <button onclick="CloseCalendar(); if(window.event){window.event.cancelBubble=true;}" style="background:#e05638; border:none; border-radius:8px; padding:6px 14px; font-size:11px; font-weight:bold; color:#ffffff; cursor:pointer; outline:none; transition:all 0.15s ease; box-shadow:0 2px 6px rgba(224,86,56,0.2); font-family:'Inter', sans-serif;">CHIUDI</button>
        </div>
    </div>


    <!-- PREMIUM HUD SYSTEM TOAST NOTIFICATION -->
    <div id="customSystemToast" style="position:fixed; top: 25px; right: -360px; z-index:99999; background:rgba(15, 23, 42, 0.95); border: 2px solid #10b981; border-radius:16px; padding:16px 22px; display:flex; align-items:center; gap:15px; box-shadow:0 20px 40px rgba(0,0,0,0.45); transition: all 0.5s cubic-bezier(.175,.885,.32,1.275); font-family:'Inter',sans-serif; width:320px; box-sizing:border-box;">
        <div id="toastIcon" style="font-size:28px; color:#10b981; display:flex; align-items:center; justify-content:center; flex-shrink:0; width:30px; filter:drop-shadow(0 0 8px rgba(16,185,129,0.4));">
            <i class="fa fa-check-circle"></i>
        </div>
        <div style="flex:1;">
            <b id="toastTitle" style="display:block; font-size:11.5px; text-transform:uppercase; letter-spacing:1px; color:#ffffff; font-weight:900; margin-bottom:2px;">Operazione Riuscita</b>
            <span id="toastMessage" style="display:block; font-size:11px; color:#94a3b8; line-height:1.3;">Dati registrati con successo!</span>
        </div>
    </div>
    <script src="assets/js/accessibility.js"></script>

<script src="./assets/js/global_context.js"></script>
<!-- MODAL GUIDA ALL'USO (MSHTA REFLOW COMPATIBLE) -->
<div id="helpModalOverlay" style="display:none; visibility:hidden; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(2, 6, 23, 0.88); z-index:200000;">
    <div style="position:absolute; top:50%; left:50%; margin-top:-260px; margin-left:-320px; width:640px; background:#0f172a; border:2px solid #38bdf8; border-radius:16px; box-shadow:0 0 35px rgba(56, 189, 248, 0.4); padding:25px; color:#f8fafc; font-family:'Plus Jakarta Sans', 'Segoe UI', sans-serif;">
        <!-- Header Modal -->
        <div style="border-bottom:1px solid #38bdf8; padding-bottom:12px; margin-bottom:15px; position:relative;">
            <div style="font-family:'Outfit', sans-serif; font-size:1.2rem; font-weight:800; color:#38bdf8; letter-spacing:0.5px;">
                &#128216; GUIDA ALL'USO - ZENITH MATERIALI
            </div>
            <div style="font-size:0.75rem; color:#94a3b8; margin-top:2px;">Manuale Rapido Operativo &amp; Scorciatoie</div>
            <div onmousedown="ChiudiGuidaModal(event); return false;" onclick="ChiudiGuidaModal(event);" style="cursor:pointer; position:absolute; top:0; right:0; width:30px; height:30px; background:#1e293b; border:1px solid #38bdf8; border-radius:50%; text-align:center; line-height:28px; color:#f8fafc; font-weight:bold; font-size:1.2rem; user-select:none;">&times;</div>
        </div>

        <!-- Content Modal -->
        <div style="height:350px; overflow-y:auto; padding-right:5px;">
            <table style="width:100%; border-collapse:collapse; margin-bottom:12px;">
                <tr>
                    <td style="width:50%; padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#fbbf24; font-size:0.88rem; margin-bottom:6px;">
                                &#128269; 1. Ricerca Globale Istantanea
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Digita nel campo in alto per filtrare in tempo reale clienti, città, telefoni o specifiche attrezzature assegnate.
                            </div>
                        </div>
                    </td>
                    <td style="width:50%; padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#38bdf8; font-size:0.88rem; margin-bottom:6px;">
                                &#128205; 2. Filtri Provincia &amp; Articolo
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Usa la barra laterale sinistra per isolare velocemente le province (Bari, Foggia, Taranto) o i dispositivi (Orologio, Sveglia, Braille).
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td style="padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#34d399; font-size:0.88rem; margin-bottom:6px;">
                                &#128203; 3. Pulsanti Copia Dati
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Clicca sul tasto verde <b>Copia</b> per salvare la scheda cliente negli appunti e trasferirla nei promemoria o report.
                            </div>
                        </div>
                    </td>
                    <td style="padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#a78bfa; font-size:0.88rem; margin-bottom:6px;">
                                &#128259; 4. Sincronizzazione Danea
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Dal menu <b>File</b> o <b>Strumenti</b> premi <i>Sincronizza Excel Ora</i> per ricaricare le anagrafiche aggiornate.
                            </div>
                        </div>
                    </td>
                </tr>
            </table>

            <div style="background:rgba(56, 189, 248, 0.15); border:1px solid #38bdf8; padding:12px; border-radius:10px; font-size:0.8rem; color:#cbd5e1;">
                <b style="color:#38bdf8;">&#9889; Suggerimento Rapido:</b> Per resettare tutti i filtri attivi e tornare alla vista completa, seleziona <b>TUTTE LE PROVINCE</b> ed <b>ELENCO COMPLETO</b> dalla sidebar a sinistra.
            </div>
        </div>

        <!-- Footer Modal -->
        <div style="margin-top:15px; padding-top:12px; border-top:1px solid rgba(255,255,255,0.1); text-align:right;">
            <span style="font-size:0.75rem; color:#94a3b8; float:left; margin-top:8px;">Sistema Zenith Materiali v1.0 &bull; C. Milella 2026</span>
            <button onmousedown="ChiudiGuidaModal(event); return false;" onclick="ChiudiGuidaModal(event);" style="background:#0284c7; color:white; border:1px solid #38bdf8; padding:8px 24px; border-radius:8px; font-weight:800; font-size:0.85rem; cursor:pointer; font-family:'Outfit', sans-serif;">HO CAPITO</button>
        </div>
    </div>
</div>
</body>
</html>

