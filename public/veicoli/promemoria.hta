    <!-- MODALE CESTINO -->
    <div id="trashModal" class="calendar-overlay" style="display:none; z-index:20000;">
        <div class="calendar-modal" style="width: 500px;">
            <div class="calendar-header" style="background:#ef4444; color:white;">
                <h3 style="color:white; margin:0;"><i class="fa fa-trash"></i> Cestino Appuntamenti</h3>
            </div>
            <div id="trashList" style="max-height: 400px; overflow-y: auto; padding: 15px; background: #fff;">
                <!-- JS List -->
            </div>
            <div class="calendar-footer" style="display:flex; justify-content:space-between; padding: 15px; background: #f8fafc;">
                <button class="btn-cal-action" onclick="SvuotaCestino()" style="color:#ef4444; border-color:#ef4444;">SVUOTA TUTTO</button>
