            <div style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); padding: 25px 35px; color:white; display:flex; justify-content:space-between; align-items:center; position:relative; border-bottom: 1px solid rgba(255,255,255,0.05);">
                <div>
                    <div style="font-size:10px; font-weight:900; color:#ffab00; letter-spacing:2px; text-transform:uppercase; margin-bottom:4px;">Tutorial & Istruzioni</div>
                    <h2 style="margin:0; font-size:22px; font-weight:800; letter-spacing:-0.5px; display:flex; align-items:center; gap:10px;">✨ Guida alle Novità del Cruscotto</h2>
                </div>
                <button onclick="ChiudiGuidaNovita()" style="background:rgba(255,255,255,0.1); border:none; color:white; border-radius:50%; width:36px; height:36px; cursor:pointer; font-weight:900; font-size:18px; display:flex; align-items:center; justify-content:center; outline:none; transition:all 0.2s;" onmouseover="this.style.background='rgba(231, 76, 60, 0.8)'; this.style.transform='rotate(90deg)';" onmouseout="this.style.background='rgba(255,255,255,0.1)'; this.style.transform='none';">×</button>
            </div>
            
            <!-- CONTENITORE PRINCIPALE CON SIDEBAR TABS -->
            <div style="display:flex; flex:1; overflow:hidden;">
                <!-- TABS MENU (SINISTRA) -->
                <div style="width:240px; background:#f8fafc; border-right:1.5px solid #e2e8f0; padding:20px 15px; display:flex; flex-direction:column; gap:8px;">
                    <button class="tab-guida-btn active" onclick="CambiaTabGuida(0, this)" id="tabGuidaBtn0">📊 Widget & KPI</button>
                    <button class="tab-guida-btn" onclick="CambiaTabGuida(1, this)" id="tabGuidaBtn1">📅 Agenda Operativa</button>
                    <button class="tab-guida-btn" onclick="CambiaTabGuida(2, this)" id="tabGuidaBtn2">⚡ Scorciatoie & Trucchi</button>
                    <button class="tab-guida-btn" onclick="CambiaTabGuida(3, this)" id="tabGuidaBtn3" style="color:#d97706; font-weight:900; background:linear-gradient(90deg, transparent, rgba(217, 119, 6, 0.05)); border-left-color:#d97706;">🌟 Premium Gold</button>
                    
                    <div style="margin-top:auto; background:rgba(255, 171, 0, 0.1); border:1.5px dashed #ffab00; padding:15px; border-radius:16px; font-size:11px; color:#9b6d00; line-height:1.4;">
                        <b>💡 Lo Sapevi?</b><br>Tutti i bottoni visualizzano una descrizione d'aiuto nel footer quando ci passi sopra col mouse!
                    </div>
                </div>
                
                <!-- CONTENUTO TABS (DESTRA) -->
                <div style="flex:1; overflow-y:auto; padding:30px 35px; background:#ffffff;" id="contenutoGuida">
                    <!-- Dati inseriti dinamicamente via JS -->
                </div>
            </div>
            
            <!-- FOOTER AZIONI -->
            <div style="padding:15px 35px; background:#f8fafc; border-top:1.5px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:11px; color:#94a3b8; font-weight:700; text-transform:uppercase;">Logistica C. Milella Gold v4.0</span>
                <button onclick="ChiudiGuidaNovita()" style="background:#0f172a; color:white; border:none; border-radius:10px; padding:10px 25px; font-size:12px; font-weight:800; cursor:pointer; transition:all 0.2s; letter-spacing:0.5px; text-transform:uppercase; box-shadow: 0 4px 10px rgba(15, 23, 42, 0.15);" onmouseover="this.style.transform='translateY(-1px)'; this.style.boxShadow='0 8px 15px rgba(15, 23, 42, 0.25)';" onmouseout="this.style.transform='none'; this.style.boxShadow='0 4px 10px rgba(15, 23, 42, 0.15)';" >HO CAPITO, GRAZIE!</button>
            </div>
        </div>
    </div>

    <!-- PAUSA SCHERMO (SCREENSAVER) -->
    <div id="screensaver" class="screensaver-overlay" style="display: none;" onmousemove="ResetScreensaver()">
        <div class="ss-aurora ss-aurora-1"></div>
        <div class="ss-aurora ss-aurora-2"></div>
        <canvas id="ssCanvas" style="position: absolute; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:2;"></canvas>
        <div class="screensaver-content" style="text-align: center;">
            <div id="ssClock" class="ss-clock">00:00</div>
            <div class="ss-date" id="ssDate">Lunedì 1 Gennaio 2026</div>
            <div class="ss-cards-container">
                <div class="ss-card">
                    <span class="ss-card-icon">📦</span>
                    <div class="ss-card-label">
                        <span class="ss-card-title">Consegne Oggi</span>
                        <span class="ss-card-val" id="ssConsegneOggi">0</span>
                    </div>
                </div>
                <div class="ss-card">
                    <span class="ss-card-icon">⛅</span>
                    <div class="ss-card-label">
                        <span class="ss-card-title">Meteo Bari</span>
                        <span class="ss-card-val" id="ssMeteo">Bari --°C</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- QUICK ACTIONS FAB -->
    <div id="ux-quick-fab" style="position:fixed; bottom:30px; right:30px; z-index:9999; display:flex; flex-direction:column; align-items:flex-end; gap:15px;">
        <div id="ux-fab-menu" style="display:none; flex-direction:column; gap:10px; align-items:flex-end;">
            <button class="ux-ripple-btn" onclick="try{ NavigaModulo('consegne.hta'); }catch(e){ window.location.href='consegne_v2.hta'; }" style="background:#2563eb; color:white; border:none; padding:10px 18px; border-radius:20px; font-weight:bold; cursor:pointer; box-shadow:0 4px 10px rgba(37,99,235,0.3); font-size:12px; display:flex; align-items:center; gap:8px;">
                <span style="font-size:16px;">📦</span> Nuova Consegna
            </button>
            <button class="ux-ripple-btn" onclick="try{ NavigaModulo('anagrafica.hta'); }catch(e){ window.location.href='anagrafica.hta'; }" style="background:#059669; color:white; border:none; padding:10px 18px; border-radius:20px; font-weight:bold; cursor:pointer; box-shadow:0 4px 10px rgba(5,150,105,0.3); font-size:12px; display:flex; align-items:center; gap:8px;">
                <span style="font-size:16px;">👥</span> Gestione Clienti
            </button>
            <button class="ux-ripple-btn" onclick="if(window.CalcolaPercorsoMappaOdierno) CalcolaPercorsoMappaOdierno(); else UXPremium.ShowToast('Funzione non disponibile', 'error');" style="background:#d97706; color:white; border:none; padding:10px 18px; border-radius:20px; font-weight:bold; cursor:pointer; box-shadow:0 4px 10px rgba(217,119,6,0.3); font-size:12px; display:flex; align-items:center; gap:8px;">
                <span style="font-size:16px;">🗺️</span> Calcola Percorso Mappa
            </button>
        </div>
        <button id="ux-fab-main" onclick="var m=document.getElementById('ux-fab-menu'); m.style.display=m.style.display==='none'?'flex':'none';" class="ux-ripple-btn" style="width:60px; height:60px; border-radius:50%; background:linear-gradient(135deg, #f59e0b, #d97706); border:none; color:white; font-size:28px; box-shadow:0 8px 25px rgba(217,119,6,0.5); cursor:pointer; display:flex; justify-content:center; align-items:center; transition:transform 0.3s; outline:none;" onmouseover="this.style.transform='scale(1.1) rotate(90deg)';" onmouseout="this.style.transform='scale(1) rotate(0deg)';">
            +
        </button>
    </div>

    <script src="assets/js/accessibility.js"></script>
    <script src="assets/js/dashboard_hta.js"></script>
    <script src="assets/js/materiali_engine.js"></script>

<script src="./assets/js/global_context.js"></script>
<!-- MODAL GUIDA ALL'USO (MSHTA REFLOW COMPATIBLE) -->
<div id="helpModalOverlay" style="display:none; visibility:hidden; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(2, 6, 23, 0.88); z-index:200000;">
    <div style="position:absolute; top:50%; left:50%; margin-top:-260px; margin-left:-320px; width:640px; background:#0f172a; border:2px solid #38bdf8; border-radius:16px; box-shadow:0 0 35px rgba(56, 189, 248, 0.4); padding:25px; color:#f8fafc; font-family:'Plus Jakarta Sans', 'Segoe UI', sans-serif;">
        <!-- Header Modal -->
        <div style="border-bottom:1px solid #38bdf8; padding-bottom:12px; margin-bottom:15px; position:relative;">
            <div style="font-family:'Outfit', sans-serif; font-size:1.2rem; font-weight:800; color:#38bdf8; letter-spacing:0.5px;">
                &#128216; GUIDA ALL'USO - ZENITH MATERIALI
            </div>
            <div style="font-size:0.75rem; color:#94a3b8; margin-top:2px;">Manuale Rapido Operativo &amp; Scorciatoie</div>
            <div onmousedown="ChiudiGuidaModal(event); return false;" onclick="ChiudiGuidaModal(event);" style="cursor:pointer; position:absolute; top:0; right:0; width:30px; height:30px; background:#1e293b; border:1px solid #38bdf8; border-radius:50%; text-align:center; line-height:28px; color:#f8fafc; font-weight:bold; font-size:1.2rem; user-select:none;">&times;</div>
        </div>

        <!-- Content Modal -->
        <div style="height:350px; overflow-y:auto; padding-right:5px;">
            <table style="width:100%; border-collapse:collapse; margin-bottom:12px;">
                <tr>
                    <td style="width:50%; padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#fbbf24; font-size:0.88rem; margin-bottom:6px;">
                                &#128269; 1. Ricerca Globale Istantanea
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Digita nel campo in alto per filtrare in tempo reale clienti, città, telefoni o specifiche attrezzature assegnate.
                            </div>
                        </div>
                    </td>
                    <td style="width:50%; padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#38bdf8; font-size:0.88rem; margin-bottom:6px;">
                                &#128205; 2. Filtri Provincia &amp; Articolo
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Usa la barra laterale sinistra per isolare velocemente le province (Bari, Foggia, Taranto) o i dispositivi (Orologio, Sveglia, Braille).
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td style="padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#34d399; font-size:0.88rem; margin-bottom:6px;">
                                &#128203; 3. Pulsanti Copia Dati
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Clicca sul tasto verde <b>Copia</b> per salvare la scheda cliente negli appunti e trasferirla nei promemoria o report.
                            </div>
                        </div>
                    </td>
                    <td style="padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#a78bfa; font-size:0.88rem; margin-bottom:6px;">
                                &#128259; 4. Sincronizzazione Danea
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Dal menu <b>File</b> o <b>Strumenti</b> premi <i>Sincronizza Excel Ora</i> per ricaricare le anagrafiche aggiornate.
                            </div>
                        </div>
                    </td>
                </tr>
            </table>

            <div style="background:rgba(56, 189, 248, 0.15); border:1px solid #38bdf8; padding:12px; border-radius:10px; font-size:0.8rem; color:#cbd5e1;">
                <b style="color:#38bdf8;">&#9889; Suggerimento Rapido:</b> Per resettare tutti i filtri attivi e tornare alla vista completa, seleziona <b>TUTTE LE PROVINCE</b> ed <b>ELENCO COMPLETO</b> dalla sidebar a sinistra.
            </div>
        </div>

        <!-- Footer Modal -->
        <div style="margin-top:15px; padding-top:12px; border-top:1px solid rgba(255,255,255,0.1); text-align:right;">
            <span style="font-size:0.75rem; color:#94a3b8; float:left; margin-top:8px;">Sistema Zenith Materiali v1.0 &bull; C. Milella 2026</span>
            <button onmousedown="ChiudiGuidaModal(event); return false;" onclick="ChiudiGuidaModal(event);" style="background:#0284c7; color:white; border:1px solid #38bdf8; padding:8px 24px; border-radius:8px; font-weight:800; font-size:0.85rem; cursor:pointer; font-family:'Outfit', sans-serif;">HO CAPITO</button>
        </div>
    </div>
</div>
</body>
</html>
