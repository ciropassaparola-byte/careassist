            var idonei = ringIdonei ? (ringIdonei.innerText || ringIdonei.textContent || "0") : "0";
            Parla("Stato Dispositivi: " + idonei + " dispositivi con Sblocco Pronto. Questi ausili sono idonei per una nuova fornitura immediata.");
        }

        function EvidenziaParole(testo, parole) {
            if (!testo || !parole || parole.length === 0) return testo;
            var html = testo.toString();
            // Ordiniamo le parole dal pi� lungo al pi� corto per evitare conflitti di sovrascrittura parziale
            var sorted = parole.slice().sort(function(a, b) { return b.length - a.length; });
            for (var i = 0; i < sorted.length; i++) {
                var w = sorted[i].trim();
                if (w.length < 2) continue; // Escludiamo lettere singole per evitare falsi positivi continui
                
                // Effettuiamo un escape dei caratteri speciali per evitare errori di espressione regolare
                var escaped = w.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
                var regex = new RegExp("(" + escaped + ")", "gi");
                html = html.replace(regex, "<span class='search-highlight'>$1</span>");
            }
            return html;
        }

        function RiproduciSuono(nomeSuono) {
            try {
                var path = "C:\\Windows\\Media\\" + nomeSuono + ".wav";
                var snd = new Audio(path);
                snd.volume = 0.15; // Gentle 15% volume for an ultra-premium feel
                snd.play();
            } catch(e) {}
        }

        function ApriModalStatistiche() {
            RiproduciSuono("notify");
            CalcolaStatisticheECharts();
            try { CaricaStoricoPostitArchiviati(); } catch(e) {}
            document.getElementById("modalStatistiche").style.display = "block";
        }

        function ChiudiModalStatistiche() {
            document.getElementById("modalStatistiche").style.display = "none";
        }

        function CalcolaStatisticheECharts() {
            var total = 0;
            var ciechi = 0;
            var ipovedenti = 0;
            var deceduti = 0;
            var normali = 0;
            var prontiRinnovo = 0;
            var provMap = {};
            var idoneiNomi = {};
            
            for (var i = 0; i < allData.length; i++) {
                var p = allData[i];
                var nome = (p[0] || "").trim().toUpperCase();
                var inv = (p[4] || "DA DEFINIRE").trim().toUpperCase();
                var citta = (p[5] || "").trim();
                var prov = (p[6] || "").trim().toUpperCase();
                
                // Calcolo idonei rinnovo
                if (p[2] && p[2] !== "NULL") {
                    var dS = new Date(new Date(p[2]).getFullYear() + 6, new Date(p[2]).getMonth(), new Date(p[2]).getDate());
                    if (inv.indexOf("DECEDUTO") === -1) {
                        if (new Date() > dS) {
                            idoneiNomi[nome] = true;
                        }
                    }
                }
                
                if (inv.indexOf("DECEDUTO") > -1) {
                    deceduti++;
                } else {
                    total++;
                    if (inv.indexOf("CIECO") > -1) {
                        ciechi++;
                    } else if (inv.indexOf("IPOVEDENT") > -1) {
                        ipovedenti++;
                    } else {
                        normali++;
                    }
                    
                    // Raggruppamento per provincia
                    if (prov && prov !== "---" && prov !== "") {
                        provMap[prov] = (provMap[prov] || 0) + 1;
                    }
                }
            }
            
            prontiRinnovo = Object.keys(idoneiNomi).length;
            
            // Popoliamo le tessere numeriche
            document.getElementById("statTotalText").innerText = total;
            document.getElementById("statCiechiText").innerText = ciechi;
            document.getElementById("statIpovText").innerText = ipovedenti;
            document.getElementById("statRinnovaText").innerText = prontiRinnovo;
            
            // Rinvio vocale delle statistiche salienti
            Parla("Dashboard aperta. Totale assistiti attivi: " + total + ", di cui " + ciechi + " non vedenti e " + ipovedenti + " ipovedenti. " + prontiRinnovo + " pronti per rinnovo.");
            
            // 1. GRAFICO DELLE PROVINCE (Barre SVG Native orizzontali)
            var barsHTML = "";
            var sortedProv = [];
            for (var k in provMap) {
                sortedProv.push({ name: k, count: provMap[k] });
            }
            sortedProv.sort(function(a, b) { return b.count - a.count; });
            
            var maxShow = Math.min(sortedProv.length, 5);
            var maxCount = sortedProv.length > 0 ? sortedProv[0].count : 1;
            
            if (sortedProv.length === 0) {
                barsHTML = "<div style='color:#64748b; font-size:11px; text-align:center;'>Nessun dato geografico disponibile</div>";
            } else {
                for (var j = 0; j < maxShow; j++) {
                    var pct = (sortedProv[j].count / maxCount) * 100;
                    var hue = 200 + (j * 12); 
                    barsHTML += "<div style='margin-bottom:8px; font-family:sans-serif;'>" +
                                "  <div style='display:flex; justify-content:space-between; font-size:11px; font-weight:800; margin-bottom:3px; color:#cbd5e1;'>" +
                                "    <span>?? " + sortedProv[j].name + "</span>" +
                                "    <span style='color:hsl(" + hue + ", 90%, 65%);'>" + sortedProv[j].count + " Assistiti</span>" +
                                "  </div>" +
                                "  <div style='width:100%; height:10px; background-color:#1e293b; border-radius:5px; overflow:hidden;'>" +
                                "    <div style='width:" + pct + "%; height:100%; background:linear-gradient(90deg, #3b82f6 0%, hsl(" + hue + ", 90%, 60%) 100%); border-radius:5px; transition:width 0.5s ease-out;'></div>" +
                                "  </div>" +
                                "</div>";
                }
            }
            document.getElementById("statProvinceBars").innerHTML = barsHTML;
            
            // 2. GRAFICO INVALIDIT� (SVG Pie Chart)
            var pieHTML = "";
            var totalActive = ciechi + ipovedenti + normali;
            if (totalActive === 0) {
                pieHTML = "<div style='color:#64748b; font-size:11px;'>Nessun dato disponibile</div>";
            } else {
                var pctCiechi = (ciechi / totalActive) * 100;
                var pctIpovedenti = (ipovedenti / totalActive) * 100;
                var pctNormali = (normali / totalActive) * 100;
                
                var circ = 314.16;
                var offset = 0;
                
                var strokeCiechi = (pctCiechi / 100) * circ;
                var strokeIpovedenti = (pctIpovedenti / 100) * circ;
                var strokeNormali = (pctNormali / 100) * circ;
                
                pieHTML = "<div style='display:flex; align-items:center; justify-content:center; gap:20px;'>" +
                          "  <svg width='110' height='110' viewBox='0 0 160 160' style='transform: rotate(-90deg);'>" +
                          "    <circle cx='80' cy='80' r='50' fill='#0f172a' />";
                
                if (strokeCiechi > 0) {
                    pieHTML += "    <circle cx='80' cy='80' r='50' fill='transparent' stroke='#ef4444' stroke-width='22' " +
                               "      stroke-dasharray='" + strokeCiechi + " " + (circ - strokeCiechi) + "' stroke-dashoffset='" + (-offset) + "' />";
                    offset += strokeCiechi;
                }
                
                if (strokeIpovedenti > 0) {
                    pieHTML += "    <circle cx='80' cy='80' r='50' fill='transparent' stroke='#38bdf8' stroke-width='22' " +
                               "      stroke-dasharray='" + strokeIpovedenti + " " + (circ - strokeIpovedenti) + "' stroke-dashoffset='" + (-offset) + "' />";
                    offset += strokeIpovedenti;
                }
                
                if (strokeNormali > 0) {
                    pieHTML += "    <circle cx='80' cy='80' r='50' fill='transparent' stroke='#64748b' stroke-width='22' " +
                               "      stroke-dasharray='" + strokeNormali + " " + (circ - strokeNormali) + "' stroke-dashoffset='" + (-offset) + "' />";
                }
                
                pieHTML += "  </svg>" +
                           "  <div style='text-align:left; font-size:10px; color:#cbd5e1; font-family:sans-serif;'>" +
                           "    <div style='margin-bottom:6px; font-weight:800;'><span style='display:inline-block; width:8px; height:8px; background-color:#ef4444; border-radius:50%; margin-right:6px;'></span>Ciechi: " + Math.round(pctCiechi) + "%</div>" +
                           "    <div style='margin-bottom:6px; font-weight:800;'><span style='display:inline-block; width:8px; height:8px; background-color:#38bdf8; border-radius:50%; margin-right:6px;'></span>Ipovedenti: " + Math.round(pctIpovedenti) + "%</div>" +
                           "    <div style='font-weight:800;'><span style='display:inline-block; width:8px; height:8px; background-color:#64748b; border-radius:50%; margin-right:6px;'></span>Normali: " + Math.round(pctNormali) + "%</div>" +
                           "  </div>" +
                           "</div>";
            }
            document.getElementById("statPieChart").innerHTML = pieHTML;
        }

