        function AggiungiNotaPaziente() {
            var nomeOld = document.getElementById("mainNome").innerText;
            document.getElementById("noteClienteNome").innerText = nomeOld;
            document.getElementById("txtNotaContenuto").value = "";
            document.getElementById("modalAddNote").style.display = "block";
            setTimeout(function() {
                try { document.getElementById("txtNotaContenuto").focus(); } catch(e){}
            }, 100);
        }

        function ChiudiModalAddNote() {
            document.getElementById("modalAddNote").style.display = "none";
        }

        function SalvaNuovaNotaPaziente() {
            var nomeOld = document.getElementById("noteClienteNome").innerText;
            var nota = document.getElementById("txtNotaContenuto").value;
            if (!nota || nota.trim() === "") {
                alert("La nota non pu� essere vuota!");
                return;
            }
            
            var oggi = new Date();
            var dataStr = oggi.toLocaleDateString();
            var line = nomeOld + "|NOTE_LOG|" + dataStr + "|" + nota.trim().replace(/\|/g, " ") + "|---|---|---|---|---|---|---";
            
            try {
                var f = fso.OpenTextFile(dataFile, 8); // 8 = Append
                f.WriteLine(SanitizeForFSO(line));
                f.Close();
                
                ChiudiModalAddNote();
                RiproduciSuono("tada");
                Parla("Nota aggiunta al diario!");
                alert("Nota aggiunta al diario con successo!");
                AggiungiAttivita("?? DIARIO: Aggiunta nota per " + nomeOld + " - " + nota.trim());
                CaricaArchivio();
                
                var targetPulito = PulishNome(nomeOld);
                var cards = document.getElementsByClassName("item-card");
                for (var i = 0; i < cards.length; i++) {
                    if (PulishNome(cards[i].getElementsByClassName("name-main")[0].innerText) === targetPulito) {
                        cards[i].click();
                        cards[i].scrollIntoView();
                        break;
                    }
                }
            } catch(e) { alert("Errore nel salvataggio: " + e.message); }
        }

        function OttieniNomeProfilo() {
            try {
                if (typeof appPath !== "undefined" && appPath !== "") {
                    var sysDir = fso.BuildPath(appPath, "system");
                    var credFile = fso.BuildPath(sysDir, "cred.local");
                    if (fso.FileExists(credFile)) {
                        var f = fso.OpenTextFile(credFile, 1);
                        if (!f.AtEndOfStream) {
                            var user = f.ReadLine().trim();
                            f.Close();
                            if (user && user.toUpperCase() !== "OSPITE") {
                                var parts = user.split(" ");
                                for (var i = 0; i < parts.length; i++) {
                                    if (parts[i]) {
                                        parts[i] = parts[i].charAt(0).toUpperCase() + parts[i].slice(1).toLowerCase();
                                    }
                                }
                                return parts.join(" ");
                            }
                        } else {
                            f.Close();
                        }
                    }
                }
            } catch(e) {}
            return "Ciro Milella";
        }

        window.onload = function() {
            window.moveTo(0, 0);
            window.resizeTo(screen.availWidth, screen.availHeight);
            try {
                document.body.scrollTop = 0;
                document.documentElement.scrollTop = 0;
                var path = decodeURIComponent(document.location.pathname);
                if (path.indexOf(":") > -1) {
                    path = path.substring(path.indexOf(":") - 1).replace(/\//g, "\\");
                    if (path.charAt(0) === "\\") path = path.substring(1);
                }
                appPath = fso.GetParentFolderName(path);
                dataFile = fso.BuildPath(appPath, "asl_archivio.dat");
                POSTIT_FILE = fso.BuildPath(appPath, "postit_board.txt");
                
                // Aggiorna dinamicamente l'operatore attivo nella testata HTML
                var opNome = OttieniNomeProfilo();
                var lblOp = document.getElementById("lblHeaderOperatore");
                if (lblOp) {
                    lblOp.innerText = "MASCHERA OPERATIVA " + opNome.toUpperCase();
                }
                
                // Creazione cartella Foto_Clienti se non esiste
                var fotoDir = fso.BuildPath(appPath, "Foto_Clienti");
                if (!fso.FolderExists(fotoDir)) {
                    try { fso.CreateFolder(fotoDir); } catch(err) {}
                }
                
                function RidimensionaElementi() {
                    try {
                        var docHeight = document.documentElement.clientHeight || document.body.clientHeight;
                        var h = docHeight - 205;
                        if (h < 300) h = 300;
                        var lista = document.getElementById("listaClienti");
                        if (lista) lista.style.height = h + "px";
                        var content = document.getElementById("contentCol");
                        if (content) content.style.height = h + "px";
                    } catch(e) {}
                }
                RidimensionaElementi();
                window.onresize = RidimensionaElementi;
                
                CaricaArchivio();
                CaricaPostit();
                AggiornaStatoFileCSV();
                AggiungiAttivita("?? MASCHERA AVVIATA: Benvenuto nel Command Center ASL di " + opNome + "!");
                AggiungiAttivita("?? Database locale caricato: " + allData.length + " record ausili attivi.");

            } catch(e) {
                AggiungiAttivita("?? ERRORE AVVIO: " + e.message);
            }
        };

        function PulishNome(n) { return String(n).toUpperCase().replace(/\s/g, ""); }

        function SanitizeForFSO(str) {
            if (!str) return "";
            var result = "";
            for (var i = 0; i < str.length; i++) {
                var charCode = str.charCodeAt(i);
                if (charCode > 255) {
                    if (charCode === 0x20AC) { // Euro symbol �
                        result += "EUR";
                    } else if (charCode === 0x2014 || charCode === 0x2013) { // Em-dash or en-dash
                        result += "-";
                    } else if (charCode === 0x201C || charCode === 0x201D) { // Smart double quotes
                        result += '"';
                    } else if (charCode === 0x2018 || charCode === 0x2019) { // Smart single quotes
                        result += "'";
                    } else {
                        result += "?"; // Fallback for emojis and other high characters
                    }
                } else {
                    result += str.charAt(i);
                }
            }
            return result;
        }

        function AggiungiAttivita(messaggio) {
            var consoleBox = document.getElementById("consoleLogBox");
            if (consoleBox) {
                var now = new Date();
                var timeStr = ("0" + now.getHours()).slice(-2) + ":" + 
                              ("0" + now.getMinutes()).slice(-2) + ":" + 
                              ("0" + now.getSeconds()).slice(-2);
                var div = document.createElement("div");
                div.style.borderBottom = "1px solid rgba(16, 185, 129, 0.1)";
                div.style.padding = "4px 0";
                div.innerText = "[" + timeStr + "] " + messaggio;
                consoleBox.appendChild(div);
                consoleBox.scrollTop = consoleBox.scrollHeight;
            }
        }

        function CambiaTema(temaName) {
            var styleEl = document.getElementById("themeStyle");
            if (!styleEl) {
                styleEl = document.createElement("style");
                styleEl.id = "themeStyle";
                document.getElementsByTagName("head")[0].appendChild(styleEl);
            }
            
            if (temaName === "dark") {
                styleEl.innerHTML = "";
                AggiungiAttivita("TEMA VISIVO: Reimpostato Deep Space Blue (Default)");
                Parla("Tema visivo impostato su Deep Space Blue.");
            } else if (temaName === "contrast") {
                styleEl.innerHTML = 
                    "body, .scroll-list, .content-col { scrollbar-face-color: #000000 !important; scrollbar-track-color: #000000 !important; scrollbar-arrow-color: #f59e0b !important; scrollbar-shadow-color: #f59e0b !important; scrollbar-highlight-color: #f59e0b !important; scrollbar-3dlight-color: #000000 !important; scrollbar-darkshadow-color: #000000 !important; }" +
                    "body { background-color: #000000 !important; color: #ffffff !important; }" +
                    ".header { background-color: #000000 !important; border-bottom: 3px solid #f59e0b !important; }" +
                    ".sidebar { background-color: #000000 !important; border-right: 3px solid #f59e0b !important; }" +
                    ".item-card { background-color: #000000 !important; border: 2px solid #ffffff !important; color: #ffffff !important; }" +
                    ".item-card.active { border-color: #f59e0b !important; background-color: #1e1b10 !important; box-shadow: 0 0 15px #f59e0b !important; }" +
                    ".item-card h4 { color: #f59e0b !important; }" +
                    ".gold-card { background: #000000 !important; border: 4px solid #f59e0b !important; color: #ffffff !important; box-shadow: 0 0 20px rgba(245,158,11,0.4) !important; }" +
                    ".gold-card div, .gold-card span { color: #ffffff !important; }" +
                    "#cardNomeCompleto { color: #f59e0b !important; }" +
                    "#cardCodiceId { color: #f59e0b !important; }" +
                    ".btn-action, .import-btn { background-color: #000000 !important; border: 2px solid #f59e0b !important; color: #f59e0b !important; font-weight: 900 !important; }" +
                    ".btn-action:hover, .import-btn:hover { background-color: #f59e0b !important; color: #000000 !important; }" +
                    ".zenith-tab-btn { background-color: #000000 !important; border: 2px solid #ffffff !important; color: #ffffff !important; }" +
                    ".zenith-tab-btn.active { background-color: #f59e0b !important; border-color: #f59e0b !important; color: #000000 !important; }" +
                    ".zenith-tab-content > div { background-color: #000000 !important; border: 3px solid #f59e0b !important; }" +
                    ".search-box { background-color: #000000 !important; border: 2px solid #ffffff !important; color: #ffffff !important; }" +
                    ".search-box:focus { border-color: #f59e0b !important; }";
                AggiungiAttivita("TEMA VISIVO: Attivato tema Nero & Oro ad alto contrasto");
                Parla("Tema visivo impostato su alto contrasto nero e oro.");
            } else if (temaName === "terminal") {
                styleEl.innerHTML = 
                    "body, .scroll-list, .content-col { scrollbar-face-color: #000000 !important; scrollbar-track-color: #000000 !important; scrollbar-arrow-color: #10b981 !important; scrollbar-shadow-color: #10b981 !important; scrollbar-highlight-color: #10b981 !important; scrollbar-3dlight-color: #000000 !important; scrollbar-darkshadow-color: #000000 !important; }" +
