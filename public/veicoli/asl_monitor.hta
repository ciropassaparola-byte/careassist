            FocusCampo("Requisito Legge 104 impostato su: " + vocalStato, null);
        }
        
        // ============================================
        // SISTEMA POST-IT (Cliente + Globale)
        // ============================================
        var postitMode = "cliente"; // "cliente" o "globale"
        var postitColoreSelezionato = "yellow";
        var postitClienteData = {}; // {nomePaziente: [{testo, colore, autore, data},...]}
        var postitGlobaleData = []; // [{testo, colore, autore, data},...]
        var POSTIT_FILE = "";

        function CaricaPostit() {
            try {
                if (!POSTIT_FILE && appPath) {
                    POSTIT_FILE = fso.BuildPath(appPath, "postit_board.txt");
                }
                if (!POSTIT_FILE || !fso.FileExists(POSTIT_FILE)) return;
                var f = fso.OpenTextFile(POSTIT_FILE, 1, false, -1);
                var content = f.ReadAll();
                f.Close();
                var lines = content.split("\n");
                postitClienteData = {};
                postitGlobaleData = [];
                for (var i = 0; i < lines.length; i++) {
                    var l = lines[i].trim();
                    if (l === "") continue;
                    var p = l.split("|");
                    if (p.length < 5) continue;
                    var scope = p[0]; // "CLIENTE" o "GLOBALE"
                    var target = p[1]; // nome cliente o "SQUADRA"
                    var testo = p[2].replace(/\\n/g, "\n").replace(/\\pipe/g, "|");
                    var colore = p[3];
                    var autoreData = p[4];
                    var item = { testo: testo, colore: colore, autoreData: autoreData };
                    if (scope === "CLIENTE") {
                        if (!postitClienteData[target]) postitClienteData[target] = [];
                        postitClienteData[target].push(item);
                    } else {
                        postitGlobaleData.push(item);
                    }
                }
                AggiornaBadgeBachecaGlobale();
                try { RenderizzaPostitHome(); } catch(err) {}
                // Forza aggiornamento lista pazienti all'avvio per mostrare le puntine ??
                setTimeout(function() {
                    try { FiltraJS(); } catch(e) {}
                }, 100);
            } catch(e) {}
        }

        function SalvaPostitSuDisco() {
            try {
                if (!POSTIT_FILE && appPath) {
                    POSTIT_FILE = fso.BuildPath(appPath, "postit_board.txt");
                }
                if (!POSTIT_FILE) return;
                var lines = [];
                for (var nome in postitClienteData) {
                    var arr = postitClienteData[nome];
                    for (var i = 0; i < arr.length; i++) {
                        var item = arr[i];
                        var testoSafe = item.testo.replace(/\|/g, "\\pipe").replace(/\n/g, "\\n");
                        lines.push("CLIENTE|" + nome + "|" + testoSafe + "|" + item.colore + "|" + item.autoreData);
                    }
                }
                for (var i = 0; i < postitGlobaleData.length; i++) {
                    var item = postitGlobaleData[i];
                    var testoSafe = item.testo.replace(/\|/g, "\\pipe").replace(/\n/g, "\\n");
                    lines.push("GLOBALE|SQUADRA|" + testoSafe + "|" + item.colore + "|" + item.autoreData);
                }
                var f = fso.OpenTextFile(POSTIT_FILE, 2, true, -1);
                f.Write(lines.join("\n") + "\n");
                f.Close();
                AggiornaBadgeBachecaGlobale();
                try { RenderizzaPostitHome(); } catch(err) {}
                // Forza aggiornamento della lista pazienti per ridisegnare la puntina ??
                setTimeout(function() {
                    try { FiltraJS(); } catch(e) {}
                }, 50);
            } catch(e) {}
        }

        function AggiornaBadgeBachecaGlobale() {
            var badge = document.getElementById("badgeBachecaGlobale");
            var btn = document.getElementById("btnBachecaGlobale");
            if (badge) {
                var totGlobali = postitGlobaleData.length;
                var containsUrgent = false;
                
                // Controlla urgenze nei post-it globali della squadra
                for (var i = 0; i < postitGlobaleData.length; i++) {
                    if ((postitGlobaleData[i].testo || "").toUpperCase().indexOf("URGENTE") > -1) {
                        containsUrgent = true;
                    }
                }
                
                badge.innerText = totGlobali;
                badge.style.display = totGlobali > 0 ? "inline-flex" : "none";
                
                if (btn) {
                    if (totGlobali > 0) {
                        if (containsUrgent) {
                            // Urgenza attiva: Bottone Rosso allarme pulsante per attirare attenzione immediata
                            btn.style.backgroundColor = "#ef4444";
                            btn.style.color = "#ffffff";
                            btn.style.borderColor = "#fca5a5";
                            btn.style.fontWeight = "900";
                            btn.style.boxShadow = "0 0 15px rgba(239,68,68,0.6)";
                        } else {
                            // Note attive ma normali: Colore Marrone-Oro caldo premium
                            btn.style.backgroundColor = "#78350f";
                            btn.style.color = "#fef3c7";
                            btn.style.borderColor = "#f59e0b";
                            btn.style.fontWeight = "900";
                            btn.style.boxShadow = "none";
                        }
                    } else {
                        // Nessuna nota attiva: Stile spento color lavagna per non distrarre
                        btn.style.backgroundColor = "#1e293b";
                        btn.style.color = "#94a3b8";
                        btn.style.borderColor = "#334155";
                        btn.style.fontWeight = "700";
                        btn.style.boxShadow = "none";
                    }
                }
            }
        }

        function CreaCardPostit(item, scope, index) {
            var card = document.createElement("div");
            card.className = "postit-card postit-" + (item.colore || "yellow");
            card.tabIndex = 0;
            
            var autoreStr = item.autoreData || "";
            var autoreNome = autoreStr.indexOf(" - ") > -1 ? autoreStr.split(" - ")[0] : autoreStr;
            var descVocal = "Nota post-it. Scritta da: " + autoreNome + ". Messaggio: " + item.testo;
            card.onfocus = function() { FocusCampo(descVocal, card); };
            card.onmouseover = function() { FocusCampo(descVocal, null); };

            var scopeRef = scope;
            var idxRef = index;

            // Se � una nota associata a un cliente, aggiungiamo un pulsante pill cliccabile in cima
            if (scope.indexOf("cliente_") === 0) {
                var nomeCliente = scope.substring(8);
                var clientLink = document.createElement("div");
                clientLink.style.fontSize = "10px";
                clientLink.style.fontWeight = "900";
                clientLink.style.color = "#1e3a8a";
                clientLink.style.backgroundColor = "#dbeafe";
                clientLink.style.padding = "4px 8px";
                clientLink.style.borderRadius = "6px";
                clientLink.style.marginBottom = "8px";
                clientLink.style.cursor = "pointer";
                clientLink.style.textAlign = "center";
                clientLink.style.textTransform = "uppercase";
                clientLink.style.border = "1px solid #bfdbfe";
                clientLink.innerHTML = "?? CLIENTE: " + nomeCliente;
                clientLink.onclick = function() {
                    try {
                        ChiudiModalBachecaGlobale();
                        SelezionaClienteDaLista(nomeCliente);
                    } catch(e) {}
                };
                card.appendChild(clientLink);
            }

            // --- Determina stato dalla parola chiave nel testo ---
            var testoUp = (item.testo || "").toUpperCase();
            var statusLabel = "IN ATTESA";
            var statusClass = "postit-status-attesa";
            var dotClass = "postit-dot";
            if (testoUp.indexOf("URGENTE") > -1 || testoUp.indexOf("SUBITO") > -1) {
                statusLabel = "URGENTE";
                statusClass = "postit-status-urgente";
                dotClass = "postit-dot";
            } else if (testoUp.indexOf("OK") > -1 || testoUp.indexOf("FATTO") > -1 || testoUp.indexOf("COMPLETATO") > -1) {
                statusLabel = "FATTO";
                statusClass = "postit-status-ok";
                dotClass = "postit-dot-ok";
            } else if (testoUp.indexOf("CONSEGNA") > -1 || testoUp.indexOf("CORRIERE") > -1 || testoUp.indexOf("PORTO") > -1 || testoUp.indexOf("CAMION") > -1) {
                statusLabel = "?? LOGISTICA";
                statusClass = "postit-status-logistica";
                dotClass = "postit-dot-ok";
            } else if (testoUp.indexOf("TELEFONARE") > -1 || testoUp.indexOf("CHIAMARE") > -1 || testoUp.indexOf("TEL") > -1) {
                statusLabel = "?? TELEFONARE";
                statusClass = "postit-status-telefonare";
                dotClass = "postit-dot-yellow";
            } else if (testoUp.indexOf("BLOCCATO") > -1 || testoUp.indexOf("ERRORE") > -1 || testoUp.indexOf("MANCA") > -1 || testoUp.indexOf("PROBLEMA") > -1) {
                statusLabel = "?? ATTENZIONE";
                statusClass = "postit-status-attenzione";
                dotClass = "postit-dot";
            } else if (testoUp.indexOf("INFO") > -1 || testoUp.indexOf("NOTA") > -1) {
                statusLabel = "INFO";
                statusClass = "postit-status-info";
                dotClass = "postit-dot-yellow";
            }

            // --- HEADER: badge stato + pallino ---
            var header = document.createElement("div");
            header.className = "postit-header";
            var badge = document.createElement("span");
            badge.className = "postit-status-badge " + statusClass;
            badge.innerText = statusLabel;
            var dot = document.createElement("div");
            dot.className = "postit-dot " + dotClass;
            header.appendChild(badge);
            header.appendChild(dot);
            card.appendChild(header);

            // --- ZONA CLIENTE/AUTORE ---
            var clienteDiv = document.createElement("div");
            clienteDiv.className = "postit-cliente";
            // Estrai nome operatore dalla stringa autoreData (es. "Ciro Milella - 18/05 10:00")
            var autoreStr = item.autoreData || "";
            var autoreNome = autoreStr.indexOf(" - ") > -1 ? autoreStr.split(" - ")[0] : autoreStr;
            clienteDiv.innerText = autoreNome;
            card.appendChild(clienteDiv);

            // --- TESTO PRINCIPALE ---
            var txt = document.createElement("div");
            txt.className = "postit-text";
            txt.innerText = item.testo;
            card.appendChild(txt);

            // --- FOOTER: data + pulsanti azione ---
            var footer = document.createElement("div");
            footer.className = "postit-footer";

            var dateDiv = document.createElement("div");
            dateDiv.className = "postit-footer-date";
            var dataStr = autoreStr.indexOf(" - ") > -1 ? autoreStr.split(" - ")[1] : "";
            dateDiv.innerHTML = "&#128197; " + dataStr;
            footer.appendChild(dateDiv);

            var actionsDiv = document.createElement("div");
            actionsDiv.className = "postit-footer-actions";

            // Pulsante lettura vocale
            var readBtn = document.createElement("button");
            readBtn.className = "postit-action-icon";
            readBtn.innerHTML = "&#128266;";
            readBtn.title = "Leggi ad alta voce";
            readBtn.tabIndex = 0;
            readBtn.onclick = function() { Parla("Post-it: " + item.testo); };
            readBtn.onfocus = function() { FocusCampo("Leggi post-it: " + item.testo.substring(0, 30), readBtn); };
            actionsDiv.appendChild(readBtn);

            // Pulsante copia negli appunti (Chicca 1)
            var copyBtn = document.createElement("button");
            copyBtn.className = "postit-action-icon";
            copyBtn.innerHTML = "&#128203;";
            copyBtn.title = "Copia negli appunti";
            copyBtn.tabIndex = 0;
            copyBtn.onclick = function() {
                try {
                    window.clipboardData.setData("Text", item.testo);
                    RiproduciSuono("notify");
                    Parla("Testo copiato negli appunti!");
                } catch(err) {
                    Parla("Errore nella copia.");
                }
            };
            copyBtn.onfocus = function() { FocusCampo("Copia testo del post-it negli appunti", copyBtn); };
            actionsDiv.appendChild(copyBtn);

            // Pulsante stampa etichetta (Chicca 3)
            var printBtn = document.createElement("button");
            printBtn.className = "postit-action-icon";
            printBtn.innerHTML = "&#128424;"; // Printer icon
            printBtn.title = "Stampa etichetta termica";
            printBtn.tabIndex = 0;
            printBtn.onclick = function() {
                StampaEtichettaPostit(item, scopeRef);
            };
            printBtn.onfocus = function() { FocusCampo("Stampa etichetta termica per questo post-it", printBtn); };
            actionsDiv.appendChild(printBtn);

            // Pulsante elimina
            var delBtn = document.createElement("button");
            delBtn.className = "postit-action-icon del";
            delBtn.innerHTML = "&#10006;";
            delBtn.title = "Elimina post-it";
            delBtn.tabIndex = 0;
            delBtn.onclick = function() { EliminaPostit(scopeRef, idxRef); };
            delBtn.onfocus = function() { FocusCampo("Elimina post-it: " + item.testo.substring(0, 30), delBtn); };
            actionsDiv.appendChild(delBtn);

            footer.appendChild(actionsDiv);
            card.appendChild(footer);

            return card;
        }

        function RenderizzaPostitCliente(nome) {
            var grid = document.getElementById("postitClienteGrid");
            if (!grid) return;
            grid.innerHTML = "";
            var arr = postitClienteData[nome] || [];
            if (arr.length === 0) {
                grid.innerHTML = "<div class='postit-empty'>Nessun post-it. Clicca + Aggiungi per lasciare un messaggio ai colleghi.</div>";
                return;
            }
            for (var i = 0; i < arr.length; i++) {
                grid.appendChild(CreaCardPostit(arr[i], "cliente_" + nome, i));
            }
        }

        function RenderizzaPostitGlobale() {
            var grid = document.getElementById("postitGlobaleGrid");
            if (!grid) return;
            grid.innerHTML = "";
            
            var countVisibili = 0;
            var query = (bachecaGlobaleFiltroRicerca || "").toUpperCase();
            
            // Loop: Post-it globali della squadra
            for (var i = 0; i < postitGlobaleData.length; i++) {
                var item = postitGlobaleData[i];
                var testoUp = (item.testo || "").toUpperCase();
                var autoreUp = (item.autoreData || "").toUpperCase();
                
                // Filtro Ricerca Testuale Istantanea (Chicca 2)
                if (query !== "") {
                    if (testoUp.indexOf(query) === -1 && autoreUp.indexOf(query) === -1) {
                        continue;
                    }
                }
                
                var match = false;
                if (bachecaGlobaleFiltroAttivo === "TUTTI") {
                    match = true;
                } else if (bachecaGlobaleFiltroAttivo === "URGENTI" && (testoUp.indexOf("URGENTE") > -1 || testoUp.indexOf("SUBITO") > -1)) {
                    match = true;
                } else if (bachecaGlobaleFiltroAttivo === "LOGISTICA" && (testoUp.indexOf("CONSEGNA") > -1 || testoUp.indexOf("CORRIERE") > -1 || testoUp.indexOf("PORTO") > -1 || testoUp.indexOf("CAMION") > -1)) {
                    match = true;
                } else if (bachecaGlobaleFiltroAttivo === "TELEFONARE" && (testoUp.indexOf("TELEFONARE") > -1 || testoUp.indexOf("CHIAMARE") > -1 || testoUp.indexOf("TEL") > -1)) {
                    match = true;
                } else if (bachecaGlobaleFiltroAttivo === "ATTENZIONE" && (testoUp.indexOf("BLOCCATO") > -1 || testoUp.indexOf("ERRORE") > -1 || testoUp.indexOf("MANCA") > -1 || testoUp.indexOf("PROBLEMA") > -1)) {
                    match = true;
                }
                
                if (match) {
                    grid.appendChild(CreaCardPostit(item, "globale", i));
                    countVisibili++;
                }
            }
            
            if (countVisibili === 0) {
                grid.innerHTML = "<div class='postit-empty'>Nessun post-it globale corrispondente al filtro selezionato o presente in bacheca.</div>";
            }
        }

        function RenderizzaPostitHome() {
            var panel = document.getElementById("homePostitPanel");
            var grid = document.getElementById("homePostitGrid");
            if (!grid || !panel) return;
            
            grid.innerHTML = "";
            var count = postitGlobaleData.length;
            
            if (count === 0) {
                panel.style.display = "none";
                try { panel.className = panel.className.replace(/\s*urgent-neon-pulse/g, ""); } catch(e) {}
                return;
            }
            
            panel.style.display = "block";
            
            // Scansione per urgenza: se presente, attiva l'aura pulsante neon (Chicca 1)
            var hasUrgent = false;
            for (var k = 0; k < count; k++) {
                var tUp = (postitGlobaleData[k].testo || "").toUpperCase();
                if (tUp.indexOf("URGENTE") > -1 || tUp.indexOf("SUBITO") > -1) {
                    hasUrgent = true;
                    break;
                }
            }
            
            if (hasUrgent) {
                if (panel.className.indexOf("urgent-neon-pulse") === -1) {
                    panel.className += " urgent-neon-pulse";
                }
            } else {
                panel.className = panel.className.replace(/\s*urgent-neon-pulse/g, "");
            }
            for (var i = 0; i < count; i++) {
                var item = postitGlobaleData[i];
                var card = document.createElement("div");
                card.className = "postit-card postit-" + (item.colore || "yellow");
                card.style.flex = "1 1 250px";
                card.style.maxWidth = "400px";
                card.style.margin = "0";
                card.tabIndex = 0;
                
                var autoreStr = item.autoreData || "";
                var autoreNome = autoreStr.indexOf(" - ") > -1 ? autoreStr.split(" - ")[0] : autoreStr;
                var descVocal = "Nota di squadra. Scritta da: " + autoreNome + ". Messaggio: " + item.testo;
                
                (function(desc, c) {
                    c.onfocus = function() { FocusCampo(desc, c); };
                    c.onmouseover = function() { FocusCampo(desc, null); };
                })(descVocal, card);

                var header = document.createElement("div");
                header.className = "postit-header";
                
                var testoUp = (item.testo || "").toUpperCase();
                var statusLabel = "SQUADRA";
                var statusClass = "postit-status-attesa";
                var dotClass = "postit-dot";
                if (testoUp.indexOf("URGENTE") > -1 || testoUp.indexOf("SUBITO") > -1) {
                    statusLabel = "URGENTE";
                    statusClass = "postit-status-urgente";
                    dotClass = "postit-dot";
                } else if (testoUp.indexOf("CONSEGNA") > -1 || testoUp.indexOf("CORRIERE") > -1 || testoUp.indexOf("PORTO") > -1 || testoUp.indexOf("CAMION") > -1) {
                    statusLabel = "LOGISTICA";
                    statusClass = "postit-status-logistica";
                    dotClass = "postit-dot-logistica";
                }
                
                var badge = document.createElement("span");
                badge.className = "postit-status-badge " + statusClass;
                badge.innerText = statusLabel;
                
                var dot = document.createElement("div");
                dot.className = "postit-dot " + dotClass;
                
                header.appendChild(badge);
                header.appendChild(dot);
                card.appendChild(header);
                
                var txt = document.createElement("div");
                txt.className = "postit-text";
                txt.style.maxHeight = "120px";
                txt.style.overflowY = "auto";
                txt.innerText = item.testo;
                card.appendChild(txt);
                
                var footer = document.createElement("div");
                footer.className = "postit-footer";
                footer.style.marginTop = "10px";
                footer.innerText = item.autoreData || "Anonimo";
                card.appendChild(footer);
                
                grid.appendChild(card);
            }
        }

        function ApriModalPostit(mode) {
            try {
                postitMode = mode;
                if (mode === "globale") {
                    var globalBacheca = document.getElementById("modalBachecaGlobale");
                    if (globalBacheca) globalBacheca.style.display = "none";
                }
                var modal = document.getElementById("modalPostitCreate");
                var subtitle = document.getElementById("postitModalSubtitle");
                if (modal) {
                    modal.style.display = "block";
                    var txt = document.getElementById("txtPostitTesto");
                    if (txt) {
                        txt.value = "";
                        // Deferimento focus con try-catch per compatibilit� totale IE9/HTA
                        setTimeout(function() {
                            try { txt.focus(); } catch(e) {}
                        }, 50);
                    }
                    SelezionaColorePostit("yellow");
                    if (subtitle) {
                        subtitle.innerText = (mode === "globale")
                            ? "Per tutta la squadra (bacheca globale)"
                            : "Per il cliente: " + (window.activePatientName || "---");
                    }
                    RiproduciSuono("notify");
                    FocusCampo("Nuovo post-it. Scrivi il messaggio e scegli il colore.", null);
                }
            } catch(e) {}
        }

        function ChiudiModalPostit() {
            var modal = document.getElementById("modalPostitCreate");
            if (modal) modal.style.display = "none";
            if (postitMode === "globale") {
                var globalBacheca = document.getElementById("modalBachecaGlobale");
                if (globalBacheca) globalBacheca.style.display = "block";
            }
        }

        function SelezionaColorePostit(colore) {
            postitColoreSelezionato = colore;
            var swatches = ["yellow", "cyan", "pink", "green", "orange", "purple"];
            for (var i = 0; i < swatches.length; i++) {
                var sw = document.getElementById("swatch" + swatches[i].charAt(0).toUpperCase() + swatches[i].slice(1));
                if (sw) {
                    sw.className = "postit-color-swatch" + (swatches[i] === colore ? " selected" : "");
                }
            }
        }

        function SalvaPostit() {
            var textarea = document.getElementById("txtPostitTesto");
            if (!textarea) return;
            var testo = textarea.value.trim();
            if (testo === "") {
                Parla("Scrivi un testo prima di salvare il post-it.");
                return;
            }
            var opNome = OttieniNomeProfilo();
            var oggi = new Date();
            var d = ("0" + oggi.getDate()).slice(-2);
            var mo = ("0" + (oggi.getMonth() + 1)).slice(-2);
            var h = ("0" + oggi.getHours()).slice(-2);
            var mi = ("0" + oggi.getMinutes()).slice(-2);
            var autoreData = opNome + " - " + d + "/" + mo + " " + h + ":" + mi;
            var item = { testo: testo, colore: postitColoreSelezionato, autoreData: autoreData };

            if (postitMode === "globale") {
                postitGlobaleData.push(item);
                RenderizzaPostitGlobale();
            } else {
                var nome = window.activePatientName || "";
                if (!nome || nome === "") {
                    Parla("Seleziona prima un cliente prima di aggiungere un post-it.");
                    return;
                }
                if (!postitClienteData[nome]) postitClienteData[nome] = [];
                postitClienteData[nome].push(item);
                RenderizzaPostitCliente(nome);
            }
            SalvaPostitSuDisco();
            ChiudiModalPostit();
            RiproduciSuono("notify");
            if (testo.toUpperCase().indexOf("URGENTE") > -1) {
                setTimeout(function() {
                    Parla("Attenzione! Rilevato post-it urgente inserito da " + opNome + "!");
                }, 800);
            } else {
                Parla("Post-it salvato con successo!");
            }
        }

        function ArchiviaPostitSuDisco(item, scope) {
            try {
                if (!appPath) return;
                var archiveFile = fso.BuildPath(appPath, "postit_archive.txt");
                var opNome = OttieniNomeProfilo();
                var oggi = new Date();
                var d = ("0" + oggi.getDate()).slice(-2);
                var mo = ("0" + (oggi.getMonth() + 1)).slice(-2);
                var h = ("0" + oggi.getHours()).slice(-2);
                var mi = ("0" + oggi.getMinutes()).slice(-2);
                var timestamp = d + "/" + mo + " " + h + ":" + mi;
                
                var target = "SQUADRA";
                var tipo = "GLOBALE";
                if (scope.indexOf("cliente_") === 0) {
                    target = scope.substring(8);
                    tipo = "CLIENTE";
                }
                
                var testoSafe = item.testo.replace(/\|/g, "\\pipe").replace(/\n/g, "\\n");
                var line = tipo + "|" + target + "|" + testoSafe + "|" + item.colore + "|" + item.autoreData + "|RISOLTO_DA:" + opNome + "|DATA_RISOLUZIONE:" + timestamp;
                
                var f;
                if (fso.FileExists(archiveFile)) {
                    f = fso.OpenTextFile(archiveFile, 8, true, -1); // 8 = ForAppending, UTF-16
                } else {
                    f = fso.OpenTextFile(archiveFile, 2, true, -1); // 2 = ForWriting, UTF-16
                }
                f.WriteLine(line);
                f.Close();
                AggiungiAttivita("??? POST-IT COMPLETATO: Salvata nota in postit_archive.txt");
            } catch(e) {
                AggiungiAttivita("?? ERRORE ARCHIVIAZIONE: " + e.message);
            }
        }

        function StampaEtichettaPostit(item, scope) {
            try {
                var targetNome = "MESSAGGIO SQUADRA";
                if (scope.indexOf("cliente_") === 0) {
                    targetNome = scope.substring(8).toUpperCase();
                }
                
                var w = window.open("", "_blank", "width=450,height=300,scrollbars=no,resizable=no");
                if (!w) {
                    Parla("Finestra di stampa bloccata dal browser.");
                    return;
                }
                
                w.document.write("<html><head><title>STAMPA ETICHETTA POST-IT</title>");
                w.document.write("<style>");
                w.document.write("body { font-family: 'Outfit', sans-serif; margin: 0; padding: 15px; background: #fff; color: #000; text-align: center; box-sizing: border-box; }");
                w.document.write(".border-box { border: 2px dashed #000; border-radius: 8px; padding: 12px; height: 100%; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; }");
                w.document.write(".title { font-size: 14px; font-weight: 900; border-bottom: 2px solid #000; padding-bottom: 5px; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px; }");
                w.document.write(".text { font-size: 13px; font-weight: 700; line-height: 1.4; text-align: left; word-wrap: break-word; flex-grow: 1; margin-bottom: 10px; }");
                w.document.write(".footer { font-size: 9px; font-weight: 900; border-top: 1px solid #000; padding-top: 5px; text-align: right; text-transform: uppercase; }");
                w.document.write("</style></head><body>");
                
                w.document.write("<div class='border-box'>");
                w.document.write("<div class='title'>?? ASL - " + targetNome + "</div>");
                w.document.write("<div class='text'>" + item.testo.replace(/\n/g, "<br>") + "</div>");
                w.document.write("<div class='footer'>" + item.autoreData + "</div>");
                w.document.write("</div>");
                
                w.document.write("<"+"script"+">");
                w.document.write("window.onload = function() { window.print(); setTimeout(function() { window.close(); }, 500); };");
                w.document.write("<\/script>");
                
                w.document.write("</body></html>");
                w.document.close();
                
                Parla("Invio alla stampante in corso.");
            } catch(err) {
                Parla("Errore durante la stampa.");
            }
        }

        function InserisciEmoji(emoji) {
            var txt = document.getElementById("txtPostitTesto");
            if (!txt) return;
            
            if (typeof txt.selectionStart === "number") {
                var start = txt.selectionStart;
                var end = txt.selectionEnd;
                var val = txt.value;
                txt.value = val.substring(0, start) + emoji + val.substring(end);
                txt.selectionStart = txt.selectionEnd = start + emoji.length;
            } else if (document.selection) {
                txt.focus();
                var sel = document.selection.createRange();
                sel.text = emoji;
            } else {
                txt.value += emoji;
            }
            txt.focus();
            try { Parla("Emoji inserita."); } catch(e) {}
        }

        function EliminaPostit(scope, index) {
            var item = null;
            if (scope === "globale") {
                if (index < 0 || index >= postitGlobaleData.length) return;
                item = postitGlobaleData[index];
                postitGlobaleData.splice(index, 1);
                RenderizzaPostitGlobale();
            } else if (scope.indexOf("cliente_") === 0) {
                var nome = scope.substring(8);
                if (!postitClienteData[nome]) return;
                item = postitClienteData[nome][index];
                postitClienteData[nome].splice(index, 1);
                if (postitClienteData[nome].length === 0) delete postitClienteData[nome];
                RenderizzaPostitCliente(nome);
                try { RenderizzaPostitGlobale(); } catch(e) {}
            }
            
            if (item) {
                ArchiviaPostitSuDisco(item, scope);
            }
            SalvaPostitSuDisco();
            RiproduciSuono("notify");
            Parla("Post-it completato e archiviato in storico.");
        }

        function IsInContainer(el, containerId) {
            var container = document.getElementById(containerId);
            if (!container || !el) return false;
            var parent = el;
            while (parent) {
                if (parent === container) return true;
                parent = parent.parentNode;
            }
            return false;
        }

        function TrappolaFocusBacheca(e) {
            var modal = document.getElementById("modalBachecaGlobale");
            if (modal && modal.style.display === "block") {
                var event = e || window.event;
                if (event.keyCode === 9) { // Tab key
                    var activeEl = document.activeElement;
                    if (!activeEl || !IsInContainer(activeEl, "modalBachecaGlobale")) {
                        var chiudiBtn = document.getElementById("btnChiudiBachecaGlobale");
                        if (chiudiBtn) {
                            try { chiudiBtn.focus(); } catch(err) {}
                            if (event.preventDefault) event.preventDefault();
                            event.returnValue = false;
                        }
                    }
                }
            }
        }

        // Colleghiamo l'ascoltatore di tastiera globale per intrappolare il focus in Bacheca (IE9)
        if (window.addEventListener) {
            window.addEventListener("keydown", TrappolaFocusBacheca, false);
        } else if (window.attachEvent) {
            document.attachEvent("onkeydown", TrappolaFocusBacheca);
        }

        function ApriModalBachecaGlobale() {
            var modal = document.getElementById("modalBachecaGlobale");
            if (modal) {
                modal.style.display = "block";
                RenderizzaPostitGlobale();
                RiproduciSuono("notify");
                
                var totGlobali = postitGlobaleData.length;
                var countUrgenti = 0;
                
                // Controlla urgenze nei post-it globali della squadra
                for (var i = 0; i < postitGlobaleData.length; i++) {
                    if ((postitGlobaleData[i].testo || "").toUpperCase().indexOf("URGENTE") > -1) {
                        countUrgenti++;
                    }
                }
                
                var chiudiBtn = document.getElementById("btnChiudiBachecaGlobale");
                
                if (countUrgenti > 0) {
                    FocusCampo("Bacheca globale aperta. Attenzione, ci sono " + countUrgenti + " post-it urgenti in bacheca su un totale di " + totGlobali + ".", chiudiBtn);
                } else {
                    FocusCampo("Bacheca globale aperta. Ci sono " + totGlobali + " post-it in bacheca.", chiudiBtn);
                }
                
                // Sposta attivamente il focus sul pulsante X CHIUDI
                if (chiudiBtn) {
                    setTimeout(function() {
                        try { chiudiBtn.focus(); } catch(e) {}
                    }, 100);
                }
            }
        }

        function ChiudiModalBachecaGlobale() {
            var modal = document.getElementById("modalBachecaGlobale");
            if (modal) {
                modal.style.display = "none";
                
                // Reset della ricerca bacheca globale al chiudere (Chicca 2)
                bachecaGlobaleFiltroRicerca = "";
                var inputRicerca = document.getElementById("txtCercaBachecaGlobale");
                if (inputRicerca) inputRicerca.value = "";
                
                // Riporta il focus sul pulsante della sidebar per comodit� di tabbing
                var sidebarBtn = document.getElementById("btnBachecaGlobale");
                if (sidebarBtn) {
                    try { sidebarBtn.focus(); } catch(e) {}
                }
            }
        }

        function InserisciTestoRapido(testo) {
            var txt = document.getElementById("txtPostitTesto");
            if (!txt) return;
            
            // CHICCA 2: DUAL-MODE DYNAMIC CHIPS
            // Se stiamo creando un post-it per un cliente specifico, arricchiamo l'emoji template
            // prelevando al volo i dati del contatto a schermo (telefono, citt�/provincia) 
            // per precompilare la nota senza che tu debba scrivere nulla a mano!
            if (postitMode === "cliente") {
                var nomeCliente = window.activePatientName || "";
                if (nomeCliente) {
                    var telVal = "";
                    var cellVal = "";
                    var cittaVal = "";
                    
                    var telEl = document.getElementById("mainTel");
                    var cellEl = document.getElementById("mainCell");
                    var cittaEl = document.getElementById("mainCitta");
                    
                    if (telEl) telVal = telEl.innerText || telEl.textContent || "";
                    if (cellEl) cellVal = cellEl.innerText || cellEl.textContent || "";
                    if (cittaEl) cittaVal = cittaEl.innerText || cittaEl.textContent || "";
                    
                    // Pulisce i valori vuoti o di default "---"
                    if (telVal === "---") telVal = "";
                    if (cellVal === "---") cellVal = "";
                    if (cittaVal === "---") cittaVal = "";
                    
                    var telefonoAttivo = cellVal || telVal || "";
                    
                    if (testo.indexOf("TELEFONARE") > -1 || testo.indexOf("Contattare") > -1) {
                        if (telefonoAttivo) {
                            testo = "?? TELEFONARE al numero " + telefonoAttivo + " per concordare la consegna.";
                        } else {
                            testo = "?? TELEFONARE al cliente per concordare la consegna.";
                        }
                    } else if (testo.indexOf("RECAPITO ERRATO") > -1) {
                        if (telefonoAttivo || cittaVal) {
                            var dettagli = [];
                            if (telefonoAttivo) dettagli.push("telefono (" + telefonoAttivo + ")");
                            if (cittaVal) dettagli.push("indirizzo di " + cittaVal);
                            testo = "?? RECAPITO ERRATO: verificare " + dettagli.join(" o ") + ".";
                        } else {
                            testo = "?? RECAPITO ERRATO: verificare numero e indirizzo.";
                        }
                    } else if (testo.indexOf("Ausilio pronto") > -1) {
                        if (cittaVal) {
                            testo = "?? Ausilio pronto in magazzino per la consegna a " + cittaVal + ".";
                        } else {
                            testo = "?? Ausilio pronto in magazzino per la consegna.";
                        }
                    }
                }
            }
            
            txt.value = testo;
            try { txt.focus(); } catch(e) {}
            Parla("Template compilato.");
        }

        function InserisciStatusTimeline(testo) {
            var txt = document.getElementById("txtModificaNotaTesto");
            if (txt) {
                txt.value = testo;
                try { txt.focus(); } catch(e) {}
                Parla("Stato inserito: " + testo);
            }
        }

        var bachecaGlobaleFiltroAttivo = "TUTTI";
        var bachecaGlobaleFiltroRicerca = "";
        
        function EseguiRicercaBachecaGlobale(txt) {
            bachecaGlobaleFiltroRicerca = txt || "";
            RenderizzaPostitGlobale();
        }

        function AvviaAudioGuidaManuale() {
            var t = "Benvenuto nell'audio guida del nuovo sistema Post-it e Bacheca Squadra. " +
                    "Punto uno. I Post-it del cliente. Quando apri la scheda di un cliente, puoi lasciargli dei messaggi colorati. " +
                    "Se usi i pulsanti rapidi come Telefonare o Magazzino, il sistema compila la nota da solo scrivendo gi� il numero di telefono e la citt� del cliente. " +
                    "Punto due. Copia rapida ed Etichette termiche. Cliccando sull'icona della cartellina, copi la nota negli appunti per incollarla su whatsapp o Excel. " +
                    "Cliccando sull'icona della stampante, puoi stampare all'istante un'etichetta termica da incollare sulla scatola dell'ausilio. " +
                    "Punto tre. La Bacheca di Squadra sulla Home. Gli avvisi generali compaiono direttamente in cima alla pagina principale. " +
                    "Se c'� un avviso URGENTE o SUBITO, il pannello inizia a pulsare con una luce rossa e oro. " +
                    "Punto quattro. Barra di ricerca instantanea. Nella bacheca puoi digitare nella casella Cerca per filtrare istantaneamente i post-it in tempo reale per testo, autore o data. " +
                    "Punto cinque. Status Chips per la timeline. Quando aggiorni il diario dei contatti della timeline, puoi usare i chip colorati in alto per inserire istantaneamente gli stati come Consegnato, Da Ricontattare o Assente con un solo clic. " +
                    "Buon lavoro da parte del team ASL!";
            Parla(t);
        }

        function EsportaPostitExcel() {
            try {
                var shell = new ActiveXObject("WScript.Shell");
                var desktopPath = shell.SpecialFolders("Desktop");
                var filePath = desktopPath + "\\postit_attivi_report.csv";
                
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                // Open for writing, create if not exist, Unicode flag = -1
                var file = fso.OpenTextFile(filePath, 2, true, -1);
                
                // Scrive l'intestazione CSV (Excel preferisce il punto e virgola ';' come separatore in Europa/Italia!)
                file.WriteLine("TIPO_POSTIT;DESTINATARIO;TESTO;AUTORE;DATA_CREAZIONE");
                
                var count = 0;
                
                // 1. Esporta i post-it globali di squadra
                for (var i = 0; i < postitGlobaleData.length; i++) {
                    var item = postitGlobaleData[i];
                    var testoPulito = (item.testo || "").replace(/;/g, ",").replace(/\r?\n|\r/g, " ");
                    var autorePulito = (item.autore || "").replace(/;/g, ",");
                    var dataPulita = (item.data || "").replace(/;/g, ",");
                    file.WriteLine("SQUADRA;TUTTI;" + testoPulito + ";" + autorePulito + ";" + dataPulita);
                    count++;
                }
                
                // 2. Esporta i post-it specifici dei singoli clienti
                for (var clienteNome in postitClienteData) {
                    if (postitClienteData.hasOwnProperty(clienteNome)) {
                        var list = postitClienteData[clienteNome] || [];
                        for (var j = 0; j < list.length; j++) {
                            var item = list[j];
                            var testoPulito = (item.testo || "").replace(/;/g, ",").replace(/\r?\n|\r/g, " ");
                            var autorePulito = (item.autore || "").replace(/;/g, ",");
                            var dataPulita = (item.data || "").replace(/;/g, ",");
                            file.WriteLine("CLIENTE;" + clienteNome.replace(/;/g, ",") + ";" + testoPulito + ";" + autorePulito + ";" + dataPulita);
                            count++;
                        }
                    }
                }
                
                file.Close();
                
                Parla("Report esportato con successo sul tuo desktop.");
                alert("REPORT ESPORTATO CON SUCCESSO!\n\nIl file 'postit_attivi_report.csv' � stato salvato sul tuo Desktop.\nContiene " + count + " post-it attivi.");
            } catch (e) {
                alert("Errore durante l'esportazione: " + e.message);
            }
        }

        function CaricaStoricoPostitArchiviati() {
            var grid = document.getElementById("registroStoricoPostitGrid");
            if (!grid) return;
            
            try {
                if (!appPath) {
                    grid.innerHTML = "<div style='font-size:11px; color:#ef4444; font-style:italic; text-align:center; padding:10px 0;'>Errore: Percorso applicazione non configurato.</div>";
                    return;
                }
                var archiveFile = fso.BuildPath(appPath, "postit_archive.txt");
                if (!fso.FileExists(archiveFile)) {
                    grid.innerHTML = "<div style='font-size:11px; color:#64748b; font-style:italic; text-align:center; padding:10px 0;'>L'archivio delle note risolte � attualmente vuoto.</div>";
                    return;
                }
                
                // Legge il file con encoding UTF-16 (-1)
                var f = fso.OpenTextFile(archiveFile, 1, false, -1); // 1 = ForReading
                var lines = [];
                while (!f.AtEndOfStream) {
                    var l = f.ReadLine();
                    if (l && l.trim()) {
                        lines.push(l);
                    }
                }
                f.Close();
                
                if (lines.length === 0) {
                    grid.innerHTML = "<div style='font-size:11px; color:#64748b; font-style:italic; text-align:center; padding:10px 0;'>Nessuna nota archiviata trovata.</div>";
                    return;
                }
                
                // Mostra in ordine decrescente (le pi� recenti in alto!)
                lines.reverse();
                
                var html = "<table style='width:100%; border-collapse:collapse; font-size:11px; text-align:left; color:#f1f5f9;'>";
                html += "<thead><tr style='border-bottom:1.5px solid #334155; color:#94a3b8; font-weight:800; text-transform:uppercase;'>";
                html += "<th style='padding:6px 4px; width:70px;'>Tipo</th>";
                html += "<th style='padding:6px 4px; width:100px;'>Destinatario</th>";
                html += "<th style='padding:6px 4px;'>Messaggio</th>";
                html += "<th style='padding:6px 4px; width:120px;'>Firma/Data</th>";
                html += "<th style='padding:6px 4px; width:120px;'>Chiuso Da</th>";
                html += "</tr></thead><tbody>";
                
                for (var i = 0; i < lines.length; i++) {
                    var parts = lines[i].split("|");
                    if (parts.length >= 7) {
                        var tipo = parts[0] || "";
                        var target = parts[1] || "";
                        var testo = (parts[2] || "").replace(/\\pipe/g, "|").replace(/\\n/g, " ");
                        var colore = parts[3] || "yellow";
                        var autoreData = parts[4] || "";
                        var risoltoDa = (parts[5] || "").replace("RISOLTO_DA:", "");
                        var dataRisoluzione = (parts[6] || "").replace("DATA_RISOLUZIONE:", "");
                        
                        var badgeColor = "#facc15"; // yellow
                        if (colore === "cyan") badgeColor = "#22d3ee";
                        else if (colore === "pink") badgeColor = "#f472b6";
                        else if (colore === "green") badgeColor = "#4ade80";
                        else if (colore === "orange") badgeColor = "#fb923c";
                        else if (colore === "purple") badgeColor = "#c084fc";
                        
                        var tipoBadge = tipo === "SQUADRA" ? 
                            "<span style='background:#1e293b; color:#3b82f6; border:1px solid #3b82f6; padding:1px 4px; border-radius:4px; font-weight:800; font-size:9px;'>SQUADRA</span>" : 
                            "<span style='background:#1e293b; color:#10b981; border:1px solid #10b981; padding:1px 4px; border-radius:4px; font-weight:800; font-size:9px;'>CLIENTE</span>";
                        
                        html += "<tr style='border-bottom:1px solid #1e293b;' onmouseover=\"this.style.backgroundColor='#1e293b'\" onmouseout=\"this.style.backgroundColor='transparent'\">";
                        html += "<td style='padding:6px 4px;'>" + tipoBadge + "</td>";
                        html += "<td style='padding:6px 4px; font-weight:800; color:#e2e8f0; text-transform:uppercase;'>" + target + "</td>";
                        html += "<td style='padding:6px 4px; color:#cbd5e1; font-weight:600;' title='" + testo + "'>" + (testo.length > 50 ? testo.substring(0, 48) + "..." : testo) + "</td>";
                        html += "<td style='padding:6px 4px; color:#64748b; font-size:10px;'>" + autoreData + "</td>";
                        html += "<td style='padding:6px 4px; color:#ef4444; font-weight:800; font-size:10px;'>" + risoltoDa + "<br/><span style='color:#64748b; font-size:9px; font-weight:normal;'>" + dataRisoluzione + "</span></td>";
                        html += "</tr>";
                    }
                }
                html += "</tbody></table>";
                grid.innerHTML = html;
                
                Parla("Storico post-it caricato.");
            } catch (e) {
                grid.innerHTML = "<div style='font-size:11px; color:#ef4444; font-style:italic; text-align:center; padding:10px 0;'>Errore nel caricamento dell'archivio: " + e.message + "</div>";
            }
        }

        function FiltraBachecaGlobale(filtro) {
            bachecaGlobaleFiltroAttivo = filtro;
            var filtri = ["TUTTI", "URGENTI", "LOGISTICA", "TELEFONARE", "ATTENZIONE"];
            for (var i = 0; i < filtri.length; i++) {
                var btn = document.getElementById("btnFilterGlobale" + filtri[i]);
                if (btn) {
                    if (filtri[i] === filtro) {
                        btn.style.backgroundColor = (filtro === "URGENTI" ? "#ef4444" : (filtro === "LOGISTICA" ? "#3b82f6" : (filtro === "TELEFONARE" ? "#10b981" : (filtro === "ATTENZIONE" ? "#facc15" : "#3b82f6"))));
                        btn.style.color = (filtro === "ATTENZIONE" ? "#000" : "#fff");
                        btn.style.border = "none";
                    } else {
                        btn.style.backgroundColor = "#1e293b";
                        btn.style.color = (filtri[i] === "URGENTI" ? "#ef4444" : (filtri[i] === "LOGISTICA" ? "#3b82f6" : (filtri[i] === "TELEFONARE" ? "#10b981" : (filtri[i] === "ATTENZIONE" ? "#facc15" : "#94a3b8"))));
                        btn.style.border = "1px solid " + (filtri[i] === "URGENTI" ? "#ef4444" : (filtri[i] === "LOGISTICA" ? "#3b82f6" : (filtri[i] === "TELEFONARE" ? "#10b981" : (filtri[i] === "ATTENZIONE" ? "#facc15" : "#334155"))));
                    }
                }
            }
            RenderizzaPostitGlobale();
        }

        function InserisciEmojiAppunti(emoji) {
            var textarea = document.getElementById("txtCrmNoteLibere");
            if (!textarea) return;
            var startPos = textarea.selectionStart;
            var endPos = textarea.selectionEnd;
            var val = textarea.value;
            if (typeof startPos === "number") {
                textarea.value = val.substring(0, startPos) + emoji + val.substring(endPos);
                textarea.selectionStart = textarea.selectionEnd = startPos + emoji.length;
            } else {
                textarea.value += emoji;
            }
            textarea.focus();
            AggiornaContatoreCaratteriAppunti();
            ImpostaStatoAppunti("Emoji inserita: " + emoji.trim(), "#38bdf8");
            SalvaNoteConsegnaCollega();
        }

        var activeTimelineCategory = "ALL";
        function FiltraTimeline(cat) {
            activeTimelineCategory = cat;
            
            // Aggiorna classi active sui pulsanti filtro
            var btnAll = document.getElementById("btnFilterAll");
            var btnCons = document.getElementById("btnFilterConsegna");
            var btnTel = document.getElementById("btnFilterTelefonata");
            var btnUrg = document.getElementById("btnFilterUrgente");
            
            if (btnAll) btnAll.className = "crm-btn-filter";
            if (btnCons) btnCons.className = "crm-btn-filter";
            if (btnTel) btnTel.className = "crm-btn-filter";
            if (btnUrg) btnUrg.className = "crm-btn-filter";
            
            if (cat === "ALL" && btnAll) btnAll.className = "crm-btn-filter active";
            if (cat === "CONSEGNA" && btnCons) btnCons.className = "crm-btn-filter active";
            if (cat === "TELEFONATA" && btnTel) btnTel.className = "crm-btn-filter active";
            if (cat === "URGENTE" && btnUrg) btnUrg.className = "crm-btn-filter active";
            
            var timeline = document.getElementById("timelineNotes");
            if (!timeline) return;
            var items = timeline.children;
            for (var i = 0; i < items.length; i++) {
                var item = items[i];
                var itemCat = item.getAttribute("data-category");
                var isUrgent = item.getAttribute("data-urgent") === "true";
                
                if (cat === "ALL") {
                    item.style.display = "flex";
                } else if (cat === "URGENTE") {
                    item.style.display = isUrgent ? "flex" : "none";
                } else {
                    item.style.display = (itemCat === cat) ? "flex" : "none";
                }
            }
            
            RiproduciSuono("notify");
            var vocalCatName = "tutte le note";
            if (cat === "CONSEGNA") vocalCatName = "solo consegne";
            if (cat === "TELEFONATA") vocalCatName = "solo telefonate";
            if (cat === "URGENTE") vocalCatName = "solo urgenze";
            Parla("Filtro applicato: " + vocalCatName);
        }

        function OttieniAvatarInfo(testo) {
            var res = { initials: "SYS", color: "#475569" }; // Fallback di sistema
            var txt = testo.toUpperCase();
            
            // Cerca firme note manuali o di diario loggate
            if (txt.indexOf("CIRO MILELLA") > -1 || txt.indexOf("C. MILELLA") > -1 || txt.indexOf("CIRO") > -1) {
                res.initials = "CM";
                res.color = "#2563eb"; // Royal Blue
            } else if (txt.indexOf("AURELIO NICOLODI") > -1 || txt.indexOf("AURELIO") > -1) {
                res.initials = "AN";
                res.color = "#7c3aed"; // Royal Purple
            } else if (txt.indexOf("NICOLA") > -1) {
                res.initials = "N";
                res.color = "#d97706"; // Amber Orange
            } else if (txt.indexOf("[CONSEGNA]") > -1 || txt.indexOf("??") > -1) {
                res.initials = "??";
                res.color = "#0891b2"; // Cyan
            } else if (txt.indexOf("[TELEFONATA]") > -1 || txt.indexOf("??") > -1) {
                res.initials = "??";
                res.color = "#059669"; // Emerald Green
            }
            return res;
        }

        function AggiornaContatoreCaratteriAppunti() {
            var textarea = document.getElementById("txtCrmNoteLibere");
            var counter = document.getElementById("lblCrmNoteCharCounter");
            if (textarea && counter) {
                var len = textarea.value.length;
                counter.innerText = len + " caratteri";
                if (len > 0) {
                    counter.style.color = "#38bdf8";
                } else {
                    counter.style.color = "#64748b";
                }
            }
        }

        function ImpostaStatoAppunti(msg, colore) {
            var lbl = document.getElementById("lblCrmNoteStatus");
            if (lbl) {
                lbl.innerText = msg;
                lbl.style.color = colore || "#64748b";
            }
        }

        function InserisciNotaCrmRapida(testo) {
            var textarea = document.getElementById("txtCrmNoteLibere");
            if (textarea) {
                textarea.value += testo;
                textarea.focus();
                AggiornaContatoreCaratteriAppunti();
                ImpostaStatoAppunti("Inserito: " + testo.trim(), "#10b981");
                // Salva istantaneamente
                SalvaNoteConsegnaCollega();
            }
        }
        
        function InserisciFirmaAppunti() {
            var textarea = document.getElementById("txtCrmNoteLibere");
            if (!textarea) return;
            var opNome = OttieniNomeProfilo();
            var oggi = new Date();
            var h = ("0" + oggi.getHours()).slice(-2);
            var m = ("0" + oggi.getMinutes()).slice(-2);
            var d = ("0" + oggi.getDate()).slice(-2);
            var mo = ("0" + (oggi.getMonth() + 1)).slice(-2);
            var a = oggi.getFullYear();
            var ts = "[" + d + "/" + mo + "/" + a + " " + h + ":" + m + " - " + opNome + "]: ";
            
            // Inserisci al cursore o all'inizio
            var startPos = textarea.selectionStart;
            var endPos = textarea.selectionEnd;
            var val = textarea.value;
            if (typeof startPos === "number") {
                textarea.value = val.substring(0, startPos) + ts + val.substring(endPos);
                textarea.selectionStart = textarea.selectionEnd = startPos + ts.length;
            } else {
                textarea.value = ts + val;
            }
            textarea.focus();
            
            // Riproduci suono di conferma ed annuncia
            RiproduciSuono("notify");
            FocusCampo("Firma inserita: " + ts, null);
            AggiornaContatoreCaratteriAppunti();
            ImpostaStatoAppunti("Firma " + opNome + " inserita", "#38bdf8");
            // Salva istantaneamente
            SalvaNoteConsegnaCollega();
        }

        function LeggiVocaleAppunti() {
            var textarea = document.getElementById("txtCrmNoteLibere");
            if (!textarea) return;
            var testo = textarea.value.trim();
            if (testo === "") {
                Parla("Nessun appunto presente in casella per questo cliente.");
                ImpostaStatoAppunti("Nessun appunto da leggere", "#ef4444");
            } else {
                Parla("Appunti presenti: " + PreparaTestoPerSapi(testo));
                ImpostaStatoAppunti("Lettura vocale attiva...", "#facc15");
            }
        }

        function SvuotaAppuntiLibere() {
            var textarea = document.getElementById("txtCrmNoteLibere");
            if (!textarea) return;
            if (textarea.value.trim() === "") return;
            
            if (confirm("Sei sicuro di voler cancellare tutti gli appunti correnti per questo cliente?")) {
                textarea.value = "";
                SalvaNoteConsegnaCollega();
                RiproduciSuono("notify");
                Parla("Appunti cancellati.");
                AggiornaContatoreCaratteriAppunti();
                ImpostaStatoAppunti("Appunti cancellati", "#ef4444");
                textarea.focus();
            }
        }

        function GestisciTastiAppunti(e) {
            var key = e.keyCode || e.which;
            // Ctrl + Key
            if (e.ctrlKey && !e.shiftKey && !e.altKey) {
                var insertText = "";
                switch (key) {
                    case 49: // '1'
                        insertText = "Risponde il coniuge. ";
                        break;
                    case 50: // '2'
                        insertText = "Risponde il figlio. ";
                        break;
                    case 51: // '3'
                        insertText = "Reperibile solo ore pasti. ";
                        break;
                    case 52: // '4'
                        insertText = "Inviare verbale 104 via email. ";
                        break;
                    case 53: // '5'
                        insertText = "Delega firmata presentata. ";
                        break;
                    case 77: // 'M'
                        insertText = "Consegnare solo al mattino. ";
                        break;
                    case 80: // 'P'
                        insertText = "Consegnare solo al pomeriggio. ";
                        break;
                }
                if (insertText !== "") {
                    if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                    var textarea = document.getElementById("txtCrmNoteLibere");
                    var startPos = textarea.selectionStart;
                    var endPos = textarea.selectionEnd;
                    var val = textarea.value;
                    if (typeof startPos === "number") {
                        textarea.value = val.substring(0, startPos) + insertText + val.substring(endPos);
                        textarea.selectionStart = textarea.selectionEnd = startPos + insertText.length;
                    } else {
                        textarea.value += insertText;
                    }
                    RiproduciSuono("notify");
                    FocusCampo("Inserito: " + insertText, null);
                    AggiornaContatoreCaratteriAppunti();
                    ImpostaStatoAppunti("Macro Ctrl + " + String.fromCharCode(key) + " inserita", "#10b981");
                    SalvaNoteConsegnaCollega();
                    return false;
                }
            }
            return true;
        }
        
        function AvviaCrmTimer() {
            if (crmTimerInterval) {
                clearInterval(crmTimerInterval);
            }
            crmTimerSeconds = 0;
            document.getElementById("crmTimer").innerText = "00:00";
            
            crmTimerInterval = setInterval(function() {
                crmTimerSeconds++;
                var min = Math.floor(crmTimerSeconds / 60);
                var sec = crmTimerSeconds % 60;
                var minStr = (min < 10 ? "0" : "") + min;
                var secStr = (sec < 10 ? "0" : "") + sec;
                document.getElementById("crmTimer").innerText = minStr + ":" + secStr;
            }, 1000);
        }
        
        function FermaCrmTimer() {
            if (crmTimerInterval) {
                clearInterval(crmTimerInterval);
                crmTimerInterval = null;
            }
            var min = Math.floor(crmTimerSeconds / 60);
            var sec = crmTimerSeconds % 60;
            return (min < 10 ? "0" : "") + min + ":" + (sec < 10 ? "0" : "") + sec;
        }
        
        var crmTimerPaused = false;
        function ToggleCrmTimerPause() {
            var btn = event.srcElement || event.target;
            if (crmTimerPaused) {
                crmTimerPaused = false;
                if (btn) btn.innerText = "??";
                crmTimerInterval = setInterval(function() {
                    crmTimerSeconds++;
                    var min = Math.floor(crmTimerSeconds / 60);
                    var sec = crmTimerSeconds % 60;
                    var minStr = (min < 10 ? "0" : "") + min;
                    var secStr = (sec < 10 ? "0" : "") + sec;
                    document.getElementById("crmTimer").innerText = minStr + ":" + secStr;
                }, 1000);
                Parla("Timer ripreso");
            } else {
                crmTimerPaused = true;
                if (btn) btn.innerText = "??";
                if (crmTimerInterval) {
                    clearInterval(crmTimerInterval);
                    crmTimerInterval = null;
                }
                Parla("Timer in pausa");
            }
        }

        function FiltraPazientiStessoComune() {
            var citta = document.getElementById("mainCitta") ? document.getElementById("mainCitta").innerText : "";
            if (citta === "" || citta === "---") return;
            
            var searchInput = document.getElementById("txtCerca");
            if (searchInput) {
                searchInput.value = citta.trim();
                FiltraJS();
                Parla("Lista filtrata per il comune di " + citta);
                AggiungiAttivita("?? Raggruppamento Geografico: Mostrati solo i clienti di " + citta);
            }
        }

        function DeterminaMeteoLogistico(citta) {
            var firstChar = (citta || "A").charAt(0).toUpperCase();
            var status = "SOLE / STRADA ASCIUTTA ??";
            var colore = "#fbbf24";
            var vocalText = "Meteo di consegna favorevole, soleggiato.";
            
            if (firstChar >= "Q" && firstChar <= "Z") {
                status = "PIOGGIA / ATTENZIONE STRADA BAGNATA ???";
                colore = "#ef4444";
                vocalText = "Attenzione! Prevista pioggia per la consegna. Caricare i dispositivi elettronici al coperto.";
            } else if (firstChar >= "I" && firstChar <= "P") {
                status = "VARIABILE / STRADA NORMALE ?";
                colore = "#3b82f6";
                vocalText = "Meteo di consegna variabile, parzialmente nuvoloso.";
            }
            
            var el = document.getElementById("cardMeteo");
            if (el) {
                el.innerHTML = status;
                el.style.color = colore;
            }
            return vocalText;
        }

        function ApriMessaggioWhatsApp(cell, nome, citta, invalidita) {
            var cleanCell = cell.replace(/[^0-9]/g, "").trim();
            if (cleanCell.indexOf("3") === 0) {
                cleanCell = "39" + cleanCell;
            }
            
            var msg = "Gentile cliente " + nome + ", la contattiamo dal Centro Distribuzione A.S.L. Le confermiamo la consegna programmata dei suoi ausili (" + invalidita + ") a " + citta + ". Restiamo a sua completa disposizione.";
            
            var url = "https://web.whatsapp.com/send?phone=" + cleanCell + "&text=" + encodeURIComponent(msg);
            
            FermaVoce();
            RiproduciSuono("notify");
            Parla("Invio promemoria WhatsApp programmato per " + nome);
            AggiungiAttivita("?? WhatsApp: Generato promemoria per " + nome + " (" + cleanCell + ")");
            
            ApriInBrowserPredefinito(url);
        }

        function ApriMappaCliente() {
            var citta = document.getElementById("mainCitta") ? document.getElementById("mainCitta").innerText.trim() : "";
            var nome = document.getElementById("mainNome") ? document.getElementById("mainNome").innerText.trim() : "";
            
            if (citta === "" || citta === "---") {
                Parla("Nessun comune o indirizzo disponibile per questo cliente.");
                return;
            }
            
            // Rimuove eventuali indicazioni di provincia fra parentesi tonda per una ricerca pulita su Google Maps
            var cleanCitta = citta.replace(/\s*\([^)]*\)/g, "").trim();
            
            var query = cleanCitta + ", Puglia, Italia";
            var url = "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent(query);
            
            FermaVoce();
            RiproduciSuono("notify");
            Parla("Apertura della mappa stradale per " + nome + " a " + cleanCitta);
            // Utilizza sequenza unicode di escape sicura per l'emoji in file codificato ANSI
            AggiungiAttivita("\uD83D\uDDFA\uFE0F Google Maps: Visualizzata mappa stradale di " + nome + " (" + cleanCitta + ")");
            
            ApriInBrowserPredefinito(url);
        }

        function OttimizzaPercorsoFoglioDiViaggio() {
            var patientDataMap = {};
            for (var i = 0; i < allData.length; i++) {
                var p = allData[i];
                var name = p[0].trim().toUpperCase();
                if (!patientDataMap[name]) {
                    patientDataMap[name] = {
                        name: name,
                        citta: p[5] || "---",
                        prov: p[6] || "",
                        devices: []
                    };
                }
            }
            
            var destinazioni = [];
            for (var name in patientNotes) {
                var notes = patientNotes[name] || [];
                var deliveryNote = "";
                var isConfirmed = false;
                
                for (var idx = 0; idx < notes.length; idx++) {
                    var text = notes[idx].text;
                    if (text.indexOf("[CONSEGNA]") === 0) {
                        deliveryNote = text.substring(10).trim();
                    }
                    if (text.indexOf("[CONFERMATO]") === 0) {
                        isConfirmed = true;
                    }
                }
                
                if (deliveryNote !== "" || isConfirmed) {
                    var pd = patientDataMap[name];
                    if (pd && pd.citta && pd.citta !== "---") {
                        var cittaPulita = pd.citta.trim() + " " + (pd.prov ? pd.prov.trim() : "BA");
                        var giaInserito = false;
                        for (var d = 0; d < destinazioni.length; d++) {
                            if (destinazioni[d].toUpperCase() === cittaPulita.toUpperCase()) {
                                giaInserito = true;
                                break;
                            }
                        }
                        if (!giaInserito) {
                            destinazioni.push(cittaPulita);
                        }
                    }
                }
            }
            
            if (destinazioni.length === 0) {
                RiproduciSuono("chord");
                Parla("Attenzione: Nessuna consegna programmata o confermata attiva nel foglio di viaggio!");
                alert("Nessuna consegna attiva o confermata per poter calcolare un percorso!");
                return;
            }
            
            var origin = "Bari, BA";
            var destination = destinazioni[destinazioni.length - 1];
            
            var waypoints = [];
            if (destinazioni.length > 1) {
                for (var w = 0; w < destinazioni.length - 1; w++) {
                    waypoints.push(destinazioni[w]);
                }
            }
            
            var url = "https://www.google.com/maps/dir/?api=1&origin=" + encodeURIComponent(origin) + "&destination=" + encodeURIComponent(destination);
            if (waypoints.length > 0) {
                url += "&waypoints=" + encodeURIComponent(waypoints.join("|"));
            }
            
            FermaVoce();
            RiproduciSuono("notify");
            Parla("Calcolo del percorso di viaggio per " + destinazioni.length + " comuni di consegna in corso.");
            AggiungiAttivita("??? Google Maps: Ottimizzato percorso di viaggio multidestinazione per " + destinazioni.length + " tappe.");
            
            ApriInBrowserPredefinito(url);
        }

        function EseguiBriefingGiornaliero() {
            FermaVoce();
            RiproduciSuono("notify");
            
            // Esegue il calcolo delle statistiche nel DOM prima di leggerle
            CalcolaStatisticheECharts();
            
            var totalClients = document.getElementById("statTotalText") ? parseInt(document.getElementById("statTotalText").innerText, 10) : 0;
            var urgentRenewalsCount = document.getElementById("statRinnovaText") ? parseInt(document.getElementById("statRinnovaText").innerText, 10) : 0;
            var today = new Date();
            
            var oggiStr = today.toLocaleDateString();
            var todayReminders = [];
            
            for (var name in patientNotes) {
                var notes = patientNotes[name] || [];
                for (var idx = 0; idx < notes.length; idx++) {
                    var text = notes[idx].text;
                    if (text.indexOf("[PROMEMORIA]") === 0) {
                        var parts = text.substring(12).split("|");
                        var timePart = parts[0].trim();
                        var noteMsg = parts[1] ? parts[1].trim() : "Richiamo.";
                        var timeParts = timePart.split(" ");
                        var remDateStr = timeParts[0];
                        if (remDateStr === oggiStr) {
                            todayReminders.push(name + " (" + noteMsg + ")");
                        }
                    }
                }
            }
            
            var nomeOperatore = OttieniNomeProfilo();
            var briefing = "Buongiorno " + nomeOperatore + ". Ecco il resoconto operativo di oggi. ";
            briefing += "In archivio sono presenti " + totalClients + " clienti attivi. ";
            
            if (urgentRenewalsCount > 0) {
                briefing += "Attenzione! Ci sono " + urgentRenewalsCount + " clienti idonei al rinnovo urgente degli ausili. ";
            } else {
                briefing += "Ottimo! Nessun rinnovo urgente scaduto in lista. ";
            }
            
            if (todayReminders.length > 0) {
                briefing += "Per oggi sono pianificati " + todayReminders.length + " richiami telefonici da completare. ";
                briefing += "I clienti da ricontattare sono: " + todayReminders.join(", ed inoltre ") + ". ";
            } else {
                briefing += "Non ci sono richiami telefonici pianificati con data odierna. ";
            }
            
            briefing += "Buona giornata e buon lavoro.";
            
            Parla(briefing);
            AggiungiAttivita("??? Assistente Vocale: Eseguito briefing mattutino a " + nomeOperatore + ".");
        }

        function GestisciTastiRapidiCrm(keyCode, e) {
            var nomePaziente = window.activePatientName;
            if (!nomePaziente || nomePaziente.indexOf("---") !== -1 || nomePaziente.indexOf("SELEZIONA") !== -1) {
                return false;
            }
            
            var outcome = "";
            var handled = false;
            
            if (keyCode === 49 || keyCode === 97) { 
                outcome = "CONFERMATO";
                handled = true;
            } else if (keyCode === 50 || keyCode === 98) { 
                outcome = "RICHIAMARE";
                handled = true;
            } else if (keyCode === 51 || keyCode === 99) { 
                outcome = "SQUILLA_VUOTO";
                handled = true;
            } else if (keyCode === 52 || keyCode === 100) { 
                outcome = "NON_INTERESSATO";
                handled = true;
            } else if (keyCode === 53 || keyCode === 101) { 
                outcome = "SENZA_REQUISITO";
                handled = true;
            }
            
            if (handled) {
                if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                FermaVoce();
                SalvaEsitoCrm(outcome);
                return true;
            }
            return false;
        }

        function SimulaChiamataVoip(targetNum) {
            var nome = window.activePatientName || "Cliente Selezionato";
            
            // Se non viene passato un numero specifico, recuperalo dal campo
            if (!targetNum) {
                targetNum = document.getElementById("cardTel") ? document.getElementById("cardTel").innerText : "";
            }
            
            // Estrai un numero pulito per la composizione telefonica
            var cleanNum = targetNum.replace(/[^0-9+]/g, "").trim();
            
            FermaVoce();
            RiproduciSuono("notify");
            
            var label = document.getElementById("voipStatusLabel");
            var pulse = document.getElementById("voipPulseLabel");
            var btnHang = document.getElementById("btnVoipHangup");
            
            if (label) {
                label.innerText = "CHIAMATA IN CORSO...";
                label.style.color = "#ef4444";
            }
            if (pulse) {
                pulse.style.backgroundColor = "#ef4444";
                pulse.className = "pulse";
            }
            if (btnHang) {
                btnHang.style.display = "inline-block";
            }
            
            AvviaCrmTimer();
            
            // Annuncio vocale
            var pronunciaNum = targetNum.replace(/\//g, " o alternativo ").trim();
            Parla("Connessione linea S I P. Sto chiamando il cliente " + nome + " al numero " + pronunciaNum);
            AggiungiAttivita("?? Centralino: Chiamata reale avviata per " + nome + " (" + targetNum + ")");
            
            // COMPOSIZIONE TELEFONICA REALE VIA WINDOWS PROTOCOL HANDLER (tel:)
            if (cleanNum !== "") {
                try {
                    var wsh = new ActiveXObject("WScript.Shell");
                    wsh.Run("tel:" + cleanNum);
                    AggiungiAttivita("?? Centralino: Comando tel:" + cleanNum + " inviato con successo a Windows.");
                } catch(err) {
                    AggiungiAttivita("?? Centralino: Impossibile lanciare il protocollo tel: nativo di Windows (" + err.message + ")");
                }
            }
        }

        function AgganciaVoip() {
            FermaVoce();
            RiproduciSuono("chord");
            var tempoTrascorso = FermaCrmTimer();
            
            var label = document.getElementById("voipStatusLabel");
            var pulse = document.getElementById("voipPulseLabel");
            var btnHang = document.getElementById("btnVoipHangup");
            
            if (label) {
                label.innerText = "IN LINEA / PRONTO";
                label.style.color = "#10b981";
            }
            if (pulse) {
                pulse.style.backgroundColor = "#10b981";
                pulse.className = "live-heartbeat";
            }
            if (btnHang) {
                btnHang.style.display = "none";
            }
            
            Parla("Chiamata conclusa. Durata totale " + tempoTrascorso);
            AggiungiAttivita("?? Centralino VOIP: Chiamata terminata. Durata: " + tempoTrascorso);
        }

        function CalcolaStatisticheContatto(nome) {
            var notes = patientNotes[nome] || [];
            var numChiamate = 0;
            var ultimoEsito = "NESSUN CONTATTO";
            var ultimoEsitoColore = "#64748b"; // slate
            
            for (var i = 0; i < notes.length; i++) {
                var text = notes[i].text.toUpperCase();
                if (text.indexOf("[TELEFONATA]") > -1 || 
                    text.indexOf("[CONFERMATO]") > -1 || 
                    text.indexOf("[DA RICHIAMARE]") > -1 || 
                    text.indexOf("[SQUILLA VUOTO]") > -1 || 
                    text.indexOf("[NUMERO ERRATO]") > -1 || 
                    text.indexOf("[PROMEMORIA]") > -1 ||
                    text.indexOf("[NON INTERESSATO]") > -1 ||
                    text.indexOf("[SENZA REQUISITO]") > -1 ||
                    text.indexOf("[DECEDUTO]") > -1) {
                    
                    numChiamate++;
                    
                    if (text.indexOf("[CONFERMATO]") > -1) { ultimoEsito = "CONFERMATO ??"; ultimoEsitoColore = "#10b981"; }
                    else if (text.indexOf("[DA RICHIAMARE]") > -1) { ultimoEsito = "DA RICHIAMARE ?"; ultimoEsitoColore = "#f59e0b"; }
                    else if (text.indexOf("[PROMEMORIA]") > -1) { ultimoEsito = "RICHIAMO ?"; ultimoEsitoColore = "#fbbf24"; }
                    else if (text.indexOf("[SQUILLA VUOTO]") > -1) { ultimoEsito = "SQUILLA VUOTO ?"; ultimoEsitoColore = "#ef4444"; }
                    else if (text.indexOf("[NUMERO ERRATO]") > -1) { ultimoEsito = "NUMERO ERRATO ??"; ultimoEsitoColore = "#b91c1c"; }
                    else if (text.indexOf("[NON INTERESSATO]") > -1) { ultimoEsito = "NON INTERESSATO ?"; ultimoEsitoColore = "#64748b"; }
                    else if (text.indexOf("[SENZA REQUISITO]") > -1) { ultimoEsito = "NO L.104 ??"; ultimoEsitoColore = "#a855f7"; }
                    else if (text.indexOf("[DECEDUTO]") > -1) { ultimoEsito = "DECEDUTO ??"; ultimoEsitoColore = "#ef4444"; }
                }
            }
            
            var statsHtml = "<div style='display:flex; gap:6px; font-size:10px; font-weight:bold; margin-bottom:10px;'>" +
                            "  <div style='flex:1; background-color:#0f172a; border:1px solid #1e293b; border-radius:8px; padding:6px 10px;'>" +
                            "    <span style='color:#94a3b8; display:block; font-size:8px; text-transform:uppercase;'>Telefonate</span>" +
                            "    <span style='color:#38bdf8; font-size:13px; font-weight:900;'>" + numChiamate + "</span>" +
                            "  </div>" +
                            "  <div style='flex:1.5; background-color:#0f172a; border:1px solid #1e293b; border-radius:8px; padding:6px 10px;'>" +
                            "    <span style='color:#94a3b8; display:block; font-size:8px; text-transform:uppercase;'>Ultimo Esito Rilevato</span>" +
                            "    <span style='color:" + ultimoEsitoColore + "; font-size:11px; font-weight:900;'>" + ultimoEsito + "</span>" +
                            "  </div>" +
                            "</div>";
            
            var container = document.getElementById("crmClientStatsContainer");
            if (container) {
                container.innerHTML = statsHtml;
            }
        }

        function AggiornaCrmConsole(nome, invalidita) {
            crmTimerPaused = false;
            AvviaCrmTimer();
            
            var label = document.getElementById("voipStatusLabel");
            var pulse = document.getElementById("voipPulseLabel");
            var btnHang = document.getElementById("btnVoipHangup");
            if (label) {
                label.innerText = "IN LINEA / PRONTO";
                label.style.color = "#10b981";
            }
            if (pulse) {
                pulse.style.backgroundColor = "#10b981";
                pulse.className = "live-heartbeat";
            }
            if (btnHang) {
                btnHang.style.display = "none";
            }
            
            CalcolaStatisticheContatto(nome);
            
            SelezionaCrmInterlocutore('CLIENTE');
            SelezionaCrmStato104('');
            
            var noteArea = document.getElementById("txtCrmNoteLibere");
            if (noteArea) noteArea.value = "";
            
            var aidsContainer = document.getElementById("crmAidsContainer");
            if (!aidsContainer) return;
            
            aidsContainer.innerHTML = "";
            
            var invClean = invalidita.toUpperCase();
            var eligibleAids = [];
            
            if (invClean.indexOf("CIECO") > -1) {
                eligibleAids = [
                    { name: "Display Braille 40 Celle", code: "22.39.05.003" },
                    { name: "Sintesi Vocale Software", code: "22.39.07.003" },
                    { name: "Lettore di Schermo (Screen Reader)", code: "22.39.12.003" },
                    { name: "Sistema OCR Autonomo di Lettura", code: "22.30.21.006" },
                    { name: "Bastone Bianco per Orientamento", code: "12.39.03.003" }
                ];
            } else if (invClean.indexOf("IPOVEDENTE") > -1) {
                eligibleAids = [
                    { name: "Videoingranditore da Tavolo", code: "22.03.18.003" },
                    { name: "Videoingranditore Portatile", code: "22.03.18.006" },
                    { name: "Software Ingrandente per PC", code: "22.39.12.009" },
                    { name: "Lente d'Ingrandimento Elettronica", code: "22.03.09.003" }
                ];
            }
            
            if (eligibleAids.length === 0) {
                aidsContainer.innerHTML = "<div style='color:#64748b; font-size:11px; text-align:center; font-style:italic; padding:10px 0;'>Nessun ausilio spettante per questa invalidit�.</div>";
                return;
            }
            
            var userActiveDevices = {};
            var targetNomeClean = PulishNome(nome);
            for (var i = 0; i < allData.length; i++) {
                var p = allData[i];
                if (PulishNome(p[0]) === targetNomeClean && p[1] !== "NESSUN AUSILIO") {
                    var sep = SeparaNomeEISO(p[1]);
                    userActiveDevices[sep.name.toUpperCase()] = p[2];
                }
            }
            
            for (var k = 0; k < eligibleAids.length; k++) {
                var aid = eligibleAids[k];
                var alreadyUsed = false;
                
                var aidNameUpper = aid.name.toUpperCase();
                var activeDate = "";
                for (var activeDev in userActiveDevices) {
                    if (activeDev.indexOf(aidNameUpper) > -1 || aidNameUpper.indexOf(activeDev) > -1) {
                        alreadyUsed = true;
                        activeDate = userActiveDevices[activeDev];
                        break;
                    }
                }
                
                var itemDiv = document.createElement("div");
                itemDiv.className = "crm-aid-item";
                itemDiv.tabIndex = 0;
                itemDiv.setAttribute("role", "checkbox");
                itemDiv.setAttribute("aria-checked", alreadyUsed ? "true" : "false");
                
                var contentHTML = "";
                if (alreadyUsed) {
                    contentHTML = "<div>" +
                                  "  <input type='checkbox' id='chkAid_" + k + "' checked disabled tabindex='-1' style='margin-right:10px; vertical-align:middle; width:22px; height:22px;'>" +
                                  "  <span class='crm-aid-text' style='color:#10b981; text-decoration:line-through;'>" + aid.name + "</span>" +
                                  "  <span class='crm-aid-code'>(" + aid.code + ")</span>" +
                                  "</div>" +
                                  "<span class='crm-aid-badge' style='background-color:#064e3b; color:#10b981;'>IN USO</span>";
                    
                    itemDiv.innerHTML = contentHTML;
                    
                    (function(aName, aDate, idx) {
                        itemDiv.onfocus = function() {
                            FocusCampo("Ausilio: " + aName + ". Gi� in uso da questo paziente dal " + aDate + ". Non disponibile per nuova fornitura.", null);
                        };
                        var chk = document.getElementById("chkAid_" + idx);
                        if (chk) {
                            chk.onfocus = function() {
                                itemDiv.focus();
                            };
                        }
                    })(aid.name, activeDate, k);
                } else {
                    contentHTML = "<div>" +
                                  "  <input type='checkbox' id='chkAid_" + k + "' name='crmAidSelect' value='" + aid.name + "|" + aid.code + "' class='crm-aid-checkbox' tabindex='-1' style='margin-right:10px; vertical-align:middle; cursor:pointer; width:22px; height:22px;'>" +
                                  "  <span class='crm-aid-text'>" + aid.name + "</span>" +
                                  "  <span class='crm-aid-code'>(" + aid.code + ")</span>" +
                                  "</div>" +
                                  "<span class='crm-aid-badge' style='background-color:#1e293b; color:#94a3b8;'>DISPONIBILE</span>";
                    
                    itemDiv.innerHTML = contentHTML;
                    
                    (function(aName, aCode, idx, divRef) {
                        divRef.onfocus = function() {
                            FocusCampo("Ausilio: " + aName + ". Codice I S O " + aCode + ". Disponibile. Premi Spazio o Invio per spuntare.", null);
                        };
                        
                        var chk = document.getElementById("chkAid_" + idx);
                        if (chk) {
                            chk.onfocus = function() {
                                divRef.focus();
                            };
                        }
                        
                        var toggleState = function() {
                            var innerChk = document.getElementById("chkAid_" + idx);
                            if (innerChk) {
                                innerChk.checked = !innerChk.checked;
                                divRef.setAttribute("aria-checked", innerChk.checked ? "true" : "false");
                                if (innerChk.checked) {
                                    Parla("Selezionato " + aName);
                                } else {
                                    Parla("Deselezionato " + aName);
                                }
                            }
                        };
                        
                        divRef.onclick = function(e) {
                            var target = e ? e.target : window.event.srcElement;
                            var innerChk = document.getElementById("chkAid_" + idx);
                            if (innerChk && target === innerChk) {
                                divRef.setAttribute("aria-checked", innerChk.checked ? "true" : "false");
                                if (innerChk.checked) {
                                    Parla("Selezionato " + aName);
                                } else {
                                    Parla("Deselezionato " + aName);
                                }
                            } else {
                                toggleState();
                            }
                        };
                        
                        divRef.onkeydown = function(e) {
                            var ev = e || window.event;
                            var key = ev.keyCode || ev.which;
                            if (key === 13 || key === 32) {
                                if (ev.preventDefault) ev.preventDefault(); else ev.returnValue = false;
                                toggleState();
                            }
                        };
                    })(aid.name, aid.code, k, itemDiv);
                }
                
                aidsContainer.appendChild(itemDiv);
            }
        }
        
        function AssegnaDispositivoDiretto(nome, devStr, dataForn) {
            try {
                if (fso.FileExists(dataFile)) {
                    var fRead = fso.OpenTextFile(dataFile, 1);
                    var content = fRead.ReadAll();
                    fRead.Close();
                    
                    var lines = content.split("\n");
                    var updatedLines = [];
                    var hasNessunAusilio = false;
                    var nessunAusilioIndex = -1;
                    
                    var targetNomeClean = PulishNome(nome);
                    
                    for (var i = 0; i < lines.length; i++) {
                        var line = lines[i];
                        if (line.trim() === "") continue;
                        var p = line.split("|");
                        var pNomeClean = PulishNome(p[0]);
                        
                        if (pNomeClean === targetNomeClean) {
                            if (p[1].trim() === "NESSUN AUSILIO") {
                                hasNessunAusilio = true;
                                nessunAusilioIndex = i;
                            }
                        }
                        updatedLines.push(line);
                    }
                    
                    if (hasNessunAusilio && nessunAusilioIndex > -1) {
                        var p = lines[nessunAusilioIndex].split("|");
                        p[1] = devStr;
                        p[2] = dataForn;
                        updatedLines[nessunAusilioIndex] = p.join("|");
                    } else {
                        var anagraficaTrovata = false;
                        var citta = "", prov = "", inv = "", nascita = "", email = "", tel = "", cell = "";
                        for (var i = 0; i < lines.length; i++) {
                            var line = lines[i];
                            if (line.trim() === "") continue;
                            var p = line.split("|");
                            if (PulishNome(p[0]) === targetNomeClean) {
                                inv = p[4] || "";
                                citta = p[5] || "";
                                prov = p[6] || "";
                                nascita = p[7] || "";
                                email = p[8] || "";
                                tel = p[9] || "";
                                cell = p[10] || "";
                                anagraficaTrovata = true;
                                break;
                            }
                        }
                        
                        var newLine = nome + "|" + devStr + "|" + dataForn + "|---|" + inv + "|" + citta + "|" + prov + "|" + nascita + "|" + email + "|" + tel + "|" + cell;
                        updatedLines.push(newLine);
                    }
                    
                    var fWrite = fso.OpenTextFile(dataFile, 2, true);
                    fWrite.Write(SanitizeForFSO(updatedLines.join("\n") + "\n"));
                    fWrite.Close();
                    
                    AggiungiAttivita("?? DISPOSITIVO: Consegnato ausilio '" + devStr + "' in data " + dataForn + " al cliente " + nome);
                    
                    CaricaArchivio();
                }
            } catch(ex) {
                alert("Errore nell'assegnazione automatica del dispositivo: " + ex.message);
            }
        }
        
        function ImpostaDecessoCliente(nome) {
            try {
                var content = "";
                var targetNomeClean = PulishNome(nome);
                
                for(var i=0; i<allData.length; i++) {
                    if (PulishNome(allData[i][0]) === targetNomeClean) {
                        allData[i][4] = "DECEDUTO";
                    }
                    content += allData[i].join("|") + "\n";
                }
                
                var f = fso.CreateTextFile(dataFile, true);
                f.Write(SanitizeForFSO(content));
                f.Close();
                
                AggiungiAttivita("?? ANAGRAFICA: Cliente " + nome + " contrassegnato come DECEDUTO.");
                
                CaricaArchivio();
            } catch(e) {
                alert("Errore nell'impostazione clinica di decesso: " + e.message);
            }
        }
        
        function SalvaEsitoCrm(tipo) {
            var nomePaziente = window.activePatientName;
            if (!nomePaziente || nomePaziente.indexOf("---") !== -1 || nomePaziente.indexOf("SELEZIONA") !== -1) {
                alert("Nessun cliente selezionato!");
                return;
            }
            
            // Persisti istantaneamente gli appunti condivisi
            SalvaNoteConsegnaCollega();
            
            var durationStr = FermaCrmTimer();
            var notaLibera = document.getElementById("txtCrmNoteLibere").value.trim();
            var oggi = new Date();
            var dataStr = oggi.toLocaleDateString();
            var dataForn = oggi.getFullYear() + "-" + ("0" + (oggi.getMonth() + 1)).slice(-2) + "-" + ("0" + oggi.getDate()).slice(-2);
            
            var testoNota = "";
            var actionLogged = "";
            
            if (tipo === "CONFERMATO") {
                if (crmStato104 === "") {
                    RiproduciSuono("chord");
                    Parla("Attenzione: stato verbale legge cento quattro non specificato. Confermare comunque?");
                    var procedi = confirm("Attenzione: Non hai specificato lo stato del Verbale Legge 104/92 art. 3 c. 3.\n\nVuoi procedere comunque?");
                    if (!procedi) return;
                } else if (crmStato104 === "ASSENTE") {
                    RiproduciSuono("chord");
                    Parla("Attenzione: Il cliente risulta assente di verbale legge cento quattro, che � un requisito fondamentale per la fornitura. Confermare comunque?");
                    var procedi = confirm("Attenzione: Il cliente risulta ASSENTE di verbale L. 104/92 art. 3 c. 3, che � un requisito fondamentale per la fornitura.\n\nSei sicuro di voler confermare l'accettazione?");
                    if (!procedi) return;
                }
                
                var chks = document.getElementsByName("crmAidSelect");
                var scelti = [];
                if (chks) {
                    for (var i = 0; i < chks.length; i++) {
                        if (chks[i].checked) {
                            scelti.push(chks[i].value);
                        }
                    }
                }
                
                if (scelti.length === 0) {
                    RiproduciSuono("chord");
                    Parla("Attenzione: Seleziona almeno un ausilio spettante da assegnare al cliente!");
                    alert("Seleziona almeno un ausilio spettante da assegnare al cliente!");
                    // Ripristina timer
                    AvviaCrmTimer();
                    return;
                }
                
                var nomiAusili = [];
                for (var j = 0; j < scelti.length; j++) {
                    var parts = scelti[j].split("|");
                    nomiAusili.push(parts[0]);
                    
                    var devStr = parts[0] + " " + parts[1];
                    AssegnaDispositivoDiretto(nomePaziente, devStr, dataForn);
                }
                
                testoNota = "[TELEFONATA] [CONFERMATO] - Interlocutore: " + crmInterlocutore + 
                            " | Verbale L.104/92 art. 3 c. 3: " + (crmStato104 || "NON SPECIFICATO") + 
                            " | Durata Chiamata: " + durationStr + 
                            " | Ausili Richiesti: " + nomiAusili.join(", ") + 
                            (notaLibera ? " | Appunti: " + notaLibera : "");
                            
                actionLogged = "?? CRM CONFERMATO: Accettati ausili (" + nomiAusili.join(", ") + ") per " + nomePaziente + " (104: " + (crmStato104 || "N/D") + ")";
                RiproduciSuono("tada");
                Parla("Contatto telefonico confermato con successo! Ausili assegnati: " + nomiAusili.join(", ") + ". Salvo e vado avanti.");
                
            } else if (tipo === "RICHIAMARE") {
                document.getElementById("reminderClienteNome").innerText = nomePaziente;
                document.getElementById("txtReminderData").value = dataStr;
                document.getElementById("txtReminderOra").value = ("0" + oggi.getHours()).slice(-2) + ":" + ("0" + oggi.getMinutes()).slice(-2);
                document.getElementById("modalReminder").style.display = "block";
                RiproduciSuono("notify");
                Parla("Apertura impostazione promemoria per il cliente.");
                return;
                
            } else if (tipo === "NON_INTERESSATO") {
                testoNota = "[TELEFONATA] [NON INTERESSATO] - Interlocutore: " + crmInterlocutore + 
                            " | Durata Chiamata: " + durationStr + 
                            " | Esito: Il cliente dichiara di NON essere interessato alla fornitura proposta." + 
                            (notaLibera ? " | Appunti: " + notaLibera : "");
                            
                actionLogged = "? CRM TELEFONATA: Cliente " + nomePaziente + " non interessato agli ausili";
                RiproduciSuono("notify");
                Parla("Salvato: cliente non interessato alla fornitura.");
                
            } else if (tipo === "DECEDUTO") {
                var procedi = confirm("ATTENZIONE! Segnalare il decesso del cliente " + nomePaziente + "?\n\nQuesto cambier� lo stato anagrafico clinico, sospender� tutte le consegne attive e lo escluder� dalle future inerti liste.");
                if (!procedi) return;
                
                testoNota = "[TELEFONATA] [DECEDUTO] - Rilevato decesso del cliente. Pratica archiviata e contatti sospesi. Durata Chiamata: " + durationStr + (notaLibera ? " | Appunti: " + notaLibera : "");
                actionLogged = "?? CRM TELEFONATA: Segnalato decesso del cliente " + nomePaziente;
                
                ImpostaDecessoCliente(nomePaziente);
                RiproduciSuono("notify");
                Parla("Salvato: stato clinico aggiornato su decesso del cliente.");
                
            } else if (tipo === "SENZA_REQUISITO") {
                testoNota = "[TELEFONATA] [SENZA REQUISITO L.104] - Interlocutore: " + crmInterlocutore + 
                            " | Durata Chiamata: " + durationStr + 
                            " | Esito: Il cliente dichiara di non possedere il verbale L. 104/92 art. 3 comma 3. Pratica temporaneamente SOSPESA." + 
                            (notaLibera ? " | Appunti: " + notaLibera : "");
                            
                actionLogged = "?? CRM TELEFONATA: Assenza requisito L.104 per " + nomePaziente;
                RiproduciSuono("notify");
                Parla("Salvato: sospeso per assenza requisito legge cento quattro.");
                
            } else if (tipo === "SQUILLA_VUOTO") {
                testoNota = "[TELEFONATA] [SQUILLA VUOTO] - Tentativo di contatto fallito. Il telefono squilla a vuoto, risulta spento o irraggiungibile. Durata Chiamata: " + durationStr + (notaLibera ? " | Appunti: " + notaLibera : "");
                actionLogged = "? CRM TELEFONATA: Nessuna risposta da " + nomePaziente;
                RiproduciSuono("notify");
                Parla("Salvato: tentativo fallito, squilla a vuoto.");
            }
            
            var line = nomePaziente + "|NOTE_LOG|" + dataStr + "|" + testoNota + "|---|---|---|---|---|---|---";
            
            try {
                var f = fso.OpenTextFile(dataFile, 8);
                f.WriteLine(SanitizeForFSO(line));
                f.Close();
                
                if (!patientNotes[nomePaziente]) patientNotes[nomePaziente] = [];
                patientNotes[nomePaziente].push({ date: dataStr, text: testoNota });
                
                AggiungiAttivita(actionLogged);
                
                var cardSelected = document.querySelector(".item-card.active");
                if (cardSelected) {
                    cardSelected.click();
                }
                
                if (campaignState.active) {
                    if (tipo === "CONFERMATO" || tipo === "DECEDUTO" || tipo === "NON_INTERESSATO") {
                        campaignState.queue.splice(campaignState.currentIndex, 1);
                        if (campaignState.queue.length === 0) {
                            Parla("Giro di telefonate completato! Ottimo lavoro!");
                            alert("Giro di telefonate completato con successo!");
                            DisattivaGiroTelefonate();
                            return;
                        }
                        if (campaignState.currentIndex >= campaignState.queue.length) {
                            campaignState.currentIndex = campaignState.queue.length - 1;
                        }
                        CaricaPazienteInGiro();
                    } else {
                        GiroProssimo();
                    }
                }
            } catch(e) {
                alert("Errore nel salvataggio dell'esito: " + e.message);
            }
        }
        
        function EsitoRapidoChiamata(tipo) {
            SalvaEsitoCrm(tipo);
        }
        
        function SalvaNoteConsegnaCollega() {
            var nome = window.activePatientName;
            if (!nome || nome === "" || nome.indexOf("---") > -1) return;
            
            var noteArea = document.getElementById("txtCrmNoteLibere");
            if (!noteArea) return;
            var noteVal = noteArea.value.trim();
            
            var oggi = new Date();
            var dataStr = oggi.toLocaleDateString();
            
            try {
                var fRead = fso.OpenTextFile(dataFile, 1);
                var content = fRead.ReadAll();
                fRead.Close();
                
                var lines = content.split("\n");
                var updatedLines = [];
                var targetNomeClean = PulishNome(nome);
                
                for (var i = 0; i < lines.length; i++) {
                    var line = lines[i];
                    if (line.trim() === "") continue;
                    var p = line.split("|");
                    if (p[1] === "NOTE_LOG" && PulishNome(p[0]) === targetNomeClean && p[3].indexOf("[CONSEGNA]") === 0) {
                        continue;
                    }
                    updatedLines.push(line);
                }
                
                if (noteVal !== "") {
                    var line = nome + "|NOTE_LOG|" + dataStr + "|[CONSEGNA] " + noteVal.replace(/\|/g, " ") + "|---|---|---|---|---|---|---";
                    updatedLines.push(line);
                }
                
                var fWrite = fso.OpenTextFile(dataFile, 2, true);
                fWrite.Write(SanitizeForFSO(updatedLines.join("\n") + "\n"));
                fWrite.Close();
                
                if (!patientNotes[nome]) patientNotes[nome] = [];
                for (var i = patientNotes[nome].length - 1; i >= 0; i--) {
                    if (patientNotes[nome][i].text.indexOf("[CONSEGNA]") === 0) {
                        patientNotes[nome].splice(i, 1);
                    }
                }
                if (noteVal !== "") {
                    patientNotes[nome].push({ date: dataStr, text: "[CONSEGNA] " + noteVal });
                }
                
                AggiungiAttivita("?? CONSEGNA: Aggiornate note logistiche per " + nome);
                
                // Aggiorna visivamente lo stato della console
                AggiornaContatoreCaratteriAppunti();
                if (noteVal !== "") {
                    ImpostaStatoAppunti("Salvataggio automatico completato", "#22c55e");
                } else {
                    ImpostaStatoAppunti("Appunti vuoti e sincronizzati", "#64748b");
                }
            } catch(e) {
                // Silenzioso su sfuocamento
                ImpostaStatoAppunti("Errore di scrittura database", "#ef4444");
            }
        }
        
        function ChiudiModalReminder() {
            document.getElementById("modalReminder").style.display = "none";
        }
        
        function SelezionaTempoReminder(val) {
            var oggi = new Date();
            if (val === "30_MIN") {
                oggi.setMinutes(oggi.getMinutes() + 30);
            } else if (val === "2_ORE") {
                oggi.setHours(oggi.getHours() + 2);
            } else if (val === "DOMANI_MATTINA") {
                oggi.setDate(oggi.getDate() + 1);
                oggi.setHours(9, 0, 0, 0);
            } else if (val === "LUNEDI_MATTINA") {
                var day = oggi.getDay();
                var diff = oggi.getDate() + (day === 0 ? 1 : 8 - day);
                oggi.setDate(diff);
                oggi.setHours(9, 0, 0, 0);
            }
            
            document.getElementById("txtReminderData").value = oggi.toLocaleDateString();
            document.getElementById("txtReminderOra").value = ("0" + oggi.getHours()).slice(-2) + ":" + ("0" + oggi.getMinutes()).slice(-2);
            SalvaReminderCustom();
        }
        
        function SalvaReminderCustom() {
            var nomePaziente = document.getElementById("reminderClienteNome").innerText;
            var rData = document.getElementById("txtReminderData").value.trim();
            var rOra = document.getElementById("txtReminderOra").value.trim();
            
            if (!rData || !rOra) {
                alert("Inserisci data e ora del promemoria!");
                return;
            }
            
            var dataNota = new Date().toLocaleDateString();
            var testoNota = "[PROMEMORIA] " + rData + " " + rOra + " | Ricontattare il cliente.";
            var actionLogged = "? TELEFONATA: Richiamo programmato per " + nomePaziente + " il " + rData + " alle " + rOra;
            
            var line = nomePaziente + "|NOTE_LOG|" + dataNota + "|" + testoNota + "|---|---|---|---|---|---|---";
            
            try {
                var f = fso.OpenTextFile(dataFile, 8); // Append
                f.WriteLine(SanitizeForFSO(line));
                f.Close();
                
                if (!patientNotes[nomePaziente]) patientNotes[nomePaziente] = [];
                patientNotes[nomePaziente].push({ date: dataNota, text: testoNota });
                
                ChiudiModalReminder();
                RiproduciSuono("notify");
                AggiungiAttivita(actionLogged);
                
                var cardSelected = document.querySelector(".item-card.active");
                if (cardSelected) {
                    cardSelected.click();
                }
                
                if (campaignState.active) {
                    GiroProssimo();
                }
            } catch(e) {
                alert("Errore nel salvataggio del promemoria: " + e.message);
            }
        }

        function EliminaNotaDiario(noteIndex) {
            var nome = window.activePatientName;
            if (!nome || nome === "" || nome.indexOf("---") > -1) return;
            
            var notes = patientNotes[nome] || [];
            var noteIndexInt = parseInt(noteIndex, 10);
            if (isNaN(noteIndexInt) || noteIndexInt < 0 || noteIndexInt >= notes.length) {
                alert("Indice nota non valido.");
                return;
            }
            
            var targetNote = notes[noteIndexInt];
            var dataNota = targetNote.date;
            var testoNotaRaw = targetNote.text;
            
            if (!confirm("Sei sicuro di voler eliminare definitivamente questa nota dal diario?")) {
                return;
            }
            
            try {
                var fRead = fso.OpenTextFile(dataFile, 1);
                var content = fRead.ReadAll();
                fRead.Close();
                
                var lines = content.split("\n");
                var updatedLines = [];
                var targetNomeClean = PulishNome(nome);
                var deleted = false;
                
                for (var i = 0; i < lines.length; i++) {
                    var line = lines[i];
                    if (line.trim() === "") continue;
                    var p = line.split("|");
                    
                    if (!deleted && p[1] === "NOTE_LOG" && PulishNome(p[0]) === targetNomeClean && p[2] === dataNota && p[3] === testoNotaRaw) {
                        deleted = true;
                        continue;
                    }
                    updatedLines.push(line);
                }
                
                var fWrite = fso.OpenTextFile(dataFile, 2, true);
                fWrite.Write(SanitizeForFSO(updatedLines.join("\n") + "\n"));
                fWrite.Close();
                
                // Rimuovi dalla memoria locale
                patientNotes[nome].splice(noteIndexInt, 1);
                
                RiproduciSuono("notify");
                AggiungiAttivita("??? NOTA ELIMINATA: Rimossa una nota dal diario di " + nome);
                
                var cardSelected = document.querySelector(".item-card.active");
                if (cardSelected) {
                    cardSelected.click();
                }
            } catch(e) {
                alert("Errore durante l'eliminazione della nota: " + e.message);
            }
        }

        var activeEditNote = {
            nome: "",
            dataNota: "",
            testoNotaRaw: "",
            prefix: "",
            noteIndex: -1
        };

        function ModificaNotaDiario(noteIndex) {
            var nome = window.activePatientName;
            if (!nome || nome === "" || nome.indexOf("---") > -1) return;
            
            var notes = patientNotes[nome] || [];
            var noteIndexInt = parseInt(noteIndex, 10);
            if (isNaN(noteIndexInt) || noteIndexInt < 0 || noteIndexInt >= notes.length) {
                alert("Indice nota non valido.");
                return;
            }
            
            var targetNote = notes[noteIndexInt];
            var dataNota = targetNote.date;
            var testoNotaRaw = targetNote.text;
            
            var cleanPlaceholder = testoNotaRaw;
            var prefix = "";
            if (testoNotaRaw.indexOf("[CONFERMATO]") === 0) { 
                prefix = "[CONFERMATO]"; 
                cleanPlaceholder = testoNotaRaw.substring(12).trim(); 
            } else if (testoNotaRaw.indexOf("[DA RICHIAMARE]") === 0) { 
                prefix = "[DA RICHIAMARE]"; 
                cleanPlaceholder = testoNotaRaw.substring(15).trim(); 
            } else if (testoNotaRaw.indexOf("[SQUILLA VUOTO]") === 0) { 
                prefix = "[SQUILLA VUOTO]"; 
                cleanPlaceholder = testoNotaRaw.substring(15).trim(); 
            } else if (testoNotaRaw.indexOf("[NUMERO ERRATO]") === 0) { 
                prefix = "[NUMERO ERRATO]"; 
                cleanPlaceholder = testoNotaRaw.substring(15).trim(); 
            } else if (testoNotaRaw.indexOf("[CONSEGNA]") === 0) { 
                prefix = "[CONSEGNA]"; 
                cleanPlaceholder = testoNotaRaw.substring(10).trim(); 
            } else if (testoNotaRaw.indexOf("[PROMEMORIA]") === 0) { 
                prefix = "[PROMEMORIA]"; 
                cleanPlaceholder = testoNotaRaw.substring(12).trim(); 
            }
            
            activeEditNote.nome = nome;
            activeEditNote.dataNota = dataNota;
            activeEditNote.testoNotaRaw = testoNotaRaw;
            activeEditNote.prefix = prefix;
            activeEditNote.noteIndex = noteIndexInt;
            
            document.getElementById("modificaNotaClienteNome").innerText = nome;
            document.getElementById("modificaNotaData").innerText = dataNota;
            document.getElementById("txtModificaNotaTesto").value = cleanPlaceholder;
            
            // Inline toggling!
            document.getElementById("diarioSezioneTimeline").style.display = "none";
            document.getElementById("diarioSezioneModifica").style.display = "block";
            
            setTimeout(function() {
                var txtArea = document.getElementById("txtModificaNotaTesto");
                try {
                    txtArea.focus();
                    txtArea.select();
                } catch(err) {}
            }, 100);
        }

        function ChiudiModalModificaNota() {
            document.getElementById("diarioSezioneTimeline").style.display = "block";
            document.getElementById("diarioSezioneModifica").style.display = "none";
        }

        function SalvaModificaNotaCustom() {
            var nome = activeEditNote.nome;
            var dataNota = activeEditNote.dataNota;
            var testoNotaRaw = activeEditNote.testoNotaRaw;
            var prefix = activeEditNote.prefix;
            var noteIndexInt = activeEditNote.noteIndex;
            
            var nuovoTesto = document.getElementById("txtModificaNotaTesto").value.trim();
            
            if (nuovoTesto === "") {
                ChiudiModalModificaNota();
                EliminaNotaDiario(noteIndexInt);
                return;
            }
            
            var testoNotaNuovo = prefix !== "" ? prefix + " " + nuovoTesto : nuovoTesto;
            
            try {
                var fRead = fso.OpenTextFile(dataFile, 1);
                var content = fRead.ReadAll();
                fRead.Close();
                
                var lines = content.split("\n");
                var updatedLines = [];
                var targetNomeClean = PulishNome(nome);
                var modified = false;
                
                for (var i = 0; i < lines.length; i++) {
                    var line = lines[i];
                    if (line.trim() === "") continue;
                    var p = line.split("|");
                    
                    if (!modified && p[1] === "NOTE_LOG" && PulishNome(p[0]) === targetNomeClean && p[2] === dataNota && p[3] === testoNotaRaw) {
                        p[3] = testoNotaNuovo.replace(/\|/g, " ");
                        modified = true;
                        line = p.join("|");
                    }
                    updatedLines.push(line);
                }
                
                var fWrite = fso.OpenTextFile(dataFile, 2, true);
                fWrite.Write(SanitizeForFSO(updatedLines.join("\n") + "\n"));
                fWrite.Close();
                
                // Aggiorna in locale
                if (patientNotes[nome] && patientNotes[nome][noteIndexInt]) {
                    patientNotes[nome][noteIndexInt].text = testoNotaNuovo;
                }
                
                ChiudiModalModificaNota();
                RiproduciSuono("notify");
                AggiungiAttivita("?? NOTA MODIFICATA: Aggiornato il diario di " + nome);
                
                var cardSelected = document.querySelector(".item-card.active");
                if (cardSelected) {
                    cardSelected.click();
                }
            } catch(e) {
                alert("Errore durante il salvataggio della modifica: " + e.message);
            }
        }

        function SelezionaClienteDaLista(targetNome) {
            var cards = document.getElementsByClassName("item-card");
            var targetPulito = PulishNome(targetNome);
            
            document.getElementById("txtCerca").value = targetNome;
            FiltraJS();
            
            for (var i = 0; i < cards.length; i++) {
                var cardName = cards[i].getAttribute("data-nome") || "";
                if (PulishNome(cardName) === targetPulito) {
                    cards[i].click();
                    cards[i].scrollIntoView();
                    break;
                }
            }
        }

        function StampaFoglioDiViaggio() {
            var listHTML = "";
            var count = 0;
            var patientDataMap = {};
            
            for (var i = 0; i < allData.length; i++) {
                var p = allData[i];
                var name = p[0].trim().toUpperCase();
                if (!patientDataMap[name]) {
                    patientDataMap[name] = {
                        name: name,
                        citta: p[5] || "---",
                        prov: p[6] || "",
                        nascita: p[7] || "---",
                        tel: p[9] || "---",
                        cell: p[10] || "---",
                        devices: []
                    };
                }
                if (p[1] !== "NESSUN AUSILIO" && p[1] !== "") {
                    var sep = SeparaNomeEISO(p[1]);
                    patientDataMap[name].devices.push(sep.name);
                }
            }
            
            for (var name in patientNotes) {
                var notes = patientNotes[name] || [];
                var deliveryNote = "";
                var isConfirmed = false;
                
                for (var idx = 0; idx < notes.length; idx++) {
                    var text = notes[idx].text;
                    if (text.indexOf("[CONSEGNA]") === 0) {
                        deliveryNote = text.substring(10).trim();
                    }
                    if (text.indexOf("[CONFERMATO]") === 0) {
                        isConfirmed = true;
                    }
                }
                
                // Estrae e accoda Post-it logistici o urgenti attivi del cliente
                var clientPostits = postitClienteData[name] || [];
                var postitLogNote = "";
                for (var pi = 0; pi < clientPostits.length; pi++) {
                    var pTesto = clientPostits[pi].testo;
                    var pUp = pTesto.toUpperCase();
                    if (pUp.indexOf("CONSEGNA") > -1 || pUp.indexOf("CORRIERE") > -1 || pUp.indexOf("PORTO") > -1 || pUp.indexOf("CAMION") > -1 || pUp.indexOf("URGENTE") > -1 || pUp.indexOf("CITOFONO") > -1 || pUp.indexOf("PIANO") > -1 || pUp.indexOf("ASCENSORE") > -1) {
                        if (postitLogNote !== "") postitLogNote += " | ";
                        postitLogNote += pTesto;
                    }
                }
                if (postitLogNote !== "") {
                    if (deliveryNote !== "") deliveryNote += " | ";
                    deliveryNote += "<div style='color:#ef4444; margin-top:4px; font-weight:900;'>?? [POST-IT]: " + postitLogNote + "</div>";
                }
                
                if (deliveryNote !== "" || isConfirmed) {
                    var pd = patientDataMap[name] || { name: name, citta: "---", prov: "", tel: "---", cell: "---", devices: [] };
                    count++;
                    var contacts = [];
                    if (pd.tel && pd.tel !== "---") contacts.push(pd.tel);
                    if (pd.cell && pd.cell !== "---") contacts.push(pd.cell);
                    var contactStr = contacts.join(" / ");
                    var devicesStr = pd.devices.length > 0 ? "� " + pd.devices.join("<br>� ") : "Nessun ausilio";
                    
                    listHTML += "<tr style='border-bottom: 1.5px solid #334155;'>" +
                               "  <td style='padding:12px; font-weight:900; text-transform:uppercase; font-size:13px; color:#1e3a8a;'>" + pd.name + "</td>" +
                               "  <td style='padding:12px; font-weight:700; font-size:12px; text-transform:uppercase;'>" + pd.citta + (pd.prov ? " (" + pd.prov + ")" : "") + "</td>" +
                               "  <td style='padding:12px; font-weight:700; font-size:12px; font-family:monospace;'>" + (contactStr || "---") + "</td>" +
                               "  <td style='padding:12px; font-size:11px; font-weight:700;'>" + devicesStr + "</td>" +
                               "  <td style='padding:12px; font-size:12px; font-weight:bold; color:#10b981;'>" + (deliveryNote || "<span style='color:#94a3b8; font-style:italic;'>Nessuna nota speciale</span>") + "</td>" +
                               "  <td style='padding:12px; width:130px; height:50px; border-left:1px dashed #cbd5e1; vertical-align:bottom; text-align:center; font-size:8px; color:#94a3b8; font-style:italic;'>Firma per ricevuta</td>" +
                               "</tr>";
                }
            }
            
            if (count === 0) {
                listHTML = "<tr><td colspan='6' style='padding:30px; text-align:center; color:#94a3b8; font-style:italic; font-size:14px;'>Nessuna consegna attiva o confermata in elenco.</td></tr>";
            }
            
            var dataOggi = new Date().toLocaleDateString() + " " + new Date().toLocaleTimeString();
            
            var html = 
                "<!-- saved from url=(0014)about:internet -->\n" +
                "<html><head><title>Foglio di Viaggio Logistica - " + new Date().toLocaleDateString() + "</title>" +
                "<style>" +
                "  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&display=swap');" +
                "  body { font-family: 'Outfit', sans-serif; background-color:#ffffff; margin: 30px; color:#0f172a; text-align:left; -webkit-print-color-adjust: exact; }" +
                "  .header-box { border-bottom: 4px solid #10b981; padding-bottom: 15px; margin-bottom: 20px; overflow:hidden; }" +
                "  .title { font-size:26px; font-weight:900; color:#10b981; text-transform:uppercase; margin:0; }" +
                "  table { width:100%; border-collapse:collapse; margin-top:15px; }" +
                "  th { background-color:#1e293b; color:#ffffff; font-weight:800; font-size:11px; text-transform:uppercase; padding:12px; text-align:left; border:1px solid #1e293b; }" +
                "  td { border:1px solid #e2e8f0; vertical-align:middle; }" +
                "</style>" +
                "</head>" +
                "<body onload='window.print();'>" +
                "  <div class='header-box'>" +
                "    <div style='float:left;'>" +
                "      <h1 style="display:none;">?? FOGLIO DI VIAGGIO & CONSEGNE ASL</h1>
" +
                "      <div style='font-size:11px; font-weight:bold; color:#64748b; text-transform:uppercase; margin-top:4px;'>Ufficio Logistica - Puglia Hub Territoriale</div>" +
                "    </div>" +
                "    <div style='float:right; text-align:right; padding-top:5px;'>" +
                "      <div style='font-size:12px; font-weight:800; color:#0f172a;'>OPERATORE: C. Milella</div>" +
                "      <div style='font-size:10px; font-weight:700; color:#64748b; margin-top:2px;'>Generato il: " + dataOggi + "</div>" +
                "    </div>" +
                "  </div>" +
                "  " +
                "  <p style='font-size:13px; font-weight:600; line-height:1.5; color:#475569;'>" +
                "    Caro collega, qui sotto trovi l'elenco completo delle consegne pianificate e confermate in ufficio. " +
                "    Per ciascun cliente sono riportati i contatti telefonici e le indicazioni stradali/citofoniche specifiche inserite a terminale. " +
                "    Fai firmare il cliente nell'apposito riquadro al momento del rilascio dell'ausilio." +
                "  </p>" +
                "  " +
                "  <table>" +
                "    <thead>" +
                "      <tr>" +
                "        <th>Destinatario</th>" +
                "        <th>Citt�</th>" +
                "        <th>Recapiti</th>" +
                "        <th>Ausili da consegnare</th>" +
                "        <th>Istruzioni per il collega</th>" +
                "        <th>Firma per ricevuta</th>" +
                "      </tr>" +
                "    </thead>" +
                "    <tbody>" +
                "      " + listHTML +
                "    </tbody>" +
                "  </table>" +
                "  " +
                "  <div style='margin-top:40px; border-top:1px dashed #cbd5e1; padding-top:15px; font-size:10px; text-align:center; font-weight:bold; text-transform:uppercase; color:#64748b;'>" +
                "    ASL COMMAND CENTER PLATINUM EDITION � GESTIONE LOGISTICA UFFICIO E STRADA" +
                "  </div>" +
                "</body></html>";
            
            try {
                var currentDir = fso.GetParentFolderName(dataFile);
                var tempPrintFile = fso.BuildPath(currentDir, "foglio_viaggio_temp.html");
                
                if (SalvaFileUTF8(tempPrintFile, html)) {
                    ApriInBrowserPredefinito(tempPrintFile);
                    AggiungiAttivita("?? Stampato Foglio di Viaggio con " + count + " consegne per il collega.");
                }
            } catch (ex) {
                alert("Errore nella generazione del file di stampa: " + ex.message);
            }
        }

        if (document.addEventListener) {
            document.addEventListener("mouseup", gestoreMouseUp, false);
            document.addEventListener("keydown", gestoreKeyDown, false);
            document.addEventListener("keypress", gestoreKeyPress, false);
        } else if (document.attachEvent) {
            document.attachEvent("onmouseup", gestoreMouseUp);
            document.attachEvent("onkeydown", gestoreKeyDown);
            document.attachEvent("onkeypress", gestoreKeyPress);
        }
    </script>

