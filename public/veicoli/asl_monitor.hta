        function EsportaExcel() {
            var csv = "Nome;Invalidita;Dispositivo;Data;Sblocco\n";
            for(var i=0; i<allData.length; i++) {
                var p = allData[i];
                if (p[2] && p[2] !== "NULL") {
                    var dS = new Date(new Date(p[2]).getFullYear() + 6, new Date(p[2]).getMonth(), new Date(p[2]).getDate());
                    if (new Date() > dS) csv += p[0] + ";" + p[4] + ";" + p[1] + ";" + p[2] + ";" + dS.toDateString() + "\n";
                }
            }
            var f = fso.CreateTextFile(fso.GetParentFolderName(dataFile) + "\\Idonei_Rinnovo.csv", true);
            f.Write(csv); f.Close();
            alert("File 'Idonei_Rinnovo.csv' creato!");
        }

        var filterState = { cat: "TUTTI", prov: "TUTTI", workflow: "TUTTI" };

        function SetFiltro(tipo, btn) {
            var group = btn.parentElement.children;
            for(var i=0; i<group.length; i++) group[i].className = "btn-filter";
            btn.className = "btn-filter active";
            var val = btn.getAttribute("data-val");
            filterState[tipo] = val;
            FiltraJS();
            
            var labelStato = val;
            if (val === "DA_CHIAMARE") labelStato = "Da Chiamare";
            if (val === "DA_RICHIAMARE") labelStato = "Da Richiamare";
            if (val === "DA_CONSEGNARE") labelStato = "Da Consegnare";
            
            var vocalText = tipo === "cat" ? "Filtro categoria impostato su " + val : 
                            tipo === "prov" ? "Filtro provincia impostato su " + val :
                            "Filtro stato gestione impostato su " + labelStato;
            Parla(vocalText);
        }

        function FiltraJS() {
            var txt = document.getElementById("txtCerca").value.trim().toUpperCase();
            var invF = filterState.cat;
            var provF = filterState.prov;
            var wfF = filterState.workflow;
            var hideDec = document.getElementById("chkNascondiDeceduti") ? document.getElementById("chkNascondiDeceduti").checked : true;
            var showOnlyWithPostit = document.getElementById("chkSoloConPostit") ? document.getElementById("chkSoloConPostit").checked : false;
            
            // Spezziamo la query di ricerca in singole parole per supportare la ricerca indipendente dall'ordine
            var searchWords = txt ? txt.split(/\s+/) : [];
            
            var cards = document.getElementsByClassName("item-card");
            for (var i = 0; i < cards.length; i++) {
                var iv = cards[i].getAttribute("data-inv") || "";
                var pr = cards[i].getAttribute("data-prov") || "";
                var nomeOriginal = cards[i].getAttribute("data-nome") || "";
                
                // Se dobbiamo nascondere i deceduti ed � deceduto, saltiamo e nascondiamo
                if (hideDec && iv.toUpperCase().indexOf("DECEDUTO") > -1) {
                    cards[i].style.display = "none";
                    continue;
                }
                
                // Se dobbiamo mostrare solo quelli con post-it ed il cliente non ne ha, lo nascondiamo
                if (showOnlyWithPostit) {
                    var postitPaziente = postitClienteData[nomeOriginal] || [];
                    if (postitPaziente.length === 0) {
                        cards[i].style.display = "none";
                        continue;
                    }
                }
                
                var matchSearch = true;
                var cittaOriginal = cards[i].getAttribute("data-citta") || "";
                var hasPulse = cards[i].getAttribute("data-pulse") === "true";
                var isMan = cards[i].getAttribute("data-manuale") === "true";
                
                var displayNome = nomeOriginal;
                var displayCitta = cittaOriginal;
                var displayInv = iv;

                if (searchWords.length > 0) {
                    var nomeUpper = nomeOriginal.toUpperCase();
                    var cittaUpper = cittaOriginal.toUpperCase();
                    var nascitaUpper = (cards[i].getAttribute("data-nascita") || "").toUpperCase();
                    var invUpper = iv.toUpperCase();
                    
                    var searchableText = nomeUpper + " " + cittaUpper + " " + pr.toUpperCase() + " " + nascitaUpper + " " + invUpper;
                    
                    // Controlliamo che OGNI singola parola cercata sia presente in almeno uno dei campi
                    for (var w = 0; w < searchWords.length; w++) {
                        if (searchableText.indexOf(searchWords[w]) === -1) {
                            matchSearch = false;
                            break;
                        }
                    }
                    
                    // Se c'� un match, evidenziamo le parole!
                    if (matchSearch) {
                        displayNome = EvidenziaParole(nomeOriginal, searchWords);
                        displayCitta = EvidenziaParole(cittaOriginal, searchWords);
                        displayInv = EvidenziaParole(iv, searchWords);
                    }
                }

                // Determine workflow status
                var notes = patientNotes[nomeOriginal] || [];
                var cardWf = "DA_CHIAMARE";
                var hasDeliveryNote = false;
                var isConfirmed = false;
                var hasReminder = false;
                
                for (var idx = 0; idx < notes.length; idx++) {
                    var noteText = notes[idx].text;
                    if (noteText.indexOf("[CONSEGNA]") === 0) {
                        hasDeliveryNote = true;
                    }
                    if (noteText.indexOf("[CONFERMATO]") === 0) {
                        isConfirmed = true;
                    }
                    if (noteText.indexOf("[DA RICHIAMARE]") === 0 || noteText.indexOf("[PROMEMORIA]") === 0) {
                        hasReminder = true;
                    }
                }
                
                if (hasDeliveryNote || isConfirmed) {
                    cardWf = "DA_CONSEGNARE";
                } else if (hasReminder) {
                    cardWf = "DA_RICHIAMARE";
                }
                
                var wfIcon = "??";
                var wfColor = "#64748b"; // slate
                if (cardWf === "DA_CONSEGNARE") {
                    wfIcon = "??";
                    wfColor = "#10b981"; // emerald
                } else if (cardWf === "DA_RICHIAMARE") {
                    wfIcon = "?";
                    wfColor = "#f59e0b"; // amber
                }
                
                var wfBadge = " <span style='background-color:" + wfColor + "; color:#0f172a; padding:1px 5px; border-radius:10px; font-size:9px; font-weight:bold; margin-left:4px; vertical-align:middle;'>" + wfIcon + "</span>";
                
                // Ricostruiamo l'HTML interno con le evidenziazioni dorate
                var pulseHTML = hasPulse ? "<span class='pulse'></span>" : "";
                var manualBadgeHTML = isMan ? " <span style='background-color: #10b981; color: #ffffff; padding: 2px 6px; border-radius: 4px; font-size: 8px; font-weight: 900; vertical-align: middle; margin-left: 5px;'>LOCALE ??</span>" : "";
                
                // Per evitare problemi con il substring che tronca i tag HTML, limitiamo la lunghezza dell'invalidit� solo se non � evidenziata
                var finalInvTag = displayInv;
                if (searchWords.length === 0 && finalInvTag.length > 15) {
                    finalInvTag = finalInvTag.substring(0, 15);
                }
                
                // Disegna puntina ?? se il cliente ha dei Post-it attivi
                var postits = postitClienteData[nomeOriginal] || [];
                var postitPinHTML = "";
                if (postits.length > 0) {
                    postitPinHTML = " <span style='color:#facc15; font-size:11px; margin-left:4px; vertical-align:middle; cursor:pointer;' title='Contiene " + postits.length + " Post-it'>??</span>";
                }
                
                cards[i].innerHTML = "<span class='name-main'>" + displayNome + manualBadgeHTML + wfBadge + postitPinHTML + "</span>" +
                                     "<span class='name-sub'>" + pulseHTML + displayCitta + (pr ? " (" + pr + ")" : "") + " | <span class='tag'>" + finalInvTag + "</span></span>";
                
                var matchInv = (invF === "TUTTI") || (invF === "DA DEFINIRE" && (iv === "DA DEFINIRE" || iv === "")) || (iv.indexOf(invF) > -1);
                var matchProv = (provF === "TUTTI") || (pr.indexOf(provF) > -1);
                var matchWf = (wfF === "TUTTI") || (cardWf === wfF);
                
                cards[i].style.display = (matchSearch && matchInv && matchProv && matchWf) ? "" : "none";
            }
            
            // Annuncio vocale dei risultati (con debounce per la ricerca da tastiera)
            if (window._filtraVoiceTimeout) clearTimeout(window._filtraVoiceTimeout);
            window._filtraVoiceTimeout = setTimeout(function() {
                var visibleCount = 0;
                var cards = document.getElementsByClassName("item-card");
                for (var i = 0; i < cards.length; i++) {
                    if (cards[i].style.display !== "none") {
                        visibleCount++;
                    }
                }
                var msg = "";
                if (visibleCount === 0) {
                    msg = "Nessun cliente trovato per i filtri selezionati.";
                } else if (visibleCount === 1) {
                    msg = "Trovato 1 cliente.";
                } else {
                    msg = "Trovati " + visibleCount + " clienti.";
                }
                Parla(msg);
            }, 600);
        }

        function NavigaListaClienti(direzione) {
            var cards = document.getElementById("listaClienti").getElementsByClassName("item-card");
            var visibleCards = [];
            for (var i = 0; i < cards.length; i++) {
                if (cards[i].style.display !== "none") {
                    visibleCards.push(cards[i]);
                }
            }
            if (visibleCards.length === 0) return;

            var activeEl = document.activeElement;
            var currentIndex = -1;
            for (var i = 0; i < visibleCards.length; i++) {
                if (visibleCards[i] === activeEl) {
                    currentIndex = i;
                    break;
                }
            }

            var nextIndex = -1;
            if (activeEl === document.getElementById("txtCerca")) {
                if (direzione === "GIU") {
                    nextIndex = 0;
                }
            } else if (currentIndex > -1) {
                if (direzione === "GIU") {
                    if (currentIndex < visibleCards.length - 1) {
                        nextIndex = currentIndex + 1;
                    }
                } else if (direzione === "SU") {
                    if (currentIndex > 0) {
                        nextIndex = currentIndex - 1;
                    } else {
                        // Focus back to search input
                        document.getElementById("txtCerca").focus();
                        return;
                    }
                }
            }

            if (nextIndex > -1) {
                visibleCards[nextIndex].focus();
                // Riproduci micro feedback sonoro
                RiproduciSuono("ding");
            }
        }

        function ConvertExcelDate(d) {
            if (!d) return null;
            if (typeof d === "string" && d.indexOf("/") > -1) {
                var pts = d.split("/"); if (pts.length === 3) {
                    var day = parseInt(pts[0], 10), mon = parseInt(pts[1], 10)-1, yr = parseInt(pts[2], 10);
                    if (yr < 100) yr += 2000;
                    var dt = new Date(yr, mon, day); if (!isNaN(dt.getTime())) return dt;
                }
            }
            var dt = new Date(d); if (!isNaN(dt.getTime()) && dt.getFullYear() > 1900) return dt;
            if (!isNaN(d) && d > 10000) return new Date(new Date(1899, 11, 30).getTime() + (d * 86400000));
            return null;
        }

        function ModificaPaziente() {
            var nomeOld = document.getElementById("mainNome").innerText;
            var cittaOld = document.getElementById("mainCitta").innerText;
            var nascitaOld = document.getElementById("mainNascita").innerText;
            var emailOld = document.getElementById("mainEmail").innerText;
            var telOld = document.getElementById("mainTel").innerText;
            var cellOld = document.getElementById("mainCell").innerText;
            var invOld = document.getElementById("mainBadge").innerText;
            
            var prov = "";
            var cOnly = cittaOld;
            var m = cittaOld.match(/\(([^)]+)\)/);
            if (m) {
                prov = m[1];
                cOnly = cittaOld.replace(/\s*\([^)]+\)/g, "").trim();
            }

            document.getElementById("editCitta").value = cOnly;
            document.getElementById("editProv").value = prov;
            var selectInv = document.getElementById("editInv");
            var foundInv = false;
            var searchVal = (invOld || "").toUpperCase().trim();
            for (var i = 0; i < selectInv.options.length; i++) {
                var optVal = selectInv.options[i].value.toUpperCase().trim();
                if (optVal === searchVal || optVal.indexOf(searchVal) > -1 || searchVal.indexOf(optVal) > -1) {
                    selectInv.selectedIndex = i;
                    foundInv = true;
                    break;
                }
            }
            if (!foundInv) {
                selectInv.selectedIndex = 4; // Default to "DA DEFINIRE"
            }
            document.getElementById("editNascita").value = nascitaOld;
            document.getElementById("editTel").value = (telOld === "---") ? "" : telOld;
            document.getElementById("editCell").value = (cellOld === "---") ? "" : cellOld;
            document.getElementById("editEmail").value = (emailOld === "---") ? "" : emailOld;
            try {
                document.getElementById("editFotoFile").value = "";
            } catch(ex) {
                try {
                    var input = document.getElementById("editFotoFile");
                    input.outerHTML = input.outerHTML;
                } catch(e) {}
            }

            // Mostra anteprima foto corrente se esiste nella modale
            tempBase64Photo = "";
            var previewImg = document.getElementById("photoPreviewImg");
            var placeholder = document.getElementById("photoPreviewPlaceholder");
            
            var localPhotoJpg = fso.BuildPath(appPath, "Foto_Clienti\\" + nomeOld.toUpperCase().trim() + ".jpg");
            var localPhotoPng = fso.BuildPath(appPath, "Foto_Clienti\\" + nomeOld.toUpperCase().trim() + ".png");
            var currentPhotoUrl = "";
            if (fso.FileExists(localPhotoJpg)) {
                currentPhotoUrl = "file:///" + localPhotoJpg.replace(/\\/g, "/") + "?t=" + new Date().getTime();
            } else if (fso.FileExists(localPhotoPng)) {
                currentPhotoUrl = "file:///" + localPhotoPng.replace(/\\/g, "/") + "?t=" + new Date().getTime();
            }
            
            if (currentPhotoUrl !== "") {
                previewImg.src = currentPhotoUrl;
                previewImg.style.display = "block";
                placeholder.style.display = "none";
            } else {
                previewImg.style.display = "none";
                placeholder.style.display = "block";
            }

            document.getElementById("editModalTitle").innerText = "Modifica Anagrafica - " + nomeOld;
            document.getElementById("modalEdit").style.display = "block";
            Parla("Modifica anagrafica di " + nomeOld + ".");
            document.getElementById("editCitta").focus();
        }

        function ChiudiModalEdit() {
            document.getElementById("modalEdit").style.display = "none";
        }

        function SalvaDatiModal() {
            var nomeOld = document.getElementById("mainNome").innerText;
            var nuovoCitta = document.getElementById("editCitta").value.trim();
            var nuovoProv = document.getElementById("editProv").value.trim().toUpperCase();
            var editInvEl = document.getElementById("editInv");
            var nuovaInv = editInvEl.options[editInvEl.selectedIndex].value;
            var nuovoNascita = document.getElementById("editNascita").value.trim();
            var nuovoTel = document.getElementById("editTel").value.trim();
            if (nuovoTel === "") nuovoTel = "---";
            var nuovoCell = document.getElementById("editCell").value.trim();
            if (nuovoCell === "") nuovoCell = "---";
            var nuovoEmail = document.getElementById("editEmail").value.trim();
            if (nuovoEmail === "") nuovoEmail = "---";
            
            var isManuale = document.getElementById("mainIsManuale").innerText === "true";
            var content = "";
            for(var i=0; i<allData.length; i++) {
                if (PulishNome(allData[i][0]) === PulishNome(nomeOld)) {
                    allData[i][5] = nuovoCitta;
                    allData[i][6] = nuovoProv;
                    allData[i][4] = nuovaInv;
                    allData[i][7] = nuovoNascita;
                    allData[i][8] = nuovoEmail;
                    allData[i][9] = nuovoTel;
                    allData[i][10] = nuovoCell;
                    if (isManuale) {
                        allData[i][11] = "MANUALE";
                    }
                }
                content += allData[i].join("|") + "\n";
            }
            // Gestione copia o salvataggio foto da Dropzone/Clipboard/Sfoglia (Base64)
            if (tempBase64Photo !== "") {
                try {
                    // Rileva estensione corretta (.png o .jpg) dal mime type del Base64
                    var ext = ".jpg";
                    if (tempBase64Photo.indexOf("image/png") !== -1) {
                        ext = ".png";
                    }
                    
                    var destPath = fso.BuildPath(appPath, "Foto_Clienti\\" + nomeOld.toUpperCase().trim() + ext);
                    
                    // Rimuove eventuali doppioni
                    var oldJpg = fso.BuildPath(appPath, "Foto_Clienti\\" + nomeOld.toUpperCase().trim() + ".jpg");
                    var oldPng = fso.BuildPath(appPath, "Foto_Clienti\\" + nomeOld.toUpperCase().trim() + ".png");
                    if (ext === ".png" && fso.FileExists(oldJpg)) {
                        try { fso.DeleteFile(oldJpg, true); } catch(ex) {}
                    } else if (ext === ".jpg" && fso.FileExists(oldPng)) {
                        try { fso.DeleteFile(oldPng, true); } catch(ex) {}
                    }
                    
                    SalvaBase64SuFile(tempBase64Photo, destPath);
                } catch(ex) {
                    alert("Errore nel salvataggio della foto: " + ex.message);
                }
            }

            try {
                var f = fso.CreateTextFile(dataFile, true);
                f.Write(SanitizeForFSO(content));
                f.Close();
                ChiudiModalEdit();
                RiproduciSuono("tada");
                alert("Anagrafica aggiornata con successo nel database!");
                AggiungiAttivita("?? ANAGRAFICA: Aggiornati dati anagrafici e categoria per " + nomeOld + " (" + nuovaInv.toUpperCase() + ")");
                CaricaArchivio();
                var targetPulito = PulishNome(nomeOld);
                var cards = document.getElementsByClassName("item-card");
                for (var i = 0; i < cards.length; i++) {
                    if (PulishNome(cards[i].getElementsByClassName("name-main")[0].innerText) === targetPulito) {
                        cards[i].click();
                        cards[i].scrollIntoView();
                        break;
                    }
                }
            } catch(e) { alert("Errore durante il salvataggio: " + e.message); }
        }

        function AvviaImport(path) {
            if (!path) return;
            
            var ext = path.split('.').pop().toLowerCase();
            if (ext === "csv") {
                try {
                    var f = fso.OpenTextFile(path, 1);
                    var txt = f.ReadAll();
                    f.Close();
                    
                    var lines = txt.split("\n");
                    var header = lines[0].split(";");
                    var aidH = [];
                    for(var c = 9; c < header.length; c++) {
                        var h = header[c].replace(/"/g, "").trim();
                        if (h !== "") aidH.push({ col: c, title: h });
                    }
                    var out = fso.CreateTextFile(dataFile, true);
                    var total = 0;
                    
                    for (var r = 1; r < lines.length; r++) {
                        var line = lines[r].replace(/\r/g, "").trim();
                        if (line === "") continue;
                        var pts = line.split(";");
                        if (pts.length < 3) continue;
                        
                        var valN = (pts[1] || "").replace(/"/g, "").trim();
                        if (!valN) continue;
                        
                        var inv = (pts[0] || "DA DEFINIRE").replace(/"/g, "").trim();
                        var citta = (pts[2] || "---").replace(/"/g, "").trim();
                        var prov = (pts[4] || "XX").replace(/"/g, "").trim();
                        var nascita = (pts[5] || pts[3] || "---").replace(/"/g, "").trim();
                        if (nascita === "") nascita = "---";
                        var email = (pts[6] || "---").replace(/"/g, "").trim();
                        if (email === "") email = "---";
                        var tel = (pts[7] || "---").replace(/"/g, "").trim();
                        if (tel === "") tel = "---";
                        var cell = (pts[8] || "---").replace(/"/g, "").trim();
                        if (cell === "") cell = "---";
                        
                        var found = false;
                        for (var i = 0; i < aidH.length; i++) {
                            if (aidH[i].col < pts.length) {
                                var dR = pts[aidH[i].col].replace(/"/g, "").trim();
                                var dt = ConvertExcelDate(dR);
                                if (dt) { out.WriteLine(valN + "|" + aidH[i].title + "|" + dt.toDateString() + "|---|" + inv + "|" + citta + "|" + prov + "|" + nascita + "|" + email + "|" + tel + "|" + cell); found = true; total++; }
                            }
                        }
                        if (!found) { out.WriteLine(valN + "|NESSUN AUSILIO|NULL|---|" + inv + "|" + citta + "|" + prov + "|" + nascita + "|" + email + "|" + tel + "|" + cell); total++; }
                    }
                    out.Close();
                    CaricaArchivio();
                    Parla("Database aggiornato con successo!");
                    alert("DATABASE AGGIORNATO DA CSV ISTANTANEAMENTE!");
                } catch(e) { alert("ERRORE CSV: " + e.message); }
                return;
            }

            var xlApp = null, f = null;
            try {
                xlApp = new ActiveXObject("Excel.Application");
                xlApp.DisplayAlerts = false;
                var xlBook = xlApp.Workbooks.Open(path);
                var xlSheet = null;
                for (var s = 1; s <= xlBook.Worksheets.Count; s++) {
                    if (String(xlBook.Worksheets.Item(s).Name).toUpperCase().indexOf("ALFABETICO") > -1) {
                        xlSheet = xlBook.Worksheets.Item(s); break;
                    }
                }
                if (!xlSheet) xlSheet = xlBook.Worksheets.Item(1);
                f = fso.CreateTextFile(dataFile, true);
                var total = 0;
                var aidH = [];
                for (var c = 10; c <= 75; c++) {
                    var h = String(xlSheet.Cells.Item(1, c).Text || "").trim();
                    if (h !== "") aidH.push({ col: c, title: h });
                }
                var emp = 0;
                for (var r = 2; r < 60000; r++) {
                    var valN = xlSheet.Cells.Item(r, 2).Text;
                    if (!valN || String(valN).trim() === "") { if (++emp > 200) break; continue; }
                    emp = 0;
                    var nome = String(valN).toUpperCase().trim();
                    var inv = String(xlSheet.Cells.Item(r, 1).Text || "DA DEFINIRE").trim();
                    var citta = String(xlSheet.Cells.Item(r, 3).Text || "---").trim();
                    var prov = String(xlSheet.Cells.Item(r, 5).Text || "XX").trim();
                    var nascita = String(xlSheet.Cells.Item(r, 6).Text || xlSheet.Cells.Item(r, 4).Text || "---").trim();
                    if (nascita === "") nascita = "---";
                    var email = String(xlSheet.Cells.Item(r, 7).Text || "---").trim();
                    if (email === "") email = "---";
                    var tel = String(xlSheet.Cells.Item(r, 8).Text || "---").trim();
                    if (tel === "") tel = "---";
                    var cell = String(xlSheet.Cells.Item(r, 9).Text || "---").trim();
                    if (cell === "") cell = "---";
                    
                    var found = false;
                    for (var i = 0; i < aidH.length; i++) {
                        var dR = xlSheet.Cells.Item(r, aidH[i].col).Text;
                        var dt = ConvertExcelDate(dR);
                        if (dt) { f.WriteLine(nome + "|" + aidH[i].title + "|" + dt.toDateString() + "|---|" + inv + "|" + citta + "|" + prov + "|" + nascita + "|" + email + "|" + tel + "|" + cell); found = true; total++; }
                    }
                    if (!found) { f.WriteLine(nome + "|NESSUN AUSILIO|NULL|---|" + inv + "|" + citta + "|" + prov + "|" + nascita + "|" + email + "|" + tel + "|" + cell); total++; }
                }
                if (f) f.Close(); xlBook.Close(false); xlApp.Quit();
                CaricaArchivio();
                Parla("Database aggiornato con successo!");
                alert("DATABASE AGGIORNATO!");
            } catch(e) { if (xlApp) xlApp.Quit(); alert("ERRORE: " + e.message); }
        }

        function AutoFormattaData(input) {
            var val = input.value.replace(/\D/g, "");
            if (val.length > 8) val = val.substring(0, 8);
            var formatted = val;
            if (val.length > 4) {
                formatted = val.substring(0, 2) + "/" + val.substring(2, 4) + "/" + val.substring(4);
            } else if (val.length > 2) {
                formatted = val.substring(0, 2) + "/" + val.substring(2);
            }
            input.value = formatted;
        }

        var tempDevPatient = "";
        var tempDevFullName = "";
        var tempDevDate = "";

        function SeparaNomeEISO(fullName) {
            var match = fullName.match(/\b\d{2}\.\d{2}\.\d{2}\.\d{3}\b/);
            if (match) {
                var code = match[0];
                var name = fullName.replace(code, "").trim();
                return { name: name, code: code };
            } else {
                return { name: fullName.trim(), code: "" };
            }
        }

        function ModificaCodiceDispositivo(pNome, pFullName, pDate) {
            tempDevPatient = decodeURIComponent(pNome);
            tempDevFullName = decodeURIComponent(pFullName);
            tempDevDate = decodeURIComponent(pDate);

            var sep = SeparaNomeEISO(tempDevFullName);
            document.getElementById("devCodeArticolo").innerText = sep.name;
            document.getElementById("devCodeInput").value = sep.code;

            document.getElementById("modalDeviceCode").style.display = "block";
            document.getElementById("devCodeInput").focus();
        }

        function ChiudiModalDeviceCode() {
            document.getElementById("modalDeviceCode").style.display = "none";
        }

        function MostraModalScorciatoie() {
            document.getElementById("modalScorciatoie").style.display = "block";
            Parla("Apertura finestra scorciatoie da tastiera.");
            setTimeout(function() {
                try { document.getElementById("titleScorciatoie").focus(); } catch(e) {}
            }, 100);
        }
        function ChiudiModalScorciatoie() {
            document.getElementById("modalScorciatoie").style.display = "none";
            Parla("Chiusura finestra.");
        }
        function MostraModalInfo() {
            document.getElementById("modalInfo").style.display = "block";
            Parla("Apertura finestra informazioni.");
            setTimeout(function() {
                try { document.getElementById("titleInfo").focus(); } catch(e) {}
            }, 100);
        }
        function ChiudiModalInfo() {
            document.getElementById("modalInfo").style.display = "none";
            Parla("Chiusura finestra.");
        }

        function SalvaCodiceDispositivo() {
            var newCode = document.getElementById("devCodeInput").value.trim();
            var sep = SeparaNomeEISO(tempDevFullName);
            var newFullName = sep.name;
            if (newCode !== "") {
                newFullName += " " + newCode;
            }

            try {
                if (fso.FileExists(dataFile)) {
                    var fRead = fso.OpenTextFile(dataFile, 1);
                    var content = fRead.ReadAll();
                    fRead.Close();

                    var lines = content.split("\n");
                    var updatedLines = [];
                    var matchCount = 0;

                    for (var i = 0; i < lines.length; i++) {
                        var line = lines[i];
                        if (line.trim() === "") continue;
                        var p = line.split("|");
                        if (p[0].trim().toUpperCase() === tempDevPatient.toUpperCase() &&
                            p[1].trim() === tempDevFullName.trim() &&
                            p[2].trim() === tempDevDate.trim()) {
                            
                            p[1] = newFullName;
                            matchCount++;
                        }
                        updatedLines.push(p.join("|"));
                    }

                    if (matchCount > 0) {
                        var fWrite = fso.OpenTextFile(dataFile, 2, true);
                        fWrite.Write(SanitizeForFSO(updatedLines.join("\n") + "\n"));
                        fWrite.Close();

                        ChiudiModalDeviceCode();
                        CaricaArchivio();
                        
                        // Ricarica la scheda del cliente corrente per mostrare subito le modifiche
                        var activeNome = document.getElementById("mainNome").innerText;
                        var cards = document.getElementsByClassName("item-card");
                        for (var i = 0; i < cards.length; i++) {
                            var cardName = cards[i].getElementsByClassName("name-main")[0].innerText;
                            if (cardName.trim().toUpperCase() === activeNome.trim().toUpperCase()) {
                                cards[i].click();
                                break;
                            }
                        }

                        Parla("Codice articolo salvato correttamente!");
                        alert("CODICE DISPOSITIVO AGGIORNATO CON SUCCESSO!");
                    } else {
                        alert("Impossibile trovare la riga corrispondente nel database.");
                    }
                }
            } catch(e) {
                alert("Errore nel salvataggio del codice: " + e.message);
            }
        }

        // Lettura automatica del testo evidenziato con il mouse
        var gestoreMouseUp = function(e) {
            try {
                e = e || window.event;
                var target = e.target || e.srcElement;
                
                // Evita di riprodurre se il click/rilascio � avvenuto sulla lista dei pazienti o su controlli/bottoni
                var node = target;
                while (node) {
                    if (node.id === "listaClienti" || node.className === "header" || node.tagName === "BUTTON" || node.tagName === "INPUT" || node.tagName === "SELECT") {
                        return;
                    }
                    node = node.parentNode;
                }

                var text = "";
                if (window.getSelection) {
                    text = window.getSelection().toString().trim();
                } else if (document.selection && document.selection.type === "Text") {
                    text = document.selection.createRange().text.trim();
                }
                // Legge solo se � una vera e propria frase (almeno 3 caratteri)
                if (text.length > 2 && text.length < 500) {
                    Parla(text);
                }
            } catch(err) {}
        };
        
        var echoTimeout = null;

        var gestoreKeyDown = function(e) {
            try {
                e = e || window.event;
                var target = e.target || e.srcElement;
                var keyCode = e.keyCode || e.which;
                // Tasto F10 per Assistente Vocale del Mattino (Daily Briefing)
                if (keyCode === 121) {
                    if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                    EseguiBriefingGiornaliero();
                    return false;
                }

                // CRM Easy Touch (Tasti da 1 a 5 per esiti chiamata)
                if (target && target.tagName !== "INPUT" && target.tagName !== "TEXTAREA") {
                    var crmHandled = GestisciTastiRapidiCrm(keyCode, e);
                    if (crmHandled) return false;
                }

                // Tasti Freccia per lo scorrimento dei clienti
                if (keyCode === 40) { // Freccia Gi�
                    if (target.id === "txtCerca" || (target.className && target.className.indexOf("item-card") > -1)) {
                        if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                        NavigaListaClienti("GIU");
                        return false;
                    }
                }
                if (keyCode === 38) { // Freccia Su
                    if (target.className && target.className.indexOf("item-card") > -1) {
                        if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                        NavigaListaClienti("SU");
                        return false;
                    }
                }

                // Scorciatoia globale Ctrl + F per la Ricerca Cliente
                if (e.ctrlKey && keyCode === 70) {
                    if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                    FermaVoce();
                    var searchInput = document.getElementById("txtCerca");
                    if (searchInput) {
                        searchInput.value = "";
                        searchInput.focus();
                        Parla("Ricerca cliente attiva. Digita per cercare e premi freccia gi� per scorrere la lista.");
                    }
                    return false;
                }

                // Tasto ESCAPE: Chiude i modali aperti oppure, se nessuno � aperto, esce dall'applicazione
                if (keyCode === 27) {
                    if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                    FermaVoce();
                    var modalEdit = document.getElementById("modalEdit");
                    var modalAddNote = document.getElementById("modalAddNote");
                    var modalAddClient = document.getElementById("modalAddClient");
                    var modalAssignAid = document.getElementById("modalAssignAid");
                    var modalDeviceCode = document.getElementById("modalDeviceCode");
                    var modalScorciatoie = document.getElementById("modalScorciatoie");
                    var modalInfo = document.getElementById("modalInfo");
                    if (modalEdit && modalEdit.style.display === "block") {
                        ChiudiModalEdit();
                    } else if (modalAddNote && modalAddNote.style.display === "block") {
                        ChiudiModalAddNote();
                    } else if (modalAddClient && modalAddClient.style.display === "block") {
                        ChiudiModalAddClient();
                    } else if (modalAssignAid && modalAssignAid.style.display === "block") {
                        ChiudiModalAssignAid();
                    } else if (modalDeviceCode && modalDeviceCode.style.display === "block") {
                        ChiudiModalDeviceCode();
                    } else if (modalScorciatoie && modalScorciatoie.style.display === "block") {
                        ChiudiModalScorciatoie();
                    } else if (modalInfo && modalInfo.style.display === "block") {
                        ChiudiModalInfo();
                    } else {
                        window.close();
                    }
                    return false;
                }

                // Scorciatoie da tastiera globali:
                // - F11 oppure Alt + D per FIRMA E TIMESTAMP APPUNTI
                if (keyCode === 122 || (e.altKey && keyCode === 68)) {
                    if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                    InserisciFirmaAppunti();
                    return false;
                }

                // - F12 oppure Alt + L per LEGGERE VOCALE GLI APPUNTI
                if (keyCode === 123 || (e.altKey && keyCode === 76)) {
                    if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                    LeggiVocaleAppunti();
                    return false;
                }

                // - F2 oppure Ctrl + Spazio oppure Alt + R per RIPETERE l'ultima lettura vocale
                if (keyCode === 113 || (e.ctrlKey && keyCode === 32) || (e.altKey && keyCode === 82)) {
                    if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                    FermaVoce();
                    RipetiLetturaAttiva();
                    return false;
                }

                // - Alt + N o F3 per REGISTRARE UN NUOVO CLIENTE
                if ((e.altKey && keyCode === 78) || keyCode === 114) {
                    if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                    FermaVoce();
                    ApriModalNuovoCliente();
                    return false;
                }

                // - Alt + M o F4 per MODIFICARE il cliente correntemente selezionato
                if ((e.altKey && keyCode === 77) || keyCode === 115) {
                    if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                    FermaVoce();
                    var nomeOld = document.getElementById("mainNome") ? document.getElementById("mainNome").innerText : "";
                    if (nomeOld && nomeOld.trim() !== "" && nomeOld.indexOf("---") === -1 && nomeOld.indexOf("SELEZIONA") === -1) {
                        ModificaPaziente();
                    } else {
                        Parla("Nessun cliente selezionato.");
                    }
                    return false;
                }

                // - Alt + E o F7 per ESPORTARE in Excel
                if ((e.altKey && keyCode === 69) || keyCode === 118) {
                    if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                    FermaVoce();
                    EsportaExcel();
                    return false;
                }

                // - Alt + S o F8 per STAMPARE la scheda
                if ((e.altKey && keyCode === 83) || keyCode === 119) {
                    if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                    FermaVoce();
                    StampaScheda();
                    return false;
                }

                // - Alt + L per STAMPARE l'etichetta logistica box
                if (e.altKey && keyCode === 76) {
                    if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                    FermaVoce();
                    StampaEtichettaLogistica();
                    return false;
                }

                // - Alt + C per visualizzare il registro attivit� console
                if (e.altKey && keyCode === 67) {
                    if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                    FermaVoce();
                    document.getElementById("boxEmpty").style.display = "block";
                    document.getElementById("boxMain").style.display = "none";
                    SetZenithTab("tabConsole");
                    Parla("Visualizzazione console di registro attivit�.");
                    return false;
                }

                // - Alt + T o F9 per avviare/fermare il Giro Telefonate
                if ((e.altKey && keyCode === 84) || keyCode === 120) {
                    if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                    FermaVoce();
                    ToggleGiroTelefonate();
                    return false;
                }

                // Navigazione tastiera del giro telefonate con Freccia Sinistra / Freccia Destra
                if (typeof campaignState !== "undefined" && campaignState.active && target && target.tagName !== "INPUT" && target.tagName !== "TEXTAREA") {
                    if (keyCode === 37) { // Freccia Sinistra
                        if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                        GiroPrec();
                        return false;
                    }
                    if (keyCode === 39) { // Freccia Destra
                        if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
                        GiroProssimo();
                        return false;
                    }
                }

                // Cancella il timeout precedente se l'utente continua a digitare
                if (echoTimeout) {
                    clearTimeout(echoTimeout);
                    echoTimeout = null;
                }
                
                // Qualsiasi tasto premuto zittisce immediatamente la sintesi vocale corrente
                FermaVoce();
                
                // Gestione tasti speciali per la digitazione assistita
                if (target && (target.tagName === "INPUT" && target.type === "text" || target.tagName === "TEXTAREA")) {
                    var keyCode = e.keyCode || e.which;
                    
                    if (keyCode === 8) { // Backspace
                        Parla("cancella");
                    } else if (keyCode === 46) { // Canc
                        Parla("elimina");
                    } else if (keyCode === 32) { // Spazio
                        Parla("spazio");
                    }
                    
                    // Avvia un timer: se l'utente si ferma per 900ms, legge l'intero testo inserito
                    echoTimeout = setTimeout(function() {
                        try {
                            if (document.activeElement === target) {
                                var val = target.value;
                                if (val && val.trim() !== "") {
                                    Parla("Testo inserito: " + val);
                                }
                            }
                        } catch(ex) {}
                    }, 900);
                }
            } catch(err) {}
        };
        
        var gestoreKeyPress = function(e) {
            try {
                e = e || window.event;
                var target = e.target || e.srcElement;
                
                // Pronuncia la lettera digitata nei campi di testo
                if (target && (target.tagName === "INPUT" && target.type === "text" || target.tagName === "TEXTAREA")) {
                    var charCode = e.charCode || e.keyCode;
                    if (charCode && charCode !== 13 && charCode !== 32) { // Escludiamo Invio e Spazio
                        var charStr = String.fromCharCode(charCode);
                        Parla(charStr);
                    }
                }
            } catch(err) {}
        };
        
        // ==========================================
        // NICOLA CALL CENTER CAMPAIGN LOGIC
        // ==========================================
        var campaignState = {
            active: false,
            queue: [],
            currentIndex: -1
        };

        function ToggleGiroTelefonate() {
            if (campaignState.active) {
                DisattivaGiroTelefonate();
            } else {
                AttivaGiroTelefonate();
            }
        }

        function AttivaGiroTelefonate() {
            FermaVoce();
            var listEl = document.getElementById("listaClienti");
            if (!listEl) return;
            
            var cards = listEl.getElementsByClassName("item-card");
            var queue = [];
            
            for (var i = 0; i < cards.length; i++) {
                var card = cards[i];
                if (card.style.display !== "none") {
                    var isDeceduto = card.getAttribute("data-inv") && card.getAttribute("data-inv").indexOf("DECEDUTO") !== -1;
                    var hasPulse = card.getAttribute("data-pulse") === "true";
                    
                    // Controlla diritti nomenclatore non riscattati
                    var hasUnclaimed = false;
                    var pName = card.getAttribute("data-nome") || "";
                    var pInv = card.getAttribute("data-inv") || "";
                    
                    // Trova tutti gli ausili erogati
                    var delivered = {};
                    for (var j = 0; j < allData.length; j++) {
                        if (allData[j][0] && PulishNome(allData[j][0]) === PulishNome(pName)) {
                            var dev = (allData[j][1] || "").trim().toUpperCase();
                            if (dev && dev !== "---") {
                                delivered[dev] = true;
                            }
                        }
                    }
                    
                    // Verifica regole nomenclatore
                    if (pInv.indexOf("CIECO") !== -1) {
                        if (!delivered["DISPLAY BRAILLE"] || !delivered["SINTESI VOCALE"] || !delivered["DAISY PLAYER"]) {
                            hasUnclaimed = true;
                        }
                    } else if (pInv.indexOf("IPOVEDENTE") !== -1) {
                        if (!delivered["VIDEOINGRANDITORE"] || !delivered["MACCHINA DI LETTURA"] || !delivered["SCREEN READER"]) {
                            hasUnclaimed = true;
                        }
                    }
                    
                    if (!isDeceduto && (hasPulse || hasUnclaimed)) {
                        queue.push(card);
                    }
                }
            }
            
            if (queue.length === 0) {
                Parla("Nessun cliente idoneo da chiamare con i filtri correnti.");
                alert("Nessun cliente idoneo trovato con allarmi attivi o diritti nomenclatore da riscattare!");
                return;
            }
            
            campaignState.active = true;
            campaignState.queue = queue;
            campaignState.currentIndex = 0;
            
            // Mostra elementi grafici della campagna
            document.getElementById("campaignBar").style.display = "block";
            document.getElementById("callOutcomesPanel").style.display = "block";
            
            // Pulsante sidebar
            var btnToggle = document.getElementById("btnCampaignToggle");
            if (btnToggle) {
                btnToggle.style.backgroundColor = "#ef4444";
                btnToggle.style.borderColor = "#f87171";
                btnToggle.innerHTML = "?? FERMA GIRO [F9]";
            }
            
            RiproduciSuono("notify");
            Parla("Giro telefonate avviato. Trovati " + queue.length + " clienti da chiamare.");
            
            CaricaPazienteInGiro();
        }

        function DisattivaGiroTelefonate() {
            campaignState.active = false;
            campaignState.queue = [];
            campaignState.currentIndex = -1;
            
            document.getElementById("campaignBar").style.display = "none";
            document.getElementById("callOutcomesPanel").style.display = "none";
            
            var btnToggle = document.getElementById("btnCampaignToggle");
            if (btnToggle) {
                btnToggle.style.backgroundColor = "#6366f1";
                btnToggle.style.borderColor = "#818cf8";
                btnToggle.innerHTML = "?? GIRO TELEFONATE [F9]";
            }
            
            RiproduciSuono("notify");
            Parla("Giro telefonate terminato.");
        }

        function CaricaPazienteInGiro() {
            if (campaignState.currentIndex < 0 || campaignState.currentIndex >= campaignState.queue.length) return;
            
            var card = campaignState.queue[campaignState.currentIndex];
            
            // Evidenzia visivamente la card
            var listEl = document.getElementById("listaClienti");
            if (listEl) {
                var cards = listEl.getElementsByClassName("item-card");
                for (var i = 0; i < cards.length; i++) {
                    cards[i].className = "item-card";
                }
            }
            card.className = "item-card active";
            try { card.scrollIntoView({ block: "nearest", behavior: "smooth" }); } catch(e) { card.scrollIntoView(true); }
            
            // Clicca per caricare
            card.click();
            
            // Aggiorna testo barra
            var progressText = document.getElementById("campaignProgressText");
            if (progressText) {
                progressText.innerText = "CONTATTO " + (campaignState.currentIndex + 1) + " DI " + campaignState.queue.length;
            }
        }

        function GiroPrec() {
            if (!campaignState.active) return;
            if (campaignState.currentIndex > 0) {
                campaignState.currentIndex--;
                RiproduciSuono("notify");
                CaricaPazienteInGiro();
            } else {
                Parla("Questo � il primo cliente in coda.");
            }
        }

        function GiroProssimo() {
            if (!campaignState.active) return;
            if (campaignState.currentIndex < campaignState.queue.length - 1) {
                campaignState.currentIndex++;
                RiproduciSuono("notify");
                CaricaPazienteInGiro();
            } else {
                Parla("Giro di telefonate completato con successo!");
                alert("Giro di telefonate completato! Ottimo lavoro!");
                DisattivaGiroTelefonate();
            }
        }

        // ==========================================
        // CRM CALL CENTER & CONTATTO TELEFONICO LOGIC
        // ==========================================
        function SelezionaCrmInterlocutore(ruolo) {
            crmInterlocutore = ruolo;
            
            var pillCliente = document.getElementById("pillIntCliente");
            var pillCaregiver = document.getElementById("pillIntCaregiver");
            var pillTutore = document.getElementById("pillIntTutore");
            
            if (pillCliente) { pillCliente.className = "crm-pill"; pillCliente.setAttribute("aria-checked", "false"); }
            if (pillCaregiver) { pillCaregiver.className = "crm-pill"; pillCaregiver.setAttribute("aria-checked", "false"); }
            if (pillTutore) { pillTutore.className = "crm-pill"; pillTutore.setAttribute("aria-checked", "false"); }
            
            var vocalRuolo = "Non definito";
            if (ruolo === "CLIENTE" && pillCliente) { 
                pillCliente.className = "crm-pill active-pos"; 
                pillCliente.setAttribute("aria-checked", "true"); 
                vocalRuolo = "Titolare";
            }
            if (ruolo === "CAREGIVER" && pillCaregiver) { 
                pillCaregiver.className = "crm-pill active-pos"; 
                pillCaregiver.setAttribute("aria-checked", "true"); 
                vocalRuolo = "Famiglia o Caregiver";
            }
            if (ruolo === "TUTORE" && pillTutore) { 
                pillTutore.className = "crm-pill active-pos"; 
                pillTutore.setAttribute("aria-checked", "true"); 
                vocalRuolo = "Tutore Legale";
            }
            
            FocusCampo("Interlocutore impostato su: " + vocalRuolo, null);
        }
        
        function SelezionaCrmStato104(stato) {
            crmStato104 = stato;
            
            var pillPossiede = document.getElementById("pill104Possiede");
            var pillInCorso = document.getElementById("pill104InCorso");
            var pillAssente = document.getElementById("pill104Assente");
            
            if (pillPossiede) { pillPossiede.className = "crm-pill"; pillPossiede.setAttribute("aria-checked", "false"); }
            if (pillInCorso) { pillInCorso.className = "crm-pill"; pillInCorso.setAttribute("aria-checked", "false"); }
            if (pillAssente) { pillAssente.className = "crm-pill"; pillAssente.setAttribute("aria-checked", "false"); }
            
            var vocalStato = "Non selezionato";
            if (stato === "SODDISFATTO" && pillPossiede) { 
                pillPossiede.className = "crm-pill active-pos"; 
                pillPossiede.setAttribute("aria-checked", "true"); 
                vocalStato = "Verbale posseduto, Idoneo";
            }
            if (stato === "IN_CORSO" && pillInCorso) { 
                pillInCorso.className = "crm-pill active-inc"; 
                pillInCorso.setAttribute("aria-checked", "true"); 
                vocalStato = "Accertamento in corso";
            }
            if (stato === "ASSENTE" && pillAssente) { 
                pillAssente.className = "crm-pill active-ass"; 
                pillAssente.setAttribute("aria-checked", "true"); 
                vocalStato = "Verbale assente, Non Idoneo";
