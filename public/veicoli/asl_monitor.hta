                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                    <h3 style="margin:0; font-size:12px; color:#fbbf24; text-transform:uppercase; letter-spacing:0.5px;">??? Registro Storico Post-it Completati (Archivio Permanent)</h3>
                    <button type="button" onclick="CaricaStoricoPostitArchiviati()" style="background:#1e293b; color:#fbbf24; border:1px solid #fbbf24; border-radius:6px; padding:3px 8px; font-size:9px; font-weight:800; cursor:pointer;" onmouseover="this.style.backgroundColor='#fbbf24'; this.style.color='#000';" onmouseout="this.style.backgroundColor='#1e293b'; this.style.color='#fbbf24';" onfocus="FocusCampo('Carica lo storico dei post-it dal disco', this)" tabindex="0">?? AGGIORNA LISTA</button>
                </div>
