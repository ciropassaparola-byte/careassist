    <!-- Modal Scorciatoie -->
    <div id="modalScorciatoie" class="modal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100%; height:100%; background-color:rgba(0,0,0,0.85); text-align:center; overflow-y:auto;">
        <div style="display:inline-block; vertical-align:middle; margin-top:80px; text-align:left; background-color:#1e293b; border: 2px solid #475569; border-radius:16px; padding:25px; width:520px; color:#f8fafc; font-family:'Outfit',sans-serif; box-shadow:0 25px 50px -12px rgba(0,0,0,0.75);">
            <h2 id="titleScorciatoie" tabindex="0" onfocus="FocusCampo('Finestra scorciatoie da tastiera. Premi Tab per navigare le voci.', this)" style="margin-top:0; color:#38bdf8; font-size:20px; border-bottom:1px solid #334155; padding-bottom:10px; font-weight:800; outline:none;">?? SCORCIATOIE DA TASTIERA</h2>
            <div style="max-height:300px; overflow-y:auto; margin-bottom:20px; font-weight:bold; font-size:13px; line-height:1.6;">
                <table style="width:100%; border-collapse:collapse;">
                    <tr tabindex="0" onfocus="FocusCampo('Tasto Escape. Chiude i modali oppure chiude l\'applicazione.', this)" style="border-bottom:1px solid #334155; outline:none;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='transparent';">
                        <td style="padding:8px 0; color:#38bdf8; width:140px; font-weight:900;">[Esc]</td>
                        <td style="padding:8px 0;">Chiude i modali / Chiude l'applicazione</td>
                    </tr>
                    <tr tabindex="0" onfocus="FocusCampo('Tasti F2 o Control Spazio o Alt R. Ripeti l\'ultima lettura vocale attiva.', this)" style="border-bottom:1px solid #334155; outline:none;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='transparent';">
                        <td style="padding:8px 0; color:#38bdf8; font-weight:900;">[F2] o [Ctrl+Spazio]</td>
                        <td style="padding:8px 0;">Ripeti l'ultima lettura vocale attiva</td>
                    </tr>
                    <tr tabindex="0" onfocus="FocusCampo('Tasti F3 o Alt N. Registra un Nuovo Cliente.', this)" style="border-bottom:1px solid #334155; outline:none;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='transparent';">
                        <td style="padding:8px 0; color:#38bdf8; font-weight:900;">[F3] o [Alt+N]</td>
                        <td style="padding:8px 0;">Registra un Nuovo Cliente</td>
                    </tr>
                    <tr tabindex="0" onfocus="FocusCampo('Tasti F4 o Alt M. Modifica l\'anagrafica del cliente selezionato.', this)" style="border-bottom:1px solid #334155; outline:none;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='transparent';">
                        <td style="padding:8px 0; color:#38bdf8; font-weight:900;">[F4] o [Alt+M]</td>
                        <td style="padding:8px 0;">Modifica l'anagrafica del cliente selezionato</td>
                    </tr>
                    <tr tabindex="0" onfocus="FocusCampo('Tasti F7 o Alt E. Esporta il database filtrato in formato Excel.', this)" style="border-bottom:1px solid #334155; outline:none;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='transparent';">
                        <td style="padding:8px 0; color:#38bdf8; font-weight:900;">[F7] o [Alt+E]</td>
                        <td style="padding:8px 0;">Esporta il database filtrato in formato Excel</td>
                    </tr>
                    <tr tabindex="0" onfocus="FocusCampo('Tasti F8 o Alt S. Stampa la scheda report del cliente selezionato.', this)" style="border-bottom:1px solid #334155; outline:none;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='transparent';">
                        <td style="padding:8px 0; color:#38bdf8; font-weight:900;">[F8] o [Alt+S]</td>
                        <td style="padding:8px 0;">Stampa la scheda report del cliente selezionato</td>
                    </tr>
                    <tr tabindex="0" onfocus="FocusCampo('Tasti F9 o Alt T. Avvia o ferma il giro telefonate automatico.', this)" style="border-bottom:1px solid #334155; outline:none;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='transparent';">
                        <td style="padding:8px 0; color:#38bdf8; font-weight:900;">[F9] o [Alt+T]</td>
                        <td style="padding:8px 0;">Avvia/Ferma il Giro Telefonate automatico</td>
                    </tr>
                    <tr tabindex="0" onfocus="FocusCampo('Tasto F10. Avvia l\'Assistente Vocale del Mattino per il resoconto completo.', this)" style="border-bottom:1px solid #334155; outline:none;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='transparent';">
                        <td style="padding:8px 0; color:#38bdf8; font-weight:900;">[F10]</td>
                        <td style="padding:8px 0;">Assistente Vocale Mattino (Briefing Giornaliero)</td>
                    </tr>
                    <tr tabindex="0" onfocus="FocusCampo('Tasti F11 o Alt D. Inserisce la firma timestamp con data, ora ed operatore corrente negli appunti.', this)" style="border-bottom:1px solid #334155; outline:none;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='transparent';">
                        <td style="padding:8px 0; color:#38bdf8; font-weight:900;">[F11] o [Alt+D]</td>
                        <td style="padding:8px 0;">Firma e Timestamp Appunti Condivisi</td>
                    </tr>
                    <tr tabindex="0" onfocus="FocusCampo('Tasti F12 o Alt L. S A P I recita a voce alta gli appunti del cliente selezionato.', this)" style="border-bottom:1px solid #334155; outline:none;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='transparent';">
                        <td style="padding:8px 0; color:#38bdf8; font-weight:900;">[F12] o [Alt+L]</td>
                        <td style="padding:8px 0;">Lettura Vocale degli Appunti del Cliente</td>
                    </tr>
                    <tr tabindex="0" onfocus="FocusCampo('Scorciatoie in casella appunti. Digita Control piu uno a cinque, oppure Control M, oppure Control P per inserire i chip rapidi.', this)" style="border-bottom:1px solid #334155; outline:none;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='transparent';">
                        <td style="padding:8px 0; color:#38bdf8; font-weight:900;">[Ctrl+1..5 / M / P]</td>
                        <td style="padding:8px 0;">Inserimento rapido chip in casella appunti</td>
                    </tr>
                    <tr tabindex="0" onfocus="FocusCampo('Tasti numerici da 1 a 5. Salvano l\'esito della telefonata VoIP all\'istante senza mouse.', this)" style="border-bottom:1px solid #334155; outline:none;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='transparent';">
                        <td style="padding:8px 0; color:#38bdf8; font-weight:900;">[1] a [5]</td>
                        <td style="padding:8px 0;">CRM Easy Touch (Registra esito chiamata istantaneamente)</td>
                    </tr>
                </table>
            </div>
            <div style="text-align:right;">
                <button onclick="ChiudiModalScorciatoie()" onfocus="FocusCampo('Chiudi finestra scorciatoie', this)" tabindex="0" style="background-color:#475569; color:white; border:none; padding:10px 22px; border-radius:8px; font-weight:bold; cursor:pointer; font-size:12px; text-transform:uppercase; letter-spacing:0.5px;">CHIUDI</button>
            </div>
        </div>
    </div>

    <!-- Modal Info -->
    <div id="modalInfo" class="modal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100%; height:100%; background-color:rgba(0,0,0,0.85); text-align:center; overflow-y:auto;">
        <div style="display:inline-block; vertical-align:middle; margin-top:60px; text-align:left; background-color:#1e293b; border: 2px solid #475569; border-radius:16px; padding:25px; width:650px; color:#f8fafc; font-family:'Outfit',sans-serif; box-shadow:0 25px 50px -12px rgba(0,0,0,0.75);">
            <h2 id="titleInfo" tabindex="0" onfocus="FocusCampo('Finestra Istruzioni e Guida all\'uso del Command Center.', this)" style="margin-top:0; color:#38bdf8; font-size:22px; border-bottom:2px solid #334155; padding-bottom:10px; font-weight:800; outline:none;">?? MANUALE E GUIDA OPERATIVA</h2>
            
            <div style="max-height:420px; overflow-y:auto; margin-bottom:20px; padding-right:10px; font-size:13px; line-height:1.6; color:#e2e8f0;">
                
                <!-- Presentazione Generale -->
                <div style="background-color:#0f172a; padding:15px; border-radius:10px; border:1px solid #1e293b; margin-bottom:15px;">
                    <b tabindex="0" onfocus="FocusCampo('ASL Command Center C. Milella. Manuale d\'uso completo della maschera gestionale.', this)" style="font-size:16px; color:#22c55e; outline:none; display:block; margin-bottom:5px;">ASL Command Center C. Milella</b>
                    <span tabindex="0" onfocus="FocusCampo('Questa guida descrive in dettaglio il funzionamento di ogni sezione e pannello dell\'applicazione per ottimizzare il tuo lavoro quotidiano.', this)" style="outline:none; display:block;">Benvenuto nel manuale d'uso completo. Questo software integra una sintesi vocale attiva (SAPI) per operatori non vedenti ed ipovedenti, controlli rapidi da tastiera ed un layout ad altissimo contrasto per garantire la massima ergonomia operativa.</span>
                </div>

                <!-- NUOVA SEZIONE: GUIDA AUDIO POST-IT & UTENZE (Chicca 4) -->
                <div style="background-color:#1e293b; padding:15px; border-radius:10px; border:2px solid #ef4444; margin-bottom:15px; box-shadow: 0 4px 6px -1px rgba(239, 68, 68, 0.2);">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; gap: 8px; flex-wrap:wrap;">
                        <b tabindex="0" onfocus="FocusCampo('Guida Audio Interattiva al Sistema Post-it e Bacheca.', this)" style="font-size:13px; color:#fbbf24; outline:none; text-transform:uppercase; letter-spacing:0.5px;">?? AUDIO GUIDA SISTEMA POST-IT (Vocal Reader)</b>
                        <button type="button" onclick="AvviaAudioGuidaManuale()" style="background:#ef4444; color:#fff !important; border:none; border-radius:12px; padding:6px 14px; font-size:10px; font-weight:800; cursor:pointer;" onmouseover="this.style.backgroundColor='#dc2626';" onmouseout="this.style.backgroundColor='#ef4444';" onfocus="FocusCampo('Clicca per far leggere ad alta voce la guida rapida dei Post-it', this)">?? LEGGI AD ALTA VOCE</button>
                    </div>
                    <span tabindex="0" onfocus="FocusCampo('Sezione rapida dei Post-it. Clicca il pulsante Leggi Guida per far recitare alla voce di sintesi tutte le istruzioni del nuovo sistema operativo.', this)" style="outline:none; display:block;">Clicca sul pulsante rosso per far **recitare alla sintesi vocale (SAPI)** del computer tutte le istruzioni operative del nuovo sistema di Post-it, l'auto-compilazione veloce, le etichette termiche e la bacheca! Puoi fermare l'audio in qualsiasi momento cliccando sul tasto ESC della tastiera o chiudendo questa finestra.</span>
                </div>

                <!-- Sezione 1: Barra dei Menu -->
                <div style="background-color:#0f172a; padding:15px; border-radius:10px; border:1px solid #1e293b; margin-bottom:15px;">
                    <b tabindex="0" onfocus="FocusCampo('Sezione uno. La Barra dei Menu superiore.', this)" style="font-size:14px; color:#38bdf8; outline:none; display:block; margin-bottom:6px;">?? 1. LA BARRA DEI MENU SUPERIORE</b>
                    <span tabindex="0" onfocus="FocusCampo('La barra dei menu si trova in cima allo schermo ed � organizzata in quattro categorie principali.', this)" style="outline:none; display:block; margin-bottom:5px;">� Posizionata nella parte superiore dello schermo, consente l'accesso rapido a tutte le funzioni principali tramite dropdown attivati al mouseover:</span>
                    <span tabindex="0" onfocus="FocusCampo('Menu File. Consente di importare dati Excel, sincronizzare il database e uscire dal programma.', this)" style="outline:none; display:block; margin-bottom:3px;">- <b>FILE</b>: Importa Excel, Sincronizzazione Master, Esci.</span>
                    <span tabindex="0" onfocus="FocusCampo('Menu Anagrafica. Consente di registrare un nuovo cliente, modificare la scheda attiva o eliminare record locali.', this)" style="outline:none; display:block; margin-bottom:3px;">- <b>ANAGRAFICA</b>: Registra Nuovo Cliente locale, Modifica Scheda attiva.</span>
                    <span tabindex="0" onfocus="FocusCampo('Menu Sintesi Vocale. Consente di attivare o disattivare la voce o regolare la velocit� di lettura.', this)" style="outline:none; display:block; margin-bottom:3px;">- <b>SINTESI VOCALE</b>: Attiva/Disattiva Audio, Regolazione della velocit� di lettura.</span>
                    <span tabindex="0" onfocus="FocusCampo('Menu Aiuto. Consente di aprire questa guida o visualizzare la legenda delle scorciatoie da tastiera.', this)" style="outline:none; display:block;">- <b>AIUTO</b>: Visualizza Legenda Tasti Rapidi, Apri questa Guida.</span>
                </div>

                <!-- Sezione 2: Ricerca e Filtri -->
                <div style="background-color:#0f172a; padding:15px; border-radius:10px; border:1px solid #1e293b; margin-bottom:15px;">
                    <b tabindex="0" onfocus="FocusCampo('Sezione due. Ricerca e Filtri Rapidi dei Clienti.', this)" style="font-size:14px; color:#38bdf8; outline:none; display:block; margin-bottom:6px;">?? 2. BARRA DI RICERCA & FILTRI ANAGRAFICA</b>
                    <span tabindex="0" onfocus="FocusCampo('Usa il campo di ricerca in alto a sinistra per trovare istantaneamente un cliente per nome, cognome, comune, o categoria.', this)" style="outline:none; display:block; margin-bottom:5px;">� <b>Ricerca Dinamica</b>: Digitando una qualsiasi parola nella barra di ricerca laterale sinistra, la lista clienti si aggiorna in tempo reale filtrando per Nome, Citt�, Provincia, o Categoria.</span>
                    <span tabindex="0" onfocus="FocusCampo('Il controllo Nascondi Deceduti consente di escludere i clienti deceduti dalla lista di lavoro.', this)" style="outline:none; display:block; margin-bottom:5px;">� <b>Nascondi Deceduti (Checkbox)</b>: Se abilitato, esclude automaticamente tutti i clienti contrassegnati come "DECEDUTO" dalla lista attiva e dai contatori. Questo ti permette di lavorare solo sui pazienti attivi.</span>
                    <span tabindex="0" onfocus="FocusCampo('I clienti deceduti rimangono comunque consultabili all\'interno del Registro Audit dedicato per agevolare il recupero di dispositivi preziosi.', this)" style="outline:none; display:block;">� <b>Registro Audit</b>: I deceduti vengono raccolti in una scheda separata ("Registro Audit"), facilitando l'amministrazione nella pianificazione del recupero di dispositivi ad alto costo.</span>
                </div>

                <!-- Sezione 3: Gold Identity Card -->
                <div style="background-color:#0f172a; padding:15px; border-radius:10px; border:1px solid #1e293b; margin-bottom:15px;">
                    <b tabindex="0" onfocus="FocusCampo('Sezione tre. Gold Identity Card e anagrafica cliente.', this)" style="font-size:14px; color:#38bdf8; outline:none; display:block; margin-bottom:6px;">?? 3. TESSERA SANITARIA "GOLD IDENTITY CARD"</b>
                    <span tabindex="0" onfocus="FocusCampo('La Gold Identity Card simula una tessera sanitaria elettronica e mostra tutti i dettagli del cliente attivo.', this)" style="outline:none; display:block; margin-bottom:5px;">� Visualizza in modo elegante tutti i dati anagrafici del paziente selezionato:</span>
                    <span tabindex="0" onfocus="FocusCampo('Mostra lo stato di invalidit� del cliente con colori dinamici. Rosso ad alto contrasto per i ciechi, azzurro per gli ipovedenti.', this)" style="outline:none; display:block; margin-bottom:3px;">- <b>Stato Invalidit�</b>: Indicato con colori dinamici (Rosso con altoparlante per CIECO, Azzurro con occhio per IPOVEDENTE).</span>
                    <span tabindex="0" onfocus="FocusCampo('Genera un codice identificativo univoco ed una firma in elegante carattere corsivo del titolare.', this)" style="outline:none; display:block; margin-bottom:3px;">- <b>Codice & Firma</b>: Genera automaticamente un codice identificativo ed una firma simulata in corsivo.</span>
                    <span tabindex="0" onfocus="FocusCampo('Rileva e mostra automaticamente la fotografia del paziente se presente nella cartella Foto Clienti.', this)" style="outline:none; display:block;">- <b>Fotografia Titolare</b>: Cerca e visualizza automaticamente la foto del cliente (file `.jpg` o `.png` col suo nome) presente nella cartella <i>Foto_Clienti</i>. Puoi caricarla anche trascinandola (Drag-and-Drop) o incollandola dagli appunti.</span>
                </div>

                <!-- Sezione 4: Diario Consegne e Note -->
                <div style="background-color:#0f172a; padding:15px; border-radius:10px; border:1px solid #1e293b; margin-bottom:15px;">
                    <b tabindex="0" onfocus="FocusCampo('Sezione quattro. Diario Consegne e Note Logistiche.', this)" style="font-size:14px; color:#38bdf8; outline:none; display:block; margin-bottom:6px;">?? 4. DIARIO LOGISTICO E TIMELINE DELLE NOTE</b>
                    <span tabindex="0" onfocus="FocusCampo('Il Diario mostra l\'elenco storico di tutte le consegne, note ed appunti logistici relativi al cliente.', this)" style="outline:none; display:block; margin-bottom:5px;">� Disposto in ordine cronologico sulla destra, mostra la timeline storica del paziente.</span>
                    <span tabindex="0" onfocus="FocusCampo('Cliccando su Aggiungi Nota si apre un modal integrato per registrare istantaneamente un nuovo appunto memorizzando la data corrente.', this)" style="outline:none; display:block;">� <b>Nuovo appunto logistico</b>: Cliccando su "Aggiungi Nota", un modal moderno ti permette di digitare una nota di consegna. Una volta salvata, viene inserita all'istante nel database e vocalizzata.</span>
                </div>

                <!-- Sezione 5: Nomenclatore e Ausili -->
                <div style="background-color:#0f172a; padding:15px; border-radius:10px; border:1px solid #1e293b; margin-bottom:15px;">
                    <b tabindex="0" onfocus="FocusCampo('Sezione cinque. Nomenclatore Ausili di Diritto.', this)" style="font-size:14px; color:#38bdf8; outline:none; display:block; margin-bottom:6px;">?? 5. NOMENCLATORE E BILANCIO "AUSILI DI DIRITTO"</b>
                    <span tabindex="0" onfocus="FocusCampo('Il programma aggancia automaticamente il nomenclatore nazionale corretto in base all\'invalidit� del cliente.', this)" style="outline:none; display:block; margin-bottom:5px;">� <b>Mappatura Automatica</b>: In base alla categoria del paziente, il sistema mostra gli ausili a cui ha diritto:</span>
                    <span tabindex="0" onfocus="FocusCampo('I ciechi hanno diritto a display braille, ocr autonomi, sintesi vocale, screen reader e bastoni bianchi.', this)" style="outline:none; display:block; margin-bottom:3px;">- <b>CIECHI</b>: Display Braille, Sintesi Vocale, Screen Reader, Sistema OCR, Bastone Bianco.</span>
                    <span tabindex="0" onfocus="FocusCampo('Gli ipovedenti hanno diritto a videoingranditori da tavolo o portatili, software ingrandente e lenti elettroniche.', this)" style="outline:none; display:block; margin-bottom:3px;">- <b>IPOVEDENTI</b>: Videoingranditore da Tavolo/Portatile, Software Ingrandente, Lente Elettronica.</span>
                    <span tabindex="0" onfocus="FocusCampo('Gli ausili in uso mostrano la data di fornitura, mentre quelli disponibili mostrano il pulsante verde Assegna Ora.', this)" style="outline:none; display:block; margin-bottom:3px;">- <b>Stato Fornitura</b>: Gli ausili gi� forniti mostrano il badge verde **`?? IN USO`** con la data originale; quelli non ancora richiesti mostrano **`? DISPONIBILE`** con il pulsante verde **`? ASSEGNA ORA`**.</span>
                    <span tabindex="0" onfocus="FocusCampo('Cliccando su Assegna Ora si registra all\'istante una nuova consegna nel database aggiornando subito la schermata.', this)" style="outline:none; display:block;">- <b>Assegnazione Istantanea</b>: Cliccando su "Assegna Ora", registri all'istante la fornitura dell'articolo con la data odierna. Il dispositivo si converte in "In Uso" e viene generata automaticamente una barra di sblocco per il rinnovo (durata 6 anni).</span>
                </div>

                <!-- Sezione 6: Conversione Bidirezionale -->
                <div style="background-color:#0f172a; padding:15px; border-radius:10px; border:1px solid #1e293b; margin-bottom:15px;">
                    <b tabindex="0" onfocus="FocusCampo('Sezione sei. Conversione clinica bidirezionale.', this)" style="font-size:14px; color:#38bdf8; outline:none; display:block; margin-bottom:6px;">?? 6. CONVERSIONE CLINICA BIDIREZIONALE (F4)</b>
                    <span tabindex="0" onfocus="FocusCampo('Il software gestisce le variazioni cliniche e gli aggravamenti in modo del tutto dinamico e bidirezionale.', this)" style="outline:none; display:block; margin-bottom:5px;">� Puoi convertire lo stato clinico di un paziente in qualsiasi direzione (es. da Ipovedente a Cieco per aggravamento, o viceversa per decorso clinico favorevole o innovazioni scientifiche):</span>
                    <span tabindex="0" onfocus="FocusCampo('Premi F4, seleziona lo stato invalidit� corretto nella casella a discesa e premi Salva Dati.', this)" style="outline:none; display:block; margin-bottom:5px;">� <b>Procedura</b>: Premi **`[F4]`** (Modifica), apri il menu a discesa *Stato Invalidit�*, seleziona la nuova categoria e premi *Salva Dati*.</span>
                    <span tabindex="0" onfocus="FocusCampo('L\'interfaccia si aggiorna istantaneamente ricalcolando il nomenclatore dei diritti, ma preserva intatto tutto lo storico delle consegne pregresse e delle note logistiche.', this)" style="outline:none; display:block;">� <b>Comportamento del software</b>: La Gold Card cambia colore immediatamente, il pannello inferiore sblocca all'istante il nuovo elenco di ausili spettanti, mentre **tutto lo storico delle consegne effettuate in passato e le note del diario rimangono intatti e protetti** nel database!</span>
                </div>

                <!-- Sezione 7: Regola Excel -->
                <div style="background-color:#0f172a; padding:15px; border-radius:10px; border:1px solid #1e293b; margin-bottom:15px;">
                    <b tabindex="0" onfocus="FocusCampo('Sezione sette. La regola delle colonne gialle del foglio Excel.', this)" style="font-size:14px; color:#38bdf8; outline:none; display:block; margin-bottom:6px;">?? 7. LA REGOLA DELLE COLONNE GIALLE (EXCEL)</b>
                    <span tabindex="0" onfocus="FocusCampo('All\'interno del file Excel importato, le colonne gialle a partire dalla colonna J indicano gli ausili disponibili con il loro codice ISO.', this)" style="outline:none; display:block; margin-bottom:5px;">� Le <b>colonne in colore giallo</b> (a partire dalla colonna J) indicano i singoli ausili del nomenclatore ed i rispettivi codici ISO.</span>
                    <span tabindex="0" onfocus="FocusCampo('Se la cella all\'incrocio con il cognome del cliente � vuota, il cliente non ha attualmente diritto a quell\'ausilio.', this)" style="outline:none; display:block; margin-bottom:5px;">� <b>Cella vuota</b>: Il cliente non ha usufruito o non possiede quel dispositivo.</span>
                    <span tabindex="0" onfocus="FocusCampo('Se la cella contiene una data, significa che il cliente ha ricevuto il dispositivo e la data corrisponde all\'ultima consegna.', this)" style="outline:none; display:block;">� <b>Cella con Data</b>: Il cliente ha ricevuto il dispositivo. La data rappresenta il giorno dell'ultima fornitura effettuata.</span>
                </div>

                <!-- Sezione 8: Sincronizzazione CSV -->
                <div style="background-color:#0f172a; padding:15px; border-radius:10px; border:1px solid #1e293b; margin-bottom:15px;">
                    <b tabindex="0" onfocus="FocusCampo('Sezione otto. Monitoraggio e sincronizzazione master CSV.', this)" style="font-size:14px; color:#38bdf8; outline:none; display:block; margin-bottom:6px;">?? 8. MONITORAGGIO & AUTO-SYNC MASTER CSV</b>
                    <span tabindex="0" onfocus="FocusCampo('Il software monitora in tempo reale lo stato del file Master nella cartella superiore.', this)" style="outline:none; display:block; margin-bottom:5px;">� **Sincronizzazione Unificata**: All'avvio, il programma rileva la presenza di `CLIENTI PUGLIA NICOLA.csv` visualizzandone peso e data.</span>
                    <span tabindex="0" onfocus="FocusCampo('Cliccando su Sincronizza Istantaneo o premendo F7 si attiva un motore di caricamento step-by-step con barra di progresso animata.', this)" style="outline:none; display:block;">� **Barra di Progresso**: Cliccando su "Sincronizza Istantaneo" o premendo `[F7]`, una barra di caricamento animata elabora e importa i record Excel all'istante scrivendo il database locale `asl_archivio.dat` ad alte prestazioni.</span>
                </div>

                <!-- Sezione 9: Hub Logistico Comuni -->
                <div style="background-color:#0f172a; padding:15px; border-radius:10px; border:1px solid #1e293b; margin-bottom:15px;">
                    <b tabindex="0" onfocus="FocusCampo('Sezione nove. Hub Logistico Comuni e Statistiche Inventario.', this)" style="font-size:14px; color:#38bdf8; outline:none; display:block; margin-bottom:6px;">?? 9. HUB LOGISTICO COMUNI & STATISTICHE INVENTARIO</b>
                    <span tabindex="0" onfocus="FocusCampo('La scheda Hub Logistico Comuni raggruppa tutti i pazienti attivi per citt�.', this)" style="outline:none; display:block; margin-bottom:5px;">� **Driver Router (Hub Comuni)**: Raggruppa i clienti attivi per comune di residenza, ordinandoli in ordine decrescente partendo dalle citt� con scadenze attive (rinnovi) per ottimizzare la pianificazione dei viaggi. Cliccando su un comune, la lista clienti a sinistra viene filtrata all'istante.</span>
                    <span tabindex="0" onfocus="FocusCampo('La scheda Statistiche Ausili mostra grafici ad alte prestazioni per monitorare la diffusione dei dispositivi forniti.', this)" style="outline:none; display:block;">� **Analytics Inventario**: Visualizza la diffusione dei 22 ausili distribuiti tramite barre grafiche dinamiche HSL ordinate in ordine decrescente, ideali per controlli amministrativi straordinari.</span>
                </div>

                <!-- Sezione 10: Comandi Rapidi -->
                <div style="background-color:#0f172a; padding:15px; border-radius:10px; border:1px solid #1e293b; margin-bottom:15px;">
                    <b tabindex="0" onfocus="FocusCampo('Sezione dieci. Scorciatoie da tastiera attive.', this)" style="font-size:14px; color:#38bdf8; outline:none; display:block; margin-bottom:6px;">?? 10. SCORCIATOIE RAPIDE DA TASTIERA</b>
                    <table style="width:100%; border-collapse:collapse; font-size:12px; color:#f1f5f9;">
                        <tr tabindex="0" onfocus="FocusCampo('Tasto F2 o Control Spazio o Alt R. Ripete l\'ultima lettura vocale dell\'assistente.', this)" style="border-bottom:1px solid #1e293b; outline:none;"><td style="padding:5px 0; color:#38bdf8; width:130px; font-weight:bold;">[F2] o [Ctrl+Spazio]</td><td style="padding:5px 0;">Ripeti ultima lettura vocale attiva</td></tr>
                        <tr tabindex="0" onfocus="FocusCampo('Tasto F3 o Alt N. Registra un nuovo cliente manuale.', this)" style="border-bottom:1px solid #1e293b; outline:none;"><td style="padding:5px 0; color:#38bdf8; font-weight:bold;">[F3] o [Alt+N]</td><td style="padding:5px 0;">Registra un Nuovo Cliente locale</td></tr>
                        <tr tabindex="0" onfocus="FocusCampo('Tasto F4 o Alt M. Modifica la scheda del cliente attivo.', this)" style="border-bottom:1px solid #1e293b; outline:none;"><td style="padding:5px 0; color:#38bdf8; font-weight:bold;">[F4] o [Alt+M]</td><td style="padding:5px 0;">Modifica l'anagrafica del cliente selezionato</td></tr>
                        <tr tabindex="0" onfocus="FocusCampo('Tasto F7 o Alt E. Esporta l\'archivio filtrato in formato Excel.', this)" style="border-bottom:1px solid #1e293b; outline:none;"><td style="padding:5px 0; color:#38bdf8; font-weight:bold;">[F7] o [Alt+E]</td><td style="padding:5px 0;">Esporta il database filtrato in Excel</td></tr>
                        <tr tabindex="0" onfocus="FocusCampo('Tasto F8 o Alt S. Stampa la scheda report cartacea del cliente attivo.', this)" style="border-bottom:1px solid #1e293b; outline:none;"><td style="padding:5px 0; color:#38bdf8; font-weight:bold;">[F8] o [Alt+S]</td><td style="padding:5px 0;">Stampa la scheda report cartacea del cliente</td></tr>
                        <tr tabindex="0" onfocus="FocusCampo('Tasto F9 o Alt T. Avvia o ferma il giro telefonate automatico per i rinnovi e i diritti nomenclatore.', this)" style="border-bottom:1px solid #1e293b; outline:none;"><td style="padding:5px 0; color:#38bdf8; font-weight:bold;">[F9] o [Alt+T]</td><td style="padding:5px 0;">Avvia/Ferma il Giro Telefonate automatico</td></tr>
                        <tr tabindex="0" onfocus="FocusCampo('Tasto Escape. Chiude qualsiasi finestra modale attiva o esce dal programma.', this)" style="outline:none;"><td style="padding:5px 0; color:#38bdf8; font-weight:bold;">[Esc]</td><td style="padding:5px 0;">Chiude le finestre modali o esce dal programma</td></tr>
                    </table>
                </div>

                <!-- Copyright e crediti -->
                <div style="text-align:center; opacity:0.5; font-size:11px; margin-top:20px;">
                    <span tabindex="0" onfocus="FocusCampo('Sviluppato per il Centro Distribuzione Clienti A.S.L. Aurelio Nicolodi. Tutti i diritti riservati.', this)" style="outline:none;">� 2026 - Centro Distribuzione Clienti A.S.L. - Aurelio Nicolodi</span>
                </div>

            </div>
            
            <div style="text-align:right; border-top:1px solid #334155; padding-top:15px;">
                <button onclick="ChiudiModalInfo()" onfocus="FocusCampo('Chiudi finestra istruzioni', this)" tabindex="0" style="background-color:#475569; color:white; border:none; padding:10px 22px; border-radius:8px; font-weight:bold; cursor:pointer; font-size:12px; text-transform:uppercase; letter-spacing:0.5px;">CHIUDI GUIDA</button>
            </div>
        </div>
    </div>
    <!-- MODAL STATISTICHE (BUSINESS INTELLIGENCE LOGISTICA) -->
    <div id="modalStatistiche" class="modal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100%; height:100%; background-color:rgba(0,0,0,0.85); text-align:center; overflow-y:auto; backdrop-filter:blur(8px);">
        <div style="display:inline-block; vertical-align:middle; margin-top:50px; text-align:left; background-color:#1e293b; border: 2px solid #475569; border-radius:24px; padding:30px; width:750px; color:#f8fafc; font-family:'Outfit',sans-serif; box-shadow:0 25px 50px -12px rgba(0,0,0,0.75); overflow:hidden; position:relative;">
            <span onclick="ChiudiModalStatistiche()" style="position:absolute; top:20px; right:25px; font-size:28px; font-weight:bold; color:#64748b; cursor:pointer; transition:color 0.2s;" onmouseover="this.style.color='#ef4444'" onmouseout="this.style.color='#64748b'">&times;</span>
            <h2 tabindex="0" onfocus="FocusCampo('Dashboard Statistiche di Business Intelligence e Logistica.', this)" style="margin-top:0; color:#38bdf8; font-size:22px; border-bottom:2px solid #334155; padding-bottom:12px; font-weight:800; text-transform:uppercase; letter-spacing:0.5px;">?? BUSINESS INTELLIGENCE & STATISTICHE LOGISTICA</h2>
            
            <!-- Cards Numeriche -->
            <div style="display:flex; justify-content:space-between; gap:12px; margin-top:20px;">
                <div style="flex:1; background-color:#0f172a; border:1px solid #334155; border-radius:12px; padding:12px; text-align:center;">
                    <div style="font-size:9px; color:#94a3b8; font-weight:850; text-transform:uppercase;">Totale Database</div>
                    <div id="statTotalText" style="font-size:24px; font-weight:900; color:#fff; margin-top:4px;">0</div>
                </div>
                <div style="flex:1; background-color:#0f172a; border:1px solid #334155; border-radius:12px; padding:12px; text-align:center;">
                    <div style="font-size:9px; color:#ef4444; font-weight:850; text-transform:uppercase;">Assistiti Ciechi</div>
                    <div id="statCiechiText" style="font-size:24px; font-weight:900; color:#ef4444; margin-top:4px;">0</div>
                </div>
                <div style="flex:1; background-color:#0f172a; border:1px solid #334155; border-radius:12px; padding:12px; text-align:center;">
                    <div style="font-size:9px; color:#38bdf8; font-weight:850; text-transform:uppercase;">Assistiti Ipovedenti</div>
                    <div id="statIpovText" style="font-size:24px; font-weight:900; color:#38bdf8; margin-top:4px;">0</div>
                </div>
                <div style="flex:1; background-color:#0f172a; border:1px solid #334155; border-radius:12px; padding:12px; text-align:center;">
                    <div style="font-size:9px; color:#22c55e; font-weight:850; text-transform:uppercase;">Pronti Rinnovo</div>
                    <div id="statRinnovaText" style="font-size:24px; font-weight:900; color:#22c55e; margin-top:4px;">0</div>
                </div>
            </div>
            
            <!-- Charts Section -->
            <div style="display:flex; gap:20px; margin-top:20px;">
                <!-- Grafico Province -->
                <div style="flex:1.2; background-color:#0f172a; border:1px solid #334155; border-radius:16px; padding:15px;">
                    <h3 style="margin:0 0 10px 0; font-size:12px; color:#f8fafc; text-transform:uppercase; letter-spacing:0.5px;">?? Distribuzione per Provincia</h3>
                    <div id="statProvinceBars" style="display:flex; flex-direction:column; gap:8px; min-height:160px; justify-content:center;">
                        <!-- Generato dinamicamente in JS -->
                    </div>
