    <!-- Elegant Modal for Promemoria (Callback) -->
    <div id="modalReminder" class="modal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100%; height:100%; background-color:rgba(0,0,0,0.85); text-align:center; overflow-y:auto;">
        <div style="display:inline-block; vertical-align:middle; margin-top:100px; text-align:left; background-color:#1e293b; border: 2px solid #f59e0b; border-radius:16px; padding:25px; width:480px; color:#f8fafc; font-family:'Outfit',sans-serif; box-shadow:0 25px 50px -12px rgba(0,0,0,0.75);">
            <h2 style="margin-top:0; color:#f59e0b; font-size:20px; border-bottom:1px solid #334155; padding-bottom:10px; font-weight:800; text-transform:uppercase;">? IMPOSTA PROMEMORIA RICHIAMO</h2>
            
            <div style="margin-bottom:15px;">
                <label style="display:block; font-size:11px; color:#94a3b8; font-weight:bold; margin-bottom:5px; text-transform:uppercase; letter-spacing:0.5px;">CLIENTE</label>
                <div id="reminderClienteNome" style="font-size:16px; font-weight:900; color:#fff; text-transform:uppercase; letter-spacing:0.5px;"></div>
            </div>
            
            <div style="margin-bottom:20px;">
                <label style="display:block; font-size:11px; color:#94a3b8; font-weight:bold; margin-bottom:10px; text-transform:uppercase; letter-spacing:0.5px;">QUANDO VUOI RICHIAMARE?</label>
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; margin-bottom:15px;">
                    <button onclick="SelezionaTempoReminder('30_MIN')" style="background-color:#0f172a; border:1px solid #f59e0b; color:#fff; padding:10px; border-radius:8px; font-weight:bold; cursor:pointer;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='#0f172a';">?? FRA 30 MINUTI</button>
                    <button onclick="SelezionaTempoReminder('2_ORE')" style="background-color:#0f172a; border:1px solid #f59e0b; color:#fff; padding:10px; border-radius:8px; font-weight:bold; cursor:pointer;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='#0f172a';">?? FRA 2 ORE</button>
                    <button onclick="SelezionaTempoReminder('DOMANI_MATTINA')" style="background-color:#0f172a; border:1px solid #f59e0b; color:#fff; padding:10px; border-radius:8px; font-weight:bold; cursor:pointer;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='#0f172a';">?? DOMANI MATTINA (09:00)</button>
                    <button onclick="SelezionaTempoReminder('LUNEDI_MATTINA')" style="background-color:#0f172a; border:1px solid #f59e0b; color:#fff; padding:10px; border-radius:8px; font-weight:bold; cursor:pointer;" onmouseover="this.style.backgroundColor='#1e293b';" onmouseout="this.style.backgroundColor='#0f172a';">?? LUNED� MATTINA (09:00)</button>
                </div>
                
                <label style="display:block; font-size:11px; color:#94a3b8; font-weight:bold; margin-bottom:5px; text-transform:uppercase; letter-spacing:0.5px;">OPPURE DATA/ORA PERSONALIZZATA</label>
                <div style="display:flex; gap:10px;">
                    <input type="text" id="txtReminderData" placeholder="GG/MM/AAAA" style="width:60%; padding:10px; border-radius:8px; border:1px solid #475569; background-color:#0f172a; color:#fff; font-size:14px; font-weight:bold;" />
                    <input type="text" id="txtReminderOra" placeholder="HH:MM" style="width:40%; padding:10px; border-radius:8px; border:1px solid #475569; background-color:#0f172a; color:#fff; font-size:14px; font-weight:bold;" />
                </div>
            </div>
            
            <div style="text-align:right;">
                <button onclick="ChiudiModalReminder()" style="background-color:#475569; color:white; border:none; padding:10px 18px; border-radius:8px; font-weight:bold; cursor:pointer; margin-right:10px; font-size:12px; text-transform:uppercase;">ANNULLA</button>
                <button onclick="SalvaReminderCustom()" style="background-color:#f59e0b; color:black; border:none; padding:10px 22px; border-radius:8px; font-weight:bold; cursor:pointer; font-size:12px; text-transform:uppercase; box-shadow:0 4px 6px -1px rgba(245,158,11,0.3);">SALVA RICHIAMO</button>
            </div>
        </div>
    </div>

    <!-- Elegant Modal for Modifica Nota (Ipovedenti & Accessible) -->
    <div id="modalModificaNota" class="modal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100%; height:100%; background-color:rgba(0,0,0,0.85); text-align:center; overflow-y:auto;">
        <div style="display:inline-block; vertical-align:middle; margin-top:100px; text-align:left; background-color:#1e293b; border: 2px solid #3b82f6; border-radius:16px; padding:25px; width:520px; color:#f8fafc; font-family:'Outfit',sans-serif; box-shadow:0 25px 50px -12px rgba(0,0,0,0.75);">
            <h2 id="modificaNotaHeader" style="margin-top:0; color:#38bdf8; font-size:20px; border-bottom:1px solid #334155; padding-bottom:10px; font-weight:800; text-transform:uppercase;">MODIFICA NOTA DIARIO</h2>
            
            <div style="margin-bottom:15px;">
                <label style="display:block; font-size:11px; color:#94a3b8; font-weight:bold; margin-bottom:5px; text-transform:uppercase; letter-spacing:0.5px;">CLIENTE</label>
                <div id="modificaNotaClienteNome" style="font-size:16px; font-weight:900; color:#fff; text-transform:uppercase; letter-spacing:0.5px;"></div>
            </div>

            <div style="margin-bottom:15px;">
                <label style="display:block; font-size:11px; color:#94a3b8; font-weight:bold; margin-bottom:5px; text-transform:uppercase; letter-spacing:0.5px;">DATA NOTA</label>
                <div id="modificaNotaData" style="font-size:14px; font-weight:bold; color:#38bdf8;"></div>
            </div>
            
            <div style="margin-bottom:20px;">
                <label style="display:block; font-size:11px; color:#94a3b8; font-weight:bold; margin-bottom:10px; text-transform:uppercase; letter-spacing:0.5px;">TESTO DELLA NOTA</label>
                
                <!-- CHIPS STATO RAPIDO TIMELINE (Chicca 3) -->
                <div style="margin-bottom:8px; display:flex; gap:6px; flex-wrap:wrap;">
                    <button type="button" onclick="InserisciStatusTimeline('? Ausilio consegnato a domicilio')" style="background:#1e293b; color:#34d399; border:1px solid #10b981; border-radius:12px; padding:3px 8px; font-size:9px; font-weight:800; cursor:pointer;" onmouseover="this.style.backgroundColor='#10b981'; this.style.color='#fff';" onmouseout="this.style.backgroundColor='#1e293b'; this.style.color='#34d399';">? CONSEGNATO</button>
                    <button type="button" onclick="InserisciStatusTimeline('?? Non risponde: da ricontattare')" style="background:#1e293b; color:#38bdf8; border:1px solid #0284c7; border-radius:12px; padding:3px 8px; font-size:9px; font-weight:800; cursor:pointer;" onmouseover="this.style.backgroundColor='#0284c7'; this.style.color='#fff';" onmouseout="this.style.backgroundColor='#1e293b'; this.style.color='#38bdf8';">?? DA RICONTATTARE</button>
                    <button type="button" onclick="InserisciStatusTimeline('?? Ausilio ritirato per sostituzione')" style="background:#1e293b; color:#facc15; border:1px solid #eab308; border-radius:12px; padding:3px 8px; font-size:9px; font-weight:800; cursor:pointer;" onmouseover="this.style.backgroundColor='#eab308'; this.style.color='#000';" onmouseout="this.style.backgroundColor='#1e293b'; this.style.color='#facc15';">?? SOSTITUZIONE</button>
                    <button type="button" onclick="InserisciStatusTimeline('? Cliente assente all\'appuntamento')" style="background:#1e293b; color:#f87171; border:1px solid #dc2626; border-radius:12px; padding:3px 8px; font-size:9px; font-weight:800; cursor:pointer;" onmouseover="this.style.backgroundColor='#dc2626'; this.style.color='#fff';" onmouseout="this.style.backgroundColor='#1e293b'; this.style.color='#f87171';">? ASSENTE</button>
                </div>
                
                <textarea id="txtModificaNotaTesto" rows="4" style="width:100%; padding:12px; border-radius:8px; border:2px solid #475569; background-color:#0f172a; color:#fff; font-size:14px; font-weight:bold; font-family:inherit; resize:vertical; box-sizing:border-box; outline:none;" onfocus="FocusCampo('Modifica il testo di questa nota', this)"></textarea>
            </div>
            
            <div style="text-align:right;">
                <button onclick="ChiudiModalModificaNota()" style="background-color:#475569; color:white; border:none; padding:10px 18px; border-radius:8px; font-weight:bold; cursor:pointer; margin-right:10px; font-size:12px; text-transform:uppercase;" onfocus="FocusCampo('Annulla e chiudi', this)">ANNULLA</button>
                <button onclick="SalvaModificaNotaCustom()" style="background-color:#10b981; color:white; border:none; padding:10px 22px; border-radius:8px; font-weight:bold; cursor:pointer; font-size:12px; text-transform:uppercase; box-shadow:0 4px 6px -1px rgba(16,185,129,0.3);" onfocus="FocusCampo('Salva le modifiche apportate alla nota', this)">SALVA MODIFICHE</button>
            </div>
        </div>
    </div>
    <!-- MODAL CREAZIONE POST-IT -->
    <div id="modalPostitCreate" class="modal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100%; height:100%; background:#000000; background:rgba(0,0,0,0.85); text-align:center; padding-top:80px; overflow-y:auto;">
        <div class="postit-modal" style="display:inline-block; text-align:left;">
            <h3>&#128204; NUOVO POST-IT</h3>
            <p style="color:#94a3b8; font-size:12px; margin:-10px 0 16px 0;" id="postitModalSubtitle">Per il cliente selezionato</p>
            <div style="margin-bottom:8px; display:flex; gap:6px; flex-wrap:wrap;">
                <button type="button" onclick="InserisciTestoRapido('?? Contattare il cliente per concordare la consegna')" style="background:#1e293b; color:#34d399; border:1px solid #10b981; border-radius:15px; padding:3px 8px; font-size:9px; font-weight:800; cursor:pointer;" onmouseover="this.style.backgroundColor='#10b981'; this.style.color='#fff';" onmouseout="this.style.backgroundColor='#1e293b'; this.style.color='#34d399';">?? TELEFONARE</button>
                <button type="button" onclick="InserisciTestoRapido('?? Ausilio pronto in magazzino per il ritiro')" style="background:#1e293b; color:#38bdf8; border:1px solid #0284c7; border-radius:15px; padding:3px 8px; font-size:9px; font-weight:800; cursor:pointer;" onmouseover="this.style.backgroundColor='#0284c7'; this.style.color='#fff';" onmouseout="this.style.backgroundColor='#1e293b'; this.style.color='#38bdf8';">?? MAGAZZINO</button>
                <button type="button" onclick="InserisciTestoRapido('?? RECAPITO ERRATO: verificare numero e indirizzo')" style="background:#1e293b; color:#f87171; border:1px solid #dc2626; border-radius:15px; padding:3px 8px; font-size:9px; font-weight:800; cursor:pointer;" onmouseover="this.style.backgroundColor='#dc2626'; this.style.color='#fff';" onmouseout="this.style.backgroundColor='#1e293b'; this.style.color='#f87171';">?? ERRORE CONTATTO</button>
            </div>
            <textarea id="txtPostitTesto" class="postit-modal-textarea" style="width:100%; height:90px; background:#0f172a; border:1.5px solid #334155; border-radius:10px; color:#f1f5f9; font-size:13px; font-weight:600; padding:10px 12px; font-family:'Outfit',sans-serif; resize:none; outline:none; box-sizing:border-box;" placeholder="Scrivi il tuo messaggio per i colleghi..." tabindex="0"></textarea>
            
            <!-- TASTIERINA EMOJI RAPIDA (Chicca 2) -->
            <div style="margin: 12px 0; display:flex; align-items:center; gap:8px; flex-wrap:wrap; background-color:#1e293b; border:1.5px solid #334155; border-radius:12px; padding:10px 14px;">
                <span style="font-size:11px; color:#94a3b8; font-weight:800; text-transform:uppercase; font-family:'Outfit',sans-serif; margin-right:6px;">?? EMOJI:</span>
                <button type="button" onclick="InserisciEmoji('??')" style="background:#334155; color:#ffffff !important; border:1px solid #475569; border-radius:50%; width:32px; height:32px; font-size:16px; cursor:pointer; outline:none; display:inline-flex; align-items:center; justify-content:center; padding:0;" onmouseover="this.style.backgroundColor='#475569'; this.style.borderColor='#fbbf24';" onmouseout="this.style.backgroundColor='#334155'; this.style.borderColor='#475569';" title="Puntina">??</button>
                <button type="button" onclick="InserisciEmoji('??')" style="background:#334155; color:#ffffff !important; border:1px solid #475569; border-radius:50%; width:32px; height:32px; font-size:16px; cursor:pointer; outline:none; display:inline-flex; align-items:center; justify-content:center; padding:0;" onmouseover="this.style.backgroundColor='#475569'; this.style.borderColor='#fbbf24';" onmouseout="this.style.backgroundColor='#334155'; this.style.borderColor='#475569';" title="Telefono">??</button>
                <button type="button" onclick="InserisciEmoji('??')" style="background:#334155; color:#ffffff !important; border:1px solid #475569; border-radius:50%; width:32px; height:32px; font-size:16px; cursor:pointer; outline:none; display:inline-flex; align-items:center; justify-content:center; padding:0;" onmouseover="this.style.backgroundColor='#475569'; this.style.borderColor='#fbbf24';" onmouseout="this.style.backgroundColor='#334155'; this.style.borderColor='#475569';" title="Pacco/Magazzino">??</button>
                <button type="button" onclick="InserisciEmoji('??')" style="background:#334155; color:#ffffff !important; border:1px solid #475569; border-radius:50%; width:32px; height:32px; font-size:16px; cursor:pointer; outline:none; display:inline-flex; align-items:center; justify-content:center; padding:0;" onmouseover="this.style.backgroundColor='#475569'; this.style.borderColor='#fbbf24';" onmouseout="this.style.backgroundColor='#334155'; this.style.borderColor='#475569';" title="Pericolo">??</button>
                <button type="button" onclick="InserisciEmoji('??')" style="background:#334155; color:#ffffff !important; border:1px solid #475569; border-radius:50%; width:32px; height:32px; font-size:16px; cursor:pointer; outline:none; display:inline-flex; align-items:center; justify-content:center; padding:0;" onmouseover="this.style.backgroundColor='#475569'; this.style.borderColor='#fbbf24';" onmouseout="this.style.backgroundColor='#334155'; this.style.borderColor='#475569';" title="Camion/Consegna">??</button>
                <button type="button" onclick="InserisciEmoji('?')" style="background:#334155; color:#ffffff !important; border:1px solid #475569; border-radius:50%; width:32px; height:32px; font-size:16px; cursor:pointer; outline:none; display:inline-flex; align-items:center; justify-content:center; padding:0;" onmouseover="this.style.backgroundColor='#475569'; this.style.borderColor='#fbbf24';" onmouseout="this.style.backgroundColor='#334155'; this.style.borderColor='#475569';" title="Fatto/Spunta">?</button>
                <button type="button" onclick="InserisciEmoji('?')" style="background:#334155; color:#ffffff !important; border:1px solid #475569; border-radius:50%; width:32px; height:32px; font-size:16px; cursor:pointer; outline:none; display:inline-flex; align-items:center; justify-content:center; padding:0;" onmouseover="this.style.backgroundColor='#475569'; this.style.borderColor='#fbbf24';" onmouseout="this.style.backgroundColor='#334155'; this.style.borderColor='#475569';" title="Sveglia/Orario">?</button>
                <button type="button" onclick="InserisciEmoji('??')" style="background:#334155; color:#ffffff !important; border:1px solid #475569; border-radius:50%; width:32px; height:32px; font-size:16px; cursor:pointer; outline:none; display:inline-flex; align-items:center; justify-content:center; padding:0;" onmouseover="this.style.backgroundColor='#475569'; this.style.borderColor='#fbbf24';" onmouseout="this.style.backgroundColor='#334155'; this.style.borderColor='#475569';" title="Sirena/Urgenza">??</button>
                <button type="button" onclick="InserisciEmoji('??')" style="background:#334155; color:#ffffff !important; border:1px solid #475569; border-radius:50%; width:32px; height:32px; font-size:16px; cursor:pointer; outline:none; display:inline-flex; align-items:center; justify-content:center; padding:0;" onmouseover="this.style.backgroundColor='#475569'; this.style.borderColor='#fbbf24';" onmouseout="this.style.backgroundColor='#334155'; this.style.borderColor='#475569';" title="Messaggio">??</button>
            </div>
            
            <div class="postit-color-row">
                <button class="postit-color-swatch selected" id="swatchYellow" style="background:#fde047;" title="Giallo" tabindex="0" onclick="SelezionaColorePostit('yellow')" onfocus="FocusCampo('Colore giallo', this)"></button>
                <button class="postit-color-swatch" id="swatchCyan" style="background:#22d3ee;" title="Ciano" tabindex="0" onclick="SelezionaColorePostit('cyan')" onfocus="FocusCampo('Colore ciano', this)"></button>
                <button class="postit-color-swatch" id="swatchPink" style="background:#f472b6;" title="Rosa" tabindex="0" onclick="SelezionaColorePostit('pink')" onfocus="FocusCampo('Colore rosa', this)"></button>
                <button class="postit-color-swatch" id="swatchGreen" style="background:#4ade80;" title="Verde" tabindex="0" onclick="SelezionaColorePostit('green')" onfocus="FocusCampo('Colore verde', this)"></button>
                <button class="postit-color-swatch" id="swatchOrange" style="background:#fb923c;" title="Arancione" tabindex="0" onclick="SelezionaColorePostit('orange')" onfocus="FocusCampo('Colore arancione', this)"></button>
                <button class="postit-color-swatch" id="swatchPurple" style="background:#c084fc;" title="Viola" tabindex="0" onclick="SelezionaColorePostit('purple')" onfocus="FocusCampo('Colore viola', this)"></button>
            </div>
            <div class="postit-modal-btns">
                <button onclick="ChiudiModalPostit()" style="background:#1e293b; color:#94a3b8; border:1px solid #334155; font-family:'Outfit',sans-serif; padding:10px; border-radius:10px; font-size:13px; font-weight:900; cursor:pointer; outline:none; flex:1;" onfocus="FocusCampo('Annulla e chiudi', this)" tabindex="0">ANNULLA</button>
                <button onclick="SalvaPostit()" style="background-color:#2563eb; background:linear-gradient(135deg,#2563eb,#1d4ed8); color:#ffffff !important; border:1px solid #1d4ed8; box-shadow:0 4px 12px rgba(37,99,235,0.4); font-family:'Outfit',sans-serif; padding:10px; border-radius:10px; font-size:13px; font-weight:900; cursor:pointer; outline:none; flex:1;" onfocus="FocusCampo('Salva il post-it', this)" tabindex="0">&#128204; INCOLLA</button>
            </div>
        </div>
    </div>

    <!-- MODAL BACHECA GLOBALE POST-IT -->
    <div id="modalBachecaGlobale" class="modal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100%; height:100%; background:#000000; background:rgba(0,0,0,0.85); text-align:center; padding-top:60px; overflow-y:auto;">
        <div class="postit-modal" style="display:inline-block; text-align:left; width:600px; max-width:90vw;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <h3 style="margin:0;">&#128204; BACHECA GLOBALE SQUADRA</h3>
                <button id="btnChiudiBachecaGlobale" onclick="ChiudiModalBachecaGlobale()" style="background:#334155; color:#94a3b8; border:none; border-radius:8px; padding:6px 14px; cursor:pointer; font-weight:900; font-size:12px; font-family:'Outfit',sans-serif;" onfocus="FocusCampo('Chiudi bacheca globale', this)" onmouseover="FocusCampo('Chiudi bacheca globale', this)" tabindex="0">X CHIUDI</button>
            </div>
            <p style="color:#64748b; font-size:11px; margin:-12px 0 18px 0; text-transform:uppercase; letter-spacing:0.5px;">Post-it condivisi tra tutti gli operatori del turno</p>
            
            <!-- BARRA DI RICERCA INSTANTANEA (Chicca 2) -->
            <div style="margin: -8px 0 16px 0; display:flex; align-items:center; background:#0f172a; border:1.5px solid #334155; border-radius:10px; padding:6px 12px;">
                <span style="color:#64748b; font-size:10px; margin-right:8px; font-weight:800; font-family:'Outfit',sans-serif; text-transform:uppercase; letter-spacing:0.5px;">?? CERCA:</span>
                <input type="text" id="txtCercaBachecaGlobale" placeholder="Cerca per testo o autore in tempo reale..." onkeyup="EseguiRicercaBachecaGlobale(this.value)" style="background:none; border:none; color:#f1f5f9; font-size:12px; font-weight:600; outline:none; flex:1; font-family:'Outfit',sans-serif;" tabindex="0" onfocus="FocusCampo('Digita per filtrare i post-it in tempo reale', this)">
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; gap:8px;">
                <button type="button" id="btnEsportaPostitExcel" style="background:#1e293b; color:#fbbf24; border:1px solid #fbbf24; border-radius:10px; padding:8px 16px; font-size:11px; font-weight:800; cursor:pointer;" onmouseover="this.style.backgroundColor='#fbbf24'; this.style.color='#000';" onmouseout="this.style.backgroundColor='#1e293b'; this.style.color='#fbbf24';" onclick="EsportaPostitExcel()" onfocus="FocusCampo('Esporta report di tutti i post-it attivi in formato Excel CSV', this)" tabindex="0">?? ESPORTA REPORT</button>
                <button type="button" id="btnNuovoPostitGlobale" class="postit-add-btn" onclick="ApriModalPostit('globale')" onfocus="FocusCampo('Aggiungi un nuovo post-it globale per la squadra', this)" onmouseover="FocusCampo('Aggiungi un nuovo post-it globale per la squadra', this)" tabindex="0">+ NUOVO POST-IT GLOBALE</button>
            </div>
            <!-- FILTRI INTERATTIVI -->
            <div style="margin-bottom:14px; text-align:left; display:flex; gap:6px; flex-wrap:wrap;" id="postitFilterRow">
                <span style="font-size:10px; color:#94a3b8; font-weight:800; align-self:center; margin-right:6px; text-transform:uppercase;">?? FILTRA:</span>
                <button class="postit-filter-chip active" onclick="FiltraBachecaGlobale('TUTTI')" id="btnFilterGlobaleTUTTI" style="background:#3b82f6; color:#fff; border:none; padding:4px 10px; border-radius:12px; font-size:9px; font-weight:800; cursor:pointer;" onfocus="FocusCampo('Filtra per mostrare tutti i post-it', this)" onmouseover="FocusCampo('Filtra per mostrare tutti i post-it', this)" tabindex="0">TUTTI</button>
                <button class="postit-filter-chip" onclick="FiltraBachecaGlobale('URGENTI')" id="btnFilterGlobaleURGENTI" style="background:#1e293b; color:#ef4444; border:1px solid #ef4444; padding:4px 10px; border-radius:12px; font-size:9px; font-weight:800; cursor:pointer;" onfocus="FocusCampo('Filtra per mostrare solo i post-it urgenti', this)" onmouseover="FocusCampo('Filtra per mostrare solo i post-it urgenti', this)" tabindex="0">?? URGENTI</button>
                <button class="postit-filter-chip" onclick="FiltraBachecaGlobale('LOGISTICA')" id="btnFilterGlobaleLOGISTICA" style="background:#1e293b; color:#3b82f6; border:1px solid #3b82f6; padding:4px 10px; border-radius:12px; font-size:9px; font-weight:800; cursor:pointer;" onfocus="FocusCampo('Filtra per mostrare i post-it di logistica', this)" onmouseover="FocusCampo('Filtra per mostrare i post-it di logistica', this)" tabindex="0">?? LOGISTICA</button>
                <button class="postit-filter-chip" onclick="FiltraBachecaGlobale('TELEFONARE')" id="btnFilterGlobaleTELEFONARE" style="background:#1e293b; color:#10b981; border:1px solid #10b981; padding:4px 10px; border-radius:12px; font-size:9px; font-weight:800; cursor:pointer;" onfocus="FocusCampo('Filtra per mostrare i post-it telefonate', this)" onmouseover="FocusCampo('Filtra per mostrare i post-it telefonate', this)" tabindex="0">?? TELEFONATE</button>
                <button class="postit-filter-chip" onclick="FiltraBachecaGlobale('ATTENZIONE')" id="btnFilterGlobaleATTENZIONE" style="background:#1e293b; color:#facc15; border:1px solid #facc15; padding:4px 10px; border-radius:12px; font-size:9px; font-weight:800; cursor:pointer;" onfocus="FocusCampo('Filtra per mostrare i post-it attenzione', this)" onmouseover="FocusCampo('Filtra per mostrare i post-it attenzione', this)" tabindex="0">?? ATTENZIONE</button>
            </div>
            <div class="postit-grid" id="postitGlobaleGrid" style="max-height:350px; overflow-y:auto; padding-right:4px;">
                <div class="postit-empty">Nessun post-it globale. Clicca + Nuovo Post-it Globale per iniziare.</div>
            </div>
        </div>
    </div>



<!-- MODAL GUIDA ALL'USO (MSHTA REFLOW COMPATIBLE) -->
<!-- MODAL GUIDA ALL'USO (MSHTA REFLOW COMPATIBLE) -->
<div id="helpModalOverlay" style="display:none; visibility:hidden; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(2, 6, 23, 0.88); z-index:200000;">
    <div style="position:absolute; top:50%; left:50%; margin-top:-260px; margin-left:-320px; width:640px; background:#0f172a; border:2px solid #38bdf8; border-radius:16px; box-shadow:0 0 35px rgba(56, 189, 248, 0.4); padding:25px; color:#f8fafc; font-family:'Plus Jakarta Sans', 'Segoe UI', sans-serif;">
        <!-- Header Modal -->
        <div style="border-bottom:1px solid #38bdf8; padding-bottom:12px; margin-bottom:15px; position:relative;">
            <div style="font-family:'Outfit', sans-serif; font-size:1.2rem; font-weight:800; color:#38bdf8; letter-spacing:0.5px;">
                &#128216; GUIDA ALL'USO - ZENITH MATERIALI
            </div>
            <div style="font-size:0.75rem; color:#94a3b8; margin-top:2px;">Manuale Rapido Operativo &amp; Scorciatoie</div>
            <div onmousedown="ChiudiGuidaModal(event); return false;" onclick="ChiudiGuidaModal(event);" style="cursor:pointer; position:absolute; top:0; right:0; width:30px; height:30px; background:#1e293b; border:1px solid #38bdf8; border-radius:50%; text-align:center; line-height:28px; color:#f8fafc; font-weight:bold; font-size:1.2rem; user-select:none;">&times;</div>
        </div>

        <!-- Content Modal -->
        <div style="height:350px; overflow-y:auto; padding-right:5px;">
            <table style="width:100%; border-collapse:collapse; margin-bottom:12px;">
                <tr>
                    <td style="width:50%; padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#fbbf24; font-size:0.88rem; margin-bottom:6px;">
                                &#128269; 1. Ricerca Globale Istantanea
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Digita nel campo in alto per filtrare in tempo reale clienti, città, telefoni o specifiche attrezzature assegnate.
                            </div>
                        </div>
                    </td>
                    <td style="width:50%; padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#38bdf8; font-size:0.88rem; margin-bottom:6px;">
                                &#128205; 2. Filtri Provincia &amp; Articolo
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Usa la barra laterale sinistra per isolare velocemente le province (Bari, Foggia, Taranto) o i dispositivi (Orologio, Sveglia, Braille).
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td style="padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#34d399; font-size:0.88rem; margin-bottom:6px;">
                                &#128203; 3. Pulsanti Copia Dati
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Clicca sul tasto verde <b>Copia</b> per salvare la scheda cliente negli appunti e trasferirla nei promemoria o report.
                            </div>
                        </div>
                    </td>
                    <td style="padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#a78bfa; font-size:0.88rem; margin-bottom:6px;">
                                &#128259; 4. Sincronizzazione Danea
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Dal menu <b>File</b> o <b>Strumenti</b> premi <i>Sincronizza Excel Ora</i> per ricaricare le anagrafiche aggiornate.
                            </div>
                        </div>
                    </td>
                </tr>
            </table>

            <div style="background:rgba(56, 189, 248, 0.15); border:1px solid #38bdf8; padding:12px; border-radius:10px; font-size:0.8rem; color:#cbd5e1;">
                <b style="color:#38bdf8;">&#9889; Suggerimento Rapido:</b> Per resettare tutti i filtri attivi e tornare alla vista completa, seleziona <b>TUTTE LE PROVINCE</b> ed <b>ELENCO COMPLETO</b> dalla sidebar a sinistra.
            </div>
        </div>

        <!-- Footer Modal -->
        <div style="margin-top:15px; padding-top:12px; border-top:1px solid rgba(255,255,255,0.1); text-align:right;">
            <span style="font-size:0.75rem; color:#94a3b8; float:left; margin-top:8px;">Sistema Zenith Materiali v1.0 &bull; C. Milella 2026</span>
            <button onmousedown="ChiudiGuidaModal(event); return false;" onclick="ChiudiGuidaModal(event);" style="background:#0284c7; color:white; border:1px solid #38bdf8; padding:8px 24px; border-radius:8px; font-weight:800; font-size:0.85rem; cursor:pointer; font-family:'Outfit', sans-serif;">HO CAPITO</button>
        </div>
    </div>
</div>

</body>
</html>


