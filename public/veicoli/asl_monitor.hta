                AggiungiAttivita("TEMA VISIVO: Attivato tema Verde Terminale retro-hacker");
                Parla("Tema visivo impostato su verde terminale.");
            }
        }

        function SalvaFileUTF8(filePath, content) {
            try {
                var stream = new ActiveXObject("ADODB.Stream");
                stream.Open();
                stream.Type = 2; // Text
                stream.Charset = "utf-8";
                stream.WriteText(content);
                stream.SaveToFile(filePath, 2); // 2 = Overwrite
                stream.Close();
                return true;
            } catch (err) {
                try {
                    var fWrite = fso.CreateTextFile(filePath, true, true); // Unicode
                    fWrite.Write(content);
                    fWrite.Close();
                    return true;
                } catch(e) {
                    alert("Errore nel salvataggio del file: " + e.message);
                    return false;
                }
            }
        }

        function ApriInBrowserPredefinito(filePath) {
            try {
                var shell = new ActiveXObject("WScript.Shell");
                shell.Run('cmd /c start "" "' + filePath + '"', 0, false);
                return true;
            } catch (err) {
                alert("Errore nell'apertura del browser: " + err.message);
                return false;
            }
        }

        function StampaEtichettaLogistica() {
            var nome = document.getElementById("mainNome") ? document.getElementById("mainNome").innerText : "";
            if (!nome || nome.trim() === "" || nome.indexOf("---") > -1 || nome.indexOf("SELEZIONA") > -1) {
                Parla("Errore: nessun cliente selezionato per la stampa dell'etichetta.");
                alert("Seleziona prima un cliente per stampare l'etichetta logistica.");
                return;
            }
            
            var citta = document.getElementById("mainCitta") ? document.getElementById("mainCitta").innerText : "";
            var invalidita = document.getElementById("mainBadge") ? document.getElementById("mainBadge").innerText : "";
            var codId = document.getElementById("cardCodiceId") ? document.getElementById("cardCodiceId").innerText : "ID: " + GeneraCodiceIdentificativo(nome, "");
            
            var targetPulito = PulishNome(nome);
            var devicesListHTML = "";
            var hasDevices = false;
            for(var i=0; i<allData.length; i++) {
                var p = allData[i];
                var pNomePulito = PulishNome(p[0]);
                if (pNomePulito === targetPulito && p[1] !== "NESSUN AUSILIO") {
                    hasDevices = true;
                    var sep = SeparaNomeEISO(p[1]);
                    devicesListHTML += "<li style='margin-bottom:4px; font-weight:bold; font-size:12px;'>&#128230; " + sep.name + "</li>";
                }
            }
            
            if (!hasDevices) {
                devicesListHTML = "<li style='font-style:italic; font-size:12px; color:#555;'>Nessun ausilio in consegna attiva</li>";
            }
            
            var barcodeHTML = "<div style='display:flex; justify-content:center; align-items:flex-end; height:50px; margin:15px 0; overflow:hidden;'>";
            var barCodeSeed = codId.replace(/[^a-zA-Z0-9]/g, "");
            for (var idx = 0; idx < 35; idx++) {
                var charCode = barCodeSeed.charCodeAt(idx % barCodeSeed.length) || 65;
                var width = (charCode % 3) + 1;
                var margin = (charCode % 2) + 1;
                barcodeHTML += "<div style='background-color:#000; width:" + width + "px; height:100%; margin-right:" + margin + "px;'></div>";
            }
            barcodeHTML += "</div>";
            
            var isBlind = invalidita.toUpperCase().indexOf("CIECO") > -1;
            var badgeText = isBlind ? "CIECO &#128266;" : "IPOVEDENTE &#128065;";
            var badgeColor = isBlind ? "#ef4444" : "#2563eb";
            
            var html = 
                "<!-- saved from url=(0014)about:internet -->\n" +
                "<html><head><title>Etichetta Spedizione - " + nome.toUpperCase() + "</title>" +
                "<style>" +
                "  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&display=swap');" +
                "  body { font-family: 'Outfit', sans-serif; background-color:#ffffff; margin: 20px; color:#000000; text-align:left; -webkit-print-color-adjust: exact; }" +
                "  .label-container { border: 4px dashed #000000; padding: 25px; border-radius: 12px; max-width: 500px; margin: auto; background-color:#fff; }" +
                "  .badge { background-color: " + badgeColor + "; color: #ffffff; padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 900; text-transform: uppercase; float: right; display:inline-block; }" +
                "  .barcode-text { font-family: monospace; font-size:13px; font-weight:bold; letter-spacing:3px; text-align:center; }" +
                "  .section-title { border-bottom: 2px solid #000000; padding-bottom: 4px; font-weight: 900; font-size: 13px; text-transform: uppercase; margin-top: 20px; margin-bottom: 10px; }" +
                "</style>" +
                "</head>" +
                "<body onload='window.print(); window.close();'>" +
                "  <div class='label-container'>" +
                "    <div style='overflow:hidden; line-height:22px;'>" +
                "      <span class='badge'>" + badgeText + "</span>" +
                "      <strong style='font-size:18px; text-transform:uppercase;'>LOGISTICA ITALIA S.P.A.</strong>" +
                "    </div>" +
                "    <div style='font-size:10px; text-transform:uppercase; font-weight:bold; opacity:0.6; margin-top:2px;'>Puglia - Hub Territoriale ASL</div>" +
                "    " +
                "    <div class='section-title'>&#128205; DESTINATARIO / CORRIERE</div>" +
                "    <div style='font-size:22px; font-weight:900; text-transform:uppercase; margin-bottom:6px;'>" + nome + "</div>" +
                "    <div style='font-size:15px; font-weight:700; text-transform:uppercase;'>Citt� di Consegna: " + citta + "</div>" +
                "    <div style='font-size:11px; margin-top:4px; font-weight:bold; opacity:0.7;'>Identificativo Interno: " + codId + "</div>" +
                "    " +
                "    <div class='section-title'>&#128230; LISTA COLLI E DISPOSITIVI IN USO</div>" +
                "    <ul style='margin:0; padding-left:20px; list-style-type:none;'>" + devicesListHTML + "</ul>" +
                "    " +
                "    <div class='section-title'>&#127991; CODICE A BARRE LOGISTICO</div>" +
                "    " + barcodeHTML +
                "    <div class='barcode-text'>" + codId.replace("ID: ", "") + "</div>" +
                "    " +
                "    <div style='margin-top:25px; border-top:1px solid #ccc; padding-top:10px; font-size:9px; text-align:center; font-weight:bold; text-transform:uppercase;'>" +
                "      Firma Operatore ASL: <strong>C. Milella</strong>" +
                "      </div></body></html>";
            try {
                var currentDir = fso.GetParentFolderName(dataFile);
                var tempEtichettaFile = fso.BuildPath(currentDir, "etichetta_temp.html");
                
                if (SalvaFileUTF8(tempEtichettaFile, html)) {
                    ApriInBrowserPredefinito(tempEtichettaFile);
                    AggiungiAttivita("📦 Stampata etichetta di spedizione logistica per " + nome);
                }
            } catch (ex) {
                alert("Errore nella generazione dell'etichetta temporanea: " + ex.message);
            }
        }

        // ZENITH PLATINUM SYSTEM HELPERS
        function SetZenithTab(tabId) {
            var contents = document.getElementsByClassName("zenith-tab-content");
            for (var i = 0; i < contents.length; i++) {
                contents[i].style.display = "none";
            }
            document.getElementById(tabId).style.display = "block";
            
            var btns = document.getElementsByClassName("zenith-tab-btn");
            for (var i = 0; i < btns.length; i++) {
                btns[i].className = "zenith-tab-btn";
            }
            
            if (tabId === "tabHome") document.getElementById("btnTabHome").className = "zenith-tab-btn active";
            if (tabId === "tabLogistica") document.getElementById("btnTabLogistica").className = "zenith-tab-btn active";
            if (tabId === "tabAnalytics") document.getElementById("btnTabAnalytics").className = "zenith-tab-btn active";
            if (tabId === "tabAudit") document.getElementById("btnTabAudit").className = "zenith-tab-btn active";
            if (tabId === "tabConsole") {
                document.getElementById("btnTabConsole").className = "zenith-tab-btn active";
                var consoleBox = document.getElementById("consoleLogBox");
                if (consoleBox) consoleBox.scrollTop = consoleBox.scrollHeight;
            }
        }

        function OttieniPercorsoCSV() {
            try {
                var parentDir = fso.GetParentFolderName(appPath);
                var folder = fso.GetFolder(parentDir);
                var fileEnum = new Enumerator(folder.Files);
                var bestPath = "";
                var bestScore = 0;
                var bestDate = new Date(0);
                for (; !fileEnum.atEnd(); fileEnum.moveNext()) {
                    var file = fileEnum.item();
                    var name = file.Name;
                    var upperName = name.toUpperCase();
                    var ext = name.split('.').pop().toLowerCase();
                    if (ext === "csv" || ext === "xlsx" || ext === "xls") {
                        var score = 0;
                        if (upperName === "CLIENTI PUGLIA NICOLA.CSV" || upperName === "CLIENTI PUGLIA NICOLA.XLSX") {
                            score = 100;
                        } else if (upperName.indexOf("CLIENTI PUGLIA NICOLA") === 0) {
                            score = 90;
                        } else if (upperName.indexOf("CLIENTI PUGLIA") === 0) {
                            score = 80;
                        } else if (upperName.indexOf("CLIENTI") === 0) {
                            score = 60;
                        } else if (upperName.indexOf("PUGLIA") > -1) {
                            score = 40;
                        } else {
                            score = 10;
                        }
                        
                        if (score >= 60) {
                            var fileDate = new Date(file.DateLastModified);
                            if (fileDate > bestDate) {
                                bestDate = fileDate;
                                bestScore = score;
                                bestPath = file.Path;
                            }
                        } else if (bestScore < 60 && score > bestScore) {
                            bestScore = score;
                            bestPath = file.Path;
                        }
                    }
                }
                return bestPath;
            } catch(e) { return ""; }
        }

        function AggiornaStatoFileCSV() {
            var csvPath = OttieniPercorsoCSV();
            var badge = document.getElementById("syncFileStatusBadge");
            if (csvPath && fso.FileExists(csvPath)) {
                var file = fso.GetFile(csvPath);
                var modDate = new Date(file.DateLastModified);
                var size = Math.round(file.Size / 1024);
                badge.innerText = "RILEVATO \uD83D\uDFE2";
                badge.style.backgroundColor = "#22c55e";
                badge.style.color = "#020617";
                document.getElementById("syncFileBox").style.borderColor = "#22c55e";
                
                var details = "<span style='font-size: 11px; color: #94a3b8; font-weight: bold; display: block; text-transform: uppercase;'>File Master Rilevato</span>" +
                              "<span style='font-size: 14px; color: #38bdf8; font-weight: 800; display: block; margin-top: 2px;'>" + file.Name + "</span>" +
                              "<span style='font-size: 10px; color: #64748b; font-weight: bold; display: block; margin-top: 4px;'>Ultima Modifica: " + modDate.toLocaleString() + " | Dimensione: " + size + " KB</span>";
                document.getElementById("syncFileDetails").innerHTML = details;
                document.getElementById("btnSyncCSV").style.display = "block";
            } else {
                badge.innerText = "NON RILEVATO \uD83D\uDD34";
                badge.style.backgroundColor = "#ef4444";
                badge.style.color = "#fff";
                document.getElementById("syncFileBox").style.borderColor = "#ef4444";
                document.getElementById("btnSyncCSV").style.display = "none";
            }
        }

        function AvviaSincronizzazioneAutoCSV() {
            var csvPath = OttieniPercorsoCSV();
            if (!csvPath || !fso.FileExists(csvPath)) {
                alert("File master 'CLIENTI PUGLIA NICOLA.csv' non trovato nella cartella superiore.");
                return;
            }
            
            document.getElementById("btnSyncCSV").disabled = true;
            document.getElementById("syncProgressContainer").style.display = "block";
            var bar = document.getElementById("syncProgressBar");
            var pctText = document.getElementById("syncProgressPercent");
            var label = document.getElementById("syncProgressLabel");
            
            label.innerText = "Lettura file sorgente CSV...";
            bar.style.width = "20%";
            pctText.innerText = "20%";
            
            setTimeout(function() {
                label.innerText = "Elaborazione anagrafica clienti...";
                bar.style.width = "50%";
                pctText.innerText = "50%";
                
                setTimeout(function() {
                    label.innerText = "Registrazione dispositivi e scadenze...";
                    bar.style.width = "80%";
                    pctText.innerText = "80%";
                    
                    setTimeout(function() {
                        try {
                            AvviaImport(csvPath);
                            
                            bar.style.width = "100%";
                            pctText.innerText = "100%";
                            RiproduciSuono("tada");
                            label.innerText = "Sincronizzazione completata con successo!";
                            
                            setTimeout(function() {
                                document.getElementById("syncProgressContainer").style.display = "none";
                                document.getElementById("btnSyncCSV").disabled = false;
                                SetZenithTab('tabHome');
                            }, 1500);
                        } catch(ex) {
                            alert("Errore durante l'importazione: " + ex.message);
                            document.getElementById("syncProgressContainer").style.display = "none";
                            document.getElementById("btnSyncCSV").disabled = false;
                        }
                    }, 200);
                }, 200);
            }, 200);
        }

        function CaricaArchivio() {
            try {
                document.body.scrollTop = 0;
                document.documentElement.scrollTop = 0;
            } catch(e) {}
            allData = [];
            var container = document.getElementById("listaClienti");
            container.innerHTML = "";
            var stats = { t:0, c:0, i:0, ok:0, deceduti: 0 };
            var idoneiSet = {};
            var cityMap = {};
            var aidsMap = {};

            if (fso.FileExists(dataFile)) {
                try {
                    var f = fso.OpenTextFile(dataFile, 1);
                    if (!f.AtEndOfStream) {
                        var lines = f.ReadAll().split("\n");
                        f.Close();
                        var nomiUnici = {};
                        patientNotes = {};
                        for(var i=0; i<lines.length; i++) {
                            var line = lines[i];
                            if (line.trim() === "") continue;
                            var p = line.split("|");
                            
                            if (p[1] === "NOTE_LOG") {
                                var nome = p[0].trim().toUpperCase();
                                if (!patientNotes[nome]) patientNotes[nome] = [];
                                patientNotes[nome].push({ date: p[2], text: p[3] });
                                continue;
                            }
                            
                            allData.push(p);
                            var nome = p[0].trim().toUpperCase();
                            var inv = (p[4] || "DA DEFINIRE").trim().toUpperCase();
                            var citta = (p[5] || "---").trim();
                            var prov = (p[6] || "").trim().toUpperCase();
                            var nascita = (p[7] || "---").trim();
                            var email = (p[8] || "---").trim();
                            var tel = (p[9] || "---").trim();
                            var cell = (p[10] || "---").trim();
                            var isManuale = (p[11] || "").trim().toUpperCase() === "MANUALE";

                            if (p[2] && p[2] !== "NULL") {
                                var dS = new Date(new Date(p[2]).getFullYear() + 6, new Date(p[2]).getMonth(), new Date(p[2]).getDate());
                                if (inv.indexOf("DECEDUTO") === -1) {
                                    if (new Date() > dS) idoneiSet[nome] = true;
                                }
                            }

                            if (!nomiUnici[nome]) {
                                nomiUnici[nome] = true;
                                
                                if (inv.indexOf("DECEDUTO") > -1) {
                                    stats.deceduti++;
                                } else {
                                    stats.t++;
                                    if (inv.indexOf("CIECO") > -1) stats.c++;
                                    if (inv.indexOf("IPOVEDENT") > -1) stats.i++;
                                    
                                    // Geographical grouping for active patients
                                    var keyCitta = citta.trim().toUpperCase();
                                    if (keyCitta && keyCitta !== "---" && keyCitta !== "") {
                                        if (!cityMap[keyCitta]) cityMap[keyCitta] = { name: citta, prov: prov, clients: [], renewals: 0 };
                                        cityMap[keyCitta].clients.push(nome);
                                    }
                                }
                                
                                var div = document.createElement("div");
                                div.className = "item-card";
                                div.setAttribute("data-nome", nome);
                                div.setAttribute("data-citta", citta);
                                div.setAttribute("data-prov", prov);
                                div.setAttribute("data-inv", inv);
                                div.setAttribute("data-nascita", nascita);
                                div.setAttribute("data-pulse", (idoneiSet[nome] && inv.indexOf("DECEDUTO") === -1) ? "true" : "false");
                                div.setAttribute("data-manuale", isManuale ? "true" : "false");
                                div.setAttribute("tabindex", "0");
                                div.setAttribute("role", "button");
                                div.setAttribute("aria-label", "Cliente " + nome + ". Citt� " + citta + " " + prov + ". Categoria " + inv);
                                                                 var statusDot = "";
                                 if (inv.indexOf("DECEDUTO") > -1) {
                                     statusDot = "<span style='display:inline-block; width:8px; height:8px; background-color:#64748b; border-radius:50%; margin-right:6px; vertical-align:middle;' title='Deceduto'></span>";
                                 } else if (idoneiSet[nome]) {
                                     statusDot = "<span style='display:inline-block; width:8px; height:8px; background-color:#f59e0b; border-radius:50%; margin-right:6px; vertical-align:middle;' title='Idoneo al Rinnovo (Superato Limite 6 Anni)'></span>\u23F3 ";
                                 } else {
                                     statusDot = "<span style='display:inline-block; width:8px; height:8px; background-color:#22c55e; border-radius:50%; margin-right:6px; vertical-align:middle;' title='Attivo e Regolare'></span>";
                                 }
                                 var manualBadge = isManuale ? " <span style='background-color: #10b981; color: #ffffff; padding: 2px 6px; border-radius: 4px; font-size: 8px; font-weight: 900; vertical-align: middle; margin-left: 5px;'>LOCALE \u270D</span>" : "";
                                 div.innerHTML = "<span class='name-main'>" + statusDot + nome + manualBadge + "</span>" +
                                                 "<span class='name-sub'>" + citta + (prov ? " (" + prov + ")" : "") + " | <span class='tag'>" + inv.substring(0,6) + "</span></span>";
                                (function(n, iv, c, pr, nas, em, t, cl, man) { 
                                    div.onclick = function() { MostraUnita(this, n, iv, c + (pr ? " ("+pr+")" : ""), nas, em, t, cl, man); }; 
                                    div.onkeydown = function(e) { if(e.keyCode===13||e.keyCode===32) { e.preventDefault(); MostraUnita(this, n, iv, c + (pr ? " ("+pr+")" : ""), nas, em, t, cl, man); } };
                                    div.onfocus = function() { FocusCampo("Cliente " + n + ", da " + c + ". Categoria " + iv + ". Premi Invio per caricare.", this); };
                                })(nome, inv, citta, prov, nascita, email, tel, cell, isManuale);
                                container.appendChild(div);
                            }
                        }
                        var nIdonei = Object.keys(idoneiSet).length;
                        document.getElementById("dbStatus").innerText = "RECORDS: " + stats.t;

                        // Animazione contatore con effetto slot machine decelerato (Ease-Out)
                        AnimaContatore("sTotal", stats.t);
                        AnimaContatore("sCiechi", stats.c);
                        AnimaContatore("sIpov", stats.i);
                        AnimaContatore("sIdonei", nIdonei);

                        AnimaContatore("dbRingCiechi", stats.c);
                        AnimaContatore("dbRingIpov", stats.i);
                        AnimaContatore("dbRingIdonei", nIdonei);

                        // Calcola Prossimi Rinnovi Attendibili Cliccabili
                        var urgentList = [];
                        var uniqueUrgent = {};
                        for(var i=0; i<allData.length; i++) {
                            var p = allData[i];
                            var nome = p[0].trim().toUpperCase();
                            var device = p[1];
                            var dateForn = p[2];
                            var inv = (p[4] || "DA DEFINIRE").trim().toUpperCase();
                            var keyCitta = (p[5] || "---").trim().toUpperCase();
                            var prov = (p[6] || "").trim().toUpperCase();
                            
                            // Ignora i deceduti per la logistica attiva dei rinnovi
                            if (inv.indexOf("DECEDUTO") > -1) continue;

                            // Tracciamento dispositivi attivi per analytics
                            if (device && device !== "NESSUN AUSILIO" && device !== "") {
                                var sep = SeparaNomeEISO(device);
                                var cleanDeviceName = sep.name.toUpperCase();
                                if (!aidsMap[cleanDeviceName]) aidsMap[cleanDeviceName] = 0;
                                aidsMap[cleanDeviceName]++;
                            }

                            if (dateForn && dateForn !== "NULL" && dateForn !== "") {
                                var dt = new Date(dateForn);
                                if (!isNaN(dt.getTime())) {
                                    var dS = new Date(dt.getFullYear() + 6, dt.getMonth(), dt.getDate());
                                    var oggi = new Date();
                                    var isOk = oggi > dS;
                                    var giorniMancanti = Math.ceil((dS.getTime() - oggi.getTime()) / (1000 * 3600 * 24));
                                    
                                    if (isOk) {
                                        if (cityMap[keyCitta]) {
                                            cityMap[keyCitta].renewals++;
                                        }
                                    }

                                    if (!uniqueUrgent[nome]) {
                                        uniqueUrgent[nome] = true;
                                        urgentList.push({
                                            name: nome,
                                            device: device,
                                            daysRemaining: giorniMancanti,
                                            isOk: isOk,
                                            prov: prov,
                                            dateLimit: dS.toLocaleDateString()
                                        });
                                    }
                                }
                            }
                        }

                        // Calcola Promemoria in Scadenza Oggi Cliccabili
                        var reminderList = [];
                        var oggiStr = new Date().toLocaleDateString();
                        
                        for (var name in patientNotes) {
                            var notes = patientNotes[name] || [];
                            for (var idx = 0; idx < notes.length; idx++) {
                                var text = notes[idx].text;
                                if (text.indexOf("[PROMEMORIA]") === 0) {
                                    var parts = text.substring(12).split("|");
                                    var timePart = parts[0].trim(); // "GG/MM/AAAA HH:MM"
                                    var noteMsg = parts[1] ? parts[1].trim() : "Ricontattare il cliente.";
                                    
                                    var timeParts = timePart.split(" ");
                                    var remDateStr = timeParts[0]; // GG/MM/AAAA
                                    var remTimeStr = timeParts[1] || ""; // HH:MM
                                    
                                    var isOggi = remDateStr === oggiStr;
                                    var isPastOrOggi = false;
                                    var datePts = remDateStr.split("/");
                                    if (datePts.length === 3) {
                                        var d = parseInt(datePts[0], 10);
                                        var m = parseInt(datePts[1], 10) - 1;
                                        var y = parseInt(datePts[2], 10);
                                        var remDate = new Date(y, m, d);
                                        var todayMidnight = new Date();
                                        todayMidnight.setHours(0, 0, 0, 0);
                                        if (remDate <= todayMidnight || isOggi) {
                                            isPastOrOggi = true;
                                        }
                                    }
                                    
                                    if (isPastOrOggi) {
                                        reminderList.push({
                                            name: name,
                                            dateTimeStr: timePart,
                                            msg: noteMsg,
                                            isOggi: isOggi
                                        });
                                    }
                                }
                            }
                        }
                        
                        reminderList.sort(function(a, b) {
                            return a.dateTimeStr.localeCompare(b.dateTimeStr);
                        });
                        
                        var remContainer = document.getElementById("activeRemindersList");
                        if (remContainer) {
                            remContainer.innerHTML = "";
                            var showRemCount = Math.min(reminderList.length, 6);
                            if (showRemCount === 0) {
                                remContainer.innerHTML = "<div style='color:#94a3b8; font-style:italic; font-size:13px; text-align:center;'>Nessun promemoria attivo o in scadenza oggi.</div>";
                            } else {
                                for (var r = 0; r < showRemCount; r++) {
                                    var rem = reminderList[r];
                                    var rCard = document.createElement("div");
                                    rCard.style.display = "flex";
                                    rCard.style.justifyContent = "space-between";
                                    rCard.style.alignItems = "center";
                                    rCard.style.cursor = "pointer";
                                    rCard.style.padding = "10px 15px";
                                    rCard.style.backgroundColor = "#0f172a";
                                    rCard.style.borderRadius = "8px";
                                    rCard.style.border = "1px solid #f59e0b";
                                    rCard.style.transition = "background-color 0.2s";
                                    
                                    (function(rCardEl) {
                                        rCardEl.onmouseover = function() { rCardEl.style.backgroundColor = "#1e293b"; };
                                        rCardEl.onmouseout = function() { rCardEl.style.backgroundColor = "#0f172a"; };
                                    })(rCard);
                                    
                                    rCard.setAttribute("tabindex", "0");
                                    rCard.setAttribute("role", "button");
                                    var voiceLabelRem = "Promemoria attivo per " + rem.name.replace(/'/g, " ") + ". " + rem.msg.replace(/'/g, " ") + ". Programmato il " + rem.dateTimeStr;
                                    rCard.setAttribute("aria-label", voiceLabelRem);
                                    rCard.onfocus = new Function("FocusCampo('" + voiceLabelRem.replace(/'/g, "\\'") + "', this)");
                                    
                                    (function(nomeTarget) {
                                        rCard.onclick = function() { SelezionaClienteDaLista(nomeTarget); };
                                        rCard.onkeydown = function(e) { if(e.keyCode===13||e.keyCode===32) { e.preventDefault(); SelezionaClienteDaLista(nomeTarget); } };
                                    })(rem.name);
                                    
                                    var badgeColor = rem.isOggi ? "#f59e0b" : "#ef4444";
                                    var badgeText = rem.isOggi ? "OGGI" : "SCADUTO";
                                    
                                    rCard.innerHTML = "<div>" +
                                                     "  <span style='font-weight:800; color:#f59e0b; font-size:13px; display:block;'>? " + rem.name + "</span>" +
                                                     "  <span style='font-size:11px; color:#94a3b8;'>" + rem.msg + " | Ora: " + rem.dateTimeStr + "</span>" +
                                                     "</div>" +
                                                     "<span style='font-weight:900; font-size:11px; padding:4px 8px; border-radius:5px; background-color:" + badgeColor + "; color:#020617;'>" + badgeText + "</span>";
                                    remContainer.appendChild(rCard);
                                }
                            }
                        }

                        urgentList.sort(function(a, b) { return a.daysRemaining - b.daysRemaining; });
                        var listContainer = document.getElementById("urgentRinnoviList");
                        listContainer.innerHTML = "";
                        var showCount = Math.min(urgentList.length, 4);
                        if (showCount === 0) {
                            listContainer.innerHTML = "<div style='color:#94a3b8; font-style:italic; font-size:13px; text-align:center;'>Nessun dispositivo pronto al rinnovo trovato.</div>";
                        } else {
                            for (var u = 0; u < showCount; u++) {
                                var item = urgentList[u];
                                var card = document.createElement("div");
                                card.style.display = "flex";
                                card.style.justifyContent = "space-between";
                                card.style.alignItems = "center";
                                card.style.cursor = "pointer";
                                card.style.padding = "10px 15px";
                                card.style.backgroundColor = "#0f172a";
                                card.style.borderRadius = "8px";
                                card.style.border = "1px solid #334155";
                                card.style.transition = "background-color 0.2s";
                                card.onmouseover = function() { this.style.backgroundColor = "#1e293b"; };
                                card.onmouseout = function() { this.style.backgroundColor = "#0f172a"; };
                                card.setAttribute("tabindex", "0");
                                card.setAttribute("role", "button");
                                var voiceLabel = "Rinnovo urgente per " + item.name.replace(/'/g, " ") + ". Dispositivo " + item.device.replace(/'/g, " ") + ". Scadenza il " + item.dateLimit + ". " + (item.isOk ? "Idoneo al rinnovo." : ("Mancano " + item.daysRemaining + " giorni al rinnovo."));
                                card.setAttribute("aria-label", voiceLabel);
                                card.onfocus = new Function("FocusCampo('" + voiceLabel.replace(/'/g, "\\'") + "', this)");

                                (function(nomeTarget) {
                                    var triggerClick = function() {
                                        var cards = document.getElementsByClassName("item-card");
                                        var targetPulito = PulishNome(nomeTarget);
                                        for (var c = 0; c < cards.length; c++) {
                                            if (PulishNome(cards[c].getElementsByClassName("name-main")[0].innerText) === targetPulito) {
                                                cards[c].click();
                                                cards[c].scrollIntoView();
                                                break;
                                            }
                                        }
                                    };
                                    card.onclick = triggerClick;
                                    card.onkeydown = function(e) { if(e.keyCode===13||e.keyCode===32) { e.preventDefault(); triggerClick(); } };
                                })(item.name);

                                var badgeColor = item.isOk ? "#22c55e" : "#eab308";
                                var badgeText = item.isOk ? "IDONEO" : (item.daysRemaining + " GG");

                                card.innerHTML = "<div>" +
                                                 "  <span style='font-weight:800; color:#38bdf8; font-size:13px; display:block;'>" + item.name + " (" + item.prov + ")</span>" +
                                                 "  <span style='font-size:11px; color:#94a3b8;'>" + item.device + " | Scadenza: " + item.dateLimit + "</span>" +
                                                 "</div>" +
                                                 "<span style='font-weight:900; font-size:11px; padding:4px 8px; border-radius:5px; background-color:" + badgeColor + "; color:#020617;'>" + badgeText + "</span>";
                                listContainer.appendChild(card);
                            }
                        }

                        // Rendering geographical hub (Tab 2)
                        var geoContainer = document.getElementById("logisticaCityContainer");
                        geoContainer.innerHTML = "";
                        var sortedCities = [];
                        for (var c in cityMap) {
                            sortedCities.push(cityMap[c]);
                        }
                        sortedCities.sort(function(a, b) {
                            if (b.renewals !== a.renewals) return b.renewals - a.renewals;
                            return b.clients.length - a.clients.length;
                        });
                        
                        if (sortedCities.length === 0) {
                            geoContainer.innerHTML = "<div style='color:#94a3b8; font-style:italic; font-size:13px; text-align:center;'>Nessun dato logistico disponibile. Sincronizza il CSV per caricare i dati geografici.</div>";
                        } else {
                            for (var j = 0; j < sortedCities.length; j++) {
                                var cityData = sortedCities[j];
                                var cityRow = document.createElement("div");
                                cityRow.className = "city-row";
                                cityRow.setAttribute("tabindex", "0");
                                cityRow.setAttribute("role", "button");
                                cityRow.setAttribute("aria-label", "Comune " + cityData.name + ", " + cityData.clients.length + " clienti, " + cityData.renewals + " rinnovi pronti");
                                
                                (function(cityName, totalClients, totalRenewals) {
                                    cityRow.onclick = function() {
                                        document.getElementById("txtCerca").value = cityName;
                                        FiltraJS();
                                        Parla("Filtro logistico impostato su comune di " + cityName);
                                    };
                                    cityRow.onkeydown = function(e) {
                                        if (e.keyCode === 13 || e.keyCode === 32) {
                                            e.preventDefault();
                                            document.getElementById("txtCerca").value = cityName;
                                            FiltraJS();
                                            Parla("Filtro logistico impostato su comune di " + cityName);
                                        }
                                    };
                                    cityRow.onfocus = function() {
                                        FocusCampo("Comune " + cityName + ", " + totalClients + " clienti, " + totalRenewals + " rinnovi pronti", this);
                                    };
                                })(cityData.name, cityData.clients.length, cityData.renewals);
                                
                                var renBadge = cityData.renewals > 0 ? 
                                    "<span style='background-color:#22c55e; color:#020617; font-weight:900; font-size:11px; padding:3px 8px; border-radius:12px; margin-left:10px;'>" + cityData.renewals + " RINNOVI</span>" : "";
                                
                                cityRow.innerHTML = "<div>" +
                                                    "  <b style='color:#fff; font-size:13px;'>?? " + cityData.name.toUpperCase() + (cityData.prov ? " (" + cityData.prov + ")" : "") + "</b>" +
                                                    "  <span style='color:#94a3b8; font-size:11px; display:block; margin-top:2px;'>" + cityData.clients.length + " clienti attivi</span>" +
                                                    "</div>" +
                                                    "<div>" + renBadge + "</div>";
                                geoContainer.appendChild(cityRow);
                            }
                        }

                        // Rendering aids analytics (Tab 3)
                        var aidsContainer = document.getElementById("analyticsAidsContainer");
                        aidsContainer.innerHTML = "";
                        var sortedAids = [];
                        for (var aidName in aidsMap) {
                            sortedAids.push({ name: aidName, count: aidsMap[aidName] });
                        }
                        sortedAids.sort(function(a, b) { return b.count - a.count; });
                        
                        var maxCount = 0;
                        for (var k = 0; k < sortedAids.length; k++) {
                            if (sortedAids[k].count > maxCount) maxCount = sortedAids[k].count;
                        }
                        
                        if (sortedAids.length === 0) {
                            aidsContainer.innerHTML = "<div style='color:#94a3b8; font-style:italic; font-size:13px; text-align:center;'>Nessun ausilio distribuito. Sincronizza il CSV per iniziare.</div>";
                        } else {
                            for (var j = 0; j < sortedAids.length; j++) {
                                var aid = sortedAids[j];
                                var pct = maxCount > 0 ? Math.round((aid.count / maxCount) * 100) : 0;
                                
                                var aidRow = document.createElement("div");
                                aidRow.className = "aid-stat-row";
                                aidRow.innerHTML = "<span class='aid-stat-count'>" + aid.count + " unit�</span>" +
                                                   "<span class='aid-stat-title'>?? " + aid.name + "</span>" +
                                                   "<div class='aid-stat-bar-track'><div class='aid-stat-bar' style='width:" + pct + "%; background-color:#38bdf8;'></div></div>";
                                aidsContainer.appendChild(aidRow);
                            }
                        }

                        // Rendering deceased audit list (Tab 4)
                        var auditContainer = document.getElementById("auditDeceasedContainer");
                        auditContainer.innerHTML = "";
                        var deceasedList = [];
                        var deceasedUnique = {};
                        for (var i = 0; i < allData.length; i++) {
                            var p = allData[i];
                            var nome = p[0].trim().toUpperCase();
                            var inv = (p[4] || "DA DEFINIRE").trim().toUpperCase();
                            var citta = (p[5] || "---").trim();
                            var prov = (p[6] || "").trim().toUpperCase();
                            var cell = (p[10] || "---").trim();
                            
                            if (inv.indexOf("DECEDUTO") > -1 && !deceasedUnique[nome]) {
                                deceasedUnique[nome] = true;
                                deceasedList.push({ name: nome, citta: citta, prov: prov, contact: cell });
                            }
                        }
                        
                        if (deceasedList.length === 0) {
                            auditContainer.innerHTML = "<div style='color:#94a3b8; font-style:italic; font-size:13px; text-align:center;'>Nessun cliente deceduto registrato nel sistema.</div>";
                        } else {
                            for (var j = 0; j < deceasedList.length; j++) {
                                var dec = deceasedList[j];
                                var decRow = document.createElement("div");
                                decRow.className = "city-row";
                                decRow.style.borderColor = "#ef4444";
                                decRow.style.cursor = "default";
                                decRow.innerHTML = "<div>" +
                                                   "  <b style='color:#ef4444; font-size:13px;'>?? " + dec.name + "</b>" +
                                                   "  <span style='color:#94a3b8; font-size:11px; display:block; margin-top:2px;'>?? " + dec.citta.toUpperCase() + (dec.prov ? " (" + dec.prov + ")" : "") + "</span>" +
                                                   "</div>" +
                                                   "<div style='text-align:right;'>" +
                                                   "  <span style='background-color:#ef4444; color:#fff; font-weight:900; font-size:10px; padding:3px 8px; border-radius:5px; display:block; text-align:center;'>SOSPESO / DECEDUTO</span>" +
                                                   "  <span style='color:#94a3b8; font-size:11px; display:block; margin-top:4px;'>?? Contatto: " + FormattaTelefono(dec.contact) + "</span>" +
                                                   "</div>";
                                auditContainer.appendChild(decRow);
                            }
                        }
                    }
                } catch(e) {}
            }
            
            // Applica il filtro deceduti subito dopo il caricamento
            setTimeout(function() { FiltraJS(); }, 50);
        }

        function AnimaContatore(id, targetVal) {
            var el = document.getElementById(id);
            if (!el) return;
            targetVal = parseInt(targetVal) || 0;
            if (targetVal <= 0) {
                el.innerText = "0";
                return;
            }
            
            var startTime = new Date().getTime();
            var duration = 1200; // 1.2 secondi per un effetto slot splendido
            
            if (el._animInterval) clearInterval(el._animInterval);
            
            el._animInterval = setInterval(function() {
                var now = new Date().getTime();
                var elapsed = now - startTime;
                if (elapsed >= duration) {
                    el.innerText = targetVal;
                    clearInterval(el._animInterval);
                    el._animInterval = null;
                } else {
                    var progress = elapsed / duration;
                    // Formula di Ease-Out cubica per effetto decelerazione graduale (tipo slot machine)
                    var easeOutProgress = 1 - Math.pow(1 - progress, 3);
                    var val = Math.floor(easeOutProgress * targetVal);
                    el.innerText = val;
                }
            }, 30); // 30ms = ~33 FPS fluidissimo
        }

        function FormattaTelefono(str) {
            if (!str || str === "---") return "---";
            var s = str.replace(/\b(\d{3})(\d{2})(\d{2})(\d{3})\b/g, "$1 $2 $3 $4");
            s = s.replace(/\b(\d{3})(\d{2})(\d{2})(\d{2})\b/g, "$1 $2 $3 $4");
            return s;
        }

        function GeneraCodiceIdentificativo(nome, nascita) {
            var initials = "XX";
            var parts = nome.trim().split(/\s+/);
            if (parts.length >= 2) {
                initials = parts[0].charAt(0).toUpperCase() + parts[1].charAt(0).toUpperCase();
            } else if (parts.length === 1 && parts[0].length >= 2) {
                initials = parts[0].substring(0, 2).toUpperCase();
            }
            var anno = "XXXX";
            if (nascita) {
                var match = nascita.match(/\b\d{4}\b/);
                if (match) {
                    anno = match[0];
                } else {
                    var matchG = nascita.match(/\b\d{2}\/\d{2}\/(\d{2,4})\b/);
                    if (matchG) {
                        anno = matchG[1];
                        if (anno.length === 2) {
                            anno = (parseInt(anno) > 30 ? "19" : "20") + anno;
                        }
                    }
                }
            }
            return "ID: LI-" + initials + anno + "-A";
        }

        function ConvertiInFirma(str) {
            if (!str) return "";
            var words = str.toLowerCase().split(/\s+/);
            for (var i = 0; i < words.length; i++) {
                words[i] = words[i].charAt(0).toUpperCase() + words[i].slice(1);
            }
            return words.join(" ");
        }

        function ElaboraFileImmagine(file) {
            if (!file) return;
            if (file.type.indexOf("image") === -1) {
                alert("Il file selezionato non � un'immagine valida!");
                return;
            }
            var reader = new FileReader();
            reader.onload = function(evt) {
                document.getElementById("photoPreviewImg").src = evt.target.result;
                document.getElementById("photoPreviewImg").style.display = "block";
                document.getElementById("photoPreviewPlaceholder").style.display = "none";
                tempBase64Photo = evt.target.result;
            };
            reader.readAsDataURL(file);
        }

        function GestisciDropFoto(evt) {
            evt.preventDefault();
            document.getElementById("photoDropzone").style.borderColor = "#475569";
            var files = evt.dataTransfer.files;
            if (files.length > 0) {
                ElaboraFileImmagine(files[0]);
            }
        }

        function GestisciFileSelezionato(input) {
            var files = input.files;
            if (files.length > 0) {
                ElaboraFileImmagine(files[0]);
            }
        }

        function IncollaFotoDaClipboard() {
            alert("Per incollare un'immagine dagli appunti:\n1. Fai clic all'interno del quadrato scuro dell'immagine nella finestra di modifica.\n2. Premi sulla tastiera la combinazione 'Ctrl + V'.\n\nL'immagine copiata verr� visualizzata all'istante!");
        }

        function SalvaBase64SuFile(base64Str, destPath) {
            var base64Data = base64Str;
            if (base64Data.indexOf(",") > -1) {
                base64Data = base64Data.split(",")[1];
            }
            
            var xmlDoc = new ActiveXObject("MSXML2.DOMDocument.3.0");
            var element = xmlDoc.createElement("tmp");
            element.dataType = "bin.base64";
            element.text = base64Data;
            
            var binaryStream = new ActiveXObject("ADODB.Stream");
            binaryStream.Type = 1; // Binary
            binaryStream.Open();
            binaryStream.Write(element.nodeTypedValue);
            binaryStream.SaveToFile(destPath, 2); // 2 = Overwrite
            binaryStream.Close();
        }

        // Listener globale per la pressione di CTRL+V sulla modale
        if (document.addEventListener) {
            document.addEventListener("paste", function(e) {
                if (document.getElementById("modalEdit").style.display !== "flex") return;
                var items = (e.clipboardData || e.originalEvent.clipboardData).items;
                for (var i = 0; i < items.length; i++) {
                    if (items[i].type.indexOf("image") !== -1) {
                        var file = items[i].getAsFile();
                        ElaboraFileImmagine(file);
                        break;
                    }
                }
            }, false);
        }

        function MostraUnita(el, nome, invalidita, citta, nascita, email, tel, cell, isManuale) {
            var cards = document.getElementsByClassName("item-card");
            for(var i=0; i<cards.length; i++) cards[i].className = "item-card";
            el.className = "item-card active";
            activePazienteNome = nome;
            window.activePatientName = nome;
            if (document.getElementById("diarioSezioneTimeline")) document.getElementById("diarioSezioneTimeline").style.display = "block";
            if (document.getElementById("diarioSezioneModifica")) document.getElementById("diarioSezioneModifica").style.display = "none";
            
            // Riproduzione feedback sonoro differenziato in base allo stato di rinnovo attivo
            try {
                var isPronto = el.getAttribute("data-pulse") === "true";
                if (isPronto) {
                    RiproduciSuono("chimes");
                } else {
                    RiproduciSuono("notify");
                }
            } catch(ex) {}
            
            document.getElementById("boxEmpty").style.display = "none";
            document.getElementById("boxMain").style.display = "block";
            
            document.getElementById("mainIsManuale").innerText = isManuale ? "true" : "false";
            
            var headerEl = document.getElementById("cardTitleHeader");
            if (headerEl) {
                var badgeEl = document.getElementById("cardTitleBadgeContainer");
                if (badgeEl) {
                    badgeEl.innerHTML = isManuale 
                        ? "<span style='background-color: #10b981; color: #ffffff; padding: 2px 6px; border-radius: 4px; font-size: 8px; font-weight: 900; vertical-align: middle; display: inline-block; box-shadow: 0 2px 5px rgba(16,185,129,0.3); border: 1px solid #a7f3d0;'>LOCALE ??</span>"
                        : "<span style='background-color: #3b82f6; color: #ffffff; padding: 2px 6px; border-radius: 4px; font-size: 8px; font-weight: 900; vertical-align: middle; display: inline-block; box-shadow: 0 2px 5px rgba(59,130,246,0.3); border: 1px solid #bfdbfe;'>MASTER ??</span>";
                }
            }
            
            // Popolamento elementi nascosti (compatibilit� retroattiva)
            document.getElementById("mainNome").innerHTML = nome;
            document.getElementById("mainCitta").innerText = citta;
            document.getElementById("mainNascita").innerText = nascita || "---";
            document.getElementById("mainEmail").innerText = email || "---";
            document.getElementById("mainTel").innerText = FormattaTelefono(tel || "---");
            document.getElementById("mainCell").innerText = FormattaTelefono(cell || "---");
            document.getElementById("mainBadge").innerText = invalidita;

            // Popolamento GOLD IDENTITY CARD
            document.getElementById("cardNomeCompleto").innerText = nome.toUpperCase();
            document.getElementById("cardCitta").innerText = citta.toUpperCase();
            document.getElementById("cardEmail").innerText = email || "---";
            document.getElementById("cardNascita").innerText = nascita || "---";
            
            // Contatti Telefonici Unificati
            var telStr = FormattaTelefono(tel || "");
            var cellStr = FormattaTelefono(cell || "");
            var htmlContatti = "";
            if (telStr && telStr !== "---") {
                htmlContatti += "<span style='font-weight:900; color:#1e3a8a;'>" + telStr + "</span> <button type='button' onclick=\"SimulaChiamataVoip('" + telStr + "')\" onfocus=\"FocusCampo('Chiama telefono fisso " + telStr + "', this)\" style='background-color:#10b981; color:#fff; border:1px solid #34d399; border-radius:4px; font-size:9px; font-weight:900; cursor:pointer; padding:1px 6px; line-height:1.2; vertical-align:middle; display:inline-block; font-family:\'Outfit\',sans-serif;' title='Avvia chiamata reale a numero fisso'>&#128222; FISSO</button>";
            }
            if (cellStr && cellStr !== "---") {
                if (htmlContatti !== "") htmlContatti += " / ";
                htmlContatti += "<span style='font-weight:900; color:#1e3a8a;'>" + cellStr + "</span> <button type='button' onclick=\"SimulaChiamataVoip('" + cellStr + "')\" onfocus=\"FocusCampo('Chiama cellulare " + cellStr + "', this)\" style='background-color:#06b6d4; color:#fff; border:1px solid #22d3ee; border-radius:4px; font-size:9px; font-weight:900; cursor:pointer; padding:1px 6px; line-height:1.2; vertical-align:middle; display:inline-block; font-family:\'Outfit\',sans-serif;' title='Avvia chiamata reale a cellulare'>&#128241; CELL</button>";
                
                // Pulsante WhatsApp Web rapido
                htmlContatti += " <button type='button' onclick=\"ApriMessaggioWhatsApp('" + cellStr + "', '" + nome.replace(/'/g, "\\'") + "', '" + citta.replace(/'/g, "\\'") + "', '" + invalidita.replace(/'/g, "\\'") + "')\" onfocus=\"FocusCampo('Invia avviso o promemoria WhatsApp al cellulare " + cellStr + "', this)\" style='background-color:#25d366; color:#fff; border:1px solid #128c7e; border-radius:4px; font-size:9px; font-weight:900; cursor:pointer; padding:1px 6px; line-height:1.2; vertical-align:middle; display:inline-block; font-family:\'Outfit\',sans-serif;' title='Invia messaggio promemoria su WhatsApp Web'>&#128172; WA</button>";
            }
            if (htmlContatti === "") htmlContatti = "---";
            document.getElementById("cardTel").innerHTML = htmlContatti;
            
            // Calcolo Meteo Logistico Adaptivo
            var meteoVocalText = DeterminaMeteoLogistico(citta);

            // Stato Badge con Colori Dinamici (Stile Premium CIE 2.0)
            var badge = document.getElementById("cardStatoBadge");
            if (invalidita.toUpperCase().indexOf("CIECO") !== -1) {
                badge.innerHTML = 'CIECO <span style="font-size:12px; margin-left:6px; vertical-align:middle;">??</span>';
                badge.style.backgroundColor = "#ef4444";
                badge.style.background = "linear-gradient(to right, #f59e0b, #ef4444)";
                badge.style.boxShadow = "0 4px 10px rgba(239, 68, 68, 0.3)";
                badge.style.border = "none";
            } else if (invalidita.toUpperCase().indexOf("IPOVEDENTE") !== -1) {
                badge.innerHTML = 'IPOVEDENTE <span style="font-size:12px; margin-left:6px; vertical-align:middle;">???</span>';
                badge.style.backgroundColor = "#2563eb";
                badge.style.background = "linear-gradient(to right, #0ea5e9, #2563eb)";
                badge.style.boxShadow = "0 4px 10px rgba(37, 99, 235, 0.3)";
                badge.style.border = "none";
            } else {
                badge.innerHTML = 'NORMALE';
                badge.style.backgroundColor = "#475569";
                badge.style.background = "linear-gradient(to right, #64748b, #475569)";
                badge.style.boxShadow = "0 4px 10px rgba(71, 85, 105, 0.2)";
                badge.style.border = "none";
            }

            // Codice Identificativo Auto-Generato
            var codId = GeneraCodiceIdentificativo(nome, nascita);
            document.getElementById("cardCodiceId").innerText = codId;

            // Serial Number Foto Box
            var hash = 0;
            for (var idx = 0; idx < nome.length; idx++) {
                hash += nome.charCodeAt(idx);
            }
            var serialNum = ("000" + (hash % 1000)).slice(-3);
            var serialCitta = (citta || "X").charAt(0).toUpperCase();
            document.getElementById("cardPhotoLabel").innerText = serialNum + "-" + serialCitta;

            // Firma Titolare Cursiva
            document.getElementById("cardSignature").innerText = ConvertiInFirma(nome);

            // Caricamento Foto del Cliente (se esiste nella cartella Foto_Clienti)
            var imgContainer = document.getElementById("cardPhotoImgContainer");
            var localPhotoJpg = fso.BuildPath(appPath, "Foto_Clienti\\" + nome.toUpperCase().trim() + ".jpg");
            var localPhotoPng = fso.BuildPath(appPath, "Foto_Clienti\\" + nome.toUpperCase().trim() + ".png");
            var photoUrl = "";
            if (fso.FileExists(localPhotoJpg)) {
                photoUrl = "file:///" + localPhotoJpg.replace(/\\/g, "/") + "?t=" + new Date().getTime();
            } else if (fso.FileExists(localPhotoPng)) {
                photoUrl = "file:///" + localPhotoPng.replace(/\\/g, "/") + "?t=" + new Date().getTime();
            }
            
            if (photoUrl !== "") {
                imgContainer.innerHTML = "<img src='" + photoUrl + "' style='width: 100%; height: 100%; object-fit: cover;' />";
            } else {
                var initials = "";
                var parts = nome.split(" ");
                if (parts.length > 0) initials += parts[0].charAt(0).toUpperCase();
                if (parts.length > 1) initials += parts[parts.length - 1].charAt(0).toUpperCase();
                if (initials === "") initials = "C";
                var colors = [
                    ["#4f46e5", "#312e81"],
                    ["#0891b2", "#164e63"],
                    ["#0d9488", "#115e59"],
                    ["#d97706", "#78350f"],
                    ["#db2777", "#831843"],
                    ["#2563eb", "#1e3a8a"]
                ];
                var colorIdx = nome.length % colors.length;
                var colorPair = colors[colorIdx];
                imgContainer.innerHTML = "<div style='width: 100%; height: 100%; background: linear-gradient(135deg, " + colorPair[0] + ", " + colorPair[1] + "); text-align: center; color: #fff; font-family: sans-serif; font-size: 32px; font-weight: 800; line-height: 90px; text-shadow: 0 2px 4px rgba(0,0,0,0.3); box-sizing: border-box;'>" + initials + "</div>";
            }
            
            // Load previous delivery/colleague notes into CRM Console
            var noteConsegna = "";
            var notes = patientNotes[nome] || [];
            for (var idx = 0; idx < notes.length; idx++) {
                if (notes[idx].text.indexOf("[CONSEGNA]") === 0) {
                    noteConsegna = notes[idx].text.substring(10).trim();
                } else if (notes[idx].text.indexOf("[TELEFONATA]") === 0 && notes[idx].text.indexOf(" | Appunti: ") !== -1) {
                    // Extract note content if no explicit delivery note exists
                    if (noteConsegna === "") {
                        var partsApp = notes[idx].text.split(" | Appunti: ");
                        if (partsApp.length > 1) {
                            noteConsegna = partsApp[1];
                        }
                    }
                }
            }
            var txtCrmNote = document.getElementById("txtCrmNoteLibere");
            if (txtCrmNote) {
                txtCrmNote.value = noteConsegna;
                // Aggiorna contatore caratteri all'apertura del cliente
                AggiornaContatoreCaratteriAppunti();
                ImpostaStatoAppunti("Pronto per inserimento note...", "#64748b");
            }
            // Renderizza post-it del cliente selezionato
            RenderizzaPostitCliente(nome);
            
            // Annuncio vocale o allarme se il cliente selezionato ha post-it attivi
            var postitCliente = postitClienteData[nome] || [];
            if (postitCliente.length > 0) {
                var hasUrgente = false;
                for (var pi = 0; pi < postitCliente.length; pi++) {
                    if (postitCliente[pi].testo.toUpperCase().indexOf("URGENTE") > -1) {
                        hasUrgente = true;
                        break;
                    }
                }
                if (hasUrgente) {
                    setTimeout(function() {
                        Parla("Attenzione! Questo cliente ha un post-it urgente attivo!");
                    }, 500);
                } else {
                    setTimeout(function() {
                        Parla("Questo cliente ha " + postitCliente.length + " post-it attivi.");
                    }, 500);
                }
            }
            
            // Popola l'anagrafica, i codici ISO e fa ripartire il timer telefonico
            AggiornaCrmConsole(nome, invalidita);
            
            // Rende sempre visibile il cruscotto CRM telefonico all'apertura del cliente
            var crmConsoleEl = document.getElementById("callOutcomesPanel");
            if (crmConsoleEl) {
                crmConsoleEl.style.display = "block";
            }

            // Build comprehensive voice synthesis text
            var vocalText = "Cliente " + nome + ". Citt� " + citta + ". Categoria " + invalidita + ". ";

            // Render Timeline Notes (Option 3)
            var timeline = document.getElementById("timelineNotes");
            timeline.innerHTML = "";
            if (notes.length === 0) {
                timeline.innerHTML = "<div style='color:#94a3b8; font-style:italic; font-size:13px;'>Nessuna nota o consegna registrata nel diario per questo cliente.</div>";
                vocalText += "Nessuna nota o consegna registrata nel diario per questo cliente. ";
            } else {
                vocalText += "Diario consegne e note. ";
                for (var i = 0; i < notes.length; i++) {
                    var noteText = notes[i].text;
                    var rawText = notes[i].text;
                    
                    // Determina categoria
                    var category = "ALTRO";
                    if (rawText.indexOf("[CONSEGNA]") === 0 || rawText.indexOf("??") === 0) {
                        category = "CONSEGNA";
                    } else if (rawText.indexOf("[TELEFONATA]") === 0 || rawText.indexOf("[CONFERMATO]") === 0 || 
                               rawText.indexOf("[DA RICHIAMARE]") === 0 || rawText.indexOf("[SQUILLA VUOTO]") === 0 || 
                               rawText.indexOf("[NUMERO ERRATO]") === 0 || rawText.indexOf("??") === 0) {
                        category = "TELEFONATA";
                    }
                    
                    // Determina urgenza
                    var uppercaseText = rawText.toUpperCase();
                    var isUrgent = (uppercaseText.indexOf("URGENTE") > -1 || uppercaseText.indexOf("SUBITO") > -1 || 
                                    uppercaseText.indexOf("GRAVE") > -1 || uppercaseText.indexOf("RITARDO") > -1 ||
                                    uppercaseText.indexOf("??") > -1);
                    
                    if (noteText.indexOf("[CONFERMATO]") === 0) {
                        noteText = noteText.replace("[CONFERMATO]", "?? CONFERMATO: ");
                    } else if (noteText.indexOf("[DA RICHIAMARE]") === 0) {
                        noteText = noteText.replace("[DA RICHIAMARE]", "? DA RICHIAMARE: ");
                    } else if (noteText.indexOf("[SQUILLA VUOTO]") === 0) {
                        noteText = noteText.replace("[SQUILLA VUOTO]", "? SQUILLA VUOTO: ");
                    } else if (noteText.indexOf("[NUMERO ERRATO]") === 0) {
                        noteText = noteText.replace("[NUMERO ERRATO]", "?? NUMERO ERRATO: ");
                    } else if (noteText.indexOf("[CONSEGNA]") === 0) {
                        noteText = noteText.replace("[CONSEGNA]", "?? CONSEGNA PER COLLEGA: ");
                    } else if (noteText.indexOf("[PROMEMORIA]") === 0) {
                        noteText = noteText.replace("[PROMEMORIA]", "? RICHIAMO PROGRAMMATO: ");
                    }
                    
                    var avatar = OttieniAvatarInfo(rawText);
                    
                    var item = document.createElement("div");
                    item.className = "crm-timeline-row";
                    item.setAttribute("data-category", category);
                    item.setAttribute("data-urgent", isUrgent ? "true" : "false");
                    
                    // Determina classe bolla di highlight (Chicca 1)
                    var bubbleClass = "crm-timeline-bubble";
                    if (isUrgent) {
                        bubbleClass += " crm-bubble-urgent";
                    } else if (uppercaseText.indexOf("?") > -1 || uppercaseText.indexOf("??") > -1 || uppercaseText.indexOf("CONSEGNATO") > -1 || uppercaseText.indexOf("COMPLETATO") > -1 || uppercaseText.indexOf("OK") > -1 || uppercaseText.indexOf("[CONFERMATO]") > -1) {
                        bubbleClass += " crm-bubble-ok";
                    } else if (uppercaseText.indexOf("??") > -1 || uppercaseText.indexOf("??") > -1 || uppercaseText.indexOf("SOSTITUZIONE") > -1 || uppercaseText.indexOf("SOSPESO") > -1 || uppercaseText.indexOf("RITIRO") > -1) {
                        bubbleClass += " crm-bubble-warning";
                    } else if (uppercaseText.indexOf("?") > -1 || uppercaseText.indexOf("??") > -1 || uppercaseText.indexOf("ASSENTE") > -1 || uppercaseText.indexOf("ERRATO") > -1 || uppercaseText.indexOf("ANNULLATO") > -1 || uppercaseText.indexOf("RIFIUTATO") > -1) {
                        bubbleClass += " crm-bubble-danger";
                    } else if (uppercaseText.indexOf("??") > -1 || uppercaseText.indexOf("??") > -1 || uppercaseText.indexOf("DA RICONTATTARE") > -1 || uppercaseText.indexOf("TELEFONATA") > -1 || uppercaseText.indexOf("CHIAMA") > -1 || uppercaseText.indexOf("[DA RICHIAMARE]") > -1) {
                        bubbleClass += " crm-bubble-info";
                    }
                    
                    var cleanTextForVoice = noteText.replace(/'/g, " ").replace(/"/g, " ").trim();
                    var voiceLabelDelete = "Elimina nota del " + notes[i].date + ": " + cleanTextForVoice;
                    var voiceLabelEdit = "Modifica nota del " + notes[i].date + ": " + cleanTextForVoice;
                    var voiceLabelContent = "Nota del " + notes[i].date + ": " + cleanTextForVoice + ". Clicca sul pulsante Modifica a destra per modificarla.";
                    
                    var deleteBtnHTML = "<button onclick=\"EliminaNotaDiario(" + i + ")\" " +
                                         "onfocus=\"FocusCampo('" + voiceLabelDelete + "', this)\" " +
                                         "tabindex=\"0\" " +
                                         "style='float:right; background-color:#dc2626; color:#ffffff; border:2px solid #fca5a5; padding:6px 12px; border-radius:6px; font-size:11px; font-weight:900; cursor:pointer; margin-top:4px; outline:none; text-transform:uppercase; letter-spacing:0.5px;' " +
                                         "onmouseover=\"this.style.backgroundColor='#b91c1c'\" " +
                                         "onmouseout=\"this.style.backgroundColor='#dc2626'\">" +
                                         "ELIMINA</button>";
                                         
                    var editBtnHTML = "<button onclick=\"ModificaNotaDiario(" + i + ")\" " +
                                       "onfocus=\"FocusCampo('" + voiceLabelEdit + "', this)\" " +
                                       "tabindex=\"0\" " +
                                       "style='float:right; background-color:#2563eb; color:#ffffff; border:2px solid #93c5fd; padding:6px 12px; border-radius:6px; font-size:11px; font-weight:900; cursor:pointer; margin-top:4px; margin-right:8px; outline:none; text-transform:uppercase; letter-spacing:0.5px;' " +
                                       "onmouseover=\"this.style.backgroundColor='#1d4ed8'\" " +
                                       "onmouseout=\"this.style.backgroundColor='#2563eb'\">" +
                                       "MODIFICA</button>";
                    
                    var avatarHTML = "<div class='crm-timeline-avatar' style='background-color:" + avatar.color + ";' title='Operatore: " + avatar.initials + "'>" + avatar.initials + "</div>";
                    
                    item.innerHTML = avatarHTML +
                                     "<div class='" + bubbleClass + "'>" +
                                     deleteBtnHTML + editBtnHTML +
                                     "  <div ondblclick=\"ModificaNotaDiario(" + i + ")\" " +
                                     "  onfocus=\"FocusCampo('" + voiceLabelContent + "', this)\" " +
                                     "  tabindex=\"0\" " +
                                     "  title='Clicca sul pulsante Modifica a destra (o fai doppio click qui) per modificare questa nota' " +
                                     "  style='margin-right:215px; text-align:left; cursor:pointer; outline:none;'>" +
                                     "    <span style='font-size:11px; color:#38bdf8; font-weight:bold; display:block;'>" + notes[i].date + " (doppio click per modificare)</span>" +
                                     "    <span style='font-size:13px; color:#f1f5f9; display:block; margin-top:2px; font-weight:700;'>" + noteText + "</span>" +
                                     "  </div>" +
                                     "  <div style='clear:both;'></div>" +
                                     "</div>";
                                     
                    timeline.appendChild(item);
                    vocalText += "Nota del " + notes[i].date + ": " + noteText + ". ";
                }
                
                // Sincronizza i filtri della timeline senza annuncio acustico/vocale
                if (activeTimelineCategory !== "ALL") {
                    var items = timeline.children;
                    for (var i = 0; i < items.length; i++) {
                        var item = items[i];
                        var itemCat = item.getAttribute("data-category");
                        var isUrgent = item.getAttribute("data-urgent") === "true";
                        if (activeTimelineCategory === "URGENTE") {
                            item.style.display = isUrgent ? "flex" : "none";
                        } else {
                            item.style.display = (itemCat === activeTimelineCategory) ? "flex" : "none";
                        }
                    }
                }
            }

            var corpo = document.getElementById("risultatiCorpo");
            corpo.innerHTML = "";

            var foundCount = 0;
            var targetPulito = PulishNome(nome);
            var devicesText = "";
            var hasUrgentRenewal = false;

            AggiungiAttivita("?? CLIENTE SELEZIONATO: " + nome + " (" + invalidita.toUpperCase() + ")");

            var activeDevices = [];
            for(var i=0; i<allData.length; i++) {
                var p = allData[i];
                var pNomePulito = PulishNome(p[0]);

                if (pNomePulito === targetPulito && p[1] !== "NESSUN AUSILIO") {
                    activeDevices.push(p[1].toUpperCase().trim());
                    var dt = new Date(p[2]);
                    var dS = new Date(dt.getFullYear() + 6, dt.getMonth(), dt.getDate());
                    var oggi = new Date();
                    
                    var perc = Math.round(((oggi.getTime() - dt.getTime()) / (dS.getTime() - dt.getTime())) * 100);
                    if (perc > 100) perc = 100; if (perc < 0) perc = 0;
                    var isOk = oggi > dS;
                    if (isOk) {
                        hasUrgentRenewal = true;
                    }
                    
                    var giorniMancanti = Math.ceil((dS.getTime() - oggi.getTime()) / (1000 * 3600 * 24));
                    var testoStato = isOk ? "IDONEO" : (giorniMancanti + " GG AL RINNOVO");
                    
                    var sep = SeparaNomeEISO(p[1]);
                    var statoVoice = isOk ? "idoneo al rinnovo" : ("mancano " + giorniMancanti + " giorni al rinnovo");
                    devicesText += sep.name + ", " + statoVoice + ". ";

                    var btnEditCode = "<button onclick=\"ModificaCodiceDispositivo('" + encodeURIComponent(p[0]) + "', '" + encodeURIComponent(p[1]) + "', '" + encodeURIComponent(p[2]) + "')\" class=\"btn-action\" style=\"padding: 3px 8px; font-size:11px; margin-left: 12px; background:#f97316; border:1px solid #ffedd5; vertical-align:middle; cursor:pointer; border-radius:6px; font-weight:800;\" onfocus=\"FocusCampo('Modifica codice dispositivo " + sep.name.replace(/'/g, "\\'") + "', this)\" tabindex=\"0\" title=\"Inserisci o modifica il codice ISO di questo articolo\">?? CODICE</button>";
                    var row = document.createElement("div");
                    row.className = "res-row";
                    row.tabIndex = 0;
                    var labelVoice = "Dispositivo consegnato: " + sep.name.replace(/'/g, " ") + ". " +
                                     "Fornito il: " + dt.toLocaleDateString() + ". " +
                                     "Data di sblocco: " + dS.toLocaleDateString() + ". " +
                                     "Stato: " + (isOk ? "Idoneo al rinnovo" : ("Mancano " + giorniMancanti + " giorni al rinnovo."));
                    row.setAttribute("aria-label", labelVoice);
                    row.onfocus = new Function("FocusCampo('" + labelVoice.replace(/'/g, "\\'") + "', this)");
                    row.innerHTML = "<span class='res-title'>" + p[1] + btnEditCode + "</span>" +
                                    "<span class='res-dates'>Fornito: " + dt.toLocaleDateString() + " | Sblocco: " + dS.toLocaleDateString() + "</span>" +
                                    "<div class='res-status " + (isOk ? "s-green" : "s-blue") + "'>" + testoStato + "</div>" +
                                    "<div class='progress-track'><div class='progress-bar' style='width:"+perc+"%; background-color:"+(isOk ? "#22c55e" : "#3b82f6")+"'></div></div>";
                    corpo.appendChild(row);
                    foundCount++;
                }
            }
            
            // Promotore Logistico Attivo ("Diritti Non Riscattati")
            try {
                var upperInv = invalidita.toUpperCase();
                var eligibleDevices = [];
                if (upperInv.indexOf("CIECO") > -1) {
                    eligibleDevices = ["DISPLAY BRAILLE", "SINTESI VOCALE", "DAISY PLAYER"];
                } else if (upperInv.indexOf("IPOVEDENT") > -1) {
                    eligibleDevices = ["VIDEOINGRANDITORE", "MACCHINA DI LETTURA", "SCREEN READER"];
                }
                
                var missingDevices = [];
                for (var d = 0; d < eligibleDevices.length; d++) {
                    var foundDevice = false;
                    for (var a = 0; a < activeDevices.length; a++) {
                        if (activeDevices[a].indexOf(eligibleDevices[d]) > -1 || eligibleDevices[d].indexOf(activeDevices[a]) > -1) {
                            foundDevice = true;
                            break;
                        }
                    }
                    if (!foundDevice) {
                        missingDevices.push(eligibleDevices[d]);
                    }
                }
                
                var promoterBadge = document.getElementById("cardPromoterBadge");
                if (promoterBadge) {
                    if (missingDevices.length > 0) {
                        promoterBadge.style.display = "inline-block";
                        var txtDiritti = missingDevices.length === 1 ? "1 DIRITTO NON RISCATTATO" : missingDevices.length + " DIRITTI NON RISCATTATI";
                        promoterBadge.innerHTML = "&#127873; " + txtDiritti;
                        var titleText = "Dispositivi agevolati da nomenclatore non ancora ritirati:\n� " + missingDevices.join("\n� ");
                        promoterBadge.title = titleText;
                        
                        // Arricchiamo il testo vocale
                        vocalText += "Attenzione: " + txtDiritti + " da nomenclatore! Il cliente ha diritto a ritirare: " + missingDevices.join(", ") + ". ";
                    } else {
                        promoterBadge.style.display = "none";
                    }
                }
            } catch(exProm) {}
            
            // Gestione visiva e vocale per rinnovo urgente
            var alertEl = document.getElementById("cardRenewalAlert");
            if (alertEl) {
                if (hasUrgentRenewal) {
                    alertEl.style.display = "block";
                    vocalText += "Attenzione! Trovato ausilio idoneo al rinnovo urgente! ";
                    AggiungiAttivita("?? ATTENZIONE: Trovato ausilio idoneo al rinnovo urgente per il cliente " + nome);
                } else {
                    alertEl.style.display = "none";
                }
            }
            
            document.getElementById("debugCount").innerText = "RISULTATI TROVATI: " + foundCount;
            if (foundCount === 0) {
                corpo.innerHTML = "<div style='text-align:center; padding:50px; opacity:0.5;'>NESSUN DISPOSITIVO TROVATO PER QUESTO CLIENTE</div>";
                vocalText += "Nessun ausilio consegnato per questo cliente.";
            } else {
                vocalText += "Dispositivi consegnati: " + devicesText;
            }

            // ?? Popolamento Ausili di Diritto
            var divDiritto = document.getElementById("ausiliDirittoCorpo");
            if (divDiritto) {
                divDiritto.innerHTML = "";
                
                var invClean = invalidita.toUpperCase();
                var eligibleAids = [];
                
                if (invClean.indexOf("CIECO") > -1) {
                    eligibleAids = [
                        { name: "Display Braille 40 Celle", code: "22.39.05.003" },
                        { name: "Sintesi Vocale Software", code: "22.39.07.003" },
                        { name: "Lettore di Schermo (Screen Reader)", code: "22.39.12.003" },
                        { name: "Sistema OCR Autonomo di Lettura", code: "22.30.21.006" },
                        { name: "Bastone Bianco per Orientamento", code: "12.39.03.003" }
                    ];
                } else if (invClean.indexOf("IPOVEDENTE") > -1) {
                    eligibleAids = [
                        { name: "Videoingranditore da Tavolo", code: "22.03.18.003" },
                        { name: "Videoingranditore Portatile", code: "22.03.18.006" },
                        { name: "Software Ingrandente per PC", code: "22.39.12.009" },
                        { name: "Lente d'Ingrandimento Elettronica", code: "22.03.09.003" }
                    ];
                }
                
                if (eligibleAids.length === 0) {
                    divDiritto.innerHTML = "<div style='background-color:#1e293b; border: 1px dashed #475569; padding: 15px; border-radius:10px; color:#94a3b8; text-align:center; font-size:12px; font-weight:bold;'>" +
                                           "?? NESSUN NOMENCLATORE ATTIVO PER QUESTA INVALIDIT�.<br>" +
                                           "<span style='font-size:11px; color:#64748b; font-weight:600;'>Imposta lo stato invalidit� su 'CIECO' o 'IPOVEDENTE' tramite 'Modifica Cliente' per sbloccare i diritti.</span>" +
                                           "</div>";
                } else {
                    // Recuperiamo i dispositivi attivi reali del paziente
                    var userActiveDevices = {};
                    var targetNomeClean = PulishNome(nome);
                    for (var i = 0; i < allData.length; i++) {
                        var p = allData[i];
                        if (PulishNome(p[0]) === targetNomeClean && p[1] !== "NESSUN AUSILIO") {
                            var sep = SeparaNomeEISO(p[1]);
                            userActiveDevices[sep.name.toUpperCase()] = p[2]; // Salva la data di fornitura
                        }
                    }
                    
                    for (var k = 0; k < eligibleAids.length; k++) {
                        var aid = eligibleAids[k];
                        var alreadyUsed = false;
                        var usedDate = "";
                        
                        var aidNameUpper = aid.name.toUpperCase();
                        for (var activeDev in userActiveDevices) {
                            if (activeDev.indexOf(aidNameUpper) > -1 || aidNameUpper.indexOf(activeDev) > -1) {
                                alreadyUsed = true;
                                usedDate = userActiveDevices[activeDev];
                                break;
                            }
                        }
                        
                        var row = document.createElement("div");
                        row.className = "eligible-aid-row";
                        row.tabIndex = 0;
                        row.style.padding = "12px 15px";
                        row.style.borderRadius = "10px";
                        row.style.marginBottom = "10px";
                        row.style.border = "1px solid " + (alreadyUsed ? "#059669" : "#334155");
                        row.style.backgroundColor = alreadyUsed ? "rgba(6, 78, 59, 0.4)" : "#0f172a";
                        row.style.overflow = "hidden";
                        
                        var badgeHTML = alreadyUsed 
                            ? "<span style='background-color:#059669; color:#fff; font-weight:900; font-size:10px; padding:3px 8px; border-radius:5px; display:inline-block; vertical-align:middle; text-transform:uppercase;'>?? IN USO</span>"
                            : "<span style='background-color:#475569; color:#f8fafc; font-weight:900; font-size:10px; padding:3px 8px; border-radius:5px; display:inline-block; vertical-align:middle; text-transform:uppercase;'>? DISPONIBILE (Non Richiesto)</span>";
                        
                        var dataFormattata = (usedDate && usedDate !== "NULL" && usedDate !== "undefined") ? new Date(usedDate).toLocaleDateString() : "---";
                        var detailsHTML = alreadyUsed
                            ? "<span style='color:#a7f3d0; font-size:11px; display:block; margin-top:4px; font-weight:bold;'>Fornito il: " + dataFormattata + " | Codice ISO: " + aid.code + "</span>"
                            : "<span style='color:#64748b; font-size:11px; display:block; margin-top:4px; font-weight:bold;'>Codice ISO Nomenclatore: " + aid.code + "</span>";
                        
                        var actionButton = "";
                        if (!alreadyUsed) {
                            actionButton = "<button onclick=\"MostraModalAssegnaAusilio('" + nome.replace(/'/g, "\\'") + "', '" + aid.name.replace(/'/g, "\\'") + "', '" + aid.code + "')\" class=\"btn-action\" style=\"float:right; margin:0; background-color:#10b981; border:1px solid #86efac; color:#fff; font-weight:900; padding:6px 12px; border-radius:6px; cursor:pointer; font-size:11px;\" onfocus=\"FocusCampo('Assegna dispositivo " + aid.name.replace(/'/g, "\\'") + "', this)\" tabindex=\"0\">? ASSEGNA ORA</button>";
                        }
                        
                        var labelDirittoVoice = "Ausilio da Nomenclatore: " + aid.name.replace(/'/g, " ") + ". " +
                                                "Codice ISO: " + aid.code + ". " +
                                                "Stato: " + (alreadyUsed ? ("Gi� in uso, fornito il " + dataFormattata) : "Disponibile e non ancora richiesto.");
                        row.setAttribute("aria-label", labelDirittoVoice);
                        row.onfocus = new Function("FocusCampo('" + labelDirittoVoice.replace(/'/g, "\\'") + "', this)");
                        
                        row.innerHTML = actionButton +
                                        "<div style='margin-right:110px; text-align:left;'>" +
                                        "  <span style='font-size:14px; font-weight:800; color:" + (alreadyUsed ? "#a7f3d0" : "#f8fafc") + "; display:inline-block; vertical-align:middle; margin-right:10px;'>" + aid.name + "</span>" +
                                        badgeHTML +
                                        detailsHTML +
                                        "</div>";
                        
                        divDiritto.appendChild(row);
                    }
                }
            }

            // Speak comprehensive report with adaptive weather warning
            if (typeof meteoVocalText !== "undefined") {
                vocalText += " " + meteoVocalText;
            }
            ultimoVocalText = vocalText;
            Parla(vocalText);
        }

        // Controllers per la Registrazione di Nuovi Clienti
        function ApriModalNuovoCliente() {
            document.getElementById("newNome").value = "";
            document.getElementById("newCitta").value = "BARI";
            document.getElementById("newProv").value = "BA";
            document.getElementById("newInv").selectedIndex = 0;
            document.getElementById("newNascita").value = "";
            document.getElementById("newTel").value = "";
            document.getElementById("newCell").value = "";
            document.getElementById("newEmail").value = "";
            
            document.getElementById("modalAddClient").style.display = "block";
            Parla("Registrazione nuovo cliente. Compilare i dati.");
            setTimeout(function() {
                try { document.getElementById("newNome").focus(); } catch(e){}
            }, 100);
        }
        
        function ChiudiModalAddClient() {
            document.getElementById("modalAddClient").style.display = "none";
        }
        
        function SalvaNuovoCliente() {
            var nome = document.getElementById("newNome").value.trim().toUpperCase();
            var citta = document.getElementById("newCitta").value.trim().toUpperCase();
            var prov = document.getElementById("newProv").value.trim().toUpperCase();
            var invEl = document.getElementById("newInv");
            var inv = invEl.options[invEl.selectedIndex].value;
            var nascita = document.getElementById("newNascita").value.trim();
            var tel = document.getElementById("newTel").value.trim();
            if (tel === "") tel = "---";
            var cell = document.getElementById("newCell").value.trim();
            if (cell === "") cell = "---";
            var email = document.getElementById("newEmail").value.trim();
            if (email === "") email = "---";
            
            if (nome === "") { Parla("Il nome e cognome � obbligatorio!"); alert("Il nome e cognome � obbligatorio!"); return; }
            if (citta === "") { Parla("La citt� � obbligatoria!"); alert("La citt� � obbligatoria!"); return; }
            if (nascita === "") { Parla("La data di nascita � obbligatoria!"); alert("La data di nascita � obbligatoria!"); return; }
            
            var line = nome + "|NESSUN AUSILIO|NULL|---|" + inv + "|" + citta + "|" + prov + "|" + nascita + "|" + email + "|" + tel + "|" + cell + "|MANUALE";
            
            try {
                var f = fso.OpenTextFile(dataFile, 8); // Append
                f.WriteLine(SanitizeForFSO(line));
                f.Close();
                
                ChiudiModalAddClient();
                RiproduciSuono("tada");
                Parla("Nuovo cliente registrato con successo!");
                alert("Nuovo cliente registrato con successo!");
                AggiungiAttivita("?? ANAGRAFICA: Registrato nuovo cliente locale " + nome + " (" + inv.toUpperCase() + ")");
                CaricaArchivio();
                
                var targetPulito = PulishNome(nome);
                var cards = document.getElementsByClassName("item-card");
                for (var i = 0; i < cards.length; i++) {
                    if (PulishNome(cards[i].getElementsByClassName("name-main")[0].innerText) === targetPulito) {
                        cards[i].click();
                        cards[i].scrollIntoView();
                        break;
                    }
                }
            } catch(e) { alert("Errore nel salvataggio: " + e.message); }
        }

        // Controllers per l'Assegnazione degli Ausili di Diritto
        var tempAssignCliente = "";
        var tempAssignDevice = "";
        
        function MostraModalAssegnaAusilio(nome, deviceName, deviceCode) {
            tempAssignCliente = nome;
            tempAssignDevice = deviceName + " " + deviceCode;
            
            document.getElementById("assignAidCliente").innerText = nome;
            document.getElementById("assignAidDispositivo").innerText = tempAssignDevice;
            
            // Imposta la data odierna come default in formato YYYY-MM-DD
            var oggi = new Date();
            var dataDefault = oggi.getFullYear() + "-" + ("0" + (oggi.getMonth() + 1)).slice(-2) + "-" + ("0" + oggi.getDate()).slice(-2);
            document.getElementById("assignAidData").value = dataDefault;
            
            document.getElementById("modalAssignAid").style.display = "block";
            setTimeout(function() {
                try { document.getElementById("assignAidData").focus(); } catch(e){}
            }, 100);
        }
        
        function ChiudiModalAssignAid() {
            document.getElementById("modalAssignAid").style.display = "none";
        }
        
        function EseguiAssegnazioneAusilio() {
            var dataForn = document.getElementById("assignAidData").value.trim();
            if (dataForn === "") {
                alert("La data di fornitura � obbligatoria!");
                return;
            }
            
            try {
                if (fso.FileExists(dataFile)) {
                    var fRead = fso.OpenTextFile(dataFile, 1);
                    var content = fRead.ReadAll();
                    fRead.Close();
                    
                    var lines = content.split("\n");
                    var updatedLines = [];
                    var hasNessunAusilio = false;
                    var nessunAusilioIndex = -1;
                    
                    var targetNomeClean = PulishNome(tempAssignCliente);
                    
                    for (var i = 0; i < lines.length; i++) {
                        var line = lines[i];
                        if (line.trim() === "") continue;
                        var p = line.split("|");
                        var pNomeClean = PulishNome(p[0]);
                        
                        if (pNomeClean === targetNomeClean) {
                            if (p[1].trim() === "NESSUN AUSILIO") {
                                hasNessunAusilio = true;
                                nessunAusilioIndex = i;
                            }
                        }
                        updatedLines.push(line);
                    }
                    
                    if (hasNessunAusilio && nessunAusilioIndex > -1) {
                        var p = lines[nessunAusilioIndex].split("|");
                        p[1] = tempAssignDevice;
                        p[2] = dataForn;
                        updatedLines[nessunAusilioIndex] = p.join("|");
                    } else {
                        var anagraficaTrovata = false;
                        var citta = "", prov = "", inv = "", nascita = "", email = "", tel = "", cell = "";
                        for (var i = 0; i < lines.length; i++) {
                            var line = lines[i];
                            if (line.trim() === "") continue;
                            var p = line.split("|");
                            if (PulishNome(p[0]) === targetNomeClean) {
                                inv = p[4] || "";
                                citta = p[5] || "";
                                prov = p[6] || "";
                                nascita = p[7] || "";
                                email = p[8] || "";
                                tel = p[9] || "";
                                cell = p[10] || "";
                                anagraficaTrovata = true;
                                break;
                            }
                        }
                        
                        var newLine = tempAssignCliente + "|" + tempAssignDevice + "|" + dataForn + "|---|" + inv + "|" + citta + "|" + prov + "|" + nascita + "|" + email + "|" + tel + "|" + cell;
                        updatedLines.push(newLine);
                    }
                    
                    var fWrite = fso.OpenTextFile(dataFile, 2, true);
                    fWrite.Write(SanitizeForFSO(updatedLines.join("\n") + "\n"));
                    fWrite.Close();
                    
                    ChiudiModalAssignAid();
                    RiproduciSuono("tada");
                    Parla("Ausilio assegnato con successo!");
                    alert("Ausilio assegnato con successo!");
                    AggiungiAttivita("?? DISPOSITIVO: Consegnato ausilio '" + tempAssignDevice + "' in data " + dataForn + " al cliente " + tempAssignCliente);
                    CaricaArchivio();
                    
                    // Riapri la scheda cliente
                    var cards = document.getElementsByClassName("item-card");
                    for (var i = 0; i < cards.length; i++) {
                        var cardName = cards[i].getElementsByClassName("name-main")[0].innerText;
                        if (PulishNome(cardName) === targetNomeClean) {
                            cards[i].click();
                            break;
                        }
                    }
                }
            } catch(e) {
                alert("Errore nell'assegnazione dell'ausilio: " + e.message);
            }
        }

        function EliminaClienteSelezionato() {
            var nome = document.getElementById("mainNome").innerText;
            if (!nome || nome === "") {
                alert("Nessun cliente selezionato!");
                return;
            }
            
            var confirmMsg = "ATTENZIONE! Sei sicuro di voler eliminare definitivamente '" + nome + "' e tutta la sua storia dal sistema?\n\nQuesta azione non pu� essere annullata!";
            if (confirm(confirmMsg)) {
                try {
                    if (fso.FileExists(dataFile)) {
                        var fRead = fso.OpenTextFile(dataFile, 1);
                        var content = fRead.ReadAll();
                        fRead.Close();
                        
                        var lines = content.split("\n");
                        var updatedLines = [];
                        var targetNomeClean = PulishNome(nome);
                        var removedCount = 0;
                        
                        for (var i = 0; i < lines.length; i++) {
                            var line = lines[i];
                            if (line.trim() === "") continue;
                            var p = line.split("|");
                            if (PulishNome(p[0]) === targetNomeClean) {
                                removedCount++;
                                continue;
                            }
                            updatedLines.push(line);
                        }
                        
                        var fWrite = fso.OpenTextFile(dataFile, 2, true);
                        fWrite.Write(updatedLines.join("\n") + "\n");
                        fWrite.Close();
                        
                        RiproduciSuono("tada");
                        Parla("Cliente " + nome + " eliminato con successo.");
                        alert("Cliente " + nome + " eliminato con successo! Rimosse " + removedCount + " righe storiche.");
                        AggiungiAttivita("??? ELIMINAZIONE: Rimosso completamente dal database il cliente " + nome + " (" + removedCount + " righe di storico cancellate).");
                        
                        // Nascondi la scheda e rinfresca la lista
                        document.getElementById("boxMain").style.display = "none";
                        document.getElementById("boxEmpty").style.display = "block";
                        
                        CaricaArchivio();
                    }
                } catch(e) {
                    alert("Errore durante l'eliminazione del cliente: " + e.message);
                }
            }
        }

        function RipetiLetturaAttiva() {
            if (ultimoVocalText !== "") {
                Parla(ultimoVocalText);
            } else {
                Parla("Nessun cliente selezionato.");
            }
        }

