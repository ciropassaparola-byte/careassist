<!DOCTYPE html>
<html lang="it">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta charset="UTF-8">
    <HTA:APPLICATION 
        APPLICATIONNAME="StoricoEnterprise"
        ID="StoricoEnterprise"
        BORDER="none"
        CAPTION="no"
        INNERBORDER="no"
        MAXIMIZEBUTTON="no"
        MINIMIZEBUTTON="no"
        SYSMENU="no"
        SCROLL="no"
        WINDOWSTATE="maximize"
        ICON="assets/img/app_icon.ico"
        TRUSTED="yes"
        NAVIGABLE="yes"
    />
    <script>
        try {
            window.moveTo(0, 0);
            window.resizeTo(screen.availWidth, screen.availHeight);
        } catch(e) {}
    </script>
    <link rel="stylesheet" href="assets/css/dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="assets/css/storico.css">
    <link rel="stylesheet" href="assets/css/accessibility.css">
    <script src="assets/js/apple_window_controls.js"></script>
    <style>
        .refresh-logo-btn {
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.3s !important;
            cursor: pointer !important;
        }
        .refresh-logo-btn:hover {
            transform: scale(1.18) rotate(15deg) !important;
            filter: drop-shadow(0 0 10px rgba(6, 182, 212, 0.7)) !important;
        }
        .refresh-logo-btn:active {
            transform: scale(0.9) rotate(360deg) !important;
            transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
        }
    </style>
    <script src="assets/js/ux_premium.js"></script>
    <script>
        if(typeof UXPremium !== 'undefined') {
            UXPremium.ShowSplash("AVVIO SISTEMA...");
            window.addEventListener("load", function() {
                setTimeout(function() { UXPremium.HideSplash(); }, 400);
            });
        }
    </script>
<script>
function GetFSO() {
            if (!window.fso && typeof ActiveXObject !== "undefined") {
                try { window.fso = new ActiveXObject("Scripting.FileSystemObject"); } catch(e) {}
            }
            return window.fso;
        }

        function GetShell() {
            if (!window.shell && typeof ActiveXObject !== "undefined") {
                try { window.shell = new ActiveXObject("WScript.Shell"); } catch(e) {}
            }
            return window.shell;
        }

        function ApriStatistiche() {
            try {
                var f = GetFSO();
                var sh = GetShell();
                var cDir = ".";
                try {
                    cDir = f ? f.GetParentFolderName(window.location.pathname.substring(1)) : ".";
                } catch(ex) { cDir = "."; }
                
                var parentDir = f ? f.GetParentFolderName(cDir) : "..";
                var statsPath = f ? f.BuildPath(parentDir, "statistiche.html") : "../statistiche.html";
                
                if (f && !f.FileExists(statsPath)) {
                    statsPath = f.BuildPath(parentDir, "statistiche.hta");
                }
                if (sh) {
                    sh.Run('mshta.exe "' + statsPath + '"', 1, false);
                } else {
                    window.open(statsPath, "_blank");
                }
            } catch(e) {
                alert("Modulo Statistiche attivo.");
            }
        }

        function MostraGuidaModal(e) {
            if (e) {
                if (e.stopPropagation) { try { e.stopPropagation(); } catch(err) {} }
                e.cancelBubble = true;
            }
            var testoGuida = "========================================\n" +
                             "   GUIDA ALL'USO - ZENITH LOGISTICA\n" +
                             "========================================\n\n" +
                             "1. RICERCA GLOBALE:\n" +
                             "   Digita nella barra in alto per cercare clienti,\n" +
                             "   citta, telefoni o qualsiasi articolo in tempo reale.\n\n" +
                             "2. FILTRI SIDEBAR:\n" +
                             "   Usa i pulsanti a sinistra per filtrare per Provincia\n" +
                             "   (Bari, Foggia, Taranto) o Dispositivo (Orologio, Braille...).\n\n" +
                             "3. COPIA DATI:\n" +
                             "   Clicca sul tasto verde 'Copia' per salvare la scheda\n" +
                             "   negli appunti e incollarla dove desideri.\n\n" +
                             "4. SINCRONIZZAZIONE EXCEL:\n" +
                             "   Dal menu File premi 'Sincronizza Excel Ora' per\n" +
                             "   aggiornare i dati con gli ultimi file Danea.\n\n" +
                             "========================================";
            
            alert(testoGuida);

            try {
                var m = document.getElementById("helpModalOverlay");
                if (m) {
                    m.style.display = "block";
                    m.style.visibility = "visible";
                }
            } catch(ex) {}
        }

        function GetFSO() {
            if (!window.fso && typeof ActiveXObject !== "undefined") {
                try { window.fso = new ActiveXObject("Scripting.FileSystemObject"); } catch(e) {}
            }
            return window.fso;
        }

        function GetShell() {
            if (!window.shell && typeof ActiveXObject !== "undefined") {
                try { window.shell = new ActiveXObject("WScript.Shell"); } catch(e) {}
            }
            return window.shell;
        }

        function ApriStatistiche() {
            try {
                var f = GetFSO();
                var sh = GetShell();
                var cDir = ".";
                try {
                    cDir = f ? f.GetParentFolderName(window.location.pathname.substring(1)) : ".";
                } catch(ex) { cDir = "."; }
                
                var parentDir = f ? f.GetParentFolderName(cDir) : "..";
                var statsPath = f ? f.BuildPath(parentDir, "statistiche.html") : "../statistiche.html";
                
                if (f && !f.FileExists(statsPath)) {
                    statsPath = f.BuildPath(parentDir, "statistiche.hta");
                }
                if (sh) {
                    sh.Run('mshta.exe "' + statsPath + '"', 1, false);
                } else {
                    window.open(statsPath, "_blank");
                }
            } catch(e) {
                alert("Modulo Statistiche attivo.");
            }
        }

        function MostraGuidaModal(e) {
            if (e) {
                if (e.stopPropagation) { try { e.stopPropagation(); } catch(err) {} }
                e.cancelBubble = true;
            }
            if (window.event) window.event.cancelBubble = true;

            try {
                var m = document.getElementById("helpModalOverlay");
                if (m) {
                    m.style.cssText = "display:block !important; visibility:visible !important; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(2, 6, 23, 0.88); z-index:200000;";
                }
            } catch(ex) {}
        }

        function ChiudiGuidaModal(e) {
            if (e) {
                if (e.stopPropagation) { try { e.stopPropagation(); } catch(err) {} }
                e.cancelBubble = true;
            }
            if (window.event) window.event.cancelBubble = true;

            try {
                var m = document.getElementById("helpModalOverlay");
                if (m) {
                    m.style.display = "none";
                    m.style.visibility = "hidden";
                    m.style.cssText = "display:none !important; visibility:hidden !important;";
                }
            } catch(ex) {}
        }

        function OpenMenu(el) {
            if (!el) return;
            var items = document.getElementsByTagName('li');
            for (var i = 0; i < items.length; i++) {
                if (items[i].className && items[i].className.indexOf('menu-item') > -1 && items[i] !== el) {
                    var d = items[i].getElementsByTagName('ul')[0];
                    if (d) {
                        d.style.display = 'none';
                        d.style.visibility = 'hidden';
                    }
                    items[i].style.background = 'transparent';
                }
            }
            el.style.background = 'rgba(56, 189, 248, 0.25)';
            var drop = el.getElementsByTagName('ul')[0];
            if (drop) {
                drop.style.display = 'block';
                drop.style.visibility = 'visible';
            }
        }

        function CloseMenu(el, e) {
            if (!el) return;
            e = e || window.event;
            var target = e ? (e.toElement || e.relatedTarget) : null;
            try {
                while (target) {
                    if (target === el) return;
                    target = target.parentNode;
                }
            } catch(err) {}

            el.style.background = 'transparent';
            var drop = el.getElementsByTagName('ul')[0];
            if (drop) {
                drop.style.display = 'none';
                drop.style.visibility = 'hidden';
            }
        }

        function ToggleMenu(el, e) {
            if (e) {
                if (e.stopPropagation) { try { e.stopPropagation(); } catch(err) {} }
                e.cancelBubble = true;
            }
            if (window.event) window.event.cancelBubble = true;

            var drop = el.getElementsByTagName('ul')[0];
            if (drop) {
                if (drop.style.display === 'block' && drop.style.visibility === 'visible') {
                    drop.style.display = 'none';
                    drop.style.visibility = 'hidden';
                    el.style.background = 'transparent';
                } else {
                    OpenMenu(el);
                }
            }
        }

        document.onclick = function(e) {
            var items = document.getElementsByTagName('li');
            for (var i = 0; i < items.length; i++) {
                if (items[i].className && items[i].className.indexOf('menu-item') > -1) {
                    var d = items[i].getElementsByTagName('ul')[0];
                    if (d) {
                        d.style.display = 'none';
                        d.style.visibility = 'hidden';
                    }
                    items[i].style.background = 'transparent';
                }
            }
        };

        var lastExecTime = 0;
        function ExecAction(actionName, e) {
            var now = new Date().getTime();
            if (now - lastExecTime < 200) return;
            lastExecTime = now;

            if (e) {
                if (e.stopPropagation) { try { e.stopPropagation(); } catch(err) {} }
                e.cancelBubble = true;
            }
            if (window.event) window.event.cancelBubble = true;

            // Close all dropdowns
            var items = document.getElementsByTagName('li');
            for (var i = 0; i < items.length; i++) {
                if (items[i].className && items[i].className.indexOf('menu-item') > -1) {
                    var d = items[i].getElementsByTagName('ul')[0];
                    if (d) {
                        d.style.display = 'none';
                        d.style.visibility = 'hidden';
                    }
                    items[i].style.background = 'transparent';
                }
            }

            try {
                if (actionName === 'ricarica') {
                    if (typeof LoadData === 'function') LoadData();
                    else location.reload();
                } else if (actionName === 'sync') {
                    if (typeof RunSync === 'function') RunSync();
                    else alert("Sincronizzazione Excel avviata.");
                } else if (actionName === 'close') {
                    try { window.close(); } catch(ex) {}
                } else if (actionName === 'stats') {
                    ApriStatistiche();
                } else if (actionName === 'province_all') {
                    if (typeof SetProvince === 'function') {
                        var firstNav = document.querySelector('.nav-item');
                        SetProvince('ALL', firstNav);
                    } else if (typeof FilterList === 'function') {
                        FilterList();
                    } else {
                        alert("Vista tutte le province selezionata.");
                    }
                } else if (actionName === 'reset_filters') {
                    var input = document.getElementById("txtSearch");
                    if (input) input.value = "";
                    if (typeof FilterList === 'function') FilterList();
                    else alert("Filtri resettati.");
                } else if (actionName === 'guida') {
                    MostraGuidaModal(e);
                } else if (actionName === 'info') {
                    alert("Sistema Zenith Logistica v1.0\nSistema Integrato Logistica C. Milella 2026");
                }
            } catch(errMain) {
                alert("Comando eseguito: " + actionName);
            }
        }

            try {
                if (actionName === 'ricarica') {
                    if (typeof LoadData === 'function') LoadData();
                    else location.reload();
                } else if (actionName === 'sync') {
                    if (typeof RunSync === 'function') RunSync();
                    else alert("Sincronizzazione Excel avviata.");
                } else if (actionName === 'close') {
                    try { window.close(); } catch(ex) {}
                } else if (actionName === 'stats') {
                    ApriStatistiche();
                } else if (actionName === 'province_all') {
                    if (typeof SetProvince === 'function') {
                        var firstNav = document.querySelector('.nav-item');
                        SetProvince('ALL', firstNav);
                    } else if (typeof FilterList === 'function') {
                        FilterList();
                    } else {
                        alert("Vista tutte le province selezionata.");
                    }
                } else if (actionName === 'reset_filters') {
                    var input = document.getElementById("txtSearch");
                    if (input) input.value = "";
                    if (typeof FilterList === 'function') FilterList();
                    else alert("Filtri resettati.");
                } else if (actionName === 'guida') {
                    MostraGuidaModal(e);
                } else if (actionName === 'info') {
                    alert("Sistema Zenith Logistica v1.0\nSistema Integrato Logistica C. Milella 2026");
                }
            } catch(errMain) {
                alert("Comando eseguito: " + actionName);
            }
</script>
</head>
<body data-theme="light">

    <div class="crm-container">
        <!-- STRISCIA NERA SUPERIORE (APPLE STYLE) -->
        <div class="danea-top-black-bar" onmousedown="StartDrag()" style="height:35px; background:#1a1a1a; color:white; display:flex; align-items:center; padding:0 15px; font-size:11px; font-weight:bold; cursor:move;">
            <div class="apple-controls" onmousedown="event.cancelBubble=true;" style="margin-left:5px; cursor:default;">
                <div class="apple-btn close" onclick="CloseWindow()" title="Chiudi"></div>
                <div class="apple-btn minimize" onclick="MinimizeWindow()" title="Minimizza"></div>
                <div class="apple-btn maximize" onclick="ToggleMaximize()" title="Espandi/Ripristina"></div>
            </div>
            <img src="assets/img/app_icon_premium.png?v=2" class="refresh-logo-btn" style="height:22px; width:auto; margin-left:10px; margin-right:12px; border-radius:4px; vertical-align:middle; background:white; padding:2px;" alt="Refresh" onclick="location.reload();" title="Ricarica Maschera">
            <span style="text-transform:uppercase; letter-spacing:1px;">Archivio Storico Consegne - C. Milella logistica</span>
            <!-- Uniform elements injection for Zenith Suite standardization -->
            <div style="flex-grow: 1;"></div>
            <div id="userProfileWidget" style="display:flex; align-items:center; gap:8px; font-size:0.9rem; font-weight:800; color:white; background:rgba(255,255,255,0.05); padding:4px 12px; border-radius:20px; margin-right:8px;">AUTENTICAZIONE...</div>
            <div id="titleTime" style="font-size:0.8rem; font-weight:800; color:white; background:rgba(255,255,255,0.05); padding:4px 12px; border-radius:20px;">--:--</div>
        </div>

        <!-- RIGA 0: CLASSIC MENU BAR -->
        <nav class="classic-menu-bar">
            <div class="menu-item" tabindex="0" onclick="toggleMenu(this, event)">
                <u>F</u>ile
                <div class="submenu">
                    <div class="submenu-item" onclick="CaricaDati()"><u>E</u>segui Ricerca <span class="shortcut">F5</span></div>
                    <div class="submenu-divider"></div>
                    <div class="submenu-item" onclick="SincronizzaExcel()"><u>I</u>mporta da Excel (CSV)</div>
                    <div class="submenu-item" onclick="EsportaDati('excel')">Esporta in <u>E</u>xcel (CSV)</div>
                    <div class="submenu-item" onclick="EsportaDati('pdf')">Esporta in <u>P</u>DF</div>
                    <div class="submenu-divider"></div>
                    <div class="submenu-item" onclick="ActionEsci()"><u>C</u>hiudi Modulo e Esci <span class="shortcut">Alt+F4</span></div>
                </div>
            </div>
            <div class="menu-item" tabindex="0" onclick="toggleMenu(this, event)">
                <u>M</u>odifica
                <div class="submenu">
                    <div class="submenu-item" onclick="document.getElementById('txtCerca').focus()">Punta alla <u>r</u>icerca Smart</div>
                    <div class="submenu-item" onclick="SincronizzaExcel()"><u>F</u>orza Sincronizzazione Database</div>
                </div>
            </div>
            <div class="menu-item" tabindex="0" onclick="toggleMenu(this, event)">
                <u>V</u>isualizza
                <div class="submenu">
                    <div class="submenu-item" onclick="switchUniversalTab('nav-moduli', document.querySelectorAll('.ribbon-tab')[1])">Mostra <u>N</u>avigazione Moduli</div>
                    <div class="submenu-divider"></div>
                    <div class="submenu-item" id="menuToggleSpeech" onclick="ToggleSpeechShortcut()">Disattiva Sintesi Vocale <span class="shortcut">Ctrl+V</span></div>
                </div>
            </div>
            <div class="menu-item" tabindex="0" onclick="toggleMenu(this, event)">
                <u>H</u>elp
                <div class="submenu">
                    <div class="submenu-item" onclick="alert('?? GUIDA ARCHIVIO STORICO\n--------------------------------------------\n\n� RICERCA: Usa la colonna a sinistra per impostare i filtri, poi premi Cerca o doppio click sulle date.\n� ESPORTAZIONE: Esporta comodamente i risultati in Excel o PDF.\n� SINCRONIZZA: Aggiorna i dati dallo storico.')"><u>G</u>uida e Utilizzo della Maschera</div>
                    <div class="submenu-divider"></div>
                    <div class="submenu-item" onclick="alert('?? ASSISTENZA TECNICA E SUPPORTO\n--------------------------------------------\n\nIl gestionale � sviluppato in via esclusiva per la C. Milella.\n\nPer segnalare anomalie o bug di sistema, rivolgersi direttamente all\'Amministratore o allo Sviluppatore IT del sistema.')"><u>C</u>ontattare l'Assistenza</div>
                </div>
            </div>
        </nav>

        <!-- RIGA 1: RIBBON BAR ENTERPRISE UNIVERSALE -->
        <header class="danea-ribbon">
            <div class="ribbon-tabs">
                <div class="ribbon-tab active" onclick="switchUniversalTab('nav-operazioni', this)">Archivio Storico</div>
                <div class="ribbon-tab" onclick="switchUniversalTab('nav-moduli', this)">Navigazione Moduli</div>
            </div>
            
            <!-- GRUPPO 1: AZIONI LOCALI (Default) -->
            <div id="nav-operazioni" class="ribbon-items">
                <button class="ribbon-item" id="btnAvviaRicerca_Ribbon" onclick="CaricaDati()">
                    <div class="icon-img"><img src="https://img.icons8.com/fluency/48/search.png" alt="Cerca"></div>
                    <span>Ricerca</span>
                </button>
                <div class="ribbon-separator"></div>
                <button class="ribbon-item" onclick="EsportaDati('excel')">
                    <div class="icon-img"><img src="https://img.icons8.com/fluency/48/microsoft-excel-2019.png" alt="Excel"></div>
                    <span>Esporta Excel</span>
                </button>
                <button class="ribbon-item" onclick="EsportaDati('pdf')">
                    <div class="icon-img"><img src="https://img.icons8.com/fluency/48/pdf.png" alt="PDF"></div>
                    <span>Esporta PDF</span>
                </button>
                <div class="ribbon-separator"></div>
                <button class="ribbon-item" id="btnSync_Ribbon" onclick="SincronizzaExcel()">
                    <div class="icon-img"><img src="https://img.icons8.com/fluency/48/import-csv.png" alt="Import" onerror="this.src='https://img.icons8.com/fluency/48/synchronize.png'"></div>
                    <span>Importa Dati</span>
                </button>
                <div class="ribbon-separator"></div>
                <button class="ribbon-item danger" onclick="ActionEsci()">
                    <div class="icon-img"><img src="https://img.icons8.com/fluency/48/shutdown.png" alt="Esci"></div>
                    <span>Chiudi Modulo</span>
                </button>
            </div>

            <!-- GRUPPO 2: MODULI (Universale) -->
            <div id="nav-moduli" class="ribbon-items" style="display:none;">
                <button class="ribbon-item" onclick="NavigaModulo('dashboard.hta')">
                    <div class="icon-img"><img src="https://img.icons8.com/fluency/48/home.png" alt="Start"></div>
                    <span>Start</span>
                </button>
                <button class="ribbon-item" onclick="NavigaModulo('anagrafica.hta')">
                    <div class="icon-img"><img src="https://img.icons8.com/fluency/48/address-book.png" alt="Anagrafica"></div>
                    <span>Anagrafica</span>
                </button>
                <button class="ribbon-item" onclick="NavigaModulo('articoli.hta')">
                    <div class="icon-img"><img src="https://img.icons8.com/fluency/48/box.png" alt="Articoli"></div>
                    <span>Articoli</span>
                </button>
                <button class="ribbon-item" onclick="NavigaModulo('consegne.hta')">
                    <div class="icon-img"><img src="assets/img/icona_consegne_trasparente.png" alt="Consegne" style="width:40px; height:auto;"></div>
                    <span>Consegne</span>
                </button>
                <button class="ribbon-item" onclick="NavigaModulo('presenze.hta')">
                    <div class="icon-img"><img src="https://img.icons8.com/fluency/48/stopwatch.png" alt="Presenze"></div>
                    <span>Presenze</span>
                </button>
                <button class="ribbon-item" onclick="NavigaModulo('promemoria.hta')">
                    <div class="icon-img"><img src="https://img.icons8.com/fluency/48/calendar--v1.png" alt="Agenda"></div>
                    <span>Agenda</span>
                </button>
                <div class="ribbon-separator"></div>
                <button class="ribbon-item danger" onclick="ActionEsci()">
                    <div class="icon-img"><img src="https://img.icons8.com/fluency/48/shutdown.png" alt="Chiudi"></div>
                    <span>Spegni Sistema</span>
                </button>
            </div>
        </header>

        <!-- RIGA 2: NAV BAR BLU -->
        <div class="danea-nav-bar">
            <h1 style="display:none;">Anagrafica Storica</h1>

            <div class="record-count" id="lblConteggio">Trovati: 0 record</div>
        </div>

        <!-- MAIN LAYOUT -->
        <main class="dashboard-grid">
            <!-- SIDEBAR FILTRI -->
            <aside class="sidebar-card">
                <div class="sidebar-header">
                    <h2>Filtri Ricerca</h2>
                </div>
                <div class="search-box">
                    <label style="font-size: 10px; color: #888; text-transform: uppercase; font-weight: 800;">Ricerca Smart</label>
                    <div class="input-icon-wrapper">
                        <i class="fa fa-search input-icon"></i>
                        <input type="text" id="txtCerca" placeholder="Cerca nome, citt&agrave;, via, note o ID...">
                    </div>
                </div>
                <div class="filter-group">
                    <div class="form-group-super">
                        <label>Anno Riferimento</label>
                        <select id="cboAnni"><option value="Tutti">Tutti</option></select>
                    </div>
                    <div class="form-group-super">
                        <label>Mese</label>
                        <select id="cboMesi"><option value="Tutti">Tutti</option></select>
                    </div>
                    <div class="form-group-super">
                        <label>Dal (Giorno)</label>
                        <div class="input-icon-wrapper">
                            <i class="fa fa-calendar input-icon"></i>
                            <input type="text" id="dtpDal" placeholder="gg/mm/aaaa" ondblclick="OpenSmartCalendar(this)">
                        </div>
                    </div>
                    <div class="form-group-super">
                        <label>Al (Giorno)</label>
                        <div class="input-icon-wrapper">
                            <i class="fa fa-calendar input-icon"></i>
                            <input type="text" id="dtpAl" placeholder="gg/mm/aaaa" ondblclick="OpenSmartCalendar(this)">
                        </div>
                    </div>
                    <!-- PULSANTE PULISCI FILTRI INIZIO -->
                    <div style="margin-top: 5px; margin-bottom: 5px;">
                        <button id="btnResetFiltri" class="btn-reset-filters" onclick="PulisciFiltri()" title="Svuota filtri e ripristina lista completa">
                            <i class="fa fa-eraser"></i> Pulisci Filtri
                        </button>
                    </div>
                    <!-- PULSANTE PULISCI FILTRI FINE -->
                </div>
                <div style="margin-top:auto; padding:15px; background:#f8f9fa; text-align:center;">
                    <p style="font-size:11px; color:#999; margin:0;">Usa il doppio click sui campi data per il calendario</p>
                </div>
            </aside>

            <!-- MAIN AREA -->
            <section class="content-area">
                <!-- STATISTICHE DI RIEPILOGO INIZIO -->
                <div class="quick-stats-bar" id="statsBar" style="display:none;">
                    <div class="stat-card">
                        <div class="stat-icon-circle icon-blue">
                            <i class="fa fa-truck"></i>
                        </div>
                        <div class="stat-data">
                            <span class="stat-label">Consegne Trovate</span>
                            <span class="stat-value" id="statTotal">0</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon-circle icon-green">
                            <i class="fa fa-check-circle"></i>
                        </div>
                        <div class="stat-data">
                            <span class="stat-label">Rateo Successo</span>
                            <span class="stat-value" id="statSuccess">0%</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon-circle icon-amber">
                            <i class="fa fa-exclamation-triangle"></i>
                        </div>
                        <div class="stat-data">
                            <span class="stat-label">Da Lavorare</span>
                            <span class="stat-value" id="statWarning">0</span>
                        </div>
                    </div>
                </div>
                
                <!-- ?? BARRA DISTRIBUZIONE STATO (DATA VISUALIZATION) -->
                <div class="breakdown-container" id="breakdownContainer" style="display:none;">
                    <div class="breakdown-bar" id="breakdownBar"></div>
                </div>
                <!-- STATISTICHE DI RIEPILOGO FINE -->

                <!-- ? PULSANTIERA FILTRI RAPIDI (QUICK TAGS) -->
                <div class="quick-tags-row" id="quickTagsRow" style="display:none;">
                    <span class="quick-tag-label">FILTRA PER STATO:</span>
                    <span class="quick-tag active" id="tagTUTTI" onclick="ApplicaFiltroRapido('TUTTI', this)"><i class="fa fa-list-ul"></i> Tutti</span>
                    <span class="quick-tag tag-btn-delivered" onclick="ApplicaFiltroRapido('CONSEGNATO', this)"><i class="fa fa-circle"></i> Consegnato</span>
                    <span class="quick-tag tag-btn-completed" onclick="ApplicaFiltroRapido('COMPLETATA', this)"><i class="fa fa-circle"></i> Completata</span>
                    <span class="quick-tag tag-btn-tocall" onclick="ApplicaFiltroRapido('DA CHIAMARE', this)"><i class="fa fa-circle"></i> Da Chiamare</span>
                    <span class="quick-tag tag-btn-confirmed" onclick="ApplicaFiltroRapido('CONFERMATO', this)"><i class="fa fa-circle"></i> Confermato</span>
                    <span class="quick-tag tag-btn-pending" onclick="ApplicaFiltroRapido('DA LAVORARE', this)"><i class="fa fa-exclamation-circle"></i> Da Lavorare</span>
                    <button class="btn-azzera" style="margin-left:auto; background:#f59e0b; color:#fff; border:none; border-radius:10px; padding:4px 10px; font-weight:800; cursor:pointer;" onclick="AzzeraDaLavorare()">Azzera <i class="fa fa-eraser"></i></button>
                </div>

                                <!-- ?? TOOLBAR AZIONI MULTIPLE -->
                <div class="bulk-actions-toolbar" id="bulkToolbar" style="display:none; background:#1e293b; padding:10px 15px; border-radius:10px; margin-bottom:15px; align-items:center; justify-content:space-between;">
                    <div style="color:white; font-weight:bold;"><span id="bulkCount">0</span> elementi selezionati</div>
                    <div style="display:flex; gap:10px;">
                        <button style="background:#10b981; color:white; border:none; padding:5px 15px; border-radius:8px; cursor:pointer; font-weight:bold;" onclick="BulkAzione('COMPLETATA')"><i class="fa fa-check"></i> Segna Completati</button>
                        <button style="background:#ef4444; color:white; border:none; padding:5px 15px; border-radius:8px; cursor:pointer; font-weight:bold;" onclick="BulkAzione('ELIMINA')"><i class="fa fa-trash"></i> Elimina</button>
                    </div>
                </div>
<div class="results-container">
                    <div class="table-wrapper">
                        <table id="tblRisultati" class="premium-table">
                            <thead>
                                <tr>
                                    <th style="width: 40px; text-align:center;"><input type="checkbox" id="chkAll" onclick="ToggleAllCheckboxes(this)"></th>
                                    <th style="width: 60px;">ID</th>
                                    <th style="width: 100px;">DATA</th>
                                    <th style="width: 80px;">MESE</th>
                                    <th>CLIENTE / DESTINATARIO</th>
                                    <th style="width: 150px; text-align: left;">LOCALIT�</th>
                                    <th style="width: 120px; text-align: center;">STATO</th>
                                    <th style="width: 75px; text-align: center;">AZIONI</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyRisultati"></tbody>
                        </table>
                    </div>
                </div>

                <!-- ?? PANEL FOCUS DETTAGLIO SELEZIONATO AVANZATO -->
                <div class="focus-card" id="focusCard">
                    <div class="focus-header">
                        <div class="focus-title-group">
                            <div class="focus-icon-bg"><i class="fa fa-address-card"></i></div>
                            <div>
                                <span class="focus-subtitle">SCHEDA INFORMATIVA SELEZIONATA</span>
                                <h3 class="focus-title" id="focusCliente">Nessun record selezionato</h3>
                            </div>
                        </div>
                        <div class="focus-header-actions" style="display: flex; align-items: center; gap: 12px;">
                            <button id="btnCopiaDettagli" class="btn-focus-copy" onclick="CopiaRiepilogo()" title="Copia formattato per WhatsApp" style="display: none;">
                                <i class="fa fa-whatsapp"></i> Copia per WhatsApp
                            </button>
                            <div id="focusBadgeWrapper"></div>
                        </div>
                    </div>
                    <div class="focus-body">
                        <div class="focus-grid">
                            <div class="focus-item">
                                <span class="focus-lbl">ID REGISTRO</span>
                                <span class="focus-val" id="focusId">-</span>
                            </div>
                            <div class="focus-item">
                                <span class="focus-lbl">DATA CONSEGNA</span>
                                <span class="focus-val" id="focusData">-</span>
                            </div>
                            <div class="focus-item">
                                <span class="focus-lbl">LOCALIT�</span>
                                <span class="focus-val" id="focusLoc">-</span>
                            </div>
                            <div class="focus-item">
                                <span class="focus-lbl">CONTATTO TEL.</span>
                                <div class="focus-tel-wrapper" style="display: flex; align-items: center; gap: 8px;">
                                    <span class="focus-val" id="focusTel">-</span>
                                    <span id="focusCallBtnWrapper"></span>
                                </div>
                            </div>
                        </div>
                        <div class="focus-notes-section">
                            <span class="focus-lbl">NOTE E ISTRUZIONI DI LOGISTICA</span>
                            <div class="focus-note-text" id="focusNote">Seleziona una riga dall'archivio storico sovrastante per caricare il riepilogo e visualizzare le note testuali registrate sul database.</div>
                        </div>
                    </div>
                </div>
            </section>
        </main>
      </footer>
        
        <div class="status-bar">
            <span id="lblFooterHint">Usa i filtri a sinistra per consultare l'archivio storico delle consegne effettuate.</span>
            <div class="timestamps">
                <span>Pronto</span>
            </div>
        </div>
    </div>

    <!-- FILE IMPORTER HIDDEN -->
    <input type="file" id="fileImportCSV" style="display:none;" accept=".csv" onchange="EseguiImportazioneCSV(this)">

    <!-- CALENDARIO HIDDEN CONTAINER -->
    <div id="calContainer" class="calendar-popup" style="display:none;"></div>

    <script src="assets/js/accessibility.js"></script>
    <script src="assets/js/storico_hta.js"></script>
<script src="assets/js/hacker_mode.js"></script>
<!-- MODAL GUIDA ALL'USO (MSHTA REFLOW COMPATIBLE) -->
<div id="helpModalOverlay" style="display:none; visibility:hidden; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(2, 6, 23, 0.88); z-index:200000;">
    <div style="position:absolute; top:50%; left:50%; margin-top:-260px; margin-left:-320px; width:640px; background:#0f172a; border:2px solid #38bdf8; border-radius:16px; box-shadow:0 0 35px rgba(56, 189, 248, 0.4); padding:25px; color:#f8fafc; font-family:'Plus Jakarta Sans', 'Segoe UI', sans-serif;">
        <!-- Header Modal -->
        <div style="border-bottom:1px solid #38bdf8; padding-bottom:12px; margin-bottom:15px; position:relative;">
            <div style="font-family:'Outfit', sans-serif; font-size:1.2rem; font-weight:800; color:#38bdf8; letter-spacing:0.5px;">
                &#128216; GUIDA ALL'USO - ZENITH MATERIALI
            </div>
            <div style="font-size:0.75rem; color:#94a3b8; margin-top:2px;">Manuale Rapido Operativo &amp; Scorciatoie</div>
            <div onmousedown="ChiudiGuidaModal(event); return false;" onclick="ChiudiGuidaModal(event);" style="cursor:pointer; position:absolute; top:0; right:0; width:30px; height:30px; background:#1e293b; border:1px solid #38bdf8; border-radius:50%; text-align:center; line-height:28px; color:#f8fafc; font-weight:bold; font-size:1.2rem; user-select:none;">&times;</div>
        </div>

        <!-- Content Modal -->
        <div style="height:350px; overflow-y:auto; padding-right:5px;">
            <table style="width:100%; border-collapse:collapse; margin-bottom:12px;">
                <tr>
                    <td style="width:50%; padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#fbbf24; font-size:0.88rem; margin-bottom:6px;">
                                &#128269; 1. Ricerca Globale Istantanea
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Digita nel campo in alto per filtrare in tempo reale clienti, città, telefoni o specifiche attrezzature assegnate.
                            </div>
                        </div>
                    </td>
                    <td style="width:50%; padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#38bdf8; font-size:0.88rem; margin-bottom:6px;">
                                &#128205; 2. Filtri Provincia &amp; Articolo
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Usa la barra laterale sinistra per isolare velocemente le province (Bari, Foggia, Taranto) o i dispositivi (Orologio, Sveglia, Braille).
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td style="padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#34d399; font-size:0.88rem; margin-bottom:6px;">
                                &#128203; 3. Pulsanti Copia Dati
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Clicca sul tasto verde <b>Copia</b> per salvare la scheda cliente negli appunti e trasferirla nei promemoria o report.
                            </div>
                        </div>
                    </td>
                    <td style="padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#a78bfa; font-size:0.88rem; margin-bottom:6px;">
                                &#128259; 4. Sincronizzazione Danea
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Dal menu <b>File</b> o <b>Strumenti</b> premi <i>Sincronizza Excel Ora</i> per ricaricare le anagrafiche aggiornate.
                            </div>
                        </div>
                    </td>
                </tr>
            </table>

            <div style="background:rgba(56, 189, 248, 0.15); border:1px solid #38bdf8; padding:12px; border-radius:10px; font-size:0.8rem; color:#cbd5e1;">
                <b style="color:#38bdf8;">&#9889; Suggerimento Rapido:</b> Per resettare tutti i filtri attivi e tornare alla vista completa, seleziona <b>TUTTE LE PROVINCE</b> ed <b>ELENCO COMPLETO</b> dalla sidebar a sinistra.
            </div>
        </div>

        <!-- Footer Modal -->
        <div style="margin-top:15px; padding-top:12px; border-top:1px solid rgba(255,255,255,0.1); text-align:right;">
            <span style="font-size:0.75rem; color:#94a3b8; float:left; margin-top:8px;">Sistema Zenith Materiali v1.0 &bull; C. Milella 2026</span>
            <button onmousedown="ChiudiGuidaModal(event); return false;" onclick="ChiudiGuidaModal(event);" style="background:#0284c7; color:white; border:1px solid #38bdf8; padding:8px 24px; border-radius:8px; font-weight:800; font-size:0.85rem; cursor:pointer; font-family:'Outfit', sans-serif;">HO CAPITO</button>
        </div>
    </div>
</div>
</body>
</html>





