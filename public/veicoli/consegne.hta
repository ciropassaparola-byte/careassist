                        </div>
                    </div>
                    <div class="submenu-divider"></div>
                    <div class="submenu-item" onclick="document.getElementById('btnMappa').click()">Cerca Indirizzo su <u>M</u>appe</div>
                    <div class="submenu-item" onclick="document.getElementById('txtRicerca').focus()">Vai alla Barra di <u>R</u>icerca</div>
                </div>
            </div>
            <div class="menu-item" onclick="toggleMenu(this, event)">
                <u>A</u>iuto
