                    <button onclick="ChiudiMappaInApp()" style="background:rgba(255,255,255,0.08); border:none; color:#cbd5e1; border-radius:50%; width:32px; height:32px; cursor:pointer; font-weight:900; font-size:16px; display:flex; align-items:center; justify-content:center; outline:none; transition:all 0.2s;" onmouseover="this.style.background='rgba(239, 68, 68, 0.5)'; this.style.color='white'; this.style.transform='rotate(90deg)';" onmouseout="this.style.background='rgba(255,255,255,0.08)'; this.style.color='#cbd5e1'; this.style.transform='none';">×</button>
