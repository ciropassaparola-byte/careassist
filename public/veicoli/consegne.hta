        <!-- MAIN WRAPPER -->
        <div class="main-wrapper">
            
            <!-- MINI DASHBOARD PREMIUM -->
            <div id="miniDashboardPremium" style="display:flex; justify-content:space-between; align-items:center; background:rgba(15,23,42,0.6); border:1.5px solid #334155; border-radius:14px; padding:12px 20px; margin-bottom:15px; box-shadow:0 4px 15px rgba(0,0,0,0.2);">
                <div style="display:flex; align-items:center; gap:15px;">
                    <div style="background:#1e293b; padding:10px; border-radius:10px; border:1px solid #334155; text-align:center; min-width:80px;">
                        <div style="font-size:10px; color:#94a3b8; font-weight:800; text-transform:uppercase; margin-bottom:4px;">Completate</div>
                        <div id="dashCompleted" style="font-size:18px; color:#22c55e; font-weight:900;">0 / 0</div>
                    </div>
                    <div style="background:#1e293b; padding:10px; border-radius:10px; border:1px solid #334155; text-align:center; min-width:80px;">
                        <div style="font-size:10px; color:#94a3b8; font-weight:800; text-transform:uppercase; margin-bottom:4px;">In Attesa</div>
                        <div id="dashPending" style="font-size:18px; color:#facc15; font-weight:900;">0</div>
                    </div>
                    <div style="background:#1e293b; padding:10px; border-radius:10px; border:1px solid #334155; text-align:center; min-width:80px;">
                        <div style="font-size:10px; color:#94a3b8; font-weight:800; text-transform:uppercase; margin-bottom:4px;">Sospesi</div>
                        <div id="dashIssues" style="font-size:18px; color:#ef4444; font-weight:900;">0</div>
                    </div>
                </div>
                
                <div style="display:flex; align-items:center; gap:20px;">
                    <div style="display:flex; flex-direction:column; align-items:flex-end;">
                        <div style="font-size:11px; color:#94a3b8; font-weight:800; text-transform:uppercase; margin-bottom:5px;">Progresso Giornaliero</div>
                        <div style="width:200px; height:8px; background:#1e293b; border-radius:4px; overflow:hidden;">
                            <div id="dashProgressBar" style="width:0%; height:100%; background:linear-gradient(90deg, #0ea5e9, #22c55e); transition:width 0.5s cubic-bezier(0.4, 0, 0.2, 1);"></div>
                        </div>
                    </div>
                    <div id="dashProgressText" style="font-size:22px; color:#f8fafc; font-weight:900;">0%</div>
                </div>
            </div>
            <div class="archive-filters">
                <div class="form-group" style="max-width:120px;">
                    <label>MESE</label>
                    <select id="cmbMese"></select>
                </div>
                <div class="form-group" style="max-width:100px;">
                    <label>ANNO</label>
                    <select id="cmbAnni"></select>
                </div>
                <div class="form-group">
                    <label>FILTRA STATO</label>
                    <div class="filters-status">
                        <button class="btn-filter active" id="btnFiltroTutti">TUTTI</button>
                        <button class="btn-filter" id="btnFiltroSospesi">SOSPESI</button>
                        <button class="btn-filter" id="btnFiltroUrgenti">URGENTI</button>
                        <button class="btn-filter" id="btnFiltroChiusi">CHIUSI</button>
                        <button class="btn-filter" id="btnFiltroProssimeDaFare" style="background:rgba(234, 179, 8, 0.2); color:#fde047; border:1px solid #eab308; margin-left:15px;" title="Vedi tutte le consegne dei prossimi giorni non ancora fatte">⏳ PROSSIME DA FARE</button>
                        <button class="btn-filter" id="btnFiltroOggiUrgenti" style="background:rgba(239, 68, 68, 0.1); color:#ef4444; border:1px solid rgba(239, 68, 68, 0.3); margin-left:8px;" title="Vedi solo consegne di oggi o urgenti">🔥 OGGI & URGENTI</button>
                    </div>
                </div>
                <div class="form-group flex-1">
                    <label>CERCA NELL'ELENCO</label>
                    <div style="position:relative; display:flex; align-items:center; width:100%;">
                        <input type="text" id="txtRicerca" placeholder="Cerca... (Premi CTRL+F)" style="width:100%; padding-right: 30px;">
                        <button type="button" onclick="document.getElementById('txtRicerca').value=''; if(typeof FilterData==='function') FilterData(); document.getElementById('txtRicerca').focus();" style="position:absolute; right:8px; background:none; border:none; color:#94a3b8; cursor:pointer; font-size:16px; font-weight:bold; display:flex; align-items:center; justify-content:center; transition: color 0.2s;" onmouseover="this.style.color='#ef4444'" onmouseout="this.style.color='#94a3b8'" title="Svuota ricerca">&times;</button>
                    </div>
                </div>
                <div class="form-group" style="flex:0 0 80px;">
                    <label>MAPPA</label>
                    <button class="btn-routing-special" id="btnToggleMappa" style="background:rgba(14,165,233,0.12); color:#38bdf8; border:1.5px solid rgba(14,165,233,0.4); padding:7px 12px; border-radius:8px; font-weight:800; font-size:11px; width:100%; cursor:pointer; transition:all 0.25s; text-transform:uppercase; letter-spacing:0.5px;" onclick="ToggleSplitViewMap()" title="Mostra/Nascondi Mappa">
                        🗺️ MAPPA
                    </button>
                </div>
                <div class="form-group" style="flex:0 0 80px; margin-left:10px;">
                    <label>VISTA</label>
                    <button class="btn-routing-special" id="btnToggleKanban" style="background:rgba(139,92,246,0.12); color:#a78bfa; border:1.5px solid rgba(139,92,246,0.4); padding:7px 12px; border-radius:8px; font-weight:800; font-size:11px; width:100%; cursor:pointer; transition:all 0.25s; text-transform:uppercase; letter-spacing:0.5px;" onclick="window.ToggleKanbanView()" title="Passa a vista Kanban a colonne">
                        📋 KANBAN
                    </button>
                </div>
                <div class="form-group" style="flex:0 0 80px; margin-left: 10px;">
                    <label>ORDINE</label>
                    <div style="display:flex; gap:4px;">
                        <button class="btn-nav-mini" id="btnSpostaSu" title="Sposta su">▲</button>
                        <button class="btn-nav-mini" id="btnSpostaGiu" title="Sposta giù">▼</button>
                    </div>
                </div>
                <div class="form-group" style="flex:0 0 160px; margin-left: 10px;">
                    <label style="color:#0ea5e9;">SMART ROUTING</label>
                    <button class="btn-routing-special" id="btnOttimizzaPercorso" style="background:rgba(37,211,102,0.12); color:#25D366; border:1.5px solid rgba(37,211,102,0.4); padding:7px 12px; border-radius:8px; font-weight:800; font-size:11px; width:100%; cursor:pointer; transition:all 0.25s; text-transform:uppercase; letter-spacing:0.5px;" onclick="ActionOttimizzaPercorso()" title="Ottimizza l'ordine delle consegne visibili e crea percorso su Google Maps">
                        📍 Ottimizza Percorso
                    </button>
                </div>
                <div class="form-group" style="flex:0 0 150px; margin-left: 8px;">
                    <label style="color:#fbbf24;">LOGISTICA CARICO</label>
                    <button class="btn-routing-special" id="btnDistintaCarico" style="background:rgba(251,191,36,0.12); color:#fbbf24; border:1.5px solid rgba(251,191,36,0.4); padding:7px 12px; border-radius:8px; font-weight:800; font-size:11px; width:100%; cursor:pointer; transition:all 0.25s; text-transform:uppercase; letter-spacing:0.5px;" onclick="GeneraDistintaCarico()" title="Genera il manifesto degli articoli da caricare per le consegne visibili">
                        📋 Distinta Carico
                    </button>
                </div>
            </div>

            <!-- [ZONA 1] ARCHIVIO (ORA IN CIMA) -->
            <div class="archive-panel">
                <div class="archive-header">
                    <div><img src="https://img.icons8.com/fluency/24/list.png" style="vertical-align:middle; margin-right:8px;"> ARCHIVIO CONSEGNE OPERATIVE</div>
                    <div id="lblMetadati" style="font-size:10px; color:#aaa; font-weight:normal;">
                        <span id="lblInseritoIl">Inserito: -</span> | <span id="lblModificatoIl">Modificato: -</span>
                    </div>
                </div>

                <!-- NUOVO CONTAINER PER GOLD CARDS & MAPPA -->
                <div class="split-view-container" id="splitViewContainer">
                    <div id="cardListContainer" class="card-list-container">
                        <div style="text-align:center; padding:50px; color:#999; font-style:italic;">
                            <i class="fa fa-spinner fa-spin"></i> Caricamento elenco in corso...
                        </div>
                    </div>
                    <div id="mapPanel" class="map-panel">
                        <iframe id="mapFrame" src="about:blank" style="width:100%; height:100%; border:none;"></iframe>
                    </div>
                </div>
            </div>

            <!-- BATCH ACTIONS PANEL (HIDDEN BY DEFAULT) -->
            <div id="batchActionsPanel" class="batch-actions-panel">
                <span style="color:#0ea5e9; font-weight:900; font-size:12px;"><span id="lblBatchCount">0</span> SELEZIONATI:</span>
                <button onclick="BatchActionWhatsApp()"><i class="fa fa-whatsapp" style="color:#25d366;"></i> WhatsApp Multiplo</button>
                <button onclick="BatchActionStatus()"><i class="fa fa-check" style="color:#22c55e;"></i> Segna Completati</button>
                <button onclick="BatchActionClear()" style="background:transparent; border:none; color:#ef4444;"><i class="fa fa-times"></i> Annulla</button>
            </div>

            <!-- [ZONA 2] EDITOR PANEL (COLLASSABILE) -->
            <div id="editorPanel" class="editor-panel-wrapper collapsed">
                <div class="editor-header-bar" style="display:flex; justify-content:space-between; align-items:center;">
                    <div style="display:flex; align-items:center; gap:15px; flex-wrap:wrap;">
                        <span>📝 SCHEDA DETTAGLIO CONSEGNA</span>
                        <span id="lblNomeClienteHeader" style="color: #fde047; font-weight: 900; font-size: 13px; text-transform: uppercase; margin-left: 5px; text-shadow: 0 0 10px rgba(253, 224, 71, 0.4);"></span>
                        <span id="lblPosizioneConsegna" style="background:rgba(6, 182, 212, 0.15); border:1px solid rgba(6, 182, 212, 0.35); color:#22d3ee; font-size:11px; font-weight:900; padding:4px 10px; border-radius:10px; letter-spacing:0.5px; display:none; vertical-align:middle; margin-left:12px;"></span>
                        <button type="button" onclick="NavigaModulo('dashboard.hta')" style="background:#ffab00; color:#000; border:none; padding:4px 12px; border-radius:6px; font-size:10px; font-weight:900; cursor:pointer; display:flex; align-items:center; gap:5px; box-shadow:0 2px 5px rgba(0,0,0,0.2); transition:all 0.1s;" onmouseover="this.style.backgroundColor='#e69a00'" onmouseout="this.style.backgroundColor='#ffab00'" onmousedown="this.style.transform='scale(0.96)'" onmouseup="this.style.transform='scale(1)'" title="Esci da Consegne e torna all'Agenda Dashboard">
                            ◀ TORNA ALLA DASHBOARD
                        </button>
                    </div>
                    <button type="button" class="btn-close-editor" onclick="ActionChiudiEditor()" title="Chiudi scheda (Premi ESC)">&times;</button>
                </div>

                <!-- CARD 1: ANAGRAFICA -->
                <div class="danea-card" id="cardAnagrafica" role="region" aria-label="Sezione Anagrafica e Recapiti">
                    <div class="card-header" onclick="ToggleCard('cardAnagrafica')">
                        <span>🆔 Anagrafica e Recapiti</span>
                        <div class="btn-toggle-card" id="btnToggleAnagrafica">▲</div>
                    </div>
                    <div class="card-content">
                        <div class="form-row">
                            <div class="photo-box" onclick="document.getElementById('fileFotoCliente').click()" title="Fai clic per caricare o modificare la foto del cliente" style="cursor:pointer;"><img id="imgFotoCliente" src="" alt=""><div id="lblNoFoto" class="no-photo-text">FOTO</div></div>
                            <div class="form-group" style="flex: 1;"><label>COGNOME E NOME <span id="lblStatoDisabilita" class="badge-status-client"></span> <span id="lblSmartExcel" class="badge-smart-excel" style="display:none; cursor:pointer;" onclick="ActionCaricaMerceExcel()">📦 MERCE IN EXCEL</span></label>
                                <div class="autocomplete-wrapper"><input type="text" id="txtNome" autocomplete="off" placeholder="Cerca o inserisci cliente..."><div id="suggerimenti" class="autocomplete-list" style="display:none;"></div></div>
                            </div>
                            <div class="form-group" style="flex: 0.8;"><label>PROVINCIA</label><select id="cmbProvincia"></select></div>
                            <div class="form-group" style="flex: 1;"><label>LOCALIT&Agrave; <span style="font-size:9px; color:#06b6d4; cursor:pointer; margin-left:8px;" onclick="ActionGestisciLocalita()">⚙️ GESTISCI</span></label><input type="text" id="cmbLocalita" list="listLocalita" placeholder="Scegli o scrivi..."><div id="localita-buttons-bar" style="display:flex; flex-wrap:wrap; gap:6px; margin-top:5px;"></div></div>
                            <div class="form-group" style="flex: 1.5;"><label>INDIRIZZO</label>
                                <div style="display:flex;"><input type="text" id="txtResidenza" style="border-radius:10px 0 0 10px !important;"><button id="btnMappa" title="Vedi Mappa" style="padding:0 8px; border:1.5px solid #334155; border-left:none; background:rgba(15,23,42,0.7); cursor:pointer; border-radius:0 10px 10px 0; display:flex; align-items:center; transition:all 0.2s;"><img src="https://img.icons8.com/color/20/google-maps-new.png" alt=""></button></div>
                            </div>
                        </div>
                        <div class="form-row recapiti-row">
                            <div class="form-group" style="flex: 1;"><label>EMAIL CONTATTO</label><input type="email" id="txtEmail" placeholder="esempio@mail.it"></div>
                            <div class="form-group" style="flex: 1.5;">
                                <label>TELEFONO RECAPITO (INVIO PER AGGIUNGERE)</label>
                                <div class="phone-chips-wrapper" id="phoneContainer" onclick="document.getElementById('txtTelefono').focus()">
                                    <div id="chipsArea" style="display:contents;"></div>
                                    <input type="text" id="txtTelefono" class="phone-input-inline" placeholder="Scrivi numero..." oninput="if(typeof FormatSmartPhone==='function') this.value=FormatSmartPhone(this.value);">
                                </div>
                                <div class="phone-labels-bar" style="margin-top: 6px;">
                                    <button type="button" class="label-btn" onclick="AddPhoneLabel('CELL. ')">CELL.</button>
                                    <button type="button" class="label-btn" onclick="AddPhoneLabel('FISSO ')">FISSO</button>
                                    <button type="button" class="label-btn wa" onclick="AddPhoneLabel('W.APP ')">W.APP</button>
                                    <button type="button" class="label-btn" onclick="AddPhoneLabel('FIGLIO/A ')">FIGLIO/A</button>
                                    <button type="button" class="label-btn" onclick="AddPhoneLabel('MOGLIE/MARITO ')">CONIUGE</button>
                                    <button type="button" class="label-btn" onclick="AddPhoneLabel('ALTRO ')">ALTRO</button>
                                </div>
                            </div>
                            <div class="form-group" style="flex: 1.5;"><label>ENTE Riferimento <span style="font-size:9px; color:#06b6d4; cursor:pointer; margin-left:8px;" onclick="ActionGestisciEnti()">⚙️ GESTISCI</span></label><input type="text" id="cmbEnte" list="listEnti" placeholder="Scegli o scrivi..."><datalist id="listEnti"></datalist><div id="ente-buttons-bar" style="display:flex; flex-wrap:wrap; gap:6px; margin-top:5px;"></div></div>
                        </div>
                        <div class="form-row" style="margin-top: 15px;">
                            <div class="form-group" style="flex: 1;">
                                <label style="color: #ffab00; font-weight: 800;">STATO INVALIDIT&Agrave; (CLICCA I TASTI O SCRIVI E PREMI INVIO)</label>
                                <div class="invalidity-chips-wrapper" id="invContainer" onclick="document.getElementById('txtStatoInvalidita').focus()">
                                    <div id="invChipsArea" style="display:contents;"></div>
                                    <input type="text" id="txtStatoInvalidita" class="inv-input-inline" placeholder="Aggiungi stato...">
                                </div>
                                <div class="inv-labels-bar" style="margin-top: 8px;">
                                    <button type="button" class="inv-label-btn" onclick="AddInvLabel('CIECO ASSOLUTO')">CIECO ASSOLUTO</button>
                                    <button type="button" class="inv-label-btn" onclick="AddInvLabel('IPOVEDENTE')">IPOVEDENTE</button>
                                    <button type="button" class="inv-label-btn" onclick="AddInvLabel('SORDOCIECO')">SORDOCIECO</button>
                                    <button type="button" class="inv-label-btn" onclick="AddInvLabel('INVALIDO CIVILE')">INVALIDO CIVILE</button>
                                    <button type="button" class="inv-label-btn" onclick="AddInvLabel('NON AUTO SUFFICIENTE')">NON AUTO SUFFICIENTE</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CARD 2: LOGISTICA -->
                <div class="danea-card" id="cardLogistica" style="margin-top:10px;" role="region">
                    <div class="card-header" onclick="ToggleCard('cardLogistica')" style="cursor:pointer; display:flex; justify-content:space-between; align-items:center;">
                        <span>🚚 Dettagli Logistica e KM</span>
                        <div class="btn-toggle-card" id="btnToggleLogistica">▲</div>
                    </div>
                    <div class="card-content">
                    <div class="form-row">
                        <div class="form-group" style="flex: 0.8;"><label>DATA</label><div style="display:flex;"><input type="text" id="txtDataConsegna" style="border-radius:10px 0 0 10px !important;" ondblclick="ApriCalendario(this.id)"><button type="button" onclick="ApriCalendario('txtDataConsegna')" title="Apri Calendario" style="padding:0 8px; border:1.5px solid #334155; border-left:none; background:rgba(14, 165, 233, 0.15); cursor:pointer; display:flex; align-items:center;"><i class="fa fa-calendar" style="color:#0ea5e9;"></i></button><button type="button" onclick="if(typeof ActionSalva==='function')ActionSalva(true);" title="Salva Modifica" style="padding:0 6px; border:1.5px solid #334155; border-left:none; background:rgba(16, 185, 129, 0.15); cursor:pointer; border-radius:0 10px 10px 0; display:flex; align-items:center;"><i class="fa fa-save" style="color:#10b981;"></i></button></div></div>
                        <div class="form-group" style="flex: 0.5;"><label>ORA</label><div style="display:flex;"><input type="text" id="cmbOra" ondblclick="ApriTimePicker()" onkeyup="if(typeof FormatSmartTime==='function') this.value=FormatSmartTime(this.value);" style="border-radius:10px 0 0 10px !important; background:rgba(15,23,42,0.7) url('https://img.icons8.com/fluency/18/clock.png') no-repeat 90% center !important;"><button type="button" onclick="if(typeof ActionSalva==='function')ActionSalva(true);" title="Salva Modifica" style="padding:0 6px; border:1.5px solid #334155; border-left:none; background:rgba(16, 185, 129, 0.15); cursor:pointer; border-radius:0 10px 10px 0; display:flex; align-items:center;"><i class="fa fa-save" style="color:#10b981;"></i></button></div></div>
                        <div class="form-group" style="flex: 0.8;"><label>N. ORDINE</label><div style="display:flex;"><input type="text" id="txtOrdine" style="border-radius:10px 0 0 10px !important;"><button type="button" onclick="if(typeof ActionSalva==='function')ActionSalva(true);" title="Salva Modifica" style="padding:0 6px; border:1.5px solid #334155; border-left:none; background:rgba(16, 185, 129, 0.15); cursor:pointer; border-radius:0 10px 10px 0; display:flex; align-items:center;"><i class="fa fa-save" style="color:#10b981;"></i></button></div></div>
                        <div class="form-group" style="flex: 1.5;"><label>STATO OPERATIVO <span style="font-size:9px; color:#06b6d4; cursor:pointer; margin-left:8px;" onclick="ActionGestisciStati()">⚙️ GESTISCI</span></label><div style="display:flex;"><input type="text" id="cmbStato" list="listStati" placeholder="Scegli o scrivi..." style="border-radius:10px 0 0 10px !important;"><button type="button" onclick="if(typeof ActionSalva==='function')ActionSalva(true);" title="Salva Modifica" style="padding:0 6px; border:1.5px solid #334155; border-left:none; background:rgba(16, 185, 129, 0.15); cursor:pointer; border-radius:0 10px 10px 0; display:flex; align-items:center;"><i class="fa fa-save" style="color:#10b981;"></i></button></div><datalist id="listStati"></datalist><div id="stato-buttons-bar" style="display:flex; flex-wrap:wrap; gap:6px; margin-top:5px;"></div></div>
                        <div class="form-group" style="flex: 0.4;"><label>KM A.</label><div style="display:flex;"><input type="text" id="txtKmAndata" style="border-radius:10px 0 0 10px !important;"><button type="button" onclick="if(typeof ActionSalva==='function')ActionSalva(true);" title="Salva Modifica" style="padding:0 6px; border:1.5px solid #334155; border-left:none; background:rgba(16, 185, 129, 0.15); cursor:pointer; border-radius:0 10px 10px 0; display:flex; align-items:center;"><i class="fa fa-save" style="color:#10b981;"></i></button></div></div>
                        <div class="form-group" style="flex: 0.4;"><label>KM R.</label><div style="display:flex;"><input type="text" id="txtKmRitorno" style="border-radius:10px 0 0 10px !important;"><button type="button" onclick="if(typeof ActionSalva==='function')ActionSalva(true);" title="Salva Modifica" style="padding:0 6px; border:1.5px solid #334155; border-left:none; background:rgba(16, 185, 129, 0.15); cursor:pointer; border-radius:0 10px 10px 0; display:flex; align-items:center;"><i class="fa fa-save" style="color:#10b981;"></i></button></div></div>
                        <div class="form-group" style="flex: 0.4;"><label>TOT</label><input type="text" id="txtKmTotale" readonly class="locked"></div>
                        <div class="form-group" style="flex: 0 0 100px; align-items:center; border-left: 1px solid #eee; padding-left: 15px;"><label id="lblChiusa">CHIUSA?</label><input type="checkbox" id="chkConsegnato" style="width:22px; height:22px;"></div>
                    </div>
                    </div>
                </div>

                <!-- CARD 3: NOTE E MERCE -->
                <div class="danea-card" id="cardNote" style="margin-top:10px;">
                    <div class="card-header" onclick="ToggleCard('cardNote')" style="cursor:pointer; display:flex; justify-content:space-between; align-items:center;">
                        <span>📝 Note e Descrizione Merce</span>
                        <div class="btn-toggle-card" id="btnToggleNote">▲</div>
                    </div>
                    <div class="card-content">
                    <div class="form-row" style="border-bottom:none">
                        <div class="form-group flex-1"><label>NOTE OPERATIVE <button id="btnViewPOD" style="display:none; background:#22c55e; color:white; border:none; padding:3px 8px; border-radius:6px; font-size:10px; font-weight:bold; cursor:pointer; margin-left:10px; vertical-align:middle;" onclick="if(typeof ApriPOD === 'function') ApriPOD();">🖼️ Visualizza POD</button></label>
                            <textarea id="txtNote" rows="1" style="overflow:hidden; min-height:38px; resize:none;" oninput="this.style.height='';this.style.height=this.scrollHeight+'px'"></textarea>
                            <div id="note-chips-bar" style="display:flex; flex-wrap:wrap; gap:5px; margin-top:6px;">
                                <button type="button" onclick="document.getElementById('txtNote').value += (document.getElementById('txtNote').value ? ' - ' : '') + this.innerText; document.getElementById('txtNote').dispatchEvent(new Event('change')); this.style.transform='scale(0.9)'; setTimeout(()=>this.style.transform='none',150);" style="background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); color:#cbd5e1; border-radius:12px; padding:3px 8px; font-size:9.5px; cursor:pointer; transition:all 0.2s; white-space:nowrap;" onmouseover="this.style.background='rgba(255,255,255,0.15)'" onmouseout="this.style.background='rgba(255,255,255,0.06)'">Cliente Assente</button>
                                <button type="button" onclick="document.getElementById('txtNote').value += (document.getElementById('txtNote').value ? ' - ' : '') + this.innerText; document.getElementById('txtNote').dispatchEvent(new Event('change')); this.style.transform='scale(0.9)'; setTimeout(()=>this.style.transform='none',150);" style="background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); color:#cbd5e1; border-radius:12px; padding:3px 8px; font-size:9.5px; cursor:pointer; transition:all 0.2s; white-space:nowrap;" onmouseover="this.style.background='rgba(255,255,255,0.15)'" onmouseout="this.style.background='rgba(255,255,255,0.06)'">Lasciare in portineria</button>
                                <button type="button" onclick="document.getElementById('txtNote').value += (document.getElementById('txtNote').value ? ' - ' : '') + this.innerText; document.getElementById('txtNote').dispatchEvent(new Event('change')); this.style.transform='scale(0.9)'; setTimeout(()=>this.style.transform='none',150);" style="background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); color:#cbd5e1; border-radius:12px; padding:3px 8px; font-size:9.5px; cursor:pointer; transition:all 0.2s; white-space:nowrap;" onmouseover="this.style.background='rgba(255,255,255,0.15)'" onmouseout="this.style.background='rgba(255,255,255,0.06)'">Pacco Danneggiato</button>
                                <button type="button" onclick="document.getElementById('txtNote').value += (document.getElementById('txtNote').value ? ' - ' : '') + this.innerText; document.getElementById('txtNote').dispatchEvent(new Event('change')); this.style.transform='scale(0.9)'; setTimeout(()=>this.style.transform='none',150);" style="background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); color:#cbd5e1; border-radius:12px; padding:3px 8px; font-size:9.5px; cursor:pointer; transition:all 0.2s; white-space:nowrap;" onmouseover="this.style.background='rgba(255,255,255,0.15)'" onmouseout="this.style.background='rgba(255,255,255,0.06)'">Consegnare mattina</button>
                            </div>
                        </div>
                        <div class="form-group flex-2">
                            <label>DESCRIZIONE MERCE <span id="lblConteggioMerce" class="label-info-merce">(0 ARTICOLI)</span> <span id="tagExcel" class="tag-auto-caricati" style="display:none;">✓ EXCEL UFFICIO</span></label>
                            <textarea id="txtMerce" class="txt-merce-premium" rows="2" ondblclick="ApriModalArticoli()" placeholder="Elenco ausili e dispositivi..." style="overflow:hidden; min-height:50px; resize:none;" oninput="this.style.height='';this.style.height=this.scrollHeight+'px'"></textarea>
                        </div>
                    </div>
                        </div>
                    </div>
                    </div>
                </div>
            </div>

        <!-- STATUS BAR -->
        <footer class="status-bar" role="contentinfo" style="display:flex; align-items:center;">
            <div id="lblContatore" aria-live="polite">Record trovati: 0</div>
            
            <!-- PROGRESS BAR GAMIFICATION -->
            <div style="margin-left: 20px; display:flex; align-items:center; gap:10px;" title="Stato completamento consegne per i record visibili">
                <span style="font-size:10px; font-weight:800; color:#cbd5e1; letter-spacing:0.5px;">PROGRESSO:</span>
                <div style="width: 150px; height: 14px; background: rgba(15,23,42,0.8); border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); overflow: hidden; position: relative;">
                    <div id="barProgresso" style="width: 0%; height: 100%; background: linear-gradient(90deg, #10b981, #34d399); transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 0 10px rgba(16,185,129,0.5);"></div>
                </div>
                <span id="lblProgresso" style="font-size:11px; font-weight:900; color:#10b981; width:35px;">0%</span>
            </div>

            <div style="cursor:help; padding:2px 8px; border:1px solid #334155; border-radius:12px; background:rgba(15,23,42,0.6); font-size:10px; color:#94a3b8; display:flex; align-items:center; margin-left:15px;" title="SCORCIATOIE TASTIERA:&#10;[CTRL + N] = Nuova Consegna&#10;[CTRL + S] = Salva Modifiche&#10;[CTRL + F] = Cerca nell'elenco&#10;[ESC] = Chiudi Scheda">⌨️ Scorciatoie</div>
            <div id="lblAvvisoProtezione" style="color:#ffab00; display:none; margin-left:auto;" aria-live="assertive">⚠️ MODALITÀ STORICO</div>
        </footer>

        <!-- ELEMENTI NASCOSTI PER COMPATIBILITÀ JS -->
        <div style="display:none">
            <button id="cmdNuovo"></button>
            <button id="cmdSalva"></button>
            <button id="cmdElimina"></button>
            <button id="cmdConsegneImminenti"></button>
            <button id="cmdGeneraReport"></button>
            <button id="cmdGeneraReportDiretto"></button>
            <button id="cmdPDF"></button>
            <button id="cmdEmail"></button>
            <button id="cmdWhatsApp" onclick="ActionWhatsApp()"></button>
            <button id="cmdMostraFile"></button>
            <button id="cmdHelp"></button>
            <button id="cmdChiudi"></button>
            <input type="text" id="txtId" value="NEW">
            <input type="hidden" id="lblClientID" value="">
            <input type="hidden" id="txtFirmaBase64" value="">
            <input type="file" id="fileFotoCliente" accept="image/*" style="display:none;" onchange="ActionAssociaFotoCliente(this.value)">
            <button id="cmdPromemoria"></button>
            <button id="cmdOreRecupero"></button>
            <datalist id="listLocalita"></datalist>
        </div>

    </div>

    <!-- GOLD CATALOG PICKER MODAL -->
    <div id="modalArticoli" class="modal-overlay">
        <div id="modalContentArticoli" class="modal-content">
            <div class="modal-header">
                <span style="font-weight:bold; font-size:12px;">📦 CATALOGO AUSILI</span>
                <button type="button" onclick="ChiudiModalArticoli()" style="background:none; border:none; color:white; font-size:1.2rem; cursor:pointer;">&times;</button>
            </div>
            
            <div class="modal-body">
                <div class="modal-sidebar">
                    <div class="form-group">
                        <label style="color:#94a3b8; font-size:10px;">CATEGORIA</label>
                        <select id="cmbArticoli" style="padding:8px 10px; border:1.5px solid #334155; border-radius:8px; font-size:12px; background:rgba(15,23,42,0.7); color:#fff;"></select>
                    </div>
                    
                    <div class="form-group" style="flex:1;">
                        <label style="color:#94a3b8; font-size:10px; display:flex; justify-content:space-between;">
                            <span>PRODOTTI</span>
                            <span id="lblArticoliContatore" style="font-weight:800; color:#0ea5e9;">0</span>
                        </label>
                        <select id="lstArticoli" size="10" class="list-articles"></select>
                    </div>
                </div>
                
                <div class="modal-preview">
                    <div id="lblNoFotoArt" style="font-weight:900; color:#eee; font-size:1.5rem; text-align:center;">
                        ANTEPRIMA
                    </div>
                    <img id="imgFotoArticolo" class="img-preview-box" style="display:none;">
                </div>
            </div>
            
            <div class="modal-footer">
                <button type="button" class="btn-action danger" onclick="SvuotaMerce()">
                    <img src="data:image/png;base64,"> SVUOTA
                </button>
                <div style="display:flex; gap:10px;">
                    <button type="button" class="btn-action" onclick="ChiudiModalArticoli()">
                        <img src="data:image/png;base64,"> CHIUDI
                    </button>
                    <button type="button" class="btn-action success" onclick="ConfermaSelezioneArticolo()">
                        <img src="data:image/png;base64,"> INSERISCI
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODALI -->
    <div id="calendarOverlay" class="calendar-overlay">
        <div class="calendar-modal">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; border-bottom:1px solid #1e293b; padding-bottom:10px;">
                <button id="btnCalPrev" style="border:none; background:none; cursor:pointer; font-size:1.2rem; filter:invert(1);">◀️</button>
                <h3 id="lblCalMeseAnno" style="margin:0; color:#0ea5e9; font-size:1.2rem; font-weight:900;">Mese Anno</h3>
                <button id="btnCalNext" style="border:none; background:none; cursor:pointer; font-size:1.2rem; filter:invert(1);">▶️</button>
            </div>
            <div id="gridCalendario"></div>
            <div class="calendar-footer">
                <button id="btnCalOggi" class="btn-cal-action">OGGI</button>
                <button id="btnCalChiudi" class="btn-cal-action danger">CHIUDI</button>
            </div>
        </div>
    </div>

    <div id="tp-backdrop" class="time-picker-backdrop" onclick="ChiudiTimePicker()">
        <div id="tp-modal" class="time-picker-modal" onclick="event.cancelBubble=true;">
            <div class="time-picker-header">Selezione Orario</div>
            <div class="time-picker-body">
                <div class="time-picker-col">
                    <div class="time-picker-label">ORE</div>
                    <div id="tp-hour-grid" class="time-picker-grid"></div>
                </div>
                <div class="time-picker-col">
                    <div class="time-picker-label">MINUTI</div>
                    <div id="tp-minute-grid" class="time-picker-grid"></div>
                </div>
            </div>
            <div class="time-picker-footer">
                <button onclick="ChiudiTimePicker()" class="btn-tp-cancel">ANNULLA</button>
            </div>
        </div>
    </div>

    <!-- OVERLAY OTTIMIZZAZIONE PERCORSO -->
    <div id="routingOverlay" class="calendar-overlay" style="z-index: 99999; flex-direction: column; color: white;">
        <i class="fa fa-spinner fa-spin" style="font-size: 50px; color: #ffab00; margin-bottom: 20px;"></i>
        <h2 id="lblRoutingStatus" style="text-shadow: 0 2px 4px rgba(0,0,0,0.5);">Calcolo percorso in corso...</h2>
        <p id="lblRoutingDetails" style="font-size: 14px; opacity: 0.8;">Conversione indirizzi in corso (0/0)</p>
    </div>

    <!-- OVERLAY WHATSAPP TEMPLATES -->
    <div id="whatsappOverlay" class="calendar-overlay" style="z-index: 99998; display:none; flex-direction:column; justify-content:center; align-items:center;">
        <div class="calendar-modal" style="padding:25px; width:430px; background:#0f172a; border:1.5px solid #334155; color:#cbd5e1; border-radius: 18px; box-shadow: 0 25px 60px rgba(0,0,0,0.6);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; border-bottom:1px solid #1e293b; padding-bottom:12px;">
                <h3 style="margin:0; color:#0ea5e9; font-size:1.15rem; font-weight:900; text-transform:uppercase;">💬 Seleziona Messaggio WhatsApp</h3>
                <button onclick="ChiudiWhatsAppModal()" style="border:none; background:none; cursor:pointer; font-size:1.5rem; color:#94a3b8;">&times;</button>
            </div>
            <div style="display:flex; flex-direction:column; gap:12px; max-height:400px; overflow-y:auto;" id="waTemplateContainer">
                <!-- Popolato dinamicamente da JS -->
            </div>
            <div style="margin-top:20px; text-align:right;">
                <button onclick="ChiudiWhatsAppModal()" style="padding:10px 20px; border-radius:8px; border:1.5px solid #334155; background:#1e293b; color:#cbd5e1; cursor:pointer; font-weight:800; font-size:11px; text-transform:uppercase;">ANNULLA</button>
            </div>
        </div>
    </div>

    <!-- OVERLAY GUIDA E AIUTO -->
    <div id="helpOverlay" class="calendar-overlay" style="z-index: 99999; display:none; flex-direction:column; justify-content:center; align-items:center;">
        <div class="calendar-modal" style="padding:25px; width:580px; background:#0f172a; border:1.5px solid #334155; color:#cbd5e1; border-radius: 18px; box-shadow: 0 25px 60px rgba(0,0,0,0.6);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; border-bottom:1px solid #1e293b; padding-bottom:12px;">
                <h3 style="margin:0; color:#38bdf8; font-size:1.2rem; font-weight:900; text-transform:uppercase; display:flex; align-items:center; gap:8px;">
                    <img src="https://img.icons8.com/fluency/32/help.png" style="width:22px; height:22px;" alt=""> Guida Rapida e Scorciatoie
                </h3>
                <button onclick="ChiudiHelpModal()" style="border:none; background:none; cursor:pointer; font-size:1.5rem; color:#94a3b8; padding:0; line-height:1; transition:color 0.2s;" onmouseover="this.style.color='#f43f5e'" onmouseout="this.style.color='#94a3b8'">&times;</button>
            </div>
            
            <div style="display:flex; flex-direction:column; gap:16px; max-height:450px; overflow-y:auto; padding-right:8px; font-size:12.5px; line-height:1.5; color:#cbd5e1;">
                
                <!-- SEZIONE SALVATAGGIO -->
                <div style="background:#1e293b; border:1px solid #334155; border-radius:12px; padding:14px;">
                    <div style="font-weight:900; color:#38bdf8; font-size:13px; margin-bottom:8px; display:flex; align-items:center; gap:6px;">
                        💾 COME SALVARE VELOCEMENTE LE MODIFICHE
                    </div>
                    <ul style="margin:0; padding-left:20px; display:flex; flex-direction:column; gap:6px;">
                        <li><strong>Scorciatoia Globale:</strong> Premi <span style="background:#0f172a; padding:2px 6px; border-radius:4px; border:1px solid #475569; font-family:monospace; color:#38bdf8;">Ctrl + S</span> o <span style="background:#0f172a; padding:2px 6px; border-radius:4px; border:1px solid #475569; font-family:monospace; color:#38bdf8;">Ctrl + Invio</span> in qualsiasi campo per salvare all'istante.</li>
                        <li><strong>Salvataggio Auto-Invio:</strong> Premi semplicemente il tasto <span style="background:#0f172a; padding:2px 6px; border-radius:4px; border:1px solid #475569; font-family:monospace;">Invio</span> mentre digiti nei campi a riga singola (Indirizzo, Località, Data, Ora, KM, Stato, ecc.) per salvare senza dover cliccare.</li>
                        <li><strong>Pulsante Salva (Mouse):</strong> Fai clic sull'icona col dischetto nel menu superiore (Ribbon).</li>
                    </ul>
                    <div style="margin-top:8px; font-size:11px; color:#94a3b8; font-style:italic; border-top: 1px solid #334155; padding-top:6px; margin-left:6px;">
                        💡 Nota: Il salvataggio da tastiera/Invio è <strong>silenzioso</strong> (mostra solo una barra azzurra in alto senza fastidiosi popup).
                    </div>
                </div>

                <!-- SEZIONE ELIMINAZIONE -->
                <div style="background:#1e293b; border:1px solid #334155; border-radius:12px; padding:14px;">
                    <div style="font-weight:900; color:#f43f5e; font-size:13px; margin-bottom:8px; display:flex; align-items:center; gap:6px;">
                        ❌ COME ELIMINARE UNA CONSEGNA
                    </div>
                    <ul style="margin:0; padding-left:20px; display:flex; flex-direction:column; gap:6px;">
                        <li><strong>Scorciatoia Rapida:</strong> Premi <span style="background:#0f172a; padding:2px 6px; border-radius:4px; border:1px solid #475569; font-family:monospace; color:#f43f5e;">Ctrl + Canc</span> (o <span style="background:#0f172a; padding:2px 6px; border-radius:4px; border:1px solid #475569; font-family:monospace; color:#f43f5e;">Ctrl + Delete</span>) per eliminare subito la consegna selezionata.</li>
                        <li><strong>Barra Superiore:</strong> Clicca sul pulsante rosso <strong>'Elimina Voce'</strong> nel Ribbon.</li>
                        <li><strong>Menu Classico:</strong> Seleziona <strong>File > Elimina Record</strong> dal menu in alto.</li>
                    </ul>
                    <div style="margin-top:8px; font-size:11px; color:#94a3b8; font-style:italic; border-top: 1px solid #334155; padding-top:6px; margin-left:6px;">
                        ⚠️ Nota: Verrà sempre richiesta una conferma di sicurezza prima dell'eliminazione definitiva.
                    </div>
                </div>

                <!-- COPIA ED ALTRE SCORCIATOIE -->
                <div style="background:#1e293b; border:1px solid #334155; border-radius:12px; padding:14px;">
                    <div style="font-weight:900; color:#a855f7; font-size:13px; margin-bottom:8px; display:flex; align-items:center; gap:6px;">
                        📋 COPIA RAPIDA ED ALTRE SCORCIATOIE
                    </div>
                    <ul style="margin:0; padding-left:20px; display:flex; flex-direction:column; gap:6px;">
                        <li><strong>Copia Riepilogo:</strong> Premi <span style="background:#0f172a; padding:2px 6px; border-radius:4px; border:1px solid #475569; font-family:monospace; color:#a855f7;">Ctrl + Shift + C</span> o fai clic su <strong>'Copia Info'</strong> nel Ribbon per copiare tutti i dettagli della consegna formattati negli appunti.</li>
                        <li><strong>F5 (Aggiorna):</strong> Aggiorna al volo i dati della griglia e azzera i filtri di ricerca.</li>
                        <li><strong>Alt + F4 (Esci):</strong> Chiude la schermata corrente e torna alla dashboard principale.</li>
                    </ul>
                </div>

                <!-- ASSOCIAZIONE FOTO -->
                <div style="background:#1e293b; border:1px solid #334155; border-radius:12px; padding:14px;">
                    <div style="font-weight:900; color:#10b981; font-size:13px; margin-bottom:8px; display:flex; align-items:center; gap:6px;">
                        📸 ASSOCIAZIONE FOTO CLIENTE
                    </div>
                    <div style="padding-left:6px; margin:0;">
                        Fai clic direttamente sul riquadro grigio <strong>FOTO</strong> a sinistra del Cognome e Nome: potrai scegliere un file immagine dal computer che verrà automaticamente copiato nella cartella locale e associato al cliente nel database.
                    </div>
                </div>

                <!-- WHATSAPP AUTOMATICO -->
                <div style="background:#1e293b; border:1px solid #334155; border-radius:12px; padding:14px;">
                    <div style="font-weight:900; color:#22c55e; font-size:13px; margin-bottom:8px; display:flex; align-items:center; gap:6px;">
                        💬 INVIO WHATSAPP SMART
                    </div>
                    <div style="padding-left:6px; margin:0;">
                        Cliccando sull'icona di WhatsApp, il sistema prenderà automaticamente la merce descritta nel campo <strong>'Descrizione Merce'</strong> per comporre messaggi già pronti con l'elenco dei dispositivi da consegnare.
                    </div>
                </div>

                <!-- PROTEZIONE KM -->
                <div style="background:#1e293b; border:1px solid #334155; border-radius:12px; padding:14px;">
                    <div style="font-weight:900; color:#e2e8f0; font-size:13px; margin-bottom:8px; display:flex; align-items:center; gap:6px;">
                        🛡️ PROTEZIONE CHILOMETRAGGIO
                    </div>
                    <div style="padding-left:6px; margin:0;">
                        Il sistema impedisce di sovrascrivere accidentalmente i chilometri già rilevati sul campo dal dispositivo mobile.
                    </div>
                </div>

            </div>
            
            <div style="margin-top:20px; text-align:right; border-top:1px solid #1e293b; padding-top:15px;">
                <button onclick="ChiudiHelpModal()" style="padding:10px 24px; border-radius:8px; border:1.5px solid #334155; background:#1e293b; color:#cbd5e1; cursor:pointer; font-weight:800; font-size:11px; text-transform:uppercase; transition:all 0.2s;" onmouseover="this.style.background='#334155'; this.style.color='white';" onmouseout="this.style.background='#1e293b'; this.style.color='#cbd5e1';">CHIUDI GUIDA</button>
            </div>
        </div>
    </div>

    <!-- OVERLAY SCELTA DATA SMART ROUTING -->
    <div id="dateRoutingModalOverlay" class="calendar-overlay" style="z-index: 99999; display:none; flex-direction:column; justify-content:center; align-items:center;">
        <div class="calendar-modal" style="padding:25px; width:400px; background:#0f172a; border:1.5px solid #334155; color:#cbd5e1; border-radius: 18px; box-shadow: 0 25px 60px rgba(0,0,0,0.6);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; border-bottom:1px solid #1e293b; padding-bottom:12px;">
                <h3 style="margin:0; color:#0ea5e9; font-size:1.15rem; font-weight:900; text-transform:uppercase;">📅 Selezione Giorno Percorso</h3>
                <button onclick="ChiudiDateRoutingModal()" style="border:none; background:none; cursor:pointer; font-size:1.5rem; color:#94a3b8;">&times;</button>
            </div>
            <p style="font-size: 12px; color: #94a3b8; margin-bottom: 15px; font-weight: 600;">Sono state rilevate consegne in più date differenti. Scegli quale giorno desideri pianificare:</p>
            <div style="display:flex; flex-direction:column; gap:10px; max-height:300px; overflow-y:auto;" id="dateRoutingContainer">
                <!-- Popolato dinamicamente da JS -->
            </div>
            <div style="margin-top:20px; text-align:right;">
                <button onclick="ChiudiDateRoutingModal()" style="padding:10px 20px; border-radius:8px; border:1.5px solid #334155; background:#1e293b; color:#cbd5e1; cursor:pointer; font-weight:800; font-size:11px; text-transform:uppercase;">ANNULLA</button>
            </div>
        </div>
    </div>

    <!-- OVERLAY STATISTICHE -->
    <div id="statsOverlay" class="calendar-overlay" style="z-index: 99997; display:none; flex-direction:column; justify-content:center; align-items:center;">
        <div class="calendar-modal" style="padding:25px; width:450px; background:#0f172a; border:1.5px solid #334155; color:#cbd5e1; border-radius: 18px; box-shadow: 0 25px 60px rgba(0,0,0,0.6);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; border-bottom:1px solid #1e293b; padding-bottom:12px;">
                <h3 style="margin:0; color:#0ea5e9; font-size:1.15rem; font-weight:900; text-transform:uppercase;">📊 Cabina di Regia - Statistiche <span id="lblStatsMese" style="color: #eab308;"></span></h3>
                <button onclick="ChiudiStatsModal()" style="border:none; background:none; cursor:pointer; font-size:1.5rem; color:#94a3b8;">&times;</button>
            </div>
            <div style="display:flex; flex-direction:column; gap:15px;" id="statsContainer">
                <!-- Popolato dinamicamente da JS -->
            </div>
            <div style="margin-top:20px; text-align:right;">
                <button onclick="ChiudiStatsModal()" style="padding:10px 20px; border-radius:8px; border:1.5px solid #334155; background:#1e293b; color:#cbd5e1; cursor:pointer; font-weight:800; font-size:11px; text-transform:uppercase;">CHIUDI</button>
            </div>
        </div>
    </div>

    <!-- OVERLAY DISTINTA DI CARICO (PIANO ENHANCEMENT) -->
    <div id="distintaOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15,23,42,0.55); backdrop-filter:blur(12px); z-index:10600; justify-content:center; align-items:center;">
        <div style="background:rgba(15, 23, 42, 0.97); width:650px; max-height:85%; border-radius:24px; box-shadow: 0 30px 70px rgba(0,0,0,0.7), inset 0 1px 0 rgba(255,255,255,0.1); border:1.5px solid rgba(251,191,36,0.3); display:flex; flex-direction:column; overflow:hidden; animation: modalSlideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);">
            <!-- HEADER -->
            <div class="no-print" style="background:linear-gradient(135deg, #1e293b 0%, #0f172a 100%); padding:20px 30px; border-bottom:2px solid #fbbf24; display:flex; justify-content:space-between; align-items:center; flex-shrink:0;">
                <div style="display:flex; align-items:center; gap:12px;">
