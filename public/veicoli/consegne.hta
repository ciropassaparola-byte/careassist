<script src="./assets/js/global_context.js"></script>
<script>
function ActionWhatsApp() {
    var phones = [];
    var chips = document.querySelectorAll('#chipsArea .phone-chip');
    if (chips.length > 0) {
        for (var i = 0; i < chips.length; i++) {
            var clone = chips[i].cloneNode(true);
            var removeBtn = clone.querySelector('.remove-chip');
            if (removeBtn) clone.removeChild(removeBtn);
            var icon = clone.querySelector('.chip-wa-icon');
            if (icon) clone.removeChild(icon);
            phones.push(clone.innerText.trim());
        }
    } else {
        var t = document.getElementById('txtTelefono');
        if (t && t.value.trim() !== '') phones.push(t.value.trim());
    }

    if (phones.length === 0) {
        if(typeof showToast === 'function') showToast("Nessun numero di telefono valido inserito.", "error");
        else alert("Nessun numero di telefono inserito.");
        return;
    }

    var phone = phones[0].replace(/[^0-9+]/g, '');
    if (!phone.startsWith('+')) {
        phone = '+39' + phone; 
    }

    var clientName = "Cliente";
    var txtNome = document.getElementById('txtNome');
    if(txtNome && txtNome.value.trim() !== '') clientName = txtNome.value.trim();

    var msg = "Gentile " + clientName + ",\nLa informiamo che la sua consegna è prevista a breve.\n\nCordiali saluti,\nC. Milella Logistica";
    var url = "whatsapp://send?phone=" + phone + "&text=" + encodeURIComponent(msg);
    
    try {
        var wsh = new ActiveXObject("WScript.Shell");
        wsh.Run('cmd /c start "" "' + url + '"', 0, false);
    } catch(e) {
        window.location.href = url;
    }

}
</script>
<!-- MODAL FIRMA DIGITALE -->
<div id="signatureModalOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15, 23, 42, 0.7); z-index:30000; justify-content:center; align-items:center; backdrop-filter: blur(4px);">
    <div style="background:#1e293b; padding:25px; border-radius:18px; border:2px solid #06b6d4; box-shadow: 0 25px 60px rgba(0,0,0,0.6); width:500px; text-align:center;">
        <h3 style="color:#0ea5e9; margin-top:0; font-family:'Inter', sans-serif;">Acquisizione Firma Cliente</h3>
        <div style="background:#ffffff; border-radius:8px; margin: 15px 0; overflow:hidden;">
            <canvas id="signatureCanvas" width="450" height="200" style="cursor:crosshair; touch-action:none; display:block; background:#fff;"></canvas>
        </div>
        <div style="display:flex; justify-content:space-between; gap:10px;">
            <button onclick="ActionPulisciFirma()" style="padding:10px 20px; border-radius:8px; border:none; background:#475569; color:#fff; cursor:pointer; font-weight:bold;">Pulisci</button>
            <div style="display:flex; gap:10px;">
                <button onclick="document.getElementById('signatureModalOverlay').style.display='none'" style="padding:10px 20px; border-radius:8px; border:1px solid #ef4444; background:rgba(239, 68, 68, 0.1); color:#ef4444; cursor:pointer; font-weight:bold;">Annulla</button>
                <button onclick="ActionSalvaFirma()" style="padding:10px 20px; border-radius:8px; border:none; background:#06b6d4; color:#0f172a; cursor:pointer; font-weight:bold;">Conferma</button>
            </div>
        </div>
    </div>
</div>

<script>
var sigCanvas, sigCtx, drawing = false;

function ActionApriFirma() {
    document.getElementById('signatureModalOverlay').style.display = 'flex';
    if (!sigCanvas) {
        sigCanvas = document.getElementById('signatureCanvas');
        sigCtx = sigCanvas.getContext('2d');
        sigCtx.lineWidth = 3;
        sigCtx.lineCap = 'round';
        sigCtx.lineJoin = 'round';
        sigCtx.strokeStyle = '#0f172a';

        sigCanvas.addEventListener('mousedown', startDrawing);
        sigCanvas.addEventListener('mousemove', draw);
        sigCanvas.addEventListener('mouseup', stopDrawing);
        sigCanvas.addEventListener('mouseout', stopDrawing);

        sigCanvas.addEventListener('touchstart', function(e) { e.preventDefault(); startDrawing(e.touches[0]); }, {passive: false});
        sigCanvas.addEventListener('touchmove', function(e) { e.preventDefault(); draw(e.touches[0]); }, {passive: false});
        sigCanvas.addEventListener('touchend', stopDrawing);
    }
}

function getPos(e) {
    var rect = sigCanvas.getBoundingClientRect();
    return { x: e.clientX - rect.left, y: e.clientY - rect.top };
}

function startDrawing(e) {
    drawing = true;
    var pos = getPos(e);
    sigCtx.beginPath();
    sigCtx.moveTo(pos.x, pos.y);
}

function draw(e) {
    if (!drawing) return;
    var pos = getPos(e);
    sigCtx.lineTo(pos.x, pos.y);
    sigCtx.stroke();
}

function stopDrawing() { drawing = false; }

function ActionPulisciFirma() {
    if (sigCtx && sigCanvas) sigCtx.clearRect(0, 0, sigCanvas.width, sigCanvas.height);
}

function ActionSalvaFirma() {
    var base64 = sigCanvas.toDataURL("image/png");
    document.getElementById('txtFirmaBase64').value = base64;
    document.getElementById('signatureModalOverlay').style.display = 'none';
    if(typeof showToast === 'function') showToast("Firma acquisita con successo!", "success");
    else alert("Firma acquisita!");
    
    var id = document.getElementById('txtId').value;
    if (id && id !== 'NEW' && typeof ActionSalva === 'function') {
        ActionSalva(true);
    }

}
</script>

