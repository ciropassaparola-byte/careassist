    <script>
    // Bypass Cache: Forza l'aggiornamento
    if (typeof ActionOttimizzaPercorso === 'undefined') {
        alert("Errore: Il motore JavaScript non e' stato aggiornato. Riavviare il PC o svuotare la cache di Internet Explorer.");
    }
        // --- HACKER MODE: SCORCIATOIE TASTIERA ---
    document.addEventListener('keydown', function(e) {
        // ESC per chiudere il pannello
        if (e.key === 'Escape') {
            if (typeof ActionChiudiEditor === 'function') ActionChiudiEditor();
        }
        // CTRL + F per cercare
        if (e.ctrlKey && (e.key === 'f' || e.key === 'F')) {
            e.preventDefault();
            var searchBox = document.getElementById('txtRicerca');
            if (searchBox) { searchBox.focus(); searchBox.select(); }
        }
        // CTRL + N per nuova consegna
        if (e.ctrlKey && (e.key === 'n' || e.key === 'N')) {
            e.preventDefault();
            if (typeof ActionNuovo === 'function') ActionNuovo();
        }
        // CTRL + S per salvare (previene il salvataggio pagina del browser)
        if (e.ctrlKey && (e.key === 's' || e.key === 'S')) {
            e.preventDefault();
            var btnSalva = document.getElementById('cmdSalva');
            if(btnSalva) btnSalva.click();
        }
    });
</script>

