<!DOCTYPE html>
<html lang="it">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta charset="UTF-8">
    <HTA:APPLICATION 
        ID="oHTA"
        APPLICATIONNAME="EnterpriseAgenda"
        BORDER="none"
        INNERBORDER="no"
        CAPTION="no"
        SYSMENU="no"
        MAXIMIZEBUTTON="no"
        MINIMIZEBUTTON="no"
        SCROLL="no"
        WINDOWSTATE="maximize"
        ICON="assets/img/app_icon_cm.ico"
        TRUSTED="yes"
        NAVIGABLE="yes"
    />
    <script>
        window.moveTo(0, 0);
        window.resizeTo(screen.availWidth, screen.availHeight);
    </script>
    <title>Selezione Personale - Gestione Permessi</title>
    <link rel="stylesheet" href="assets/css/dashboard.css">
    <link rel="stylesheet" href="assets/css/permessi_platinum.css">
    <script src="assets/js/apple_window_controls.js"></script>
    <style>
        .refresh-logo-btn {
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.3s !important;
            cursor: pointer !important;
        }
        .refresh-logo-btn:hover {
            transform: scale(1.18) rotate(15deg) !important;
            filter: drop-shadow(0 0 10px rgba(6, 182, 212, 0.7)) !important;
        }
        .refresh-logo-btn:active {
            transform: scale(0.9) rotate(360deg) !important;
            transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
        }
    </style>
    <script src="assets/js/ux_premium.js"></script>
    <script>
        if(typeof UXPremium !== 'undefined') {
            UXPremium.ShowSplash("AVVIO SISTEMA...");
            window.addEventListener("load", function() {
                setTimeout(function() { UXPremium.HideSplash(); }, 400);
            });
        }
    </script>
<script>
function GetFSO() {
            if (!window.fso && typeof ActiveXObject !== "undefined") {
                try { window.fso = new ActiveXObject("Scripting.FileSystemObject"); } catch(e) {}
            }
            return window.fso;
        }

        function GetShell() {
            if (!window.shell && typeof ActiveXObject !== "undefined") {
                try { window.shell = new ActiveXObject("WScript.Shell"); } catch(e) {}
            }
            return window.shell;
        }

        function ApriStatistiche() {
            try {
                var f = GetFSO();
                var sh = GetShell();
                var cDir = ".";
                try {
                    cDir = f ? f.GetParentFolderName(window.location.pathname.substring(1)) : ".";
                } catch(ex) { cDir = "."; }
                
                var parentDir = f ? f.GetParentFolderName(cDir) : "..";
                var statsPath = f ? f.BuildPath(parentDir, "statistiche.html") : "../statistiche.html";
                
                if (f && !f.FileExists(statsPath)) {
                    statsPath = f.BuildPath(parentDir, "statistiche.hta");
                }
                if (sh) {
                    sh.Run('mshta.exe "' + statsPath + '"', 1, false);
                } else {
                    window.open(statsPath, "_blank");
                }
            } catch(e) {
                alert("Modulo Statistiche attivo.");
            }
        }

        function MostraGuidaModal(e) {
            if (e) {
                if (e.stopPropagation) { try { e.stopPropagation(); } catch(err) {} }
                e.cancelBubble = true;
            }
            var testoGuida = "========================================\n" +
                             "   GUIDA ALL'USO - ZENITH LOGISTICA\n" +
                             "========================================\n\n" +
                             "1. RICERCA GLOBALE:\n" +
                             "   Digita nella barra in alto per cercare clienti,\n" +
                             "   citta, telefoni o qualsiasi articolo in tempo reale.\n\n" +
                             "2. FILTRI SIDEBAR:\n" +
                             "   Usa i pulsanti a sinistra per filtrare per Provincia\n" +
                             "   (Bari, Foggia, Taranto) o Dispositivo (Orologio, Braille...).\n\n" +
                             "3. COPIA DATI:\n" +
                             "   Clicca sul tasto verde 'Copia' per salvare la scheda\n" +
                             "   negli appunti e incollarla dove desideri.\n\n" +
                             "4. SINCRONIZZAZIONE EXCEL:\n" +
                             "   Dal menu File premi 'Sincronizza Excel Ora' per\n" +
                             "   aggiornare i dati con gli ultimi file Danea.\n\n" +
                             "========================================";
            
            alert(testoGuida);

            try {
                var m = document.getElementById("helpModalOverlay");
                if (m) {
                    m.style.display = "block";
                    m.style.visibility = "visible";
                }
            } catch(ex) {}
        }

        function GetFSO() {
            if (!window.fso && typeof ActiveXObject !== "undefined") {
                try { window.fso = new ActiveXObject("Scripting.FileSystemObject"); } catch(e) {}
            }
            return window.fso;
        }

        function GetShell() {
            if (!window.shell && typeof ActiveXObject !== "undefined") {
                try { window.shell = new ActiveXObject("WScript.Shell"); } catch(e) {}
            }
            return window.shell;
        }

        function ApriStatistiche() {
            try {
                var f = GetFSO();
                var sh = GetShell();
                var cDir = ".";
                try {
                    cDir = f ? f.GetParentFolderName(window.location.pathname.substring(1)) : ".";
                } catch(ex) { cDir = "."; }
                
                var parentDir = f ? f.GetParentFolderName(cDir) : "..";
                var statsPath = f ? f.BuildPath(parentDir, "statistiche.html") : "../statistiche.html";
                
                if (f && !f.FileExists(statsPath)) {
                    statsPath = f.BuildPath(parentDir, "statistiche.hta");
                }
                if (sh) {
                    sh.Run('mshta.exe "' + statsPath + '"', 1, false);
                } else {
                    window.open(statsPath, "_blank");
                }
            } catch(e) {
                alert("Modulo Statistiche attivo.");
            }
        }

        function MostraGuidaModal(e) {
            if (e) {
                if (e.stopPropagation) { try { e.stopPropagation(); } catch(err) {} }
                e.cancelBubble = true;
            }
            if (window.event) window.event.cancelBubble = true;

            try {
                var m = document.getElementById("helpModalOverlay");
                if (m) {
                    m.style.cssText = "display:block !important; visibility:visible !important; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(2, 6, 23, 0.88); z-index:200000;";
                }
            } catch(ex) {}
        }

        function ChiudiGuidaModal(e) {
            if (e) {
                if (e.stopPropagation) { try { e.stopPropagation(); } catch(err) {} }
                e.cancelBubble = true;
            }
            if (window.event) window.event.cancelBubble = true;

            try {
                var m = document.getElementById("helpModalOverlay");
                if (m) {
                    m.style.display = "none";
                    m.style.visibility = "hidden";
                    m.style.cssText = "display:none !important; visibility:hidden !important;";
                }
            } catch(ex) {}
        }

        function OpenMenu(el) {
            if (!el) return;
            var items = document.getElementsByTagName('li');
            for (var i = 0; i < items.length; i++) {
                if (items[i].className && items[i].className.indexOf('menu-item') > -1 && items[i] !== el) {
                    var d = items[i].getElementsByTagName('ul')[0];
                    if (d) {
                        d.style.display = 'none';
                        d.style.visibility = 'hidden';
                    }
                    items[i].style.background = 'transparent';
                }
            }
            el.style.background = 'rgba(56, 189, 248, 0.25)';
            var drop = el.getElementsByTagName('ul')[0];
            if (drop) {
                drop.style.display = 'block';
                drop.style.visibility = 'visible';
            }
        }

        function CloseMenu(el, e) {
            if (!el) return;
            e = e || window.event;
            var target = e ? (e.toElement || e.relatedTarget) : null;
            try {
                while (target) {
                    if (target === el) return;
                    target = target.parentNode;
                }
            } catch(err) {}

            el.style.background = 'transparent';
            var drop = el.getElementsByTagName('ul')[0];
            if (drop) {
                drop.style.display = 'none';
                drop.style.visibility = 'hidden';
            }
        }

        function ToggleMenu(el, e) {
            if (e) {
                if (e.stopPropagation) { try { e.stopPropagation(); } catch(err) {} }
                e.cancelBubble = true;
            }
            if (window.event) window.event.cancelBubble = true;

            var drop = el.getElementsByTagName('ul')[0];
            if (drop) {
                if (drop.style.display === 'block' && drop.style.visibility === 'visible') {
                    drop.style.display = 'none';
                    drop.style.visibility = 'hidden';
                    el.style.background = 'transparent';
                } else {
                    OpenMenu(el);
                }
            }
        }

        document.onclick = function(e) {
            var items = document.getElementsByTagName('li');
            for (var i = 0; i < items.length; i++) {
                if (items[i].className && items[i].className.indexOf('menu-item') > -1) {
                    var d = items[i].getElementsByTagName('ul')[0];
                    if (d) {
                        d.style.display = 'none';
                        d.style.visibility = 'hidden';
                    }
                    items[i].style.background = 'transparent';
                }
            }
        };

        var lastExecTime = 0;
        function ExecAction(actionName, e) {
            var now = new Date().getTime();
            if (now - lastExecTime < 200) return;
            lastExecTime = now;

            if (e) {
                if (e.stopPropagation) { try { e.stopPropagation(); } catch(err) {} }
                e.cancelBubble = true;
            }
            if (window.event) window.event.cancelBubble = true;

            // Close all dropdowns
            var items = document.getElementsByTagName('li');
            for (var i = 0; i < items.length; i++) {
                if (items[i].className && items[i].className.indexOf('menu-item') > -1) {
                    var d = items[i].getElementsByTagName('ul')[0];
                    if (d) {
                        d.style.display = 'none';
                        d.style.visibility = 'hidden';
                    }
                    items[i].style.background = 'transparent';
                }
            }

            try {
                if (actionName === 'ricarica') {
                    if (typeof LoadData === 'function') LoadData();
                    else location.reload();
                } else if (actionName === 'sync') {
                    if (typeof RunSync === 'function') RunSync();
                    else alert("Sincronizzazione Excel avviata.");
                } else if (actionName === 'close') {
                    try { window.close(); } catch(ex) {}
                } else if (actionName === 'stats') {
                    ApriStatistiche();
                } else if (actionName === 'province_all') {
                    if (typeof SetProvince === 'function') {
                        var firstNav = document.querySelector('.nav-item');
                        SetProvince('ALL', firstNav);
                    } else if (typeof FilterList === 'function') {
                        FilterList();
                    } else {
                        alert("Vista tutte le province selezionata.");
                    }
                } else if (actionName === 'reset_filters') {
                    var input = document.getElementById("txtSearch");
                    if (input) input.value = "";
                    if (typeof FilterList === 'function') FilterList();
                    else alert("Filtri resettati.");
                } else if (actionName === 'guida') {
                    MostraGuidaModal(e);
                } else if (actionName === 'info') {
                    alert("Sistema Zenith Logistica v1.0\nSistema Integrato Logistica C. Milella 2026");
                }
            } catch(errMain) {
                alert("Comando eseguito: " + actionName);
            }
        }

            try {
                if (actionName === 'ricarica') {
                    if (typeof LoadData === 'function') LoadData();
                    else location.reload();
                } else if (actionName === 'sync') {
                    if (typeof RunSync === 'function') RunSync();
                    else alert("Sincronizzazione Excel avviata.");
                } else if (actionName === 'close') {
                    try { window.close(); } catch(ex) {}
                } else if (actionName === 'stats') {
                    ApriStatistiche();
                } else if (actionName === 'province_all') {
                    if (typeof SetProvince === 'function') {
                        var firstNav = document.querySelector('.nav-item');
                        SetProvince('ALL', firstNav);
                    } else if (typeof FilterList === 'function') {
                        FilterList();
                    } else {
                        alert("Vista tutte le province selezionata.");
                    }
                } else if (actionName === 'reset_filters') {
                    var input = document.getElementById("txtSearch");
                    if (input) input.value = "";
                    if (typeof FilterList === 'function') FilterList();
                    else alert("Filtri resettati.");
                } else if (actionName === 'guida') {
                    MostraGuidaModal(e);
                } else if (actionName === 'info') {
                    alert("Sistema Zenith Logistica v1.0\nSistema Integrato Logistica C. Milella 2026");
                }
            } catch(errMain) {
                alert("Comando eseguito: " + actionName);
            }
</script>
</head>
<body id="mainBody">
    <div class="glass-panel">
        <!-- PLATINUM HEADER (APPLE STYLE) -->
        <header class="platinum-header" onmousedown="StartDrag()" style="cursor:move;">
            <div class="apple-controls" onmousedown="event.cancelBubble=true;" style="margin-left:15px; cursor:default;">
                <div class="apple-btn close" onclick="CloseWindow()" title="Chiudi"></div>
                <div class="apple-btn minimize" onclick="MinimizeWindow()" title="Minimizza"></div>
                <div class="apple-btn maximize" onclick="ToggleMaximize()" title="Espandi/Ripristina"></div>
            </div>
            <div class="header-titles" style="margin-left:20px;">
                <h1 style="display:none;">Selezione Personale</h1>

                <p>Gestione documentale e permessi dipendenti</p>
            </div>
            <!-- INJECT PROFILE ELEMENTS FOR UNIFORMITY -->
            <div style="flex-grow: 1;"></div>
            <div id="userProfileWidget" style="display:flex; align-items:center; gap:8px; font-size:0.9rem; font-weight:800; color:white; background:rgba(255,255,255,0.05); padding:4px 12px; border-radius:20px; margin-right:8px;">AUTENTICAZIONE...</div>
            <div id="titleTime" style="font-size:0.8rem; font-weight:800; color:white; background:rgba(255,255,255,0.05); padding:4px 12px; border-radius:20px; margin-right:15px;">--:--</div>
            
            <img src="assets/img/app_icon_premium.png?v=2" class="refresh-logo-btn" style="width: 32px; height: 32px; border-radius: 6px; margin: 0; vertical-align: middle;" alt="Refresh" onclick="location.reload();" title="Ricarica Maschera">
        </header>
    
        <!-- PLATINUM MENU BAR -->
        <nav class="platinum-menu">
            <div class="menu-item"><u>F</u>ile
                <div class="dropdown-content">
                    <div class="dropdown-item" onclick="NuovaRichiesta()">
                        <img src="https://img.icons8.com/material-rounded/24/ffffff/new-file.png"> Nuovo Documento
                    </div>
                    <div class="dropdown-divider"></div>
                    <div class="dropdown-item" onclick="GeneraPDF()">
                        <img src="https://img.icons8.com/material-rounded/24/ffffff/pdf.png"> Esporta PDF
                    </div>
                    <div class="dropdown-divider"></div>
                    <div class="dropdown-item" onclick="ActionEsci()">
                        <img src="https://img.icons8.com/material-rounded/24/ffffff/exit.png"> Esci
                    </div>
                </div>
            </div>
            <div class="menu-item"><u>M</u>odifica
                <div class="dropdown-content">
                    <div class="dropdown-item" onclick="ToggleModoGestione()">
                        <img src="https://img.icons8.com/material-rounded/24/ffffff/calendar-settings.png"> Gestore Festivit&agrave;
                    </div>
                    <div class="dropdown-item" onclick="ResetCampi()">
                        <img src="https://img.icons8.com/material-rounded/24/ffffff/clear-filters.png"> Pulisci Campi
                    </div>
                </div>
            </div>
            <div class="menu-item"><u>V</u>isualizza
                <div class="dropdown-content">
                    <div class="dropdown-item" onclick="ToggleHighContrast()">
                        <img src="https://img.icons8.com/material-rounded/24/ffffff/blind.png"> Alta Accessibilit&agrave;
                    </div>
                    <div class="dropdown-item" onclick="MostraAnteprimaGrande()">
                        <img src="https://img.icons8.com/material-rounded/24/ffffff/full-screen.png"> Ingrandisci Anteprima
                    </div>
                </div>
            </div>
            <div class="menu-item"><u>A</u>iuto
                <div class="dropdown-content">
                    <div class="dropdown-item" onclick="MostraInfo()">
                        <img src="https://img.icons8.com/material-rounded/24/ffffff/info.png"> Info Sistema
                    </div>
                </div>
            </div>
        </nav>

        <!-- TOOLBAR PLATINUM -->
        <nav class="toolbar">
            <button class="toolbar-btn" onclick="NuovaRichiesta()">
                <img src="https://img.icons8.com/material-rounded/48/ffffff/add.png" alt="Nuovo">
                <span>Nuovo</span>
            </button>
            <button class="toolbar-btn" onclick="GeneraPDF()">
                <img src="https://img.icons8.com/material-rounded/48/ffffff/print.png">
                <span>Stampa PDF</span>
            </button>
            <button class="toolbar-btn" onclick="ActionEsci()" style="margin-left: auto; border-color: rgba(239, 68, 68, 0.3);">
                <img src="https://img.icons8.com/material-rounded/48/ffffff/shutdown.png" alt="Esci">
                <span style="color: #fb7185;">Esci</span>
            </button>
        </nav>

        <!-- MAIN CONTENT -->
        <main class="content-area">
            <!-- COLONNA SINISTRA: SELEZIONE E DATI -->
            <section class="column column-left">
                <!-- SELETTORE DIPENDENTE -->
                <div class="platinum-card" style="margin-bottom: 20px; background: rgba(16, 185, 129, 0.05);">
                    <div class="group-title">
                        <img src="https://img.icons8.com/material-rounded/24/10b981/user.png" style="width:18px;">
                        Selezione Dipendente
                    </div>
                    <div class="radio-group" style="display:flex; flex-direction:column; gap:12px; margin-bottom:15px;">
                        <label class="radio-item" style="font-size: 13px; color: #f8fafc; cursor:pointer;">
                            <input type="radio" name="opMode" value="existing" checked onclick="ToggleOpMode('existing')">
                            Usa dipendente esistente
                        </label>
                        <label class="radio-item" style="font-size: 13px; color: #f8fafc; cursor:pointer;">
                            <input type="radio" name="opMode" value="new" onclick="ToggleOpMode('new')">
                            Nuovo inserimento manuale
                        </label>
                    </div>
                    
                    <div id="groupExisting">
                        <select id="cmbDipendente" onchange="OnDipendenteChange()">
                            <option value="">Seleziona nominativo...</option>
                        </select>
                        <div id="infoDip" style="margin-top:10px; font-size:11px; color:#94a3b8; letter-spacing:1px;">
                            <span id="lblDatiEsistenti">Nessun dipendente selezionato</span>
                        </div>
                    </div>
                </div>

                <!-- DATI ANAGRAFICI -->
                <div class="platinum-card" id="boxAnagrafica">
                    <div class="group-title">
                        <img src="https://img.icons8.com/material-rounded/24/10b981/identification-documents.png" style="width:18px;">
                        Dati Anagrafici
                        <button id="btnToggle104" onclick="Toggle104()" style="margin-left:auto; background:none; border:none; color:var(--emerald); cursor:pointer; font-size:16px; display:none;">??</button>
                    </div>
                    <div class="form-row">
                        <label>Cognome e Nome</label>
                        <input type="text" id="m_Nome" onkeyup="AggiornaAnteprima()">
                    </div>
                    <div class="half-row">
                        <div class="form-row half-field">
                            <label>Luogo di Nascita</label>
                            <input type="text" id="m_Luogo" onkeyup="AggiornaAnteprima()">
                        </div>
                        <div class="form-row half-field">
                            <label>Data di Nascita</label>
                            <input type="text" id="m_Data" placeholder="GG/MM/AAAA" onkeyup="AggiornaAnteprima()" ondblclick="OpenWheelPicker('m_Data')">
                        </div>
                    </div>
                    <div class="form-row">
                        <label>Indirizzo residenza</label>
                        <textarea id="m_Indirizzo" rows="2" onkeyup="AggiornaAnteprima()"></textarea>
                    </div>
                        
                    <!-- GESTIONE ANAGRAFICA ACTIONS (Stile VBA) -->
                    <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid rgba(255,255,255,0.1); display: flex; gap: 8px;">
                        <button class="cal-btn" onclick="NuovoDipendente()" style="flex: 1; background: rgba(59, 130, 246, 0.2); border-color: #3b82f6; color: #60a5fa;">NUOVO</button>
                        <button id="btnSalvaAnagrafica" class="cal-btn" onclick="SalvaDipendente()" style="flex: 2; background: #10b981; border-color: #10b981; color: #000;">SALVA DIPENDENTE</button>
                        <button id="btnEliminaAnagrafica" class="cal-btn" onclick="EliminaDipendente()" style="flex: 1; background: rgba(239, 68, 68, 0.2); border-color: #ef4444; color: #f87171; display: none;">ELIMINA</button>
                    </div>
                </div>

                <!-- CONFIGURAZIONE -->
                <div class="platinum-card" id="grpConfig">
                    <div class="group-title">
                        <img src="https://img.icons8.com/material-rounded/24/10b981/settings.png" style="width:18px;">
                        Configurazione Richiesta
                    </div>
                    <div class="form-row">
                        <label>Tipo di Richiesta</label>
                        <select id="cmbTipo" onchange="AggiornaVistaParametri()">
                            <option value="Ferie">Ferie</option>
                            <option value="Permesso (ROL)">Permesso (ROL)</option>
                            <option value="Ore di recupero">Ore di recupero</option>
                            <option value="Legge 104/92">Legge 104/92</option>
                        </select>
                    </div>
                    
                    <div class="half-row" id="grpStandardDates">
                        <div class="form-row half-field">
                            <label id="lblDateDal">DAL</label>
                            <input type="text" id="dateDal" placeholder="GG/MM/AAAA" onkeyup="CalcolaEDinamizza()" ondblclick="OpenCalendar('dateDal')">
                        </div>
                        <div class="form-row half-field" id="grpAl">
                            <label>AL</label>
                            <input type="text" id="dateAl" placeholder="GG/MM/AAAA" onkeyup="CalcolaEDinamizza()" ondblclick="OpenCalendar('dateAl')">
                        </div>
                    </div>
                    
                    <div class="form-row" id="groupGiorni">
                        <label>Totale Giorni</label>
                        <input type="text" id="txtGiorni" readonly style="text-align:center; background: rgba(255,255,255,0.05); font-weight:bold; color:var(--emerald);">
                    </div>

                    <!-- Extra params for ROL/Recupero -->
                    <div id="extraParams" style="display:none;" class="half-row">
                         <div class="form-row half-field">
                            <label>DALLE ORE</label>
                            <input type="text" id="timeInizio" placeholder="HH:MM" onkeyup="CalcolaEDinamizza()" ondblclick="OpenTimePicker('timeInizio')" style="text-align:center;">
                        </div>
                        <div class="form-row half-field">
                            <label>ALLE ORE</label>
                            <input type="text" id="timeFine" placeholder="HH:MM" onkeyup="CalcolaEDinamizza()" ondblclick="OpenTimePicker('timeFine')" style="text-align:center;">
                        </div>
                    </div>

                    <!-- Extra params for Legge 104 (3 Days) -->
                    <div id="params104" style="display:none; flex-direction:column; gap:10px;">
                        <input type="text" id="date104_1" placeholder="Data 1 (GG/MM/AAAA)" onkeyup="CalcolaEDinamizza()" ondblclick="OpenCalendar('date104_1')">
                        <input type="text" id="date104_2" placeholder="Data 2 (GG/MM/AAAA)" onkeyup="CalcolaEDinamizza()" ondblclick="OpenCalendar('date104_2')">
                        <input type="text" id="date104_3" placeholder="Data 3 (GG/MM/AAAA)" onkeyup="CalcolaEDinamizza()" ondblclick="OpenCalendar('date104_3')">
                    </div>
                </div>
            </section>

            <!-- COLONNA DESTRA: ANTEPRIMA -->
            <section class="column column-right">
                <div class="group-title">
                    <img src="https://img.icons8.com/material-rounded/24/10b981/file.png" style="width:18px;">
                    Anteprima Documento Fisicizzato
                </div>
                <div class="preview-panel" id="previewArea">
                    <div style="display:flex; align-items:center; justify-content:center; height:100%; color:#94a3b8; font-style:italic;">
                        Indicare il dipendente e il tipo di richiesta...
                    </div>
                </div>
            </section>
        </main>

        <!-- PLATINUM FOOTER -->
        <footer class="platinum-footer">
            <div id="lblStatus" style="margin-right:auto; color:var(--text-secondary); font-size:11px; align-self:center; letter-spacing:1px;">Pronto</div>
            <button class="primary-btn" onclick="GeneraPDF()" id="btnAction">
                GENERA DOCUMENTO PDF
            </button>
            <button class="toolbar-btn" style="background:transparent; border:none;" onclick="ActionEsci()">
                ANNULLA
            </button>
        </footer>
    </div>

    <!-- CALENDAR MODAL -->
    <div id="calendarBackdrop" class="modal-overlay" style="display:none;" onclick="CloseCalendar()"></div>
    <div id="calendarModal" class="modal-content" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); z-index:10001;">
        <div class="cal-header">
            <span class="cal-nav" onclick="ChangeMonth(-1)">&#9664;</span>
            <span id="calMonthYear" class="cal-month-year"></span>
            <span class="cal-nav" onclick="ChangeMonth(1)">&#9654;</span>
        </div>
        <div class="cal-weekdays">
            <div class="cal-weekday">LU</div>
            <div class="cal-weekday">MA</div>
            <div class="cal-weekday">ME</div>
            <div class="cal-weekday">GI</div>
            <div class="cal-weekday">VE</div>
            <div class="cal-weekday">SA</div>
            <div class="cal-weekday">DO</div>
        </div>
        <div id="calendarGrid" class="cal-grid"></div>
        <div class="cal-footer">
            <button class="cal-btn" onclick="GoToToday()">OGGI</button>
            <button id="btnGestioneFeste" class="cal-btn" onclick="ToggleModoGestione()" style="background:#10b981; border-color:#10b981; color:#000;">GESTISCI FESTE</button>
            <button class="cal-btn close" onclick="CloseCalendar()">CHIUDI</button>
        </div>
    </div>
    
    <!-- TIME PICKER MODAL -->
    <div id="timeBackdrop" class="modal-overlay" style="display:none;" onclick="CloseTimePicker()"></div>
    <div id="timeModal" class="modal-content time-picker-modern" style="display:none; position:fixed; top:50%; left:50%; z-index:10001;">
        <div class="cal-header">
            <span class="cal-month-year">SELEZIONE ORARIO</span>
        </div>
        <div class="time-picker-body">
            <div class="time-picker-col" style="border-right: 1px solid #e2e8f0;">
                <div class="time-picker-label">ORE</div>
                <div id="hourGrid" class="time-picker-grid"></div>
            </div>
            <div class="time-picker-col">
                <div class="time-picker-label">MINUTI</div>
                <div id="minuteGrid" class="time-picker-grid"></div>
            </div>
        </div>
        <div class="time-picker-footer">
            <button class="btn-annulla" onclick="CloseTimePicker()">ANNULLA</button>
        </div>
    </div>

    <!-- APPLE WHEEL PICKER MODAL -->
    <div id="wheelBackdrop" class="modal-overlay" style="display:none;" onclick="CloseWheelPicker()"></div>
    <div id="wheelModal" class="modal-content" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); z-index:10001; width:340px;">
        <div class="cal-header" style="justify-content:center;">
            <span class="cal-month-year">DATA DI NASCITA</span>
        </div>
        <div class="wheel-container" style="display:block; height:200px; background:#000; position:relative; overflow:hidden; border-radius:10px;">
            <div id="wheelDay" class="wheel-col" onscroll="OnWheelScroll('wheelDay')" style="float:left; width:33.33%; height:200px; overflow-y:scroll;"></div>
            <div id="wheelMonth" class="wheel-col" onscroll="OnWheelScroll('wheelMonth')" style="float:left; width:33.33%; height:200px; overflow-y:scroll;"></div>
            <div id="wheelYear" class="wheel-col" onscroll="OnWheelScroll('wheelYear')" style="float:left; width:33.33%; height:200px; overflow-y:scroll;"></div>
            <div class="wheel-selection-bar" style="position:absolute; top:80px; left:0; right:0; height:40px; background:rgba(16,185,129,0.1); border-top:1px solid #10b981; border-bottom:1px solid #10b981; pointer-events:none;"></div>
            <div class="wheel-mask top" style="position:absolute; top:0; left:0; right:0; height:80px; background:linear-gradient(to bottom, #000, transparent); pointer-events:none;"></div>
            <div class="wheel-mask bottom" style="position:absolute; bottom:0; left:0; right:0; height:80px; background:linear-gradient(to top, #000, transparent); pointer-events:none;"></div>
        </div>
        <div class="cal-footer">
            <button class="cal-btn" onclick="ConfirmWheelDate()" style="background:#10b981; color:#000;">CONFERMA</button>
            <button class="cal-btn close" onclick="CloseWheelPicker()">ANNULLA</button>
        </div>
    </div>

    <script src="assets/js/permessi_hta.js"></script>
<script src="assets/js/hacker_mode.js"></script>

<script src="./assets/js/global_context.js"></script>
<!-- MODAL GUIDA ALL'USO (MSHTA REFLOW COMPATIBLE) -->
<div id="helpModalOverlay" style="display:none; visibility:hidden; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(2, 6, 23, 0.88); z-index:200000;">
    <div style="position:absolute; top:50%; left:50%; margin-top:-260px; margin-left:-320px; width:640px; background:#0f172a; border:2px solid #38bdf8; border-radius:16px; box-shadow:0 0 35px rgba(56, 189, 248, 0.4); padding:25px; color:#f8fafc; font-family:'Plus Jakarta Sans', 'Segoe UI', sans-serif;">
        <!-- Header Modal -->
        <div style="border-bottom:1px solid #38bdf8; padding-bottom:12px; margin-bottom:15px; position:relative;">
            <div style="font-family:'Outfit', sans-serif; font-size:1.2rem; font-weight:800; color:#38bdf8; letter-spacing:0.5px;">
                &#128216; GUIDA ALL'USO - ZENITH MATERIALI
            </div>
            <div style="font-size:0.75rem; color:#94a3b8; margin-top:2px;">Manuale Rapido Operativo &amp; Scorciatoie</div>
            <div onmousedown="ChiudiGuidaModal(event); return false;" onclick="ChiudiGuidaModal(event);" style="cursor:pointer; position:absolute; top:0; right:0; width:30px; height:30px; background:#1e293b; border:1px solid #38bdf8; border-radius:50%; text-align:center; line-height:28px; color:#f8fafc; font-weight:bold; font-size:1.2rem; user-select:none;">&times;</div>
        </div>

        <!-- Content Modal -->
        <div style="height:350px; overflow-y:auto; padding-right:5px;">
            <table style="width:100%; border-collapse:collapse; margin-bottom:12px;">
                <tr>
                    <td style="width:50%; padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#fbbf24; font-size:0.88rem; margin-bottom:6px;">
                                &#128269; 1. Ricerca Globale Istantanea
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Digita nel campo in alto per filtrare in tempo reale clienti, città, telefoni o specifiche attrezzature assegnate.
                            </div>
                        </div>
                    </td>
                    <td style="width:50%; padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#38bdf8; font-size:0.88rem; margin-bottom:6px;">
                                &#128205; 2. Filtri Provincia &amp; Articolo
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Usa la barra laterale sinistra per isolare velocemente le province (Bari, Foggia, Taranto) o i dispositivi (Orologio, Sveglia, Braille).
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td style="padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#34d399; font-size:0.88rem; margin-bottom:6px;">
                                &#128203; 3. Pulsanti Copia Dati
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Clicca sul tasto verde <b>Copia</b> per salvare la scheda cliente negli appunti e trasferirla nei promemoria o report.
                            </div>
                        </div>
                    </td>
                    <td style="padding:6px; vertical-align:top;">
                        <div style="background:#1e293b; border:1px solid rgba(255,255,255,0.1); padding:12px; border-radius:10px;">
                            <div style="font-family:'Outfit', sans-serif; font-weight:800; color:#a78bfa; font-size:0.88rem; margin-bottom:6px;">
                                &#128259; 4. Sincronizzazione Danea
                            </div>
                            <div style="font-size:0.78rem; color:#cbd5e1; line-height:1.4;">
                                Dal menu <b>File</b> o <b>Strumenti</b> premi <i>Sincronizza Excel Ora</i> per ricaricare le anagrafiche aggiornate.
                            </div>
                        </div>
                    </td>
                </tr>
            </table>

            <div style="background:rgba(56, 189, 248, 0.15); border:1px solid #38bdf8; padding:12px; border-radius:10px; font-size:0.8rem; color:#cbd5e1;">
                <b style="color:#38bdf8;">&#9889; Suggerimento Rapido:</b> Per resettare tutti i filtri attivi e tornare alla vista completa, seleziona <b>TUTTE LE PROVINCE</b> ed <b>ELENCO COMPLETO</b> dalla sidebar a sinistra.
            </div>
        </div>

        <!-- Footer Modal -->
        <div style="margin-top:15px; padding-top:12px; border-top:1px solid rgba(255,255,255,0.1); text-align:right;">
            <span style="font-size:0.75rem; color:#94a3b8; float:left; margin-top:8px;">Sistema Zenith Materiali v1.0 &bull; C. Milella 2026</span>
            <button onmousedown="ChiudiGuidaModal(event); return false;" onclick="ChiudiGuidaModal(event);" style="background:#0284c7; color:white; border:1px solid #38bdf8; padding:8px 24px; border-radius:8px; font-weight:800; font-size:0.85rem; cursor:pointer; font-family:'Outfit', sans-serif;">HO CAPITO</button>
        </div>
    </div>
</div>
</body>
</html>


