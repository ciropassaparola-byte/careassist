            <iframe id="iframeAdminUtenti" src="" style="width:100%; height:100%; border:none; background:transparent;"></iframe>
        </div>
    </div>

    <script>
        window.ApriModalAdminUtenti = function() {
            var modal = document.getElementById("modalAdminOverlay");
            var iframe = document.getElementById("iframeAdminUtenti");
            if (modal && iframe) {
                iframe.src = "admin_utenti.html?t=" + new Date().getTime();
                modal.style.display = "flex";
            }
        };
    </script>

