                <i class="fa fa-map-marker" style="font-size:14px;"></i> Calcola Percorso Mappa
            </button>
        </div>
        <button id="ux-fab-main" class="ux-ripple-btn" style="width:60px; height:60px; border-radius:50%; background:linear-gradient(135deg, #f59e0b, #d97706); border:none; color:white; font-size:28px; box-shadow:0 8px 25px rgba(217,119,6,0.5); cursor:grab; touch-action:none; display:flex; justify-content:center; align-items:center; transition:transform 0.3s; outline:none;" onmouseover="this.style.transform='scale(1.1) rotate(90deg)';" onmouseout="this.style.transform='scale(1) rotate(0deg)';">
            +
        </button>
    </div>
    <script>
        (function() {
            function InizializzaUxQuickFabDraggable() {
                var wrapper = document.getElementById("ux-quick-fab");
                if (!wrapper) return;
                var mainBtn = document.getElementById("ux-fab-main");
                if (!mainBtn) return;

                try {
                    var savedPos = localStorage.getItem("uxQuickFabPosition");
                    if (savedPos) {
                        var pos = JSON.parse(savedPos);
                        if (pos && typeof pos.left === "number" && typeof pos.top === "number") {
                            wrapper.style.left = pos.left + "px";
                            wrapper.style.top = pos.top + "px";
                            wrapper.style.bottom = "auto";
                            wrapper.style.right = "auto";
                        }
                    }
                } catch(eLoc) {}

                var isDragging = false;
                var fabHasMoved = false;
                var dragStartX = 0, dragStartY = 0;
                var wrapperStartX = 0, wrapperStartY = 0;

                var onStart = function(clientX, clientY) {
                    isDragging = true;
                    fabHasMoved = false;
                    dragStartX = clientX;
                    dragStartY = clientY;
                    var rect = wrapper.getBoundingClientRect();
                    wrapperStartX = rect.left;
                    wrapperStartY = rect.top;
                    mainBtn.style.cursor = "grabbing";
                };

                mainBtn.onmousedown = function(e) {
                    e = e || window.event;
                    onStart(e.clientX, e.clientY);
                    if (e.preventDefault) e.preventDefault();
                    return false;
                };

                mainBtn.ontouchstart = function(e) {
                    if (!e.touches || e.touches.length !== 1) return;
                    var touch = e.touches[0];
                    onStart(touch.clientX, touch.clientY);
                };

                var onMove = function(e) {
                    if (!isDragging) return;
                    e = e || window.event;
                    var clientX = e.clientX;
                    var clientY = e.clientY;
                    if (e.touches && e.touches.length > 0) {
                        clientX = e.touches[0].clientX;
                        clientY = e.touches[0].clientY;
                    }

                    var deltaX = clientX - dragStartX;
                    var deltaY = clientY - dragStartY;

                    if (Math.abs(deltaX) > 3 || Math.abs(deltaY) > 3) {
                        fabHasMoved = true;
                    }

                    var newLeft = wrapperStartX + deltaX;
                    var newTop = wrapperStartY + deltaY;

                    var maxLeft = window.innerWidth - wrapper.offsetWidth - 10;
                    var maxTop = window.innerHeight - wrapper.offsetHeight - 10;

                    if (newLeft < 10) newLeft = 10;
                    if (newLeft > maxLeft) newLeft = maxLeft;
                    if (newTop < 10) newTop = 10;
                    if (newTop > maxTop) newTop = maxTop;

                    wrapper.style.left = newLeft + "px";
                    wrapper.style.top = newTop + "px";
                    wrapper.style.bottom = "auto";
                    wrapper.style.right = "auto";

                    if (e.touches && e.preventDefault) e.preventDefault();
                };

                var onEnd = function(e) {
                    if (!isDragging) return;
                    isDragging = false;
                    mainBtn.style.cursor = "grab";

                    if (fabHasMoved) {
                        var rect = wrapper.getBoundingClientRect();
                        try {
                            localStorage.setItem("uxQuickFabPosition", JSON.stringify({ left: rect.left, top: rect.top }));
                        } catch(eLoc) {}
                    }
                };

                if (document.addEventListener) {
                    document.addEventListener("mousemove", onMove, false);
                    document.addEventListener("mouseup", onEnd, false);
                    document.addEventListener("touchmove", onMove, { passive: false });
                    document.addEventListener("touchend", onEnd, false);
                }

                mainBtn.onclick = function(e) {
                    if (fabHasMoved) {
                        fabHasMoved = false;
                        e = e || window.event;
                        if (e.stopPropagation) e.stopPropagation();
                        e.cancelBubble = true;
                        return false;
                    }
                    var m = document.getElementById('ux-fab-menu');
                    if (m) m.style.display = m.style.display === 'none' ? 'flex' : 'none';
                };
            }

            if (document.readyState === "complete" || document.readyState === "interactive") {
                setTimeout(InizializzaUxQuickFabDraggable, 100);
            } else {
                if (document.addEventListener) {
                    document.addEventListener("DOMContentLoaded", function() { setTimeout(InizializzaUxQuickFabDraggable, 100); });
                }
            }
        })();
    </script>

    <!-- MODALE GUIDA PASSO-PASSO BACKUP & CHIAVETTA USB -->
    <div id="modalGuidaBackup" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15,23,42,0.85); backdrop-filter:blur(8px); z-index:999999; justify-content:center; align-items:center;">
        <div style="background:#ffffff; border-radius:24px; width:720px; max-width:94%; max-height:90vh; overflow-y:auto; padding:32px 28px; box-shadow:0 25px 60px rgba(0,0,0,0.6); border:2px solid #38bdf8; position:relative;">
            <button onclick="document.getElementById('modalGuidaBackup').style.display='none'" style="position:absolute; top:16px; right:20px; background:#f1f5f9; border:none; width:36px; height:36px; border-radius:50%; font-size:18px; font-weight:bold; cursor:pointer; color:#64748b;" onmouseover="this.style.background='#e2e8f0'">‚S"</button>
            
            <div style="text-align:center; margin-bottom:24px;">
                <!-- BADGE UFFICIALE AMMINISTRATORE DEL PROGETTO -->
                <div style="display:inline-flex; align-items:center; gap:8px; background:linear-gradient(135deg, #0f172a, #1e293b); color:#f8fafc; border:1px solid #d4af37; padding:6px 18px; border-radius:20px; font-size:11.5px; font-weight:800; letter-spacing:0.5px; box-shadow:0 3px 10px rgba(0,0,0,0.25); margin-bottom:14px;">
                    <span style="color:#d4af37; font-size:14px;">x</span>
                    <span>Amministratore del progetto Ciro Milella</span>
                </div>
                
                <div style="width:64px; height:64px; border-radius:50%; background:#e0f2fe; border:2px solid #38bdf8; display:flex; align-items:center; justify-content:center; margin:0 auto 12px auto; box-shadow:0 4px 12px rgba(2,132,199,0.2);">
                    <i class="fa fa-book" style="font-size:28px; color:#0284c7;"></i>
                </div>
                <h2 style="margin:0; color:#0f172a; font-size:22px; font-weight:800;">GUIDA PASSO-PASSO: BACKUP & CHIAVETTA USB</h2>
                <p style="margin:6px 0 0 0; color:#64748b; font-size:13.5px;">Istruzioni operative per lavorare in sicurezza a casa e su chiavetta USB</p>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:24px;">
                <!-- Passo 1 -->
                <div style="background:#f8fafc; border:1px solid #e2e8f0; border-left:4px solid #3b82f6; border-radius:14px; padding:16px;">
                    <div style="font-size:14px; font-weight:800; color:#1e40af; margin-bottom:6px; display:flex; align-items:center; gap:8px;">
                        <span>xRx 1. AVVIO DA DESKTOP (CASA)</span>
                    </div>
                    <p style="font-size:12.5px; color:#475569; margin:0; line-height:1.5;">
                        Fai doppio clic sull'icona <b>"Logistica C. Milella"</b> presente sul tuo Desktop di casa. L'applicazione si avvia all'istante <b>senza dover mai aprire le cartelle di sistema</b>.
                    </p>
                </div>

                <!-- Passo 2 -->
                <div style="background:#f8fafc; border:1px solid #e2e8f0; border-left:4px solid #10b981; border-radius:14px; padding:16px;">
                    <div style="font-size:14px; font-weight:800; color:#065f46; margin-bottom:6px; display:flex; align-items:center; gap:8px;">
                        <span>xa¨ 2. LAVORO DA CHIAVETTA USB</span>
                    </div>
                    <p style="font-size:12.5px; color:#475569; margin:0; line-height:1.5;">
                        Inserisci la chiavetta USB su qualsiasi computer. Apri l'unit√† e fai doppio clic su <b>AVVIA_LOGISTICA.bat</b>. Lavori in totale autonomia da qualsiasi postazione.
                    </p>
                </div>

                <!-- Passo 3 -->
                <div style="background:#f8fafc; border:1px solid #e2e8f0; border-left:4px solid #f59e0b; border-radius:14px; padding:16px;">
                    <div style="font-size:14px; font-weight:800; color:#92400e; margin-bottom:6px; display:flex; align-items:center; gap:8px;">
                        <span>x 3. SINCRONIZZAZIONE 1-CLICK</span>
                    </div>
                    <p style="font-size:12.5px; color:#475569; margin:0; line-height:1.5;">
                        Inserisci la chiavetta nel PC di casa e clicca sul pulsante <b>"USB SYNC"</b> nella Dashboard. Il database ed i dati si sincronizzano in 3 secondi in automatico.
                    </p>
                </div>

                <!-- Passo 4 -->
                <div style="background:#f8fafc; border:1px solid #e2e8f0; border-left:4px solid #8b5cf6; border-radius:14px; padding:16px;">
                    <div style="font-size:14px; font-weight:800; color:#5b21b6; margin-bottom:6px; display:flex; align-items:center; gap:8px;">
                        <span>x¶ 4. BACKUP COMPLETO (UI + DATI)</span>
                    </div>
                    <p style="font-size:12.5px; color:#475569; margin:0; line-height:1.5;">
                        Cliccando su <b>"FULL BACKUP (UI+DATI)"</b> crei un archivio <b>.ZIP compresso</b> dell'intero progetto (interfaccia grafica, HTML, JS, CSS, immagini e database).
                    </p>
                </div>
            </div>

            <div style="text-align:center;">
                <button onclick="document.getElementById('modalGuidaBackup').style.display='none'" style="background:linear-gradient(135deg, #0284c7, #0369a1); color:#ffffff; border:none; padding:12px 32px; border-radius:12px; font-weight:800; font-size:13px; cursor:pointer; box-shadow:0 4px 12px rgba(2,132,199,0.3);">
                    HO CAPITO, PERFETTO
                </button>
            </div>
        </div>
    </div>

