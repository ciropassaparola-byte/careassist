    <!-- SOVRAPPOSIZIONE GUIDA INTERATTIVA (GLASSMORPHISM) -->
    <div id="guidaNovitaOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15,23,42,0.55); backdrop-filter:blur(10px); z-index:20000; justify-content:center; align-items:center; transition: all 0.3s ease;">
