        <div class="drawer-header">
            <div style="display: flex; align-items: center; gap: 12px;">
                <img src="https://img.icons8.com/fluency/48/bell.png" style="width: 28px; height: 28px;">
                <h2 style="margin: 0; font-family:'Segoe UI', Arial; font-size: 18px; font-weight: 800; letter-spacing: 0.5px; color:#0f172a;">Centro Notifiche</h2>
            </div>
            <button class="drawer-close-btn" onclick="ToggleNotifDrawer(false)">&times;</button>
