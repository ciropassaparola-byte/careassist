                <!-- WIDGET METEO LIVE -->
                <div class="kpi-card kpi-card-meteo meteo-modern-premium" id="cardMeteoDashboard" onclick="CaricaMeteoLive()" data-hint="Meteo Live: condizioni atmosferiche e stradali aggiornate in tempo reale.">
                    <div class="meteo-bg-glow"></div>
                    <h3 class="meteo-title">
                        <span><img src="https://img.icons8.com/fluency/48/partly-cloudy-day.png" onerror="HandleIconError(this, '')" class="meteo-title-icon"> METEO LIVE</span>
                        <span class="meteo-refresh" title="Aggiorna meteo">√∞≈∏‚¨ù‚¨~</span>
                    </h3>

                    <div class="meteo-main-row">
                        <div class="meteo-text-col">
                            <div id="lblMeteoTemp" class="meteo-temp">--√¬∞C</div>
                            <div id="lblMeteoDesc" class="meteo-desc">CARICAMENTO...</div>
                        </div>
                        <div id="lblMeteoIcon" class="meteo-icon">√¢ÀS‚¨√Ø¬∏¬è</div>
                    </div>

