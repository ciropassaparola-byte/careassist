                        <span class="quick-pill" onclick="setNomeRapido('Dott.ssa Laura Bianchi', 'RSA Villa Salus', 'demo30')">RSA Villa Salus</span>
                        <span class="quick-pill" onclick="setNomeRapido('Geom. Marco Ferri', 'EdilCantieri SpA', 'demo30')">EdilCantieri</span>
